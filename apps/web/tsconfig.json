{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "typeRoots": ["./node_modules/@types"],
    "types": ["react", "react-dom"],
    "paths": {
      "@energize/shared": ["../../packages/shared/src/index.ts"],
      "@energize/shared/*": ["../../packages/shared/src/*"],
      "astro/jsx-runtime": ["./node_modules/astro/jsx-runtime.d.ts"],
      "astro/jsx-dev-runtime": ["./node_modules/astro/jsx-runtime.d.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "api/**/*", "tests/**/*"],
  "exclude": ["dist"]
}
