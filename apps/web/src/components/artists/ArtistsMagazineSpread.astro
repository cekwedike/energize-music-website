---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  featured: ArtistCardType[];
}

const { featured } = Astro.props;
const lead = featured[0];
const side = featured.slice(1, 3);

if (!lead) return null;

const leadPhoto = urlForImage(lead.photo).width(1400).height(900).fit('crop').auto('format').url();
---

<section class="magazine-spread relative overflow-hidden py-16 sm:py-24" aria-labelledby="magazine-spread-heading" data-magazine-spread>
  <div class="magazine-spread__rule" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <header class="magazine-spread__header flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-[var(--color-glow)]">Editorial spread</p>
        <h2 id="magazine-spread-heading" class="mt-3 font-display text-[clamp(1.75rem,1.3rem+1.5vw,2.75rem)]">
          On the cover
        </h2>
      </div>
      <p class="magazine-spread__issue text-xs font-bold uppercase tracking-[0.2em] text-paper/30">
        Vol. {new Date().getFullYear()} / Spotlight
      </p>
    </header>

    <div class="magazine-spread__layout mt-12 grid gap-8 lg:grid-cols-12 lg:gap-6">
      <a href={`/artists/${lead.slug}`} class="magazine-spread__lead group lg:col-span-7">
        <div class="magazine-spread__lead-frame" data-clip-reveal>
          <img
            src={leadPhoto}
            alt={lead.photo.alt ?? lead.name}
            loading="lazy"
            decoding="async"
            class="magazine-spread__lead-photo"
          />
          <div class="magazine-spread__lead-overlay" aria-hidden="true"></div>
          <span class="magazine-spread__folio" aria-hidden="true">01</span>
        </div>
        <div class="magazine-spread__lead-copy mt-6 lg:mt-8">
          <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--color-glow)]">Lead feature</p>
          <h3 class="mt-2 font-display text-[clamp(2rem,1.5rem+2vw,3.5rem)] leading-none text-paper transition group-hover:text-[var(--color-glow)]">
            {lead.name}
          </h3>
          {lead.tagline && <p class="mt-4 max-w-md text-paper/60 leading-relaxed">{lead.tagline}</p>}
          <span class="magazine-spread__read mt-6 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-paper/45 transition group-hover:text-[var(--color-glow)]">
            Read profile
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      <div class="magazine-spread__sidebar lg:col-span-5 lg:flex lg:flex-col lg:justify-between">
        <div class="magazine-spread__pullquote hidden lg:block" aria-hidden="true">
          <p class="font-display text-4xl italic leading-tight text-paper/15">
            Voices that move the room.
          </p>
        </div>

        <div class="magazine-spread__side-stack flex flex-col gap-6">
          {
            side.map((artist, index) => {
              const photoUrl = urlForImage(artist.photo).width(600).height(750).fit('crop').auto('format').url();
              return (
                <a href={`/artists/${artist.slug}`} class="magazine-spread__side group flex gap-4">
                  <div class="magazine-spread__side-thumb shrink-0 overflow-hidden" data-clip-reveal>
                    <img src={photoUrl} alt={artist.photo.alt ?? artist.name} loading="lazy" decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
                  </div>
                  <div class="min-w-0 py-1">
                    <span class="text-[10px] font-bold tabular-nums text-paper/25">{String(index + 2).padStart(2, '0')}</span>
                    <p class="mt-1 font-display text-xl text-paper transition group-hover:text-[var(--color-glow)]">{artist.name}</p>
                    {artist.tagline && <p class="mt-1 line-clamp-2 text-sm text-paper/50">{artist.tagline}</p>}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .magazine-spread {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .magazine-spread__rule {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, rgba(77, 168, 255, 0.2) 30%, rgba(77, 168, 255, 0.2) 70%, transparent);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .magazine-spread__lead {
    text-decoration: none;
  }

  .magazine-spread__lead-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .magazine-spread__lead-photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .magazine-spread__lead:hover .magazine-spread__lead-photo {
    transform: scale(1.04);
  }

  .magazine-spread__lead-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(77, 168, 255, 0.08) 0%, transparent 50%);
    mix-blend-mode: overlay;
  }

  .magazine-spread__folio {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 4vw, 7rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.08);
  }

  .magazine-spread__side-thumb {
    width: 88px;
    height: 110px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 640px) {
    .magazine-spread__side-thumb {
      width: 110px;
      height: 138px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .magazine-spread__lead:hover .magazine-spread__lead-photo,
    .magazine-spread__side:hover img {
      transform: none !important;
    }
  }
</style>
