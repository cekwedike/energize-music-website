---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  artists: ArtistCardType[];
}

const { artists } = Astro.props;

function previewText(artist: ArtistCardType): string | undefined {
  if (artist.tagline?.trim()) return artist.tagline.trim();
  if (artist.bio?.trim()) return artist.bio.trim();
  return undefined;
}
---

<section
  id="full-roster"
  class="roster-index mx-auto max-w-7xl px-5 pb-20 sm:px-6 sm:pb-28"
  aria-labelledby="roster-index-heading"
>
  <div class="roster-index__header border-t border-white/10 pt-14 sm:pt-16">
    <h2 id="roster-index-heading" class="font-display text-2xl text-paper sm:text-3xl">Full roster</h2>
    <p class="mt-2 max-w-lg text-sm text-paper/50">Browse every artist on Energize Music.</p>
  </div>

  <div id="artist-grid" class="roster-index__grid mt-8">
    {
      artists.map((artist) => {
        const photoUrl = urlForImage(artist.photo).width(600).height(600).fit('crop').auto('format').url();
        const preview = previewText(artist);
        return (
          <a href={`/artists/${artist.slug}`} class="roster-card group">
            <div class="roster-card__art">
              <img
                src={photoUrl}
                alt={artist.photo.alt ?? artist.name}
                loading="lazy"
                decoding="async"
                class="roster-card__photo"
              />
            </div>
            <div class="roster-card__body">
              <p class="roster-card__name">{artist.name}</p>
              {preview && <p class="roster-card__preview">{preview}</p>}
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .roster-index__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.875rem;
  }

  @media (min-width: 640px) {
    .roster-index__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .roster-index__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .roster-index__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .roster-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .roster-card:hover,
  .roster-card:focus-visible {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
  }

  .roster-card__art {
    aspect-ratio: 1;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
  }

  .roster-card__photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .roster-card:hover .roster-card__photo {
    transform: scale(1.03);
  }

  .roster-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    min-height: 5.5rem;
  }

  .roster-card__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-paper);
  }

  .roster-card__preview {
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgba(250, 250, 248, 0.45);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .roster-card:hover .roster-card__photo,
    .roster-card:hover,
    .roster-card:focus-visible {
      transform: none;
    }
  }
</style>
