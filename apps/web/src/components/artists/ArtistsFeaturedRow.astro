---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  artists: ArtistCardType[];
}

const { artists } = Astro.props;
---

{
  artists.length > 0 && (
    <section class="featured-row mx-auto max-w-7xl px-5 py-10 sm:px-6" aria-labelledby="featured-artists-heading">
      <div class="flex items-end justify-between gap-4">
        <h2 id="featured-artists-heading" class="font-display text-2xl text-paper sm:text-3xl">
          Featured artists
        </h2>
      </div>

      <div class="featured-row__scroll mt-6 -mx-5 px-5 sm:-mx-6 sm:px-6">
        <ul class="featured-row__track">
          {
            artists.map((artist) => {
              const photoUrl = urlForImage(artist.photo).width(400).height(400).fit('crop').auto('format').url();
              const preview = artist.tagline ?? artist.bio?.slice(0, 80);
              return (
                <li class="featured-row__item">
                  <a href={`/artists/${artist.slug}`} class="featured-row__card group">
                    <div class="featured-row__art">
                      <img
                        src={photoUrl}
                        alt={artist.photo.alt ?? artist.name}
                        loading="lazy"
                        decoding="async"
                        class="featured-row__photo"
                      />
                    </div>
                    <p class="featured-row__name">{artist.name}</p>
                    {preview && <p class="featured-row__preview">{preview}</p>}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .featured-row__scroll {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .featured-row__scroll::-webkit-scrollbar {
    display: none;
  }

  .featured-row__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding-bottom: 0.25rem;
  }

  .featured-row__item {
    width: 10.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .featured-row__item {
      width: 11.5rem;
    }
  }

  .featured-row__card {
    display: block;
    text-decoration: none;
  }

  .featured-row__art {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .featured-row__card:hover .featured-row__art,
  .featured-row__card:focus-visible .featured-row__art {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }

  .featured-row__photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .featured-row__card:hover .featured-row__photo {
    transform: scale(1.04);
  }

  .featured-row__name {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-paper);
  }

  .featured-row__preview {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgba(250, 250, 248, 0.45);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-row__card:hover .featured-row__art,
    .featured-row__card:hover .featured-row__photo {
      transform: none;
    }
  }
</style>
