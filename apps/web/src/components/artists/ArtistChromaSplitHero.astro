---
import type { Artist } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import ArtistStreamingLinks from './ArtistStreamingLinks.astro';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props as Props;

const heroUrl = urlForImage(artist.photo).width(1920).height(1280).fit('crop').auto('format').url();
const portraitUrl = urlForImage(artist.photo).width(900).height(1200).fit('crop').auto('format').url();

const nameParts: string[] = artist.name.split(' ');
const genres: string[] = artist.genres ?? [];
---

<section class="chroma-hero" data-chroma-hero aria-label={`${artist.name} profile`}>
  <div class="chroma-hero__grid">
    <div class="chroma-hero__type-panel" data-chroma-type>
      <div class="chroma-hero__type-inner">
        <a
          href="/artists"
          class="chroma-hero__back inline-flex min-h-10 items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-paper/45 transition hover:text-[var(--color-glow)]"
        >
          ← Roster
        </a>

        <div class="chroma-hero__intro">
          <h1 class="chroma-hero__name font-display leading-[0.82] tracking-tight">
            {
              nameParts.map((part: string, index: number) => (
                <span
                  class="chroma-hero__name-line block text-[clamp(2.75rem,1.5rem+7vw,7.5rem)] text-paper"
                  data-split-line
                  data-name-line
                  style={`--line-i: ${index}`}
                >
                  {part}
                </span>
              ))
            }
          </h1>

          {
            artist.tagline && (
              <p class="chroma-hero__tagline chroma-hero__reveal mt-8 max-w-md text-[clamp(1rem,0.95rem+0.4vw,1.35rem)] leading-relaxed text-paper/68">
                {artist.tagline}
              </p>
            )
          }

          {
            genres.length > 0 && (
              <ul class="chroma-hero__genres chroma-hero__reveal mt-8 flex flex-wrap gap-2" aria-label="Genres">
                {genres.map((genre: string) => (
                  <li class="chroma-hero__genre">{genre}</li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      <div class="chroma-hero__scan" aria-hidden="true" data-chroma-scan></div>
    </div>

    <div class="chroma-hero__photo-panel" data-chroma-photo>
      <div class="chroma-hero__photo-stack">
        <img
          src={heroUrl}
          alt={artist.photo.alt ?? artist.name}
          class="chroma-hero__photo chroma-hero__photo--wide"
          data-chroma-lcp
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <img
          src={portraitUrl}
          alt=""
          class="chroma-hero__photo chroma-hero__photo--tall"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <div class="chroma-hero__duotone" aria-hidden="true"></div>
        <div class="chroma-hero__grain" aria-hidden="true"></div>
        <div class="chroma-hero__vignette" aria-hidden="true"></div>
      </div>
      <div class="chroma-hero__aperture" aria-hidden="true" data-chroma-aperture></div>
    </div>
  </div>

  <div class="chroma-hero__scroll" aria-hidden="true">
    <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-paper/30">Scroll</span>
    <span class="chroma-hero__scroll-line"></span>
  </div>
</section>

<section class="chroma-narrative border-b border-white/8 bg-[var(--color-ink-raised)]/50">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1fr_minmax(0,340px)] lg:gap-20">
    <div class="chroma-narrative__story scroll-reveal min-w-0">
      <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-[var(--color-glow)]">The narrative</p>
      <h2 class="mt-4 font-display text-[clamp(1.75rem,1.3rem+1.5vw,2.5rem)] leading-tight">
        About {artist.name}
      </h2>
      <p class="chroma-narrative__bio mt-8 max-w-2xl text-paper/72 leading-[1.75]">{artist.bio}</p>
    </div>

    {
      artist.streaming && (
        <aside class="chroma-narrative__links scroll-reveal lg:sticky lg:top-28 lg:self-start" style="--reveal-delay: 100ms">
          <div class="chroma-narrative__panel rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
            <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-paper/45">Listen and follow</p>
            <p class="mt-2 font-display text-xl text-paper">Stream {artist.name}</p>
            <div class="mt-6">
              <ArtistStreamingLinks streaming={artist.streaming} artistName={artist.name} layout="stack" />
            </div>
          </div>
        </aside>
      )
    }
  </div>
</section>

<style>
  .chroma-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--color-ink);
  }

  .chroma-hero__grid {
    display: grid;
    min-height: 100vh;
    min-height: 100dvh;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .chroma-hero__grid {
      grid-template-columns: minmax(0, 44%) minmax(0, 56%);
    }
  }

  .chroma-hero__type-panel {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem 1.25rem 4.5rem;
    background:
      linear-gradient(160deg, rgba(11, 11, 13, 0.98) 0%, rgba(11, 11, 13, 0.92) 60%, rgba(11, 11, 13, 0.85) 100%),
      radial-gradient(ellipse 80% 50% at 0% 100%, rgba(77, 168, 255, 0.1), transparent 65%);
    will-change: transform;
  }

  @media (min-width: 1024px) {
    .chroma-hero__type-panel {
      padding: 2.5rem 2.5rem 5rem 3rem;
      clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
    }
  }

  .chroma-hero__type-inner {
    max-width: 36rem;
  }

  .chroma-hero__name-line {
    transform-origin: 0 100%;
    will-change: transform, opacity;
  }

  .chroma-hero__name :global(.motion-char) {
    display: inline-block;
    transform-origin: 0 100%;
    will-change: transform, opacity;
  }

  .chroma-hero__reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .chroma-hero.is-ready .chroma-hero__reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .chroma-hero.is-ready .chroma-hero__tagline {
    transition-delay: 0.45s;
  }

  .chroma-hero.is-ready .chroma-hero__genres {
    transition-delay: 0.6s;
  }

  .chroma-hero__genre {
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.35rem 0.75rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.78);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(6px);
  }

  .chroma-hero__scan {
    position: absolute;
    top: 0;
    right: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--color-glow), transparent);
    opacity: 0.5;
    transform: translateX(50%);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .chroma-hero__scan {
      right: 8%;
    }
  }

  .chroma-hero__photo-panel {
    position: relative;
    min-height: 52vh;
    overflow: hidden;
    will-change: transform;
  }

  @media (min-width: 1024px) {
    .chroma-hero__photo-panel {
      min-height: 100vh;
      min-height: 100dvh;
      margin-left: -8%;
      clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%);
    }
  }

  .chroma-hero__photo-stack {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .chroma-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    will-change: transform;
  }

  .chroma-hero__photo--wide {
    display: none;
  }

  @media (min-width: 1024px) {
    .chroma-hero__photo--wide {
      display: block;
    }

    .chroma-hero__photo--tall {
      display: none;
    }
  }

  .chroma-hero__duotone {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(77, 168, 255, 0.55) 0%, rgba(11, 11, 13, 0.75) 55%, rgba(11, 11, 13, 0.9) 100%);
    mix-blend-mode: color;
    pointer-events: none;
  }

  .chroma-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .chroma-hero__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 11, 13, 0.35) 0%, transparent 35%, rgba(11, 11, 13, 0.55) 100%),
      linear-gradient(90deg, rgba(11, 11, 13, 0.65) 0%, transparent 28%);
    pointer-events: none;
  }

  .chroma-hero__aperture {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    clip-path: inset(0 0 0 0);
    pointer-events: none;
  }

  .chroma-hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
  }

  .chroma-hero__scroll-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(180deg, rgba(77, 168, 255, 0.55), transparent);
    animation: chroma-scroll-pulse 2.2s ease-in-out infinite;
  }

  @keyframes chroma-scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.8);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  .chroma-narrative__bio {
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
  }

  .chroma-narrative__panel {
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .chroma-hero__photo,
    .chroma-hero__type-panel,
    .chroma-hero__name-line {
      will-change: auto;
    }

    .chroma-hero__reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .chroma-hero__aperture {
      display: none;
    }

    .chroma-hero__scroll-line {
      animation: none;
    }
  }
</style>
