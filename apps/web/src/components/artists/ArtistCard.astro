---
import type { Artist } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;
const photoUrl = urlForImage(artist.photo).width(600).height(600).fit('crop').auto('format').url();

const tierLabel: Record<Artist['tier'], string> = {
  official: 'Official',
  collaborator: 'Collaborator',
  legacy: 'Legacy',
};
---

<a
  href={`/artists/${artist.slug}`}
  data-tier={artist.tier}
  class="artist-card group block overflow-hidden rounded-lg border border-white/10 bg-white/[0.02] transition hover:border-[var(--color-accent)]/50"
>
  <div class="aspect-square overflow-hidden">
    <img
      src={photoUrl}
      alt={artist.photo.alt ?? artist.name}
      loading="lazy"
      class="artist-card-photo h-full w-full object-cover"
    />
  </div>
  <div class="p-4">
    <p class="font-medium text-paper">{artist.name}</p>
    <p class="mt-1 text-xs uppercase tracking-wide text-paper/50">{tierLabel[artist.tier]}</p>
  </div>
</a>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    import('motion/mini').then(({ animate }) => {
      const ease = [0.22, 1, 0.36, 1] as const;
      document.querySelectorAll<HTMLAnchorElement>('.artist-card').forEach((card) => {
        const photo = card.querySelector<HTMLImageElement>('.artist-card-photo');
        if (!photo) return;
        card.addEventListener('mouseenter', () => animate(photo, { scale: 1.08 }, { duration: 0.5, ease }));
        card.addEventListener('mouseleave', () => animate(photo, { scale: 1 }, { duration: 0.5, ease }));
      });
    });
  }
</script>

<style>
  .artist-card-photo {
    will-change: transform;
  }
</style>
