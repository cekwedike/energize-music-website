---
import type { Artist } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import ArtistStreamingLinks from './ArtistStreamingLinks.astro';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;

const coverImage = artist.coverImage;
const hasCoverImage = Boolean(coverImage?.asset?.url);
const bannerUrl =
  coverImage != null && coverImage.asset?.url
    ? urlForImage(coverImage).width(1600).height(900).fit('crop').auto('format').url()
    : '/brand/logo.webp';
const avatarUrl = urlForImage(artist.photo).width(400).height(400).fit('crop').auto('format').url();

const tierLabel: Record<Artist['tier'], string> = {
  official: 'Official artist',
  legacy: 'Legacy catalog',
};
---

<section class="profile-hero" aria-label={`${artist.name} profile`}>
  <div class:list={['profile-hero__banner-wrap', !hasCoverImage && 'profile-hero__banner-wrap--logo']}>
    <img
      src={bannerUrl}
      alt=""
      class:list={['profile-hero__banner', !hasCoverImage && 'profile-hero__banner--logo']}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="profile-hero__banner-overlay" aria-hidden="true"></div>
  </div>

  <div class="profile-hero__body mx-auto max-w-7xl px-5 sm:px-6">
    <a
      href="/artists"
      class="profile-hero__back inline-flex min-h-10 items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-paper/50 transition hover:text-paper"
    >
      ← All artists
    </a>

    <div class="profile-hero__main">
      <img
        src={avatarUrl}
        alt={artist.photo.alt ?? artist.name}
        class="profile-hero__avatar"
        loading="eager"
        decoding="async"
      />

      <div class="profile-hero__meta min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--color-glow)]">{tierLabel[artist.tier]}</p>
        <h1 class="mt-2 font-display text-[clamp(2rem,1.2rem+4vw,3.75rem)] leading-none tracking-tight text-paper">
          {artist.name}
        </h1>
        {artist.tagline && <p class="mt-3 max-w-xl text-base text-paper/65 sm:text-lg">{artist.tagline}</p>}

        {
          artist.genres && artist.genres.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Genres">
              {artist.genres.map((genre) => (
                <li class="rounded-full bg-white/[0.08] px-3 py-1 text-xs font-medium text-paper/75">{genre}</li>
              ))}
            </ul>
          )
        }

        {
          artist.streaming && (
            <div class="mt-6">
              <ArtistStreamingLinks streaming={artist.streaming} artistName={artist.name} layout="inline" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<section class="border-b border-white/8 bg-[var(--color-ink-raised)]/40">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-6 sm:py-16">
    <h2 class="font-display text-xl text-paper sm:text-2xl">About {artist.name}</h2>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-paper/70 sm:text-lg">{artist.bio}</p>
  </div>
</section>

<style>
  .profile-hero {
    position: relative;
    background: var(--color-ink);
  }

  .profile-hero__banner-wrap {
    position: relative;
    height: clamp(12rem, 8rem + 14vw, 20rem);
    overflow: hidden;
  }

  .profile-hero__banner-wrap--logo {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse 70% 90% at 50% 40%, rgba(77, 168, 255, 0.08), transparent 60%),
      var(--color-ink-raised);
  }

  .profile-hero__banner {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .profile-hero__banner--logo {
    height: auto;
    width: min(18rem, 70%);
    max-height: 55%;
    object-fit: contain;
    object-position: center;
    opacity: 0.92;
  }

  .profile-hero__banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 11, 13, 0.15) 0%, rgba(11, 11, 13, 0.75) 70%, var(--color-ink) 100%);
  }

  .profile-hero__body {
    position: relative;
    margin-top: -4.5rem;
    padding-bottom: 2rem;
  }

  .profile-hero__main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .profile-hero__main {
      flex-direction: row;
      align-items: flex-end;
      gap: 1.5rem;
    }
  }

  .profile-hero__avatar {
    width: 9rem;
    height: 9rem;
    flex-shrink: 0;
    border-radius: 0.75rem;
    object-fit: cover;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    border: 4px solid var(--color-ink);
  }

  @media (min-width: 640px) {
    .profile-hero__avatar {
      width: 11rem;
      height: 11rem;
    }
  }
</style>
