---
import type { Artist } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;

// Prefer the wide cover image when there is one, otherwise the portrait.
const heroSource = artist.coverImage?.asset ? artist.coverImage : artist.photo;
const heroUrl = urlForImage(heroSource).width(2000).height(1250).fit('crop').auto('format').url();
const genre = artist.genres?.[0] ?? 'Afro-Gospel';
---

<section class="profile-hero" aria-labelledby="profile-hero-name">
  <img
    src={heroUrl}
    alt={artist.photo.alt ?? `${artist.name} portrait`}
    width="2000"
    height="1250"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="profile-hero__img"
  />
  <div class="profile-hero__tint" aria-hidden="true"></div>

  <div class="profile-hero__content mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <Eyebrow tone="light">{genre} artist</Eyebrow>
    <h1 id="profile-hero-name" class="profile-hero__name">{artist.name}</h1>
    {artist.tagline && <p class="profile-hero__tagline">{artist.tagline}</p>}
  </div>
</section>

<style>
  .profile-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* Sits under the transparent overlay header. */
    margin-top: calc(-1 * var(--header-height, 4rem));
    min-height: min(88svh, 52rem);
    overflow: hidden;
    background: #0a0a0a;
  }

  .profile-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  /* Flat tint so white text passes contrast on any photo. */
  .profile-hero__tint {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.6);
  }

  .profile-hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(2.5rem, 8vh, 5rem);
  }

  .profile-hero__name {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 1.4rem + 9vw, 10rem);
    font-weight: 400;
    line-height: 0.88;
    text-transform: uppercase;
    color: #ffffff;
    overflow-wrap: anywhere;
  }

  .profile-hero__tagline {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    color: #ffffff;
  }
</style>
