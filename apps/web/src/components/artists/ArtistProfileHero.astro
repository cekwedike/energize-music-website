---
import type { Artist } from '@energize/shared';
import { imageAlt } from '../../lib/seo/site';
import { titleCase } from '../../lib/text/titleCase';
import { urlForImage } from '../../lib/sanity/client';
import ArtistStreamingLinks from './ArtistStreamingLinks.astro';
import EditorialSectionLink from '../ui/EditorialSectionLink.astro';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;

const coverImage = artist.coverImage;
const hasCoverImage = Boolean(coverImage?.asset?.url);
const bannerUrl =
  coverImage != null && coverImage.asset?.url
    ? urlForImage(coverImage).width(1600).height(900).fit('crop').auto('format').url()
    : '/brand/logo.webp';
const avatarUrl = urlForImage(artist.photo).width(800).height(800).fit('crop').auto('format').url();

---

<section class="profile-hero" aria-label={`${artist.name} profile`}>
  <div class:list={['profile-hero__banner-wrap', !hasCoverImage && 'profile-hero__banner-wrap--logo']}>
    <img
      src={bannerUrl}
      alt=""
      width={hasCoverImage ? 1600 : 827}
      height={hasCoverImage ? 900 : 267}
      class:list={['profile-hero__banner', !hasCoverImage && 'profile-hero__banner--logo']}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="profile-hero__banner-overlay" aria-hidden="true"></div>
  </div>

  <div class="profile-hero__body mx-auto max-w-7xl px-5 sm:px-6">
    <EditorialSectionLink href="/artists" label="All Artistes" variant="back" class="profile-hero__back" />

    <div class="profile-hero__main">
      <img
        src={avatarUrl}
        alt={imageAlt(artist.photo.alt, `${artist.name}, Energize Music artiste`)}
        width="800"
        height="800"
        class="profile-hero__avatar"
        loading="eager"
        decoding="async"
      />

      <div class="profile-hero__meta min-w-0">
        <h1 class="font-display text-[clamp(2rem,1.2rem+4vw,3.75rem)] leading-none tracking-tight text-fg">
          {artist.name}
          <span class="mt-2 block text-[clamp(1rem,0.85rem+1vw,1.35rem)] font-sans font-medium tracking-normal text-[var(--color-muted)]">
            {titleCase(`${artist.genres?.[0] ?? 'Afro-gospel'} Artiste`)}
          </span>
        </h1>
        {artist.tagline && <p class="mt-3 max-w-xl text-base text-fg sm:text-lg">{artist.tagline}</p>}

        {
          artist.genres && artist.genres.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Genres">
              {artist.genres.map((genre: string) => (
                <li class="rounded-full bg-fg/[0.08] px-3 py-1 text-xs font-medium text-fg">{genre}</li>
              ))}
            </ul>
          )
        }

        {
          artist.streaming && (
            <div class="mt-6">
              <ArtistStreamingLinks streaming={artist.streaming} artistName={artist.name} layout="inline" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .profile-hero {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--header-height, 4rem));
    background: var(--color-bg);
  }

  .profile-hero__banner-wrap {
    position: relative;
    height: calc(clamp(12rem, 8rem + 14vw, 20rem) + var(--header-height, 4rem));
    overflow: hidden;
  }

  .profile-hero__banner-wrap--logo {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-top: var(--header-height, 4rem);
    background: var(--color-surface);
  }

  .profile-hero__banner {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .profile-hero__banner--logo {
    height: auto;
    width: min(18rem, 70%);
    max-height: 55%;
    object-fit: contain;
    object-position: center;
    opacity: 0.92;
  }

  .profile-hero__banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-bg) 15%, transparent) 0%, color-mix(in srgb, var(--color-bg) 75%, transparent) 70%, var(--color-bg) 100%);
  }

  .profile-hero__body {
    position: relative;
    margin-top: clamp(-5rem, -3rem - 4vw, -7rem);
    padding-bottom: 2.5rem;
  }

  .profile-hero__main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .profile-hero__main {
      flex-direction: row;
      align-items: flex-end;
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .profile-hero__main {
      gap: 2.5rem;
    }
  }

  .profile-hero__avatar {
    width: clamp(10.5rem, 8rem + 8vw, 16rem);
    height: clamp(10.5rem, 8rem + 8vw, 16rem);
    flex-shrink: 0;
    border-radius: var(--radius-card);
    object-fit: cover;
    box-shadow: var(--shadow-card);
    border: 4px solid var(--color-bg);
  }
</style>
