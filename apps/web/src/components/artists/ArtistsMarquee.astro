---
import type { ArtistCard as ArtistCardType } from '@energize/shared';

interface Props {
  artists: ArtistCardType[];
}

const { artists } = Astro.props;
const marqueeNames = artists.map((artist) => artist.name);
const loopNames = [...marqueeNames, ...marqueeNames];
---

{
  marqueeNames.length > 0 && (
    <div class="dsp-marquee overflow-hidden border-y border-white/8 bg-[#0a0a0c]" aria-hidden="true">
      <div class="dsp-marquee__track">
        {
          loopNames.map((name) => (
            <span class="dsp-marquee__item">{name}</span>
          ))
        }
      </div>
    </div>
  )
}

<style>
  .dsp-marquee {
    padding-block: 1rem;
  }

  .dsp-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 2.5rem;
    animation: dsp-marquee-scroll 40s linear infinite;
  }

  .dsp-marquee__item {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.28);
    white-space: nowrap;
  }

  .dsp-marquee__item::after {
    content: '•';
    margin-left: 2.5rem;
    color: rgba(77, 168, 255, 0.35);
  }

  @keyframes dsp-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dsp-marquee__track {
      animation-duration: 120s;
    }
  }
</style>
