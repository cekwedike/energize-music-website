---
---

<section class="scroll-reveal mx-auto max-w-7xl px-5 pb-24 sm:px-6 sm:pb-32">
  <div class="artists-cta relative overflow-hidden rounded-3xl border border-white/10 px-6 py-12 sm:px-12 sm:py-16">
    <div class="artists-cta__mesh" aria-hidden="true"></div>
    <div class="artists-cta__grain" aria-hidden="true"></div>

    <div class="relative grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="max-w-xl">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--color-glow)]">Join the roster</p>
        <h2 class="text-h2 mt-4 font-display">Music with purpose, built for the world</h2>
        <p class="mt-4 text-paper/65">
          Energize Music develops Afro-gospel and soul-fusion artists with excellence, family-friendly values, and global
          reach.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center rounded-full bg-[var(--color-glow)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-glow)]/90 hover:shadow-[0_0_40px_rgba(77,168,255,0.35)]"
        >
          Get in touch
        </a>
        <a
          href="/about"
          class="inline-flex min-h-11 items-center rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-paper transition hover:border-white/45 hover:bg-white/5"
        >
          About the label
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .artists-cta {
    background: rgba(255, 255, 255, 0.02);
  }

  .artists-cta__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, rgba(77, 168, 255, 0.14), transparent 55%),
      radial-gradient(ellipse 50% 60% at 0% 100%, rgba(37, 99, 235, 0.08), transparent 50%);
  }

  .artists-cta__grain {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>
