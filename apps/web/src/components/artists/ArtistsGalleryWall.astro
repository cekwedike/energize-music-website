---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  artists: ArtistCardType[];
}

const { artists } = Astro.props;

const tierLabel: Record<ArtistCardType['tier'], string> = {
  official: 'Official',
  legacy: 'Legacy',
};
---

<section
  id="gallery-wall"
  class="gallery-wall"
  data-gallery-wall
  aria-labelledby="gallery-wall-heading"
>
  <div class="gallery-wall__pin">
    <div class="gallery-wall__header mx-auto max-w-7xl px-5 sm:px-6">
      <div class="gallery-wall__header-inner flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.35em] text-[var(--color-glow)]">Light table</p>
          <h2 id="gallery-wall-heading" class="mt-3 font-display text-[clamp(2rem,1.5rem+2vw,3.5rem)] leading-none">
            Gallery wall
          </h2>
        </div>
        <p class="max-w-xs text-sm text-paper/45">
          Scroll to scrub the full lineup. Each print is a door into an artist profile.
        </p>
      </div>

      <div class="gallery-wall__progress mt-8 hidden lg:block" aria-hidden="true">
        <div class="gallery-wall__progress-track">
          <div class="gallery-wall__progress-fill" data-gallery-progress></div>
        </div>
        <div class="gallery-wall__progress-labels mt-2 flex justify-between text-[9px] font-bold uppercase tracking-[0.25em] text-paper/30">
          <span>01</span>
          <span>{String(artists.length).padStart(2, '0')}</span>
        </div>
      </div>
    </div>

    <div class="gallery-wall__viewport mt-10 overflow-hidden">
      <div class="gallery-wall__track flex gap-5 px-5 sm:gap-6 sm:px-6" data-gallery-track>
        {
          artists.map((artist, index) => {
            const photoUrl = urlForImage(artist.photo).width(720).height(900).fit('crop').auto('format').url();
            const isEven = index % 2 === 0;
            return (
              <a
                href={`/artists/${artist.slug}`}
                class:list={['gallery-wall__print group shrink-0', isEven ? 'gallery-wall__print--high' : 'gallery-wall__print--low']}
                data-tier={artist.tier}
                data-gallery-print
              >
                <div class="gallery-wall__frame">
                  <img
                    src={photoUrl}
                    alt={artist.photo.alt ?? artist.name}
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="gallery-wall__photo"
                  />
                  <div class="gallery-wall__tape" aria-hidden="true"></div>
                  <div class="gallery-wall__light" aria-hidden="true"></div>
                  <span class="gallery-wall__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="gallery-wall__meta">
                    <span class="gallery-wall__tier">{tierLabel[artist.tier]}</span>
                    <p class="gallery-wall__name">{artist.name}</p>
                    {artist.tagline && <p class="gallery-wall__tagline">{artist.tagline}</p>}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="gallery-wall__mobile-fallback lg:hidden">
    <div class="mx-auto flex max-w-7xl gap-4 overflow-x-auto px-5 pb-8 scrollbar-hide sm:px-6">
      {
        artists.map((artist, index) => {
          const photoUrl = urlForImage(artist.photo).width(480).height(600).fit('crop').auto('format').url();
          return (
            <a href={`/artists/${artist.slug}`} class="gallery-wall__mobile-card shrink-0">
              <img src={photoUrl} alt={artist.photo.alt ?? artist.name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              <span class="gallery-wall__mobile-num">{String(index + 1).padStart(2, '0')}</span>
              <p class="gallery-wall__mobile-name">{artist.name}</p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .gallery-wall {
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, var(--color-ink) 0%, rgba(20, 20, 23, 0.95) 50%, var(--color-ink) 100%);
  }

  .gallery-wall__pin {
    min-height: 100vh;
    padding-block: 4rem 3rem;
  }

  .gallery-wall__progress-track {
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .gallery-wall__progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-glow), var(--color-glow-cyan));
    box-shadow: 0 0 12px rgba(77, 168, 255, 0.5);
    transition: width 0.05s linear;
  }

  .gallery-wall__track {
    width: max-content;
    will-change: transform;
  }

  .gallery-wall__print {
    width: min(280px, 52vw);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .gallery-wall__print {
      width: min(320px, 28vw);
    }

    .gallery-wall__print--high {
      transform: translateY(-24px);
    }

    .gallery-wall__print--low {
      transform: translateY(32px);
    }
  }

  .gallery-wall__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.02);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .gallery-wall__print:hover .gallery-wall__frame,
  .gallery-wall__print:focus-visible .gallery-wall__frame {
    transform: translateY(-8px) rotate(-1deg);
    border-color: rgba(77, 168, 255, 0.45);
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(77, 168, 255, 0.12);
  }

  .gallery-wall__photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 0.7s ease, filter 0.5s ease;
  }

  .gallery-wall__print:hover .gallery-wall__photo {
    transform: scale(1.06);
    filter: saturate(1) contrast(1.1);
  }

  .gallery-wall__tape {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 48px;
    height: 18px;
    transform: translateX(-50%) rotate(-2deg);
    background: rgba(250, 250, 248, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
  }

  .gallery-wall__light {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(255, 255, 255, 0.08), transparent 60%);
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .gallery-wall__index {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.12);
    transition: color 0.4s ease;
  }

  .gallery-wall__print:hover .gallery-wall__index {
    color: rgba(77, 168, 255, 0.35);
  }

  .gallery-wall__meta {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 1rem;
    background: linear-gradient(180deg, transparent, rgba(11, 11, 13, 0.95));
  }

  .gallery-wall__tier {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-glow);
  }

  .gallery-wall__name {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-paper);
    line-height: 1.15;
  }

  .gallery-wall__tagline {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: rgba(250, 250, 248, 0.55);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gallery-wall__mobile-fallback .gallery-wall__viewport {
    display: none;
  }

  @media (max-width: 1023px) {
    .gallery-wall__viewport {
      display: none;
    }

    .gallery-wall__pin {
      min-height: auto;
      padding-bottom: 0;
    }
  }

  .gallery-wall__mobile-card {
    position: relative;
    width: min(220px, 58vw);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .gallery-wall__mobile-num {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.2);
  }

  .gallery-wall__mobile-name {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    background: linear-gradient(180deg, transparent, rgba(11, 11, 13, 0.9));
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-wall__print--high,
    .gallery-wall__print--low {
      transform: none;
    }

    .gallery-wall__print:hover .gallery-wall__frame,
    .gallery-wall__print:hover .gallery-wall__photo {
      transform: none;
    }
  }
</style>
