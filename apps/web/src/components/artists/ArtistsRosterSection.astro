---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import { bioSnippet, rosterPortraitLabel, type RosterNavItem } from '../../lib/artists/rosterUtils';
import ArtistsRosterPagination from './ArtistsRosterPagination.astro';

interface Props {
  artist: ArtistCardType;
  index: number;
  navItems: RosterNavItem[];
}

const { artist, index, navItems } = Astro.props;

const photoUrl = urlForImage(artist.photo).width(960).height(1200).fit('crop').auto('format').url();
const portraitLabel = rosterPortraitLabel(artist);
const bio = bioSnippet(artist);
const isReversed = index % 2 === 1;
---

<section
  id={`artist-${artist.slug}`}
  class="roster-card"
  data-roster-section
  data-index={index}
  data-reverse={isReversed ? 'true' : undefined}
  aria-labelledby={`roster-name-${artist.slug}`}
>
  <div class="roster-card__inner">
    <a href={`/artists/${artist.slug}`} class="roster-card__photo-link" tabindex="-1" aria-hidden="true">
      <img
        src={photoUrl}
        alt=""
        width="960"
        height="1200"
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
        class="media-frame roster-card__photo"
        data-motion="portrait"
      />
    </a>

    <div class="roster-card__info">
      <p class="roster-card__eyebrow" data-motion="reveal">{portraitLabel}</p>
      <h2 id={`roster-name-${artist.slug}`} class="roster-card__name" data-motion="reveal">
        {artist.name}
      </h2>
      <p class="roster-card__bio" data-motion="reveal">
        {bio || `Explore ${artist.name} on the Energize Music roster.`}
      </p>
      <a href={`/artists/${artist.slug}`} class="roster-card__cta" data-motion="reveal">
        View profile
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>

  <ArtistsRosterPagination items={navItems} activeIndex={index} />
</section>

<style>
  .roster-card {
    border-top: 1px solid var(--color-line);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
  }

  .roster-card__inner {
    display: grid;
    gap: 2rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-inline: 1.25rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .roster-card__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .roster-card__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(3rem, 2rem + 4vw, 6rem);
    }

    .roster-card[data-reverse='true'] .roster-card__photo-link {
      order: 2;
    }
  }

  .roster-card__photo-link {
    display: block;
    max-width: 30rem;
  }

  .roster-card__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .roster-card__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .roster-card__name {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-fg);
  }

  .roster-card__bio {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .roster-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    min-height: 2.75rem;
    padding: 0.65rem 1.25rem;
    border: 1px solid var(--color-fg);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .roster-card__cta:hover,
  .roster-card__cta:focus-visible {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .roster-card__cta svg {
    width: 1rem;
    height: 1rem;
  }
</style>
