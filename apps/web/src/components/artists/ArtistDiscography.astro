---
import type { EnrichedRelease } from '@energize/shared';
import EditorialSectionLink from '../ui/EditorialSectionLink.astro';

interface Props {
  releases: EnrichedRelease[];
  artistName: string;
}

const { releases, artistName } = Astro.props;

const typeLabel: Record<EnrichedRelease['type'], string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};

const sorted = [...releases].sort(
  (a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime(),
);
---

{
  sorted.length > 0 && (
    <section class="discography mx-auto max-w-7xl px-5 py-14 sm:px-6 sm:py-20" aria-labelledby="discography-heading">
      <div class="discography__header">
        <div class="discography__intro">
          <h2 id="discography-heading" class="font-display text-2xl text-paper sm:text-3xl">
            Discography
          </h2>
          <p class="mt-2 text-sm text-paper/50">Releases by {artistName}</p>
        </div>
        <EditorialSectionLink
          href="/releases"
          label="View All Releases"
          class="discography__cta"
        />
      </div>

      <ul class="discography__row">
        {
          sorted.map((release) => {
            const year = new Date(release.releaseDate).getFullYear();
            const href = release.externalUrl ?? `/releases/${release.slug}`;
            const isExternal = Boolean(release.externalUrl);
            const artistsLabel =
              release.artistNames.length > 0 ? release.artistNames.join(', ') : artistName;

            return (
              <li class="discography__item">
                <a
                  href={href}
                  class="discography__card group"
                  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <div class="discography__cover-wrap">
                    {
                      release.coverUrl ? (
                        <img
                          src={release.coverUrl}
                          alt={release.cover?.alt ?? release.displayTitle}
                          loading="lazy"
                          decoding="async"
                          class="discography__cover"
                        />
                      ) : (
                        <div class="discography__cover discography__cover--placeholder" aria-hidden="true">
                          <span>No cover</span>
                        </div>
                      )
                    }
                  </div>
                  <div class="discography__meta">
                    <p class="discography__title">{release.displayTitle}</p>
                    <p class="discography__sub">
                      {artistsLabel} · {typeLabel[release.type]} · {year}
                    </p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  )
}

<style>
  .discography__header {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
  }

  @media (max-width: 1023px) {
    .discography__header {
      gap: 1.25rem;
    }
  }

  @media (min-width: 640px) {
    .discography__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.25rem;
    }
  }

  .discography__intro {
    min-width: 0;
  }

  :global(.discography__cta) {
    width: 100%;
    justify-content: center;
    min-height: 2.75rem;
  }

  @media (min-width: 640px) {
    :global(.discography__cta) {
      width: auto;
      flex-shrink: 0;
    }
  }

  .discography__row {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    list-style: none;
    padding: 0 0 0.35rem;
    margin-inline: 0;
    margin-bottom: 0;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .discography__row {
      margin-top: 2rem;
    }
  }

  .discography__row::-webkit-scrollbar {
    display: none;
  }

  .discography__item {
    flex: 0 0 clamp(140px, 38vw, 168px);
    scroll-snap-align: start;
  }

  @media (min-width: 640px) {
    .discography__item {
      flex-basis: clamp(156px, 20vw, 180px);
    }
  }

  @media (min-width: 1024px) {
    .discography__item {
      flex-basis: clamp(168px, 12vw, 200px);
    }
  }

  .discography__card {
    display: block;
    text-decoration: none;
  }

  .discography__cover-wrap {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .discography__card:hover .discography__cover-wrap,
  .discography__card:focus-visible .discography__cover-wrap {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35);
  }

  .discography__cover {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .discography__cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: rgba(250, 250, 248, 0.35);
  }

  .discography__meta {
    margin-top: 0.65rem;
  }

  .discography__title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-paper);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .discography__sub {
    margin-top: 0.2rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgba(250, 250, 248, 0.42);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .discography__card:hover .discography__cover-wrap {
      transform: none;
    }
  }
</style>
