---
import type { EnrichedRelease } from '@energize/shared';
import SectionTitle from '../ui/SectionTitle.astro';
import MediaCard from '../ui/MediaCard.astro';
import { releaseMeta } from '../../lib/releases/format';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;

const sorted = [...releases].sort(
  (a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime(),
);
---

{
  sorted.length > 0 && (
    <section class="discography" aria-labelledby="discography-heading">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionTitle id="discography-heading" title="Discography" link={{ label: 'All music', href: '/releases' }} />
        <ul class="discography__grid">
          {sorted.map((release) => (
            <li class="scroll-reveal">
              <MediaCard
                href={`/releases/${release.slug}`}
                image={release.coverUrl}
                imageAlt={`${release.displayTitle} cover art`}
                title={release.displayTitle}
                meta={releaseMeta(release)}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .discography {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--color-line);
  }

  .discography__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 1.75rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .discography__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .discography__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
