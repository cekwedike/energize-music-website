---
import type { ArtistCard as ArtistCardType } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  total: number;
  featured: ArtistCardType[];
}

const { total, featured } = Astro.props;
const collage = featured.slice(0, 4);
const paddedTotal = String(total).padStart(2, '0');
---

<section class="prism-hero relative overflow-hidden" data-prism-hero aria-label="Artists roster introduction">
  <div class="prism-hero__aurora" aria-hidden="true">
    <div class="prism-hero__blob prism-hero__blob--a"></div>
    <div class="prism-hero__blob prism-hero__blob--b"></div>
    <div class="prism-hero__blob prism-hero__blob--c"></div>
  </div>

  <div class="prism-hero__mesh" aria-hidden="true"></div>
  <div class="prism-hero__grain" aria-hidden="true"></div>
  <div class="prism-hero__grid-lines" aria-hidden="true"></div>

  <p class="prism-hero__watermark font-display" aria-hidden="true">ROSTER</p>

  <div class="relative mx-auto max-w-7xl px-5 pb-16 pt-24 sm:px-6 sm:pb-20 sm:pt-32 lg:pb-24">
    <div class="grid items-end gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16">
      <div class="prism-hero__copy min-w-0">
        <p class="prism-reveal prism-reveal-1 text-[10px] font-bold uppercase tracking-[0.4em] text-[var(--color-glow)]">
          Energize Music
        </p>

        <h1 class="prism-hero__headline mt-8 font-display leading-[0.82] tracking-tight">
          <span class="prism-reveal prism-reveal-2 block text-[clamp(3rem,1.8rem+7vw,7.5rem)] text-paper" data-split-line>
            {paddedTotal} voices
          </span>
          <span
            class="prism-reveal prism-reveal-2 prism-hero__accent mt-2 block text-[clamp(2.5rem,1.5rem+5vw,6rem)] italic"
            data-split-line
          >
            one stage
          </span>
        </h1>

        <p class="prism-reveal prism-reveal-3 mt-8 max-w-lg text-[clamp(1rem,0.95rem+0.4vw,1.15rem)] leading-relaxed text-paper/60">
          Afro-gospel and soul-fusion artists on the Energize roster, each with a profile worth opening.
        </p>

        <dl class="prism-reveal prism-reveal-4 mt-10 flex flex-wrap gap-3">
          <div class="prism-hero__stat prism-hero__stat--glow">
            <dt class="text-[9px] font-bold uppercase tracking-[0.25em] text-[var(--color-glow)]/70">Artists</dt>
            <dd class="mt-1 font-display text-2xl tabular-nums text-[var(--color-glow)] sm:text-3xl">{total}</dd>
          </div>
        </dl>

        <a
          href="#gallery-wall"
          class="prism-reveal prism-reveal-5 mt-10 inline-flex min-h-11 items-center gap-3 rounded-full border border-white/15 bg-white/[0.03] px-6 py-3 text-xs font-bold uppercase tracking-[0.22em] text-paper/75 transition hover:border-[var(--color-glow)]/50 hover:text-[var(--color-glow)] hover:shadow-[0_0_40px_rgba(77,168,255,0.15)]"
        >
          Enter the gallery
          <span class="prism-hero__cta-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      {
        collage.length > 0 && (
          <div class="prism-hero__collage prism-reveal prism-reveal-6 min-w-0" data-prism-collage>
            <div class="prism-hero__collage-inner">
              {
                collage.map((artist, index) => {
                  const photoUrl = urlForImage(artist.photo).width(640).height(800).fit('crop').auto('format').url();
                  const positions = ['prism-hero__tile--a', 'prism-hero__tile--b', 'prism-hero__tile--c', 'prism-hero__tile--d'];
                  return (
                    <a
                      href={`/artists/${artist.slug}`}
                      class:list={['prism-hero__tile group', positions[index]]}
                      style={`--tile-index: ${index}`}
                    >
                      <div class="prism-hero__tile-frame">
                        <img
                          src={photoUrl}
                          alt={artist.photo.alt ?? artist.name}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                          class="prism-hero__tile-photo"
                        />
                        <div class="prism-hero__tile-glow" aria-hidden="true"></div>
                        <div class="prism-hero__tile-overlay" aria-hidden="true"></div>
                        <span class="prism-hero__tile-num" aria-hidden="true">
                          {String(index + 1).padStart(2, '0')}
                        </span>
                        <p class="prism-hero__tile-name">{artist.name}</p>
                      </div>
                    </a>
                  );
                })
              }
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="prism-hero__horizon" aria-hidden="true"></div>
</section>

<style>
  .prism-hero {
    min-height: min(92vh, 960px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-ink);
  }

  .prism-hero__aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .prism-hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    animation: prism-drift 18s ease-in-out infinite alternate;
  }

  .prism-hero__blob--a {
    top: -8%;
    right: 5%;
    width: min(480px, 55vw);
    height: min(480px, 55vw);
    background: radial-gradient(circle, rgba(77, 168, 255, 0.35), transparent 70%);
    animation-duration: 22s;
  }

  .prism-hero__blob--b {
    bottom: 10%;
    left: -8%;
    width: min(380px, 45vw);
    height: min(380px, 45vw);
    background: radial-gradient(circle, rgba(103, 232, 249, 0.2), transparent 70%);
    animation-duration: 16s;
    animation-delay: -4s;
  }

  .prism-hero__blob--c {
    top: 35%;
    left: 40%;
    width: min(300px, 35vw);
    height: min(300px, 35vw);
    background: radial-gradient(circle, rgba(37, 99, 235, 0.22), transparent 70%);
    animation-duration: 20s;
    animation-delay: -8s;
  }

  @keyframes prism-drift {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(30px, -20px) scale(1.08);
    }
  }

  .prism-hero__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 15% 20%, rgba(77, 168, 255, 0.12), transparent 55%),
      radial-gradient(ellipse 50% 40% at 85% 75%, rgba(103, 232, 249, 0.08), transparent 50%),
      linear-gradient(175deg, #0a0a0c 0%, var(--color-ink) 45%, #12121a 100%);
    pointer-events: none;
  }

  .prism-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .prism-hero__grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black, transparent);
    pointer-events: none;
  }

  .prism-hero__watermark {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 0;
    transform: translate(-50%, -50%);
    font-size: clamp(8rem, 4rem + 18vw, 22rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(77, 168, 255, 0.07);
    user-select: none;
    pointer-events: none;
  }

  .prism-hero__headline {
    perspective: 900px;
  }

  .prism-hero__headline :global(.motion-char) {
    display: inline-block;
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .prism-hero__accent {
    background: linear-gradient(120deg, var(--color-glow) 0%, var(--color-glow-cyan) 55%, var(--color-paper) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 0 40px rgba(77, 168, 255, 0.25));
  }

  .prism-hero__stat {
    min-width: 5.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 1rem;
    border-radius: 1rem;
    backdrop-filter: blur(8px);
  }

  .prism-hero__stat--glow {
    border-color: rgba(77, 168, 255, 0.3);
    background: rgba(77, 168, 255, 0.07);
    box-shadow: 0 0 48px rgba(77, 168, 255, 0.1);
  }

  .prism-hero__cta-arrow {
    display: inline-block;
    animation: prism-bounce 2.2s ease-in-out infinite;
  }

  @keyframes prism-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  .prism-hero__collage-inner {
    position: relative;
    min-height: clamp(320px, 28vw, 480px);
  }

  .prism-hero__tile {
    position: absolute;
    text-decoration: none;
    width: min(46%, 220px);
  }

  .prism-hero__tile--a {
    left: 0;
    top: 0;
    z-index: 4;
    width: min(52%, 260px);
  }

  .prism-hero__tile--b {
    right: 0;
    top: 8%;
    z-index: 3;
    width: min(44%, 200px);
  }

  .prism-hero__tile--c {
    left: 18%;
    bottom: 0;
    z-index: 2;
    width: min(40%, 180px);
  }

  .prism-hero__tile--d {
    right: 12%;
    bottom: 6%;
    z-index: 1;
    width: min(36%, 160px);
  }

  .prism-hero__tile-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .prism-hero__tile:hover .prism-hero__tile-frame,
  .prism-hero__tile:focus-visible .prism-hero__tile-frame {
    transform: translateY(-8px) scale(1.03);
    border-color: rgba(77, 168, 255, 0.5);
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.45),
      0 0 50px rgba(77, 168, 255, 0.18);
  }

  .prism-hero__tile-photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .prism-hero__tile:hover .prism-hero__tile-photo {
    transform: scale(1.07);
  }

  .prism-hero__tile-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 50% 80%, rgba(77, 168, 255, 0.35), transparent 55%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .prism-hero__tile:hover .prism-hero__tile-glow {
    opacity: 1;
  }

  .prism-hero__tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(11, 11, 13, 0.92) 100%);
  }

  .prism-hero__tile-num {
    position: absolute;
    left: 0.75rem;
    top: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.2);
  }

  .prism-hero__tile-name {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.15;
    color: var(--color-paper);
  }

  .prism-hero__horizon {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(77, 168, 255, 0.45), transparent);
    box-shadow: 0 0 24px rgba(77, 168, 255, 0.35);
  }

  .prism-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .prism-hero.is-visible .prism-reveal-1 { transition-delay: 0ms; }
  .prism-hero.is-visible .prism-reveal-2 { transition-delay: 80ms; }
  .prism-hero.is-visible .prism-reveal-3 { transition-delay: 180ms; }
  .prism-hero.is-visible .prism-reveal-4 { transition-delay: 280ms; }
  .prism-hero.is-visible .prism-reveal-5 { transition-delay: 380ms; }
  .prism-hero.is-visible .prism-reveal-6 { transition-delay: 460ms; }

  .prism-hero.is-visible .prism-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .prism-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .prism-hero__blob {
      animation: none;
    }

    .prism-hero__cta-arrow {
      animation: none;
    }

    .prism-hero__tile:hover .prism-hero__tile-frame,
    .prism-hero__tile:hover .prism-hero__tile-photo {
      transform: none;
    }
  }
</style>
