---
import type { ArtistCard } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import SocialIcon from '../ui/SocialIcon.astro';

interface Props {
  artists: ArtistCard[];
  /** Mark the first row as eager so it is not lazy-loaded above the fold. */
  eager?: boolean;
  class?: string;
}

const { artists, eager = false, class: className } = Astro.props;

type IconLabel = 'Spotify' | 'YouTube' | 'Apple Music';

const roster = artists
  .filter((artist) => artist.photo?.asset)
  .map((artist) => {
    const links: { label: IconLabel; href: string }[] = [];
    if (artist.streaming?.spotify) links.push({ label: 'Spotify', href: artist.streaming.spotify });
    if (artist.streaming?.youtube) links.push({ label: 'YouTube', href: artist.streaming.youtube });
    if (artist.streaming?.appleMusic) links.push({ label: 'Apple Music', href: artist.streaming.appleMusic });
    return {
      ...artist,
      links,
      photoUrl: urlForImage(artist.photo).width(720).height(960).fit('crop').auto('format').url(),
    };
  });
---

<ul class:list={['artist-grid', className]}>
  {
    roster.map((artist, index) => (
      <li class="artist-card scroll-reveal" style={`--reveal-delay: ${Math.min(index, 3) * 70}ms`}>
        <img
          src={artist.photoUrl}
          alt=""
          width="720"
          height="960"
          loading={eager && index < 4 ? 'eager' : 'lazy'}
          decoding="async"
          class="artist-card__img"
        />
        <span class="artist-card__tint" aria-hidden="true" />
        <a href={`/artists/${artist.slug}`} class="artist-card__link">
          <span class="artist-card__name">{artist.name}</span>
        </a>
        {artist.links.length > 0 && (
          <ul class="artist-card__icons" aria-label={`${artist.name} streaming links`}>
            {artist.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${artist.name} on ${link.label}`}
                  class="artist-card__icon"
                >
                  <SocialIcon label={link.label} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<style>
  .artist-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  @media (min-width: 1024px) {
    .artist-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .artist-card {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--color-surface);
  }

  .artist-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s ease;
  }

  .artist-card:hover .artist-card__img,
  .artist-card:focus-within .artist-card__img {
    transform: scale(1.03);
  }

  /* Flat tint keeps the white name readable on light photos. */
  .artist-card__tint {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.28);
    pointer-events: none;
  }

  .artist-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding: clamp(0.875rem, 2vw, 1.25rem);
    color: #ffffff;
    text-decoration: none;
  }

  .artist-card__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -4px;
  }

  .artist-card__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .artist-card__icons {
    position: absolute;
    top: clamp(0.625rem, 1.5vw, 1rem);
    left: clamp(0.625rem, 1.5vw, 1rem);
    z-index: 2;
    display: flex;
    gap: 0.375rem;
  }

  .artist-card__icon {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(10, 10, 10, 0.5);
    color: #ffffff;
    transition: background 0.2s ease;
  }

  .artist-card__icon:hover,
  .artist-card__icon:focus-visible {
    background: var(--color-accent);
  }

  .artist-card__icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .artist-card__img,
    .artist-card__icon {
      transition: none;
    }
  }
</style>
