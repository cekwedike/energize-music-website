---
import type { TeamMember } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(640).height(720).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part.charAt(0).toUpperCase())
  .join('');

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="team-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition duration-500 hover:border-accent/30">
  <div class="team-card__accent" aria-hidden="true"></div>

  <div class="relative aspect-[4/5] shrink-0 overflow-hidden bg-bg">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={member.photo?.alt ?? member.name}
          loading="lazy"
          class="team-card-photo h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.04]"
        />
      ) : (
        <div class="team-card__placeholder flex h-full w-full flex-col items-center justify-center bg-surface">
          <span class="font-display text-5xl font-medium tracking-tight text-ink sm:text-6xl" aria-hidden="true">
            {initials}
          </span>
          <span class="mt-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-ink">Add photo in Studio</span>
        </div>
      )
    }

    <div class="absolute inset-x-0 bottom-0 bg-bg p-5">
      <p class="font-display text-lg text-ink sm:text-xl">{member.name}</p>
      <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-accent">{member.role}</p>
    </div>
  </div>

  <div class="relative flex flex-1 flex-col p-4 pt-3 sm:p-5 sm:pt-4">
    <p class="team-card__bio flex-1 text-sm leading-relaxed text-ink transition duration-300 group-hover:text-ink">
      {member.bio}
    </p>
    {
      socialLinks.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-full border border-line px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-ink transition hover:border-accent/40 hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .team-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .team-card:hover .team-card__accent {
    opacity: 1;
  }

  .team-card-photo {
    will-change: transform;
  }

  .team-card__bio {
    min-height: 4.5rem;
  }
</style>
