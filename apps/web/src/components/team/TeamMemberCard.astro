---
import type { TeamMember } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(640).height(720).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.charAt(0).toUpperCase())
  .join('');

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="team-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] transition duration-500 hover:border-[var(--color-glow)]/30 hover:shadow-[0_8px_40px_rgba(77,168,255,0.08)]">
  <div class="team-card__accent" aria-hidden="true"></div>

  <div class="relative aspect-[4/5] shrink-0 overflow-hidden bg-[var(--color-ink)]">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={member.photo?.alt ?? member.name}
          loading="lazy"
          class="team-card-photo h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.04]"
        />
      ) : (
        <div class="team-card__placeholder flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-[var(--color-glow)]/12 via-[var(--color-ink-raised)] to-[var(--color-ink)]">
          <span class="font-display text-5xl font-medium tracking-tight text-paper sm:text-6xl" aria-hidden="true">
            {initials}
          </span>
          <span class="mt-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-paper">Add photo in Studio</span>
        </div>
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-ink)]/20 to-transparent opacity-80 transition duration-500 group-hover:opacity-90"></div>

    <div class="absolute inset-x-0 bottom-0 p-5">
      <p class="font-display text-lg text-paper sm:text-xl">{member.name}</p>
      <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-glow)]">{member.role}</p>
    </div>
  </div>

  <div class="relative flex flex-1 flex-col p-4 pt-3 sm:p-5 sm:pt-4">
    <p class="team-card__bio flex-1 text-sm leading-relaxed text-paper transition duration-300 group-hover:text-paper">
      {member.bio}
    </p>
    {
      socialLinks.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-full border border-white/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-paper transition hover:border-[var(--color-glow)]/40 hover:text-[var(--color-glow)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .team-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-glow), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .team-card:hover .team-card__accent {
    opacity: 1;
  }

  .team-card-photo {
    will-change: transform;
  }

  .team-card__bio {
    min-height: 4.5rem;
  }
</style>
