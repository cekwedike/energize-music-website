---
import type { TeamMember } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(480).height(600).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part.charAt(0).toUpperCase())
  .join('');
---

<article class="team-card">
  <div class="team-card__media">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={member.photo?.alt ?? member.name}
          width="480"
          height="600"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="team-card__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>
  <p class="team-card__role">{member.role}</p>
  <h3 class="team-card__name">{member.name}</h3>
</article>

<style>
  .team-card__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--color-surface);
  }

  .team-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .team-card__initials {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--color-faint);
  }

  .team-card__role {
    margin: 0.875rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .team-card__name {
    margin: 0.375rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
