---
import type { TeamMember } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import { firstSentence } from '../../lib/team/firstSentence';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(640).height(720).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part.charAt(0).toUpperCase())
  .join('');

// First sentence of the bio only, so the About page stays short.
const bioSentence = firstSentence(member.bio);

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="team-card">
  <div class="media-frame aspect-[4/5]">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={member.photo?.alt ?? member.name}
          width="640"
          height="720"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[var(--color-accent-soft)]">
          <span class="font-display text-5xl font-medium tracking-tight text-fg" aria-hidden="true">
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <p class="mt-4 font-display text-xl text-fg">{member.name}</p>
  <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{member.role}</p>
  {bioSentence && <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">{bioSentence}</p>}
  {
    socialLinks.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-3">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold uppercase tracking-wider text-fg underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
