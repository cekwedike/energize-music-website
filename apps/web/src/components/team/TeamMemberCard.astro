---
import type { TeamMember } from '@energize/shared';
import { imageAlt } from '../../lib/seo/site';
import { urlForImage } from '../../lib/sanity/client';
import { bioParagraphs, firstSentence } from '../../lib/team/firstSentence';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(640).height(720).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part.charAt(0).toUpperCase())
  .join('');

// The card shows the first sentence; the full bio from Sanity slides over it on hover, focus, or tap.
const bioSentence = firstSentence(member.bio);
const paragraphs = bioParagraphs(member.bio);
const hasMore = paragraphs.join(' ').length > (bioSentence?.length ?? 0) + 1;

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<article class:list={['team-card', hasMore && 'team-card--expandable']} {...(hasMore ? { tabindex: 0, 'data-team-card': '' } : {})}>
  <div class="media-frame aspect-[4/5]">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={imageAlt(member.photo?.alt, `${member.name}, ${member.role} at Energize Music`)}
          width="640"
          height="720"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[var(--color-accent-soft)]">
          <span class="font-display text-5xl font-medium tracking-tight text-fg" aria-hidden="true">
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <p class="mt-4 font-display text-xl text-fg">{member.name}</p>
  <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{member.role}</p>
  {
    bioSentence && (
      <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]" aria-hidden={hasMore ? 'true' : undefined}>
        {bioSentence}
      </p>
    )
  }
  {hasMore && <p class="team-card__hint" aria-hidden="true">Read Full Bio</p>}

  {
    hasMore && (
      <div class="team-card__full" data-lenis-prevent>
        <p class="font-display text-xl text-fg">{member.name}</p>
        <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{member.role}</p>
        <div class="team-card__bio">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    )
  }

  {
    socialLinks.length > 0 && (
      <ul class="team-card__social mt-3 flex flex-wrap gap-3">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold uppercase tracking-wider text-fg underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<script>
  // Touch screens have no hover: a tap opens the full bio, a tap elsewhere (or on it again) closes it.
  if (window.matchMedia('(hover: none)').matches) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-team-card]'));
    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('a')) return;
      const tapped = target?.closest<HTMLElement>('[data-team-card]');
      cards.forEach((card) => {
        card.classList.toggle('is-open', card === tapped && !card.classList.contains('is-open'));
      });
    });
  }
</script>

<style>
  .team-card--expandable {
    position: relative;
    cursor: pointer;
    outline: none;
  }

  .team-card--expandable:focus-visible {
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-accent);
    border-radius: var(--radius-card);
  }

  .team-card__hint {
    margin-top: 0.75rem;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
  }

  /* Full bio panel: covers the whole card and scrolls if the bio is long. */
  .team-card__full {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.3s ease;
  }

  @media (hover: hover) {
    .team-card--expandable:hover .team-card__full {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  .team-card--expandable:focus-within .team-card__full,
  .team-card--expandable.is-open .team-card__full {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .team-card__bio {
    margin-top: 1rem;
  }

  .team-card__bio p {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-fg);
  }

  .team-card__bio p + p {
    margin-top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card__full {
      transition: none;
      transform: none;
    }
  }
</style>
