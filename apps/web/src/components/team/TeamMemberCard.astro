---
import type { TeamMember } from '@energize/shared';
import { imageAlt } from '../../lib/seo/site';
import { urlForImage } from '../../lib/sanity/client';
import { bioParagraphs, firstSentence } from '../../lib/team/firstSentence';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(640).height(720).fit('crop').auto('format').url()
  : null;

const initials = member.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part.charAt(0).toUpperCase())
  .join('');

// The card shows the first sentence; "Read Full Bio" opens the full bio from Sanity over the card.
const bioSentence = firstSentence(member.bio);
const paragraphs = bioParagraphs(member.bio);
const hasMore = paragraphs.join(' ').length > (bioSentence?.length ?? 0) + 1;

const panelId = `team-bio-${member._id}`;

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<article class:list={['team-card', hasMore && 'team-card--expandable']} {...(hasMore ? { 'data-team-card': '' } : {})}>
  <div class="media-frame aspect-[4/5]">
    {
      photoUrl ? (
        <img
          src={photoUrl}
          alt={imageAlt(member.photo?.alt, `${member.name}, ${member.role} at Energize Music`)}
          width="640"
          height="720"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[var(--color-accent-soft)]">
          <span class="font-display text-5xl font-medium tracking-tight text-fg" aria-hidden="true">
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <p class="mt-4 font-display text-xl text-fg">{member.name}</p>
  <p class="team-card__role mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{member.role}</p>
  {
    bioSentence && (
      <p class="team-card__excerpt mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
        {bioSentence}
      </p>
    )
  }
  {
    hasMore && (
      <button type="button" class="team-card__hint" data-team-open aria-expanded="false" aria-controls={panelId}>
        Read Full Bio
      </button>
    )
  }

  {
    hasMore && (
      <div class="team-card__full" id={panelId} role="region" aria-label={`${member.name} full bio`} data-lenis-prevent>
        <button type="button" class="team-card__close" data-team-close aria-label="Close bio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </button>
        <p class="team-card__full-name font-display text-xl text-fg">{member.name}</p>
        <p class="mt-1 text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">{member.role}</p>
        <div class="team-card__bio">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    )
  }

  {
    socialLinks.length > 0 && (
      <ul class="team-card__social mt-3 flex flex-wrap gap-3">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold uppercase tracking-wider text-fg underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<script>
  // "Read Full Bio" opens the panel; the close button, Escape, or a click outside closes it. One open at a time.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-team-card]'));

  const setOpen = (card: HTMLElement, open: boolean, returnFocus = false) => {
    card.classList.toggle('is-open', open);
    const trigger = card.querySelector<HTMLButtonElement>('[data-team-open]');
    trigger?.setAttribute('aria-expanded', String(open));
    // Wait a frame so the panel is visible (and focusable) before moving focus into it.
    if (open) requestAnimationFrame(() => card.querySelector<HTMLButtonElement>('[data-team-close]')?.focus());
    else if (returnFocus) trigger?.focus();
  };

  const closeAll = (except?: HTMLElement) =>
    cards.forEach((card) => card !== except && card.classList.contains('is-open') && setOpen(card, false));

  cards.forEach((card) => {
    card.querySelector('[data-team-open]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      closeAll(card);
      setOpen(card, true);
    });
    card.querySelector('[data-team-close]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(card, false, true);
    });
  });

  document.addEventListener('click', (event) => {
    const inside = (event.target as Element | null)?.closest('[data-team-card].is-open');
    if (!inside) closeAll();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = cards.find((card) => card.classList.contains('is-open'));
    if (open) setOpen(open, false, true);
  });
</script>

<style>
  /* Every card in a row is the same height: the excerpt gets a fixed four-line slot and
     "Read Full Bio" sits at the bottom, so the links line up across the row. */
  .team-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Roles get a two-line slot so excerpts start at the same height even when a role wraps. */
  .team-card__role {
    line-height: 1.5;
    min-height: 3em;
  }

  .team-card__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    min-height: calc(4 * 1.625em);
  }

  .team-card--expandable {
    position: relative;
  }

  .team-card__hint {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.4em;
  }

  .team-card__hint:hover,
  .team-card__hint:focus-visible {
    color: var(--color-accent);
  }

  .team-card__hint:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Full bio panel: covers the whole card and scrolls if the bio is long. */
  .team-card__full {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.3s ease;
  }

  .team-card--expandable.is-open .team-card__full {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* Visible at once when opening, so focus can move into the panel straight away. */
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  .team-card__full-name {
    padding-right: 2.75rem;
  }

  .team-card__close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-fg);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .team-card__close:hover,
  .team-card__close:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .team-card__close svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .team-card__bio {
    margin-top: 1rem;
  }

  .team-card__bio p {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-fg);
  }

  .team-card__bio p + p {
    margin-top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card__full {
      transition: none;
      transform: none;
    }
  }
</style>
