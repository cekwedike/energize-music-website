---
/** Mobile team list row: the name opens a panel with photo, role, and the full bio. Native <details>, no JS needed. */
import type { TeamMember } from '@energize/shared';
import { imageAlt } from '../../lib/seo/site';
import { urlForImage } from '../../lib/sanity/client';
import { bioParagraphs } from '../../lib/team/firstSentence';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const photoUrl = member.photo?.asset
  ? urlForImage(member.photo).width(480).height(600).fit('crop').auto('format').url()
  : null;
const paragraphs = bioParagraphs(member.bio);

const socialLinks = [
  member.social?.linkedin && { label: 'LinkedIn', href: member.social.linkedin },
  member.social?.instagram && { label: 'Instagram', href: member.social.instagram },
  member.social?.twitter && { label: 'X', href: member.social.twitter },
].filter(Boolean) as { label: string; href: string }[];
---

<details class="team-row" name="team">
  <summary class="team-row__summary">
    <span class="team-row__text">
      <span class="team-row__name">{member.name}</span>
      <span class="team-row__role">{member.role}</span>
    </span>
    <span class="team-row__icon" aria-hidden="true"></span>
  </summary>

  <div class="team-row__panel">
    {
      photoUrl && (
        <img
          src={photoUrl}
          alt={imageAlt(member.photo?.alt, `${member.name}, ${member.role} at Energize Music`)}
          width="480"
          height="600"
          loading="lazy"
          decoding="async"
          class="team-row__photo"
        />
      )
    }
    <div class="team-row__bio">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      socialLinks.length > 0 && (
        <ul class="team-row__social">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</details>

<style>
  .team-row {
    border-bottom: 1px solid var(--color-line);
  }

  .team-row__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
  }

  .team-row__summary::-webkit-details-marker {
    display: none;
  }

  .team-row__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .team-row__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .team-row__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--color-fg);
  }

  .team-row__role {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Plus that turns into a minus when open. */
  .team-row__icon {
    position: relative;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }

  .team-row__icon::before,
  .team-row__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 1.5px;
    background: var(--color-fg);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }

  .team-row__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .team-row[open] .team-row__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .team-row[open] .team-row__icon {
    border-color: var(--color-accent);
  }

  .team-row__panel {
    padding-bottom: 1.5rem;
    animation: team-row-in 0.3s ease;
  }

  @keyframes team-row-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .team-row__photo {
    width: min(100%, 15rem);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .team-row__bio {
    margin-top: 1.1rem;
  }

  .team-row__bio p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-fg);
  }

  .team-row__bio p + p {
    margin-top: 0.85rem;
  }

  .team-row__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .team-row__social a {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (prefers-reduced-motion: reduce) {
    .team-row__panel {
      animation: none;
    }

    .team-row__icon::before,
    .team-row__icon::after {
      transition: none;
    }
  }
</style>
