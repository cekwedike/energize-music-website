<style>
  .js-logo {
    filter: drop-shadow(0 0 22px rgba(0, 0, 0, 0.35));
  }

  .logo-el {
    fill: #fdfdfd;
  }

  .js-logo-animated .logo-el {
    opacity: 0;
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .js-logo-animated .logo-bar[data-side='left'] {
    transform: translateX(-26px);
  }

  .js-logo-animated .logo-bar[data-side='right'] {
    transform: translateX(26px);
  }

  .js-logo-animated .logo-letter,
  .js-logo-animated .logo-tagline-letter {
    transform: translateY(16px);
  }

  .js-logo-animated.is-visible .logo-el {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .js-logo-animated .logo-el {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const wrappers = document.querySelectorAll('.js-logo-animated');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  wrappers.forEach((wrapper) => {
    if (prefersReducedMotion) {
      wrapper.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          wrapper.classList.add('is-visible');
        });
      });
    }
  });
</script>
