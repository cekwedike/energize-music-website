---
import { secondaryNav } from '../../lib/nav';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 py-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 text-sm text-paper/70 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} Energize Music. Distributed via Orchard.</p>
    <nav aria-label="Secondary">
      <ul class="flex gap-4">
        {
          secondaryNav.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[var(--color-gold)]">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
