---
import { primaryNav, secondaryNav, socialLinks } from '../../lib/nav';
import SocialIcon from './SocialIcon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[var(--color-ink-raised)]">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-14 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" aria-label="Energize Music" class="inline-block">
          <Logo size="sm" animated={false} />
        </a>
        <p class="font-inter mt-3 text-[10px] font-semibold uppercase tracking-[0.3em] text-paper/40">
          The Energy Different
        </p>
        <form class="mt-6 flex max-w-sm gap-2">
          <label for="footer-email" class="sr-only">Email address</label>
          <input
            id="footer-email"
            type="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-white/20 bg-transparent px-4 py-2.5 text-sm text-paper placeholder:text-paper/40 focus-visible:border-white/40"
          />
          <button
            type="submit"
            class="button-glow shrink-0 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-[var(--color-ink)] transition hover:bg-white/90"
          >
            Join
          </button>
        </form>
        <p class="mt-2 max-w-sm text-xs text-paper/40">
          Newsletter provider wires up in Phase 4.
        </p>

        <ul class="mt-8 flex gap-3">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-paper/70 transition hover:border-white/40 hover:text-paper [&_svg]:h-4 [&_svg]:w-4"
                >
                  <SocialIcon label={social.label as 'Instagram' | 'YouTube' | 'Spotify' | 'TikTok'} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Explore">
        <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Explore</p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            primaryNav.map((link) => (
              <li>
                <a href={link.href} class="text-paper/75 transition hover:text-paper">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Company</p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            secondaryNav.map((link) => (
              <li>
                <a href={link.href} class="text-paper/75 transition hover:text-paper">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Energize Music. All rights reserved.</p>
      <p>Distributed globally via The Orchard (Sony Music).</p>
    </div>
  </div>
</footer>
