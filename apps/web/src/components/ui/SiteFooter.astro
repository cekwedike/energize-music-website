---
import { primaryNav, secondaryNav, socialLinks } from '../../lib/nav';
import SocialIcon from './SocialIcon.astro';
import Logo from './Logo.astro';
import FooterMarquee from './FooterMarquee.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__mesh" aria-hidden="true"></div>
  <div class="site-footer__grain" aria-hidden="true"></div>
  <div class="site-footer__glow site-footer__glow--left" aria-hidden="true"></div>
  <div class="site-footer__glow site-footer__glow--right" aria-hidden="true"></div>

  <FooterMarquee />

  <div class="site-footer__inner mx-auto max-w-7xl px-4 pb-5 pt-6 sm:px-6 sm:pb-8 sm:pt-8 lg:px-8 lg:pb-10 lg:pt-10">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label="Energize Music" class="site-footer__logo inline-block">
          <Logo size="sm" animated={false} />
        </a>

        <p class="site-footer__tagline font-instrument mt-3 text-[clamp(1rem,0.92rem+0.35vw,1.375rem)] italic leading-snug text-paper/55">
          The Energy Different
        </p>

        <div class="site-footer__newsletter mt-5 max-w-md">
          <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-[var(--color-glow)]">
            Newsletter
          </p>
          <form class="site-footer__form mt-2.5" aria-label="Newsletter signup">
            <label for="footer-email" class="sr-only">Email address</label>
            <div class="site-footer__input-wrap">
              <input
                id="footer-email"
                type="email"
                required
                placeholder="you@example.com"
                autocomplete="email"
                class="site-footer__input"
              />
              <button type="submit" class="site-footer__submit">
                Join
              </button>
            </div>
          </form>
          <p class="mt-2 text-[11px] leading-snug text-paper/35">
            Newsletter provider wires up in Phase 4.
          </p>
        </div>

        <ul class="site-footer__social mt-5 flex flex-wrap gap-2" aria-label="Social media">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="site-footer__social-link"
                >
                  <SocialIcon label={social.label as 'Instagram' | 'YouTube' | 'Spotify' | 'TikTok'} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__nav-panel">
        <div class="site-footer__nav-grid">
          <nav aria-label="Explore" class="site-footer__nav-col">
            <p class="site-footer__nav-label">Explore</p>
            <ul class="site-footer__nav-list">
              {
                primaryNav.map((link) => (
                  <li>
                    <a href={link.href} class="site-footer__nav-link">
                      <span class="site-footer__nav-link-text">{link.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <nav aria-label="Company" class="site-footer__nav-col">
            <p class="site-footer__nav-label">Company</p>
            <ul class="site-footer__nav-list">
              {
                secondaryNav.map((link) => (
                  <li>
                    <a href={link.href} class="site-footer__nav-link">
                      <span class="site-footer__nav-link-text">{link.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </div>

    <div class="site-footer__legal">
      <div class="site-footer__legal-line" aria-hidden="true"></div>
      <p class="site-footer__copyright">
        <span class="site-footer__copyright-primary">
          <span class="site-footer__copyright-symbol" aria-hidden="true">&copy;</span>
          <span class="site-footer__copyright-year">{year}</span>
          <span class="site-footer__copyright-brand">Energize Music</span>
        </span>
        <span class="site-footer__copyright-secondary">All rights reserved.</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-ink-raised);
  }

  .site-footer__mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 0% 100%, rgba(77, 168, 255, 0.1), transparent 55%),
      radial-gradient(ellipse 55% 45% at 100% 0%, rgba(37, 99, 235, 0.08), transparent 50%),
      radial-gradient(ellipse 40% 35% at 55% 45%, rgba(103, 232, 249, 0.04), transparent 45%);
  }

  .site-footer__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .site-footer__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .site-footer__glow--left {
    bottom: -12%;
    left: -10%;
    width: min(30vmax, 280px);
    height: min(30vmax, 280px);
    background: radial-gradient(circle, rgba(77, 168, 255, 0.1) 0%, transparent 68%);
  }

  .site-footer__glow--right {
    top: 4%;
    right: -8%;
    width: min(22vmax, 220px);
    height: min(22vmax, 220px);
    background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
  }

  .site-footer__grid {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .site-footer__brand,
  .site-footer__nav-panel {
    min-width: 0;
  }

  .site-footer__logo {
    transition: opacity 0.25s ease;
  }

  .site-footer__logo :global(.js-logo) {
    width: 96px;
  }

  @media (min-width: 480px) {
    .site-footer__logo :global(.js-logo) {
      width: 108px;
    }
  }

  @media (min-width: 768px) {
    .site-footer__logo :global(.js-logo) {
      width: 118px;
    }
  }

  .site-footer__logo:hover {
    opacity: 0.88;
  }

  .site-footer__tagline {
    max-width: min(16rem, 100%);
  }

  .site-footer__newsletter {
    width: 100%;
  }

  .site-footer__input-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .site-footer__input {
    min-height: 2.75rem;
    width: 100%;
    min-width: 0;
    flex: 1;
    border: none;
    background: transparent;
    padding-inline: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-paper);
  }

  .site-footer__input::placeholder {
    color: rgba(250, 250, 248, 0.38);
  }

  .site-footer__input:focus-visible {
    outline: none;
  }

  .site-footer__input-wrap:focus-within {
    border-color: rgba(77, 168, 255, 0.45);
    box-shadow: 0 0 0 1px rgba(77, 168, 255, 0.2), 0 0 32px rgba(77, 168, 255, 0.08);
  }

  .site-footer__submit {
    display: inline-flex;
    min-height: 2.75rem;
    min-width: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 9999px;
    padding-inline: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: white;
    background: var(--color-glow);
    cursor: pointer;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
    box-shadow: 0 0 24px rgba(77, 168, 255, 0.28);
  }

  .site-footer__submit:hover {
    background: color-mix(in srgb, var(--color-glow) 92%, white);
    box-shadow: 0 0 36px rgba(77, 168, 255, 0.4);
  }

  .site-footer__submit:active {
    transform: scale(0.98);
  }

  .site-footer__social-link {
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(250, 250, 248, 0.65);
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .site-footer__social-link :global(svg) {
    height: 1rem;
    width: 1rem;
  }

  .site-footer__social-link:hover {
    border-color: rgba(77, 168, 255, 0.45);
    color: var(--color-paper);
    background: rgba(77, 168, 255, 0.08);
    box-shadow: 0 0 20px rgba(77, 168, 255, 0.15);
    transform: translateY(-1px);
  }

  .site-footer__nav-panel {
    position: relative;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.015);
  }

  @media (min-width: 768px) {
    .site-footer__nav-panel {
      padding: 1.25rem 1.5rem;
      border-radius: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__nav-panel {
      padding: 1.5rem 1.75rem;
    }
  }

  .site-footer__nav-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      145deg,
      rgba(77, 168, 255, 0.35) 0%,
      rgba(255, 255, 255, 0.06) 35%,
      rgba(255, 255, 255, 0) 55%,
      rgba(37, 99, 235, 0.2) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .site-footer__nav-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 1.25rem;
  }

  @media (min-width: 768px) {
    .site-footer__nav-grid {
      gap: 1.25rem 2rem;
    }
  }

  .site-footer__nav-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(77, 168, 255, 0.75);
  }

  .site-footer__nav-list {
    margin-top: 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .site-footer__nav-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.25rem;
    text-decoration: none;
    color: rgba(250, 250, 248, 0.72);
    transition: color 0.2s ease;
  }

  @media (min-width: 768px) {
    .site-footer__nav-link {
      min-height: 0;
      padding-block: 0.3125rem;
    }
  }

  .site-footer__nav-link-text {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 768px) {
    .site-footer__nav-link-text {
      font-family: var(--font-display);
      font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem);
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: normal;
    }
  }

  .site-footer__nav-link-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-glow), var(--color-glow-cyan));
    transition: width 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-footer__nav-link:hover {
    color: var(--color-paper);
  }

  .site-footer__nav-link:hover .site-footer__nav-link-text {
    transform: translateX(4px);
  }

  .site-footer__nav-link:hover .site-footer__nav-link-text::after {
    width: 100%;
  }

  .site-footer__legal {
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .site-footer__legal {
      margin-top: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__legal {
      margin-top: 2.5rem;
    }
  }

  .site-footer__legal-line {
    height: 1px;
    margin-bottom: 1rem;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(77, 168, 255, 0.35) 18%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(37, 99, 235, 0.25) 82%,
      transparent 100%
    );
  }

  .site-footer__copyright {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }

  @media (min-width: 480px) {
    .site-footer__copyright {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 0.75rem;
    }
  }

  .site-footer__copyright-primary {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 0.82rem + 0.2vw, 0.9375rem);
    font-style: italic;
    line-height: 1.4;
    color: rgba(250, 250, 248, 0.58);
  }

  .site-footer__copyright-symbol {
    font-style: normal;
    color: rgba(250, 250, 248, 0.62);
  }

  .site-footer__copyright-year {
    font-style: normal;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: rgba(250, 250, 248, 0.62);
  }

  .site-footer__copyright-brand {
    font-weight: 500;
    color: rgba(250, 250, 248, 0.55);
  }

  .site-footer__copyright-secondary {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
    color: rgba(250, 250, 248, 0.32);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__nav-link-text,
    .site-footer__social-link,
    .site-footer__submit {
      transition: none;
    }

    .site-footer__nav-link:hover .site-footer__nav-link-text {
      transform: none;
    }

    .site-footer__social-link:hover {
      transform: none;
    }
  }
</style>
