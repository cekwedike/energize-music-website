---
import { primaryNav, secondaryNav, socialLinks } from '../../lib/nav';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
const exploreLinks = primaryNav.filter((link) => link.href !== '/');
---

<footer class="border-t border-white/10 bg-[var(--color-ink-raised)]">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="text-h3" style="font-family: var(--font-display)">Energize Music</p>
        <p class="mt-4 max-w-sm text-paper/60">
          Afro-gospel &amp; soul-fusion music, distributed globally in partnership with The
          Orchard.
        </p>
        <form class="mt-6 flex max-w-sm gap-2">
          <label for="footer-email" class="sr-only">Email address</label>
          <input
            id="footer-email"
            type="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-full border border-white/20 bg-transparent px-4 py-2.5 text-sm text-paper placeholder:text-paper/40 focus-visible:border-[var(--color-gold)]"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-[var(--color-gold)] px-5 py-2.5 text-sm font-semibold text-[var(--color-ink)] transition hover:opacity-90"
          >
            Join
          </button>
        </form>
        <p class="mt-2 max-w-sm text-xs text-paper/40">
          Newsletter provider wires up in Phase 4.
        </p>
      </div>

      <nav aria-label="Explore">
        <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Explore</p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            exploreLinks.map((link) => (
              <li>
                <a href={link.href} class="text-paper/75 transition hover:text-[var(--color-gold)]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Company">
        <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Company</p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            secondaryNav.map((link) => (
              <li>
                <a href={link.href} class="text-paper/75 transition hover:text-[var(--color-gold)]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Connect</p>
        <ul class="mt-4 flex gap-3">
          {
            socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-paper/70 transition hover:border-[var(--color-gold)] hover:text-[var(--color-gold)] [&_svg]:h-4 [&_svg]:w-4"
                >
                  <SocialIcon label={social.label as 'Instagram' | 'YouTube' | 'Spotify' | 'TikTok'} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-paper/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Energize Music. All rights reserved.</p>
      <p>Distributed globally via The Orchard (Sony Music).</p>
    </div>
  </div>
</footer>
