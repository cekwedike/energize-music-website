---
import '../../styles/site-header.css';
import { headerNav, hqLink } from '../../lib/nav';
import Logo from './Logo.astro';

export type HeaderVariant = 'default' | 'ambient' | 'overlay';

interface Props {
  variant?: HeaderVariant;
}

const { variant = 'default' } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}

const contactEntry = headerNav.find((entry) => entry.href === '/contact');
---

<header
  id="site-header"
  class:list={[
    'site-header sticky top-0 z-40',
    variant === 'ambient' && 'site-header--ambient',
    variant === 'overlay' && 'site-header--overlay',
  ]}
>
  <div class="site-header__bar mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:gap-6 sm:px-6 sm:py-4 lg:py-[1.125rem]">
    <a href="/" class="site-header__logo shrink-0 transition-opacity duration-300 hover:opacity-90" aria-label="Energize Music">
      <Logo size="sm" animated={!isHome} />
    </a>

    <div class="hidden items-center gap-2 lg:flex lg:gap-3">
      <div class="nav-outline-group">
        <nav aria-label="Primary">
          <ul class="flex items-center gap-0.5 lg:gap-1">
            {
              headerNav
                .filter((entry) => entry.href !== '/contact')
                .map((entry) => (
                  <li>
                    <a href={entry.href} aria-current={isActive(entry.href) ? 'page' : undefined} class="nav-link">
                      {entry.label}
                    </a>
                  </li>
                ))
            }
          </ul>
        </nav>
      </div>

      {
        contactEntry ? (
          <a
            href={contactEntry.href}
            aria-current={isActive(contactEntry.href) ? 'page' : undefined}
            class="nav-cta"
          >
            {contactEntry.label}
          </a>
        ) : null
      }

      <a href={hqLink.href} target="_blank" rel="noopener noreferrer" class="nav-hq-link">
        {hqLink.label}
      </a>
    </div>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="nav-toggle lg:hidden"
    >
      <span class="nav-toggle__shell">
        <span class="nav-toggle__label" data-label-closed="Menu" data-label-open="Close">Menu</span>
        <span class="nav-toggle__icon" aria-hidden="true">
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </span>
      </span>
      <span class="sr-only">Toggle menu</span>
    </button>
  </div>

  <div id="mobile-nav-backdrop" class="mobile-nav-backdrop lg:hidden" aria-hidden="true"></div>

  <nav id="mobile-nav" aria-label="Primary mobile" class="mobile-nav lg:hidden" inert data-lenis-prevent>
    <ul class="mobile-nav__list">
      {
        headerNav.map((entry) => (
          <li>
            <a href={entry.href} aria-current={isActive(entry.href) ? 'page' : undefined} class="mobile-nav__link">
              {entry.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={hqLink.href} target="_blank" rel="noopener noreferrer" class="mobile-nav__hq-link">
          {hqLink.label}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { setScrollLocked } from '../../lib/smoothScroll';

  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const backdrop = document.getElementById('mobile-nav-backdrop');
  const toggleLabel = toggle?.querySelector<HTMLElement>('.nav-toggle__label');

  let releaseFocusTrap: (() => void) | null = null;
  let headerHeightFrame = 0;

  function syncHeaderHeight() {
    if (!header) return;
    cancelAnimationFrame(headerHeightFrame);
    headerHeightFrame = requestAnimationFrame(() => {
      if (!header) return;
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    });
  }

  function syncToggleLabel(isOpen: boolean) {
    if (!toggleLabel) return;
    const closed = toggleLabel.dataset.labelClosed ?? 'Menu';
    const open = toggleLabel.dataset.labelOpen ?? 'Close';
    toggleLabel.textContent = isOpen ? open : closed;
  }

  function trapFocus(container: HTMLElement) {
    const focusable = container.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])',
    );
    const items = [...focusable].filter((el) => el.offsetParent !== null || container.contains(el));
    if (items.length === 0) return () => {};

    const first = items[0];
    const last = items[items.length - 1];

    function onKeyDown(event: KeyboardEvent) {
      if (event.key !== 'Tab') return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }

    container.addEventListener('keydown', onKeyDown);
    first?.focus();

    return () => container.removeEventListener('keydown', onKeyDown);
  }

  function setMobileMenuOpen(isOpen: boolean) {
    panel?.classList.toggle('is-open', isOpen);
    backdrop?.classList.toggle('is-visible', isOpen);
    header?.classList.toggle('is-menu-open', isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
    panel?.toggleAttribute('inert', !isOpen);
    syncToggleLabel(isOpen);
    // Lock on <html>, not <body>: <html> has overflow-x: clip, so overflow on <body> would make <body> the
    // scroll container, reset the scroll position to the top, and unstick the header.
    document.documentElement.style.overflow = isOpen ? 'hidden' : '';
    setScrollLocked(isOpen);
    syncHeaderHeight();

    if (isOpen) {
      releaseFocusTrap?.();
      releaseFocusTrap = panel ? trapFocus(panel) : null;
    } else {
      releaseFocusTrap?.();
      releaseFocusTrap = null;
      toggle?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') !== 'true';
    setMobileMenuOpen(isOpen);
  });

  backdrop?.addEventListener('click', () => setMobileMenuOpen(false));

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') {
      setMobileMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMobileMenuOpen(false);
    }
  });

  // Scrolled state without a scroll listener: watch a 1px marker 12px down the page.
  const scrollSentinel = document.createElement('div');
  scrollSentinel.setAttribute('aria-hidden', 'true');
  scrollSentinel.style.cssText = 'position:absolute;top:12px;left:0;width:1px;height:1px;pointer-events:none;';
  document.body.prepend(scrollSentinel);
  new IntersectionObserver(([entry]) => {
    header?.classList.toggle('is-scrolled', !entry.isIntersecting);
  }).observe(scrollSentinel);
  window.addEventListener('resize', syncHeaderHeight);
  syncHeaderHeight();
  syncToggleLabel(false);
</script>
