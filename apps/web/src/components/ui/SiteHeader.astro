---
import { primaryNav } from '../../lib/nav';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[var(--color-ink)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-[family-name:var(--font-display)] text-xl tracking-tight">
      Energize Music
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="text-paper/80 hover:text-[var(--color-gold)] aria-[current=page]:text-[var(--color-gold)]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
