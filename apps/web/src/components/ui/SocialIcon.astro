---
interface Props {
  label: 'Instagram' | 'YouTube' | 'Spotify' | 'TikTok';
}

const { label } = Astro.props;
---

{
  label === 'Instagram' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  label === 'YouTube' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10.5 9.5l5 2.5-5 2.5v-5z" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  label === 'Spotify' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="9.5" />
      <path d="M7 9.8c3.2-1 6.9-.7 10 1M7.5 13c2.6-.8 5.6-.5 8 .8M8 16c2-.6 4.4-.4 6.2.6" stroke-linecap="round" />
    </svg>
  )
}
{
  label === 'TikTok' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M14 3v10.5a3.5 3.5 0 1 1-3-3.46" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M14 3c.3 2.2 2 4 4.5 4.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
