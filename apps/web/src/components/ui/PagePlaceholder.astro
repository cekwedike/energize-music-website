---
interface Props {
  heading: string;
  note?: string;
  image?: string;
  imageAlt?: string;
}

const {
  heading,
  note = 'CMS content wires up in Phase 2.',
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <div class="grid gap-10 sm:grid-cols-[1.2fr_1fr] sm:items-center">
    <div>
      <h1 class="text-h1">{heading}</h1>
      <p class="text-lead mt-5 max-w-xl text-paper/70">{note}</p>
    </div>
    {
      image && (
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          class="aspect-[4/3] w-full rounded-lg object-cover"
        />
      )
    }
  </div>
</section>
