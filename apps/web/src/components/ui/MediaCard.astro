---
interface Props {
  title: string;
  href?: string;
  image?: string | null;
  imageAlt?: string;
  /** Mono line above the title, e.g. "2025 · EP". */
  meta?: string;
  subtitle?: string;
  /** Rendered image size hint in px, used for width and height attributes. */
  size?: number;
  class?: string;
}

const { title, href, image, imageAlt = '', meta, subtitle, size = 480, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['media-card group', className]}>
  <div class="media-card__media">
    {
      image ? (
        <img src={image} alt={imageAlt} width={size} height={size} loading="lazy" decoding="async" class="media-card__img" />
      ) : (
        <span class="media-card__fallback" aria-hidden="true">{title.charAt(0)}</span>
      )
    }
  </div>
  {meta && <p class="media-card__meta">{meta}</p>}
  <h3 class="media-card__title">{title}</h3>
  {subtitle && <p class="media-card__subtitle">{subtitle}</p>}
</Tag>

<style>
  .media-card {
    display: block;
    min-width: 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .media-card__media {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--color-surface);
  }

  .media-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  a.media-card:hover .media-card__img,
  a.media-card:focus-visible .media-card__img {
    transform: scale(1.03);
  }

  .media-card__fallback {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--color-faint);
  }

  .media-card__meta {
    margin: 0.875rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .media-card__title {
    margin: 0.375rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: none;
    color: var(--color-ink);
  }

  .media-card__subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .media-card__img {
      transition: none;
    }
  }
</style>
