---
// Two identical runs so the track can loop seamlessly at -50%.
const runs = [0, 1];
const words = Array.from({ length: 4 }, () => 'Energize');
---

<div class="footer-marquee" aria-hidden="true">
  <div class="footer-marquee__track">
    {
      runs.map(() => (
        <div class="footer-marquee__run">
          {words.map((word) => (
            <span class="footer-marquee__word">{word}</span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .footer-marquee {
    overflow: hidden;
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }

  .footer-marquee__track {
    display: flex;
    width: max-content;
    animation: footer-marquee 40s linear infinite;
  }

  .footer-marquee__run {
    display: flex;
    flex-shrink: 0;
  }

  .footer-marquee__word {
    padding-right: 0.25em;
    font-family: var(--font-display);
    font-size: clamp(5rem, 2rem + 16vw, 16rem);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  @keyframes footer-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-marquee__track {
      animation: none;
    }
  }
</style>
