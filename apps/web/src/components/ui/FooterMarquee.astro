---
interface Props {
  placement?: 'footer' | 'top';
}

const { placement = 'footer' } = Astro.props;

const phrase = 'The Energy Different';
const loopItems = Array.from({ length: 12 }, () => phrase);
---

<div class:list={['footer-marquee', placement === 'top' && 'footer-marquee--top']} aria-hidden="true">
  <div class="footer-marquee__fade footer-marquee__fade--left"></div>
  <div class="footer-marquee__fade footer-marquee__fade--right"></div>
  <div class="footer-marquee__track">
    {
      loopItems.map((item) => (
        <span class="footer-marquee__item">
          <span class="footer-marquee__word">{item}</span>
          <span class="footer-marquee__dot" aria-hidden="true"></span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .footer-marquee {
    position: relative;
    overflow: hidden;
    contain: paint;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: clamp(0.4375rem, 0.4rem + 0.2vw, 0.75rem);
  }

  .footer-marquee--top {
    position: relative;
    z-index: 30;
    background: rgba(11, 11, 13, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .footer-marquee--top .footer-marquee__fade--left {
    background: linear-gradient(90deg, var(--color-ink) 0%, transparent 100%);
  }

  .footer-marquee--top .footer-marquee__fade--right {
    background: linear-gradient(270deg, var(--color-ink) 0%, transparent 100%);
  }

  .footer-marquee__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(14vw, 5rem);
    z-index: 1;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .footer-marquee__fade {
      width: min(12vw, 7rem);
    }
  }

  .footer-marquee__fade--left {
    left: 0;
    background: linear-gradient(90deg, var(--color-ink-raised) 0%, transparent 100%);
  }

  .footer-marquee__fade--right {
    right: 0;
    background: linear-gradient(270deg, var(--color-ink-raised) 0%, transparent 100%);
  }

  .footer-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0;
    animation: footer-marquee-scroll 52s linear infinite;
  }

  .footer-marquee__item {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(0.875rem, 0.7rem + 0.8vw, 2rem);
    padding-inline: clamp(0.875rem, 0.7rem + 0.8vw, 2rem);
  }

  .footer-marquee__word {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(0.8125rem, 0.78rem + 0.3vw, 1.125rem);
    font-style: italic;
    letter-spacing: 0.04em;
    color: rgba(250, 250, 248, 0.22);
    white-space: nowrap;
  }

  .footer-marquee__dot {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-glow);
    opacity: 0.45;
    box-shadow: 0 0 12px rgba(77, 168, 255, 0.5);
  }

  @keyframes footer-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-marquee__track {
      animation-duration: 140s;
    }
  }
</style>
