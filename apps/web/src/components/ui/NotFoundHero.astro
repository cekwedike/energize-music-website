---
const navLinks = [
  { label: 'Home', href: '/', description: 'Back to the main stage' },
  { label: 'Artistes', href: '/artists', description: 'Meet the roster' },
  { label: 'Contact', href: '/contact', description: 'Reach the team' },
];

---

<section class="not-found" aria-labelledby="not-found-heading">
  <div class="not-found__inner">
    <h1 id="not-found-heading" class="not-found__title scroll-reveal" style="--reveal-delay: 120ms">
      This Page <em>Isn't</em> on the Roster
    </h1>

    <p class="not-found__lead scroll-reveal" style="--reveal-delay: 180ms">
      The link may be old, or the page may have moved. Pick a page below and we'll get you back in rhythm.
    </p>

    <nav class="not-found__nav scroll-reveal" style="--reveal-delay: 240ms" aria-label="Helpful links">
      {
        navLinks.map((link, index) => (
          <a href={link.href} class="not-found__link" style={`--link-index: ${index}`}>
            <span class="not-found__link-label">{link.label}</span>
            <span class="not-found__link-note">{link.description}</span>
          </a>
        ))
      }
    </nav>
  </div>

</section>

<style>
  .not-found {
    position: relative;
    min-height: clamp(28rem, 72vh, 40rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 42rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 1.5rem);
  }

  .not-found__title {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }

  .not-found__title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--color-fg);
  }

  .not-found__lead {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 34rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-fg);
  }

  .not-found__nav {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  @media (min-width: 640px) {
    .not-found__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .not-found__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-fg) 2%, transparent);
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .not-found__link:hover,
  .not-found__link:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent) 27%, transparent);
    background: color-mix(in srgb, var(--color-accent) 3.6%, transparent);
    transform: translateY(-2px);
  }

  .not-found__link-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .not-found__link-note {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__link:hover,
    .not-found__link:focus-visible {
      transform: none;
    }
  }
</style>
