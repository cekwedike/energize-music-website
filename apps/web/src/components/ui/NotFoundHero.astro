---
const navLinks = [
  { label: 'Home', href: '/', description: 'Back to the main stage' },
  { label: 'Artists', href: '/artists', description: 'Browse the roster' },
  { label: 'Contact', href: '/contact', description: 'Reach the team' },
];

const marqueePhrases = ['Wrong turn', 'Signal lost', 'Keep the energy', 'Find your way back'];
---

<section class="not-found" aria-labelledby="not-found-heading">
  <div class="not-found__backdrop" aria-hidden="true">
    <span class="not-found__ghost">404</span>
    <div class="not-found__glow not-found__glow--left"></div>
    <div class="not-found__glow not-found__glow--right"></div>
    <div class="not-found__grain"></div>
  </div>

  <div class="not-found__inner">
    <p class="not-found__eyebrow scroll-reveal">Off the map</p>
    <div class="not-found__rule scroll-reveal" style="--reveal-delay: 60ms" aria-hidden="true"></div>

    <h1 id="not-found-heading" class="not-found__title scroll-reveal" style="--reveal-delay: 120ms">
      This page <em>isn't</em> on the roster
    </h1>

    <p class="not-found__lead scroll-reveal" style="--reveal-delay: 180ms">
      The link may be outdated, or the page moved. Pick a destination below and we'll get you back in rhythm.
    </p>

    <nav class="not-found__nav scroll-reveal" style="--reveal-delay: 240ms" aria-label="Helpful links">
      {
        navLinks.map((link, index) => (
          <a href={link.href} class="not-found__link" style={`--link-index: ${index}`}>
            <span class="not-found__link-label">{link.label}</span>
            <span class="not-found__link-note">{link.description}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="not-found__marquee" aria-hidden="true">
    <div class="not-found__marquee-track">
      {
        Array.from({ length: 8 }, () => marqueePhrases).flat().map((phrase) => (
          <span class="not-found__marquee-item">
            <span>{phrase}</span>
            <span class="not-found__marquee-dot"></span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .not-found {
    position: relative;
    min-height: clamp(28rem, 72vh, 40rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .not-found__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .not-found__ghost {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -54%);
    font-family: 'Instrument Serif', serif;
    font-size: clamp(9rem, 28vw, 22rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: rgba(250, 250, 248, 0.035);
    user-select: none;
    white-space: nowrap;
  }

  .not-found__glow {
    position: absolute;
    width: min(42vw, 28rem);
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
  }

  .not-found__glow--left {
    top: 8%;
    left: -8%;
    background: rgba(77, 168, 255, 0.22);
  }

  .not-found__glow--right {
    right: -6%;
    bottom: 12%;
    background: rgba(37, 99, 235, 0.16);
  }

  .not-found__grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 42rem);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 1.5rem);
  }

  .not-found__eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-glow);
  }

  .not-found__rule {
    width: 3rem;
    height: 1px;
    margin-top: 1rem;
    background: linear-gradient(90deg, var(--color-glow), transparent);
  }

  .not-found__title {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--color-paper);
  }

  .not-found__title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: rgba(250, 250, 248, 0.92);
  }

  .not-found__lead {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 34rem;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: rgba(250, 250, 248, 0.68);
  }

  .not-found__nav {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  @media (min-width: 640px) {
    .not-found__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .not-found__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .not-found__link:hover,
  .not-found__link:focus-visible {
    border-color: rgba(77, 168, 255, 0.45);
    background: rgba(77, 168, 255, 0.06);
    transform: translateY(-2px);
  }

  .not-found__link-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-paper);
  }

  .not-found__link-note {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgba(250, 250, 248, 0.52);
  }

  .not-found__marquee {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-block: clamp(0.5rem, 1vw, 0.75rem);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .not-found__marquee-track {
    display: flex;
    width: max-content;
    animation: not-found-marquee 38s linear infinite;
  }

  .not-found__marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding-inline: 1.25rem;
    font-family: 'Instrument Serif', serif;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.125rem);
    font-style: italic;
    color: rgba(250, 250, 248, 0.38);
    white-space: nowrap;
  }

  .not-found__marquee-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-glow);
    opacity: 0.7;
    flex-shrink: 0;
  }

  @keyframes not-found-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__marquee-track {
      animation: none;
    }

    .not-found__link:hover,
    .not-found__link:focus-visible {
      transform: none;
    }
  }
</style>
