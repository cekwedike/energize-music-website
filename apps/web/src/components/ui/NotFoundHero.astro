---
import SectionTitle from './SectionTitle.astro';

const navLinks = [
  { label: 'Home', href: '/', description: 'Back to the main stage' },
  { label: 'Artists', href: '/artists', description: 'Browse the roster' },
  { label: 'Music', href: '/releases', description: 'Stream the catalog' },
  { label: 'Contact', href: '/contact', description: 'Reach the team' },
];
---

<section class="not-found mx-auto max-w-7xl px-5 pb-24 pt-14 sm:px-6 sm:pb-32 sm:pt-20 lg:px-8">
  <SectionTitle tag="h1" title="This page isn't on the roster" eyebrow="404 · Off the map" />
  <p class="not-found__lead">
    The link may be outdated, or the page moved. Pick a destination below and we'll get you back in rhythm.
  </p>

  <nav class="not-found__nav" aria-label="Helpful links">
    {
      navLinks.map((link) => (
        <a href={link.href} class="not-found__link">
          <span class="not-found__link-label">{link.label}</span>
          <span class="not-found__link-note">{link.description}</span>
        </a>
      ))
    }
  </nav>
</section>

<style>
  .not-found__lead {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--color-muted);
  }

  .not-found__nav {
    display: grid;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 768px) {
    .not-found__nav {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 0;
      gap: 1.5rem;
    }
  }

  .not-found__link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .not-found__link {
      border-top: 1px solid var(--color-line);
      border-bottom: 0;
    }
  }

  .not-found__link-label {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .not-found__link-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .not-found__link:hover .not-found__link-label,
  .not-found__link:focus-visible .not-found__link-label {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__link-label {
      transition: none;
    }
  }
</style>
