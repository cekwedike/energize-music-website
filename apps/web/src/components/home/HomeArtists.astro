---
import type { ArtistCard } from '@energize/shared';
import SectionTitle from '../ui/SectionTitle.astro';
import ArtistGrid from '../artists/ArtistGrid.astro';

interface Props {
  artists: ArtistCard[];
}

const { artists } = Astro.props;
const roster = artists.filter((artist) => artist.photo?.asset).slice(0, 8);
---

{
  roster.length > 0 && (
    <section class="home-artists" aria-labelledby="home-artists-title">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionTitle
          id="home-artists-title"
          title="Our Artists"
          link={{ label: 'All artists', href: '/artists' }}
          class="scroll-reveal"
        />
        <ArtistGrid artists={roster} class="mt-8 sm:mt-12" />
      </div>
    </section>
  )
}

<style>
  .home-artists {
    padding-block: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--color-line);
  }
</style>
