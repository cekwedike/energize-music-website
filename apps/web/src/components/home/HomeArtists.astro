---
import type { ArtistCard } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';
import SocialIcon from '../ui/SocialIcon.astro';
import { imageAlt } from '../../lib/seo/site';

interface Props {
  artists: ArtistCard[];
}

const { artists } = Astro.props;

const roster = artists
  .filter((artist: ArtistCard) => artist.photo?.asset)
  .slice(0, 8)
  .map((artist: ArtistCard) => ({
    ...artist,
    photoUrl: urlForImage(artist.photo).width(640).height(800).fit('crop').auto('format').url(),
    streams: (
      [
        { label: 'Spotify', href: artist.streaming?.spotify },
        { label: 'YouTube', href: artist.streaming?.youtube },
        { label: 'Apple Music', href: artist.streaming?.appleMusic },
      ] as const
    ).filter((link) => Boolean(link.href)),
  }));

---

{
  roster.length > 0 && (
    <section class="home-artists" data-home-artists aria-labelledby="home-artists-title">
      <div class="home-artists__head">
        <div data-home-reveal>
          <p class="home-kicker">The artistes</p>
          <h2 id="home-artists-title" class="home-title">
            {roster.map((artist, index) => (
              <>
                {artist.name}
                {index < roster.length - 1 && (index === roster.length - 2 ? <> and<br /></> : <>,<br /></>)}
              </>
            ))}
          </h2>
        </div>
        <a href="/artists" class="home-link" data-home-reveal data-home-reveal-delay="80">
          <span class="home-link__line" aria-hidden="true"></span>
          Meet the Artistes
        </a>
      </div>

      <div class="home-h-scroll home-artists__scroll">
        <div class="home-artists__stage home-h-scroll__stage" data-home-h-scroll>
          <div
            class="home-artists__track"
            data-home-artists-track
            style={`--artist-cols: ${Math.min(roster.length, 4)}`}
          >
            {roster.map((artist: (typeof roster)[number]) => (
              <article class="home-artists__card" data-home-artist>
                <a href={`/artists/${artist.slug}`} class="home-artists__link">
                <div class="home-artists__media media-frame" data-home-artist-media>
                  <img
                    src={artist.photoUrl}
                    alt={imageAlt(artist.photo?.alt, `${artist.name}, Energize Music artiste`)}
                    width="640"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="home-artists__meta">
                  <p class="home-artists__name">{artist.name}</p>
                  {artist.tagline && <p class="home-artists__tag">{artist.tagline}</p>}
                </div>
                </a>
                {artist.streams.length > 0 && (
                  <ul class="home-artists__streams" aria-label={`Listen to ${artist.name}`}>
                    {artist.streams.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="home-artists__stream"
                          aria-label={`${artist.name} on ${link.label}`}
                        >
                          <SocialIcon label={link.label} />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
        <div class="home-h-scroll__meter" aria-hidden="true">
          <div class="home-h-scroll__track">
            <div class="home-h-scroll__thumb" data-home-h-scroll-thumb></div>
          </div>
          <span class="home-h-scroll__label">Swipe</span>
        </div>
      </div>
    </section>
  )
}

<style>
  .home-artists__media {
    aspect-ratio: 4 / 5;
  }

  .home-artists__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-artists__link:hover .home-artists__media img {
    transform: scale(1.04);
  }

  .home-artists__meta {
    padding-top: 1rem;
  }

  .home-artists__name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-fg);
  }

  .home-artists__tag {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .home-artists__streams {
    display: flex;
    gap: 0.5rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .home-artists__stream {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-fg);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .home-artists__stream:hover,
  .home-artists__stream:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .home-artists__stream :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .home-artists {
    position: relative;
    padding: clamp(5rem, 4rem + 4vw, 8rem) 0 clamp(3rem, 2rem + 3vw, 5rem);
    background: var(--color-bg);
    /* visible so ScrollTrigger pin spacers are not clipped into a blank void */
    overflow: visible;
  }

  .home-artists__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 1.75rem;
  }

  @media (min-width: 640px) {
    .home-artists__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-inline: 1.5rem;
    }
  }

  .home-artists__stage {
    overflow: hidden;
  }

  .home-artists__track {
    display: flex;
    gap: 0.85rem;
    width: max-content;
    padding: 0.5rem 1.25rem 1rem;
    perspective: 1200px;
  }

  @media (min-width: 640px) {
    .home-artists__track {
      gap: 1rem;
      padding-inline: 1.5rem;
    }
  }

  .home-artists__card {
    position: relative;
    flex: 0 0 auto;
    width: min(72vw, 18rem);
    color: var(--color-fg);
    text-decoration: none;
    transform-style: preserve-3d;
  }

  /* Wide screens: an even grid that fills the content width (no horizontal runway). */
  @media (min-width: 900px) {
    .home-artists__track {
      display: grid;
      grid-template-columns: repeat(var(--artist-cols, 3), minmax(0, 1fr));
      gap: 1.25rem;
      width: min(100%, 80rem);
      margin-inline: auto;
    }

    .home-artists__card {
      width: auto;
    }
  }

  .home-artists__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 899px) {
    .home-artists__stage.home-h-scroll__stage {
      overflow-x: auto;
    }

    .home-artists__card {
      scroll-snap-align: start;
    }
  }
</style>
