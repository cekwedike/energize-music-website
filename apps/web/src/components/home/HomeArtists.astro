---
import type { ArtistCard } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  artists: ArtistCard[];
}

const { artists } = Astro.props;

const roster = artists
  .filter((artist) => artist.photo?.asset)
  .slice(0, 8)
  .map((artist) => ({
    ...artist,
    photoUrl: urlForImage(artist.photo).width(360).height(480).fit('crop').auto('format').url(),
  }));

const marqueeNames = [...roster.map((a) => a.name), ...roster.map((a) => a.name)];
---

{
  roster.length > 0 && (
    <section class="home-artists" data-home-artists aria-labelledby="home-artists-title">
      <div class="home-artists__head">
        <div data-home-reveal>
          <p class="home-kicker">The roster</p>
          <h2 id="home-artists-title" class="home-title">
            Faces of the<br />Energy
          </h2>
        </div>
        <a href="/artists" class="home-link" data-home-reveal data-home-reveal-delay="80">
          <span class="home-link__line" aria-hidden="true"></span>
          Full roster
        </a>
      </div>

      <div class="home-marquee home-artists__marquee" data-home-reveal data-home-reveal-delay="40" aria-hidden="true">
        <div class="home-marquee__track" data-home-marquee data-home-marquee-duration="32">
          {marqueeNames.map((name) => (
            <span>{name}</span>
          ))}
        </div>
      </div>

      <div class="home-h-scroll home-artists__scroll">
        <div class="home-artists__stage home-h-scroll__stage" data-home-h-scroll>
          <div class="home-artists__track" data-home-artists-track>
            {roster.map((artist) => (
              <a
                href={`/artists/${artist.slug}`}
                class="home-artists__card"
                data-home-artist
              >
                <div class="home-artists__media" data-home-artist-media>
                  <img
                    src={artist.photoUrl}
                    alt=""
                    width="360"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    sizes="(max-width: 640px) 70vw, 280px"
                  />
                </div>
                <div class="home-artists__meta">
                  <p class="home-artists__name">{artist.name}</p>
                  {artist.tagline && <p class="home-artists__tag">{artist.tagline}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="home-h-scroll__meter" aria-hidden="true">
          <div class="home-h-scroll__track">
            <div class="home-h-scroll__thumb" data-home-h-scroll-thumb></div>
          </div>
          <span class="home-h-scroll__label">Swipe</span>
        </div>
      </div>

      <p class="home-artists__hint" data-home-reveal data-home-reveal-delay="120" aria-hidden="true">
        Scroll to move through the roster
      </p>
    </section>
  )
}

<style>
  .home-artists {
    position: relative;
    padding: 5rem 0 2.5rem;
    background:
      radial-gradient(ellipse 60% 50% at 0% 0%, rgba(77, 168, 255, 0.12), transparent 55%),
      #080b10;
    /* visible so ScrollTrigger pin spacers are not clipped into a blank void */
    overflow: visible;
  }

  .home-artists__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 1.75rem;
  }

  @media (min-width: 640px) {
    .home-artists__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-inline: 1.5rem;
    }
  }

  .home-artists__marquee {
    margin-bottom: 1.5rem;
  }

  .home-artists__stage {
    overflow: hidden;
  }

  .home-artists__track {
    display: flex;
    gap: 0.85rem;
    width: max-content;
    padding: 0.5rem 1.25rem 1rem;
    perspective: 1200px;
  }

  @media (min-width: 640px) {
    .home-artists__track {
      gap: 1rem;
      padding-inline: 1.5rem;
    }
  }

  .home-artists__card {
    position: relative;
    flex: 0 0 auto;
    width: min(72vw, 18rem);
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
  }

  @media (min-width: 900px) {
    .home-artists__card {
      width: clamp(16rem, 22vw, 20rem);
    }
  }

  .home-artists__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #12161c;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .home-artists__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-artists__card:hover .home-artists__media img {
    transform: scale(1.08);
  }

  .home-artists__meta {
    position: absolute;
    inset: auto 0 0;
    padding: 3.5rem 1rem 1.1rem;
    background: linear-gradient(180deg, transparent, rgba(4, 8, 12, 0.95));
  }

  .home-artists__name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .home-artists__tag {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--color-paper);
  }

  .home-artists__card::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    pointer-events: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .home-artists__card:hover::after {
    border-color: rgba(77, 168, 255, 0.65);
    box-shadow: inset 0 0 0 1px rgba(77, 168, 255, 0.2), 0 0 40px rgba(77, 168, 255, 0.15);
  }

  .home-artists__hint {
    display: none;
    width: min(100%, 80rem);
    margin: 0.5rem auto 0;
    padding: 0 1.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  @media (min-width: 900px) {
    .home-artists__hint {
      display: block;
    }
  }

  @media (max-width: 899px) {
    .home-artists__stage.home-h-scroll__stage {
      overflow-x: auto;
    }

    .home-artists__card {
      scroll-snap-align: start;
    }
  }
</style>
