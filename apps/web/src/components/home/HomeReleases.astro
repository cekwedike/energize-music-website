---
import type { EnrichedRelease } from '@energize/shared';
import ReleasesCatalogCard from '../releases/ReleasesCatalogCard.astro';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;
---

{
  releases.length > 0 && (
    <section class="home-row" aria-labelledby="home-row-title">
      <div class="home-row__head">
        <div data-home-reveal>
          <p class="home-kicker">The catalog</p>
          <h2 id="home-row-title" class="home-title">
            More <em class="home-row__accent">releases</em>
          </h2>
        </div>
        <a href="/releases" class="home-link" data-home-reveal data-home-reveal-delay="70">
          <span class="home-link__line" aria-hidden="true"></span>
          All releases
        </a>
      </div>

      <ul class="home-row__track" aria-label="Releases">
        {releases.map((release) => (
          <li class="home-row__item">
            <ReleasesCatalogCard release={release} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .home-row {
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: clamp(5rem, 4rem + 4vw, 8rem) 0;
  }

  .home-row__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-row__head {
      padding-inline: 1.5rem;
    }
  }

  .home-row__accent {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }

  .home-row__track {
    display: flex;
    gap: 1.25rem;
    margin: 2.75rem 0 0;
    padding: 0.25rem 1.25rem 1.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  @media (min-width: 640px) {
    .home-row__track {
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }
  }

  .home-row__item {
    flex: 0 0 min(72vw, 15rem);
    scroll-snap-align: start;
  }

  @media (min-width: 1024px) {
    .home-row__item {
      flex-basis: 16.5rem;
    }
  }
</style>
