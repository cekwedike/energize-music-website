---
import type { EnrichedRelease } from '@energize/shared';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;
// Now Spinning shows only the newest featured release (no filler rail).
const lead = releases[0];

function formatDate(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---

{
  lead && (
    <section class="home-releases" id="now-spinning" data-home-releases aria-labelledby="home-releases-title">
      <div class="home-releases__atmosphere" aria-hidden="true"></div>

      <div class="home-releases__inner">
        <div class="home-releases__head" data-home-reveal>
          <p class="home-kicker">Now spinning</p>
          <h2 id="home-releases-title" class="home-title">Fresh from<br />the Energize Corner</h2>
        </div>

        <div class="home-releases__stage">
          <a href={`/releases/${lead.slug}`} class="home-releases__cover" data-home-release-cover>
            {lead.coverUrl ? (
              <img
                src={lead.coverUrl}
                alt=""
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                referrerpolicy="no-referrer"
                sizes="(max-width: 768px) 80vw, 420px"
              />
            ) : (
              <div class="home-releases__cover-fallback" aria-hidden="true"></div>
            )}
            <span class="home-releases__ring" aria-hidden="true"></span>
          </a>

          <div class="home-releases__copy" data-home-release-copy>
            <p class="home-releases__type">
              {lead.type}
              {lead.releaseDate && (
                <>
                  <span aria-hidden="true"> / </span>
                  <time datetime={lead.releaseDate}>{formatDate(lead.releaseDate)}</time>
                </>
              )}
            </p>
            <h3 class="home-releases__name">
              <a href={`/releases/${lead.slug}`}>{lead.displayTitle || lead.title}</a>
            </h3>
            {lead.artistNames.length > 0 && (
              <p class="home-releases__artists">{lead.artistNames.join(' · ')}</p>
            )}
            <div class="home-releases__actions">
              {lead.externalUrl && (
                <a
                  href={lead.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="home-btn home-btn--solid"
                >
                  Listen Now
                </a>
              )}
              <a href="/releases" class="home-btn home-btn--ghost">
                Full Catalog
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .home-releases {
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-top: -1px;
    padding: 3.25rem 0 5.5rem;
    overflow: hidden;
    background: #06090d;
  }

  @media (min-width: 640px) {
    .home-releases {
      padding-top: 3.75rem;
    }
  }

  .home-releases__atmosphere {
    position: absolute;
    inset: -10%;
    z-index: 0;
    opacity: 0.35;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 22% 18%, rgba(77, 168, 255, 0.22), transparent 62%),
      radial-gradient(ellipse 55% 45% at 78% 82%, rgba(77, 168, 255, 0.12), transparent 58%);
  }

  .home-releases__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-releases__inner {
      padding-inline: 1.5rem;
    }
  }

  .home-releases__stage {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .home-releases__stage {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 3.5rem;
    }
  }

  .home-releases__cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    max-width: 34rem;
    margin-inline: auto;
    overflow: hidden;
    background: #10141b;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 100px rgba(0, 0, 0, 0.55);
  }

  .home-releases__cover img,
  .home-releases__cover-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-releases__cover-fallback {
    background:
      radial-gradient(circle at 30% 20%, rgba(77, 168, 255, 0.4), transparent 55%),
      #151a22;
  }

  .home-releases__ring {
    position: absolute;
    inset: 8%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: screen;
    transform: translateZ(0);
    animation: home-release-spin 18s linear infinite;
  }

  .home-releases__ring::after {
    content: '';
    position: absolute;
    inset: 18%;
    border: 1px dashed rgba(77, 168, 255, 0.35);
    border-radius: 50%;
  }

  @keyframes home-release-spin {
    to {
      transform: rotate(360deg) translateZ(0);
    }
  }

  .home-releases__type {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-glow);
  }

  .home-releases__name {
    margin-top: 0.9rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2.4rem, 1.6rem + 3.2vw, 4.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .home-releases__name a {
    color: inherit;
    text-decoration: none;
  }

  .home-releases__name a:hover {
    color: color-mix(in srgb, var(--color-glow) 65%, white);
  }

  .home-releases__artists {
    margin-top: 1rem;
    font-size: 1.05rem;
    color: var(--color-paper);
  }

  .home-releases__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-releases__ring {
      animation: none;
    }
  }
</style>
