---
import type { EnrichedRelease } from '@energize/shared';
import SectionTitle from '../ui/SectionTitle.astro';
import MediaCard from '../ui/MediaCard.astro';
import { releaseMeta } from '../../lib/releases/format';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;
---

{
  releases.length > 0 && (
    <section class="home-releases" aria-labelledby="home-releases-title">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionTitle
          id="home-releases-title"
          title="Selected Releases"
          link={{ label: 'All music', href: '/releases' }}
          class="scroll-reveal"
        />
      </div>

      <ul class="home-releases__rail scrollbar-hide" aria-label="Selected releases">
        {releases.map((release) => (
          <li class="home-releases__item">
            <MediaCard
              href={`/releases/${release.slug}`}
              image={release.coverUrl}
              imageAlt={`${release.displayTitle} cover art`}
              title={release.displayTitle}
              meta={releaseMeta(release)}
              subtitle={release.artistNames.join(', ')}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .home-releases {
    padding-block: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--color-line);
  }

  .home-releases__rail {
    /* Line the first card up with the max-w-7xl container padding. */
    --rail-pad: 1.25rem;
    --rail-gutter: max(var(--rail-pad), calc((100% - 80rem) / 2 + var(--rail-pad)));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(13rem, 62vw, 18rem);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-inline: var(--rail-gutter);
    scroll-padding-inline: var(--rail-gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  @media (min-width: 640px) {
    .home-releases__rail {
      --rail-pad: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .home-releases__rail {
      --rail-pad: 2rem;
    }
  }

  .home-releases__item {
    scroll-snap-align: start;
    min-width: 0;
  }
</style>
