---
import type { EnrichedRelease } from '@energize/shared';
import ReleasesCatalogCard from '../releases/ReleasesCatalogCard.astro';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;
---

{
  releases.length > 0 && (
    <div class="home-row">
      <ul class="home-row__track" aria-label="More releases">
        {releases.map((release) => (
          <li class="home-row__item">
            <ReleasesCatalogCard release={release} />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .home-row {
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  .home-row__track {
    display: flex;
    gap: 1.25rem;
    margin: 2.75rem 0 0;
    padding: 0.25rem 1.25rem 1.5rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  @media (min-width: 640px) {
    .home-row__track {
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }
  }

  .home-row__item {
    flex: 0 0 min(72vw, 15rem);
    scroll-snap-align: start;
  }

  /* Wide screens: four cards span the content width; centre the row when it is too short to scroll. */
  @media (min-width: 1024px) {
    .home-row__track {
      justify-content: flex-start;
      justify-content: safe center;
    }

    .home-row__item {
      flex-basis: calc((100% - 3 * 1.25rem) / 4);
    }
  }
</style>
