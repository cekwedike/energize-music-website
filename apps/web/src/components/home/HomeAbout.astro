---
const quote =
  'Music can carry hope without losing its edge. From Lagos, we create Afro-gospel and soul-fusion sound that is uplifting, family-friendly, and made to travel.';
const words = quote.split(' ');
---

<section class="home-about" data-home-about aria-labelledby="home-about-title">
  <div class="home-about__orb" aria-hidden="true"></div>
  <div class="home-about__inner">
    <p class="home-kicker" data-home-reveal>The belief</p>
    <h2 id="home-about-title" class="sr-only">Why Energize Music exists</h2>
    <blockquote class="home-about__quote">
      <p>
        {
          words.map((word) => (
            <span class="home-about__word" data-home-word>
              {word}
            </span>
          ))
        }
      </p>
    </blockquote>
    <a
      href="/about"
      class="home-btn home-btn--ghost home-about__cta"
      data-home-reveal
      data-home-reveal-delay="180"
    >
      More About Us
    </a>
  </div>
</section>

<style>
  .home-about {
    position: relative;
    overflow: hidden;
    padding: clamp(6rem, 4.5rem + 4vw, 9rem) 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 8%, transparent);
    background: var(--color-bg);
  }

  @media (min-width: 640px) {
    .home-about {
      padding: clamp(7.5rem, 5rem + 4vw, 10rem) 1.5rem;
    }
  }

  .home-about__orb {
    position: absolute;
    left: 50%;
    bottom: -35%;
    width: min(70vw, 34rem);
    height: min(70vw, 34rem);
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 16.8%, transparent), transparent 68%);
    pointer-events: none;
    transform: translateZ(0);
    animation: home-about-pulse 5.5s ease-in-out infinite;
  }

  @keyframes home-about-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.92) translateZ(0);
    }
    50% {
      opacity: 1;
      transform: scale(1.08) translateZ(0);
    }
  }

  .home-about__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 48rem);
    margin-inline: auto;
    text-align: center;
  }

  .home-about__quote {
    margin: 1.5rem 0 0;
  }

  .home-about__quote p {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.55rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.7rem, 1.2rem + 2.4vw, 2.9rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-fg);
  }

  .home-about__word {
    display: inline-block;
  }

  .home-about__cta {
    margin-top: 1.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-about__orb {
      animation: none;
    }
  }
</style>
