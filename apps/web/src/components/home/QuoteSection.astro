---
---

<section
  id="quote-section"
  class="relative h-screen w-full overflow-hidden"
  style="background: linear-gradient(180deg, #010A17 0%, #0A4267 30%, #20658E 60%, #6BADC4 100%);"
>
  <img
    id="quote-rainbow"
    src="https://soft-zoom-63098134.figma.site/_assets/v11/8d520a7515d06cbfc403d0125e3d05b1a7ccd29c.png"
    alt=""
    aria-hidden="true"
    class="absolute inset-x-0 top-0 z-30 w-full will-change-transform"
  />

  <img
    id="quote-cloud-left"
    src="https://soft-zoom-63098134.figma.site/_assets/v11/0d6dfd3f90b930f21726f2ed56a3320d79b7a797.png"
    alt=""
    aria-hidden="true"
    class="absolute bottom-[10%] left-0 z-10 hidden w-[500px] opacity-0 will-change-transform sm:block md:w-[650px]"
    style="margin-left: -50%;"
  />

  <img
    id="quote-cloud-right"
    src="https://soft-zoom-63098134.figma.site/_assets/v11/0d6dfd3f90b930f21726f2ed56a3320d79b7a797.png"
    alt=""
    aria-hidden="true"
    class="absolute bottom-[15%] right-0 z-10 hidden w-[500px] scale-x-[-1] opacity-0 will-change-transform sm:block md:w-[650px]"
    style="margin-right: -75%;"
  />

  <div class="relative z-20 mx-auto flex h-full max-w-4xl flex-col items-center justify-center px-6 text-center">
    <p class="font-instrument text-xl leading-[1.45] text-white sm:text-2xl md:text-4xl md:leading-[1.5] lg:text-[42px]">
      &ldquo;Serene was founded on a belief in beauty that honors your nature. We pursue refined
      outcomes, considered approaches, and lasting vitality. We spend time learning what matters to
      you before deciding what serves you best. No rushing, no excess &mdash; just support that lets
      you feel radiant.&rdquo;
    </p>
    <p class="font-inter mt-6 text-sm tracking-wide text-white/80 md:mt-8 md:text-base">
      Dr. Mia Callahan &mdash; Founder
    </p>
  </div>
</section>

<script>
  const section = document.getElementById('quote-section');
  const rainbow = document.getElementById('quote-rainbow');
  const cloudLeft = document.getElementById('quote-cloud-left');
  const cloudRight = document.getElementById('quote-cloud-right');

  if (section && rainbow && cloudLeft && cloudRight) {
    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
    const lerp = (current: number, target: number, factor: number) => current + (target - current) * factor;

    let rainbowY = 120;
    let cloudLeftX = -200;
    let cloudLeftY = 0;
    let cloudRightX = 200;
    let cloudRightY = 0;

    let rafId = 0;

    const tick = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const progress = clamp01((windowHeight - rect.top) / (windowHeight + rect.height));

      const rainbowTargetY = 120 - 280 * progress;
      rainbowY = lerp(rainbowY, rainbowTargetY, 0.06);
      rainbow.style.transform = `translate3d(0, ${rainbowY}px, 0)`;

      const inRange = progress >= 0.12 && progress <= 0.92;
      const cloudDriftY = progress * -50;

      const leftTargetX = inRange ? 0 : -200;
      cloudLeftX = lerp(cloudLeftX, leftTargetX, 0.04);
      cloudLeftY = lerp(cloudLeftY, cloudDriftY, 0.04);
      const leftOpacity = clamp01(1 - Math.abs(cloudLeftX) / 200);
      cloudLeft.style.transform = `translate3d(${cloudLeftX}px, ${cloudLeftY}px, 0)`;
      cloudLeft.style.opacity = String(leftOpacity);

      const rightTargetX = inRange ? 0 : 200;
      cloudRightX = lerp(cloudRightX, rightTargetX, 0.04);
      cloudRightY = lerp(cloudRightY, cloudDriftY, 0.04);
      const rightOpacity = clamp01(1 - Math.abs(cloudRightX) / 200);
      cloudRight.style.transform = `translate3d(${cloudRightX}px, ${cloudRightY}px, 0)`;
      cloudRight.style.opacity = String(rightOpacity);

      rafId = requestAnimationFrame(tick);
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      rainbow.style.transform = 'translate3d(0, 0, 0)';
      cloudLeft.style.transform = 'translate3d(0, 0, 0)';
      cloudLeft.style.opacity = '1';
      cloudRight.style.transform = 'translate3d(0, 0, 0)';
      cloudRight.style.opacity = '1';
    } else {
      rafId = requestAnimationFrame(tick);
    }

    window.addEventListener('pagehide', () => cancelAnimationFrame(rafId));
  }
</script>
