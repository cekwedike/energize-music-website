---
---

<section class="home-newsletter" aria-labelledby="home-newsletter-title">
  <div class="home-newsletter__inner mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <h2 id="home-newsletter-title" class="home-newsletter__title scroll-reveal">Stay in the Energy</h2>

    <form class="home-newsletter__form scroll-reveal" style="--reveal-delay: 80ms" aria-label="Newsletter signup">
      <label class="sr-only" for="home-newsletter-email">Email address</label>
      <div class="home-newsletter__row">
        <input
          id="home-newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="home-newsletter__input"
        />
        <button type="submit" class="home-newsletter__submit">Subscribe</button>
      </div>
      <p class="home-newsletter__note">New music only. No spam.</p>
    </form>
  </div>
</section>

<style>
  .home-newsletter {
    padding-block: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--color-line);
  }

  .home-newsletter__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .home-newsletter__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .home-newsletter__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.4rem + 7vw, 7.5rem);
    font-weight: 400;
    line-height: 0.88;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .home-newsletter__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-newsletter__input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: var(--color-bg);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .home-newsletter__input::placeholder {
    color: var(--color-faint);
  }

  .home-newsletter__input:focus-visible {
    outline: none;
    border-color: var(--color-ink);
  }

  .home-newsletter__submit {
    flex: 0 0 auto;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    border: 0;
    border-radius: 0.25rem;
    background: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .home-newsletter__submit:hover,
  .home-newsletter__submit:focus-visible {
    background: var(--color-ink);
  }

  .home-newsletter__note {
    margin: 0.875rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-newsletter__submit {
      transition: none;
    }
  }
</style>
