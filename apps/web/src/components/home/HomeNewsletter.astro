---
---

<section class="home-newsletter" id="first-to-know" data-home-newsletter aria-labelledby="home-newsletter-title">
  <div class="home-newsletter__inner">
    <div data-home-reveal>
      <p class="home-kicker">Stay in the loop</p>
      <h2 id="home-newsletter-title" class="home-title">
        Be the<br />first to know
      </h2>
      <p class="home-newsletter__lead">
        New releases, artiste news, and show dates from Energize Music, sent to you before anyone else hears.
      </p>
    </div>

    <form class="home-newsletter__form" data-home-newsletter-form novalidate>
      <label class="home-newsletter__label" for="home-newsletter-email">Email address</label>
      <div class="home-newsletter__row">
        <input
          id="home-newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          class="home-newsletter__input"
        />
        <button type="submit" class="home-btn home-btn--solid" data-home-newsletter-submit>Notify me</button>
      </div>
      <div class="home-newsletter__trap" aria-hidden="true">
        <label for="home-newsletter-company">Company</label>
        <input id="home-newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="home-newsletter__note" data-home-newsletter-note role="status" aria-live="polite">
        Only big news. Unsubscribe any time. See our <a href="/privacy">privacy policy</a>.
      </p>
    </form>
  </div>
</section>

<style>
  .home-newsletter {
    position: relative;
    overflow: hidden;
    padding: clamp(5.5rem, 4rem + 4vw, 8.5rem) 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }


  .home-newsletter__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.25rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-newsletter__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .home-newsletter__inner {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 3.5rem;
    }
  }

  .home-newsletter__lead {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-fg);
  }

  .home-newsletter__label {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .home-newsletter__row {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  @media (min-width: 560px) {
    .home-newsletter__row {
      grid-template-columns: 1fr auto;
    }
  }

  .home-newsletter__input {
    width: 100%;
    min-height: 3rem;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 30%, transparent);
    border-radius: 0;
    background: transparent;
    padding: 0.75rem 0.1rem;
    color: var(--color-fg);
    font-size: 1.05rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .home-newsletter__input::placeholder {
    color: var(--color-muted);
  }

  .home-newsletter__input:focus {
    border-bottom-color: var(--color-accent);
    box-shadow: 0 1px 0 0 var(--color-accent);
  }

  .home-newsletter__note {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    color: var(--color-fg);
  }

  .home-newsletter__note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .home-newsletter__note.is-success {
    color: var(--color-accent);
  }

  .home-newsletter__note.is-error {
    color: var(--color-danger);
  }

  .home-newsletter__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { formToObject, submitForm } from '../../lib/forms';

  const form = document.querySelector<HTMLFormElement>('[data-home-newsletter-form]');
  const note = document.querySelector<HTMLElement>('[data-home-newsletter-note]');
  const button = document.querySelector<HTMLButtonElement>('[data-home-newsletter-submit]');
  const email = document.querySelector<HTMLInputElement>('#home-newsletter-email');

  const setNote = (message: string, state: 'success' | 'error') => {
    if (!note) return;
    note.textContent = message;
    note.classList.toggle('is-success', state === 'success');
    note.classList.toggle('is-error', state === 'error');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!email?.checkValidity()) {
      setNote('Please enter a valid email address.', 'error');
      email?.focus();
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = 'Sending...';
    }
    const result = await submitForm('subscribe', formToObject(form));
    if (button) {
      button.disabled = false;
      button.textContent = 'Notify me';
    }

    setNote(result.message, result.ok ? 'success' : 'error');
    if (result.ok) form.reset();
  });
</script>
