---
---

<section class="home-newsletter" aria-labelledby="home-newsletter-title">
  <div class="home-newsletter__inner">
    <div class="home-newsletter__copy scroll-reveal">
      <p class="home-kicker">Stay close</p>
      <h2 id="home-newsletter-title" class="home-newsletter__title">
        New music. Label news. First.
      </h2>
      <p class="home-newsletter__lead">
        Drop your email for releases, artist updates, and the next Energize moment before it hits the feed.
      </p>
    </div>

    <form class="home-newsletter__form scroll-reveal" style="--reveal-delay: 90ms" data-home-newsletter>
      <label class="home-newsletter__label" for="home-newsletter-email">Email address</label>
      <div class="home-newsletter__row">
        <input
          id="home-newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="home-newsletter__input"
        />
        <button type="submit" class="home-btn home-btn--solid home-newsletter__submit">
          Subscribe
        </button>
      </div>
      <p class="home-newsletter__note" data-home-newsletter-note>
        No spam. Just the Energy.
      </p>
    </form>
  </div>
</section>

<style>
  .home-newsletter {
    padding: 4.5rem 0 5.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--color-ink-raised);
  }

  .home-newsletter__inner {
    display: grid;
    gap: 2rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-newsletter__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .home-newsletter__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: end;
      gap: 3rem;
    }
  }

  .home-newsletter__title {
    margin-top: 0.65rem;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .home-newsletter__lead {
    margin-top: 0.9rem;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(250, 250, 248, 0.62);
  }

  .home-newsletter__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.45);
  }

  .home-newsletter__row {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 560px) {
    .home-newsletter__row {
      grid-template-columns: 1fr auto;
      align-items: stretch;
    }
  }

  .home-newsletter__input {
    width: 100%;
    min-height: 2.85rem;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0;
    background: transparent;
    padding: 0.7rem 0.15rem;
    color: var(--color-paper);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .home-newsletter__input::placeholder {
    color: rgba(250, 250, 248, 0.35);
  }

  .home-newsletter__input:focus {
    border-bottom-color: var(--color-glow);
  }

  .home-newsletter__submit {
    width: 100%;
  }

  @media (min-width: 560px) {
    .home-newsletter__submit {
      width: auto;
      min-width: 9.5rem;
    }
  }

  .home-newsletter__note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: rgba(250, 250, 248, 0.42);
  }

  .home-newsletter__note.is-success {
    color: var(--color-glow-cyan);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-home-newsletter]');
  const note = document.querySelector<HTMLElement>('[data-home-newsletter-note]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!note) return;
    note.textContent = 'Thanks. Newsletter signup wires up soon. Follow us in the meantime.';
    note.classList.add('is-success');
    form.reset();
  });
</script>
