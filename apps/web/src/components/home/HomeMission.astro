---
import SectionTitle from '../ui/SectionTitle.astro';
---

<section class="home-mission" aria-labelledby="home-mission-title">
  <div class="mx-auto max-w-5xl px-5 text-center sm:px-6">
    <SectionTitle id="home-mission-title" title="Our Sound" class="home-mission__title scroll-reveal" />
    <p class="home-mission__statement scroll-reveal" style="--reveal-delay: 80ms">
      We make Afro-gospel that lifts families, from Lagos to the world.
    </p>
  </div>
</section>

<style>
  .home-mission {
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .home-mission :global(.home-mission__title) {
    justify-content: center;
  }

  .home-mission__statement {
    margin: clamp(1.5rem, 3vw, 2.5rem) auto 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>
