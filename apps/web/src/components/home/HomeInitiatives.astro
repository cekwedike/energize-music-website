---
import { initiativesNav } from '../../lib/nav';

const items = initiativesNav;
---

<section class="home-initiatives" aria-labelledby="home-initiatives-title">
  <div class="home-initiatives__head scroll-reveal">
    <p class="home-kicker">Beyond the catalog</p>
    <h2 id="home-initiatives-title" class="home-initiatives__title">Initiatives with reach</h2>
    <p class="home-initiatives__lead">
      Kids entertainment, pan-African talent, and live stages: the Energy moves further than a release date.
    </p>
  </div>

  <ul class="home-initiatives__stack">
    {
      items.map((item, index) => (
        <li class="home-initiatives__panel scroll-reveal" style={`--reveal-delay: ${80 + index * 60}ms`}>
          <a href={item.href} class="home-initiatives__link">
            <img
              src={item.image}
              alt=""
              class="home-initiatives__img"
              loading="lazy"
              decoding="async"
            />
            <div class="home-initiatives__veil" aria-hidden="true"></div>
            <div class="home-initiatives__content">
              <p class="home-initiatives__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="home-initiatives__name">{item.label}</h3>
              <p class="home-initiatives__blurb">{item.blurb}</p>
              <span class="home-initiatives__cta">
                Enter
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .home-initiatives {
    padding: 4.5rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .home-initiatives__head {
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__head {
      padding-inline: 1.5rem;
      padding-bottom: 2.5rem;
    }
  }

  .home-initiatives__title {
    margin-top: 0.65rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .home-initiatives__lead {
    margin-top: 0.9rem;
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(250, 250, 248, 0.62);
  }

  .home-initiatives__stack {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-initiatives__panel {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .home-initiatives__link {
    position: relative;
    display: grid;
    min-height: clamp(16rem, 42vw, 22rem);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 900px) {
    .home-initiatives__link {
      grid-template-columns: 1.15fr 1fr;
      min-height: 20rem;
    }
  }

  .home-initiatives__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-initiatives__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 9, 13, 0.92) 0%, rgba(6, 9, 13, 0.55) 55%, rgba(6, 9, 13, 0.28) 100%),
      linear-gradient(180deg, transparent 40%, rgba(6, 9, 13, 0.75) 100%);
  }

  .home-initiatives__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem 1.25rem 1.65rem;
    max-width: 36rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__content {
      padding: 2rem 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .home-initiatives__content {
      grid-column: 1;
      justify-content: center;
      padding-left: max(1.5rem, calc((100vw - 80rem) / 2 + 1.5rem));
    }
  }

  .home-initiatives__index {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    color: rgba(77, 168, 255, 0.8);
  }

  .home-initiatives__name {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 1.3rem + 2vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .home-initiatives__blurb {
    margin-top: 0.75rem;
    max-width: 32rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgba(250, 250, 248, 0.72);
  }

  .home-initiatives__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .home-initiatives__cta::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--color-glow);
    transition: width 0.25s ease;
  }

  .home-initiatives__link:hover .home-initiatives__img,
  .home-initiatives__link:focus-visible .home-initiatives__img {
    transform: scale(1.1);
  }

  .home-initiatives__link:hover .home-initiatives__cta::before,
  .home-initiatives__link:focus-visible .home-initiatives__cta::before {
    width: 2.75rem;
  }
</style>
