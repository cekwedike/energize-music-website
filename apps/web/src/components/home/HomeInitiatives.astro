---
import { initiativesNav } from '../../lib/nav';

const items = initiativesNav;
---

<section class="home-initiatives" data-home-initiatives aria-labelledby="home-initiatives-title">
  <div class="home-initiatives__head">
    <div data-home-reveal>
      <p class="home-kicker">Label initiatives</p>
      <h2 id="home-initiatives-title" class="home-title">
        What We're<br />Building Beyond Music
      </h2>
    </div>
    <p class="home-initiatives__lead" data-home-reveal data-home-reveal-delay="70">
      NEXT finds new Afro-gospel voices. Energize Kids serves families. Energize Fest puts the whole roster on one stage each year.
    </p>
  </div>

  <div class="home-initiatives__track" data-home-initiatives-track>
    {
      items.map((item) => (
        <a href={item.href} class="home-initiatives__card" data-home-initiative>
          <span class="home-initiatives__media media-frame">
            <img
              src={item.image}
              alt={`${item.label}, an Energize Music initiative`}
              width="800"
              height="1000"
              class="home-initiatives__img"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="home-initiatives__name">{item.label}</span>
          <span class="home-initiatives__blurb">{item.blurb}</span>
          <span class="home-link">
            <span class="home-link__line" aria-hidden="true"></span>
            Enter
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-initiatives {
    padding: clamp(5rem, 4rem + 4vw, 8rem) 0;
    background: var(--color-bg);
  }

  .home-initiatives__head {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      padding: 0 1.5rem 2.5rem;
    }
  }

  .home-initiatives__lead {
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Same container and side padding as the heading: stacked on mobile, an even 3-column grid on wide screens. */
  .home-initiatives__track {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__track {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .home-initiatives__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .home-initiatives__card {
    display: flex;
    flex-direction: column;
    color: var(--color-fg);
    text-decoration: none;
  }

  .home-initiatives__media {
    aspect-ratio: 4 / 5;
  }

  .home-initiatives__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-initiatives__card:hover .home-initiatives__img {
    transform: scale(1.04);
  }

  .home-initiatives__name {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .home-initiatives__blurb {
    margin: 0.75rem 0 1.1rem;
    max-width: 28rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
