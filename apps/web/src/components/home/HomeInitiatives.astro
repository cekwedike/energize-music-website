---
import { initiativesNav } from '../../lib/nav';

const items = initiativesNav;
---

<section class="home-initiatives" data-home-initiatives aria-labelledby="home-initiatives-title">
  <div class="home-initiatives__head">
    <div data-home-reveal>
      <p class="home-kicker">Label initiatives</p>
      <h2 id="home-initiatives-title" class="home-title">
        What We're<br />Building Beyond Music
      </h2>
    </div>
    <p class="home-initiatives__lead" data-home-reveal data-home-reveal-delay="70">
      NEXT finds new Afrogospel voices. Energize Kids serves families. Energize Fest puts the roster on one stage each year.
    </p>
  </div>

  <div class="home-initiatives__track" data-home-initiatives-track>
    {
      items.map((item) => (
        <a href={item.href} class="home-initiatives__panel theme-dark" data-home-initiative>
          <img
            src={item.image}
            alt={`${item.label} initiative`}
            width="640"
            height="400"
            class="home-initiatives__img"
            loading="lazy"
            decoding="async"
          />
          <div class="home-initiatives__veil" aria-hidden="true"></div>
          <div class="home-initiatives__content">
            <h3 class="home-initiatives__name">{item.label}</h3>
            <p class="home-initiatives__blurb">{item.blurb}</p>
            <span class="home-link">
              <span class="home-link__line" aria-hidden="true"></span>
              Enter
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-initiatives {
    padding: clamp(5rem, 4rem + 4vw, 8rem) 0 0;
    background: var(--color-bg);
    /* visible: clipping ancestors breaks position:fixed GSAP pins and causes blank voids */
    overflow: visible;
  }

  .home-initiatives__head {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      padding: 0 1.5rem 2.5rem;
    }
  }

  .home-initiatives__lead {
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg);
  }

  /* Same container and side padding as the heading: stacked on mobile, an even 3-column grid on wide screens. */
  .home-initiatives__track {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__track {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 900px) {
    .home-initiatives__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .home-initiatives__panel {
    position: relative;
    width: 100%;
    height: clamp(22rem, 70vh, 34rem);
    overflow: hidden;
    color: var(--color-fg);
    text-decoration: none;
  }

  .home-initiatives__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-initiatives__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-scrim) 15%, transparent) 0%, color-mix(in srgb, var(--color-scrim) 88%, transparent) 78%),
      linear-gradient(90deg, color-mix(in srgb, var(--color-scrim) 55%, transparent), transparent 50%);
  }

  .home-initiatives__content {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem 1.4rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__content {
      padding: 2.25rem;
    }
  }

  .home-initiatives__name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .home-initiatives__blurb {
    margin: 0.9rem 0 1.35rem;
    max-width: 28rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-fg);
  }

  .home-initiatives__panel:hover .home-initiatives__img {
    transform: scale(1.14);
  }
</style>
