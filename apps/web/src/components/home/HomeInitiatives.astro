---
import { initiativesNav } from '../../lib/nav';

const items = initiativesNav;
---

<section class="home-initiatives" data-home-initiatives aria-labelledby="home-initiatives-title">
  <div class="home-initiatives__head">
    <div data-home-reveal>
      <p class="home-kicker">Beyond the catalog</p>
      <h2 id="home-initiatives-title" class="home-title">
        Initiatives<br />With Voltage
      </h2>
    </div>
    <p class="home-initiatives__lead" data-home-reveal data-home-reveal-delay="70">
      Kids entertainment, pan-African talent, and live stages. Scroll sideways through the movement.
    </p>
  </div>

  <div class="home-h-scroll home-initiatives__scroll">
    <div class="home-initiatives__stage home-h-scroll__stage" data-home-h-scroll>
      <div class="home-initiatives__track" data-home-initiatives-track>
        {
          items.map((item) => (
            <a href={item.href} class="home-initiatives__panel" data-home-initiative>
              <img src={item.image} alt="" class="home-initiatives__img" loading="lazy" decoding="async" />
              <div class="home-initiatives__veil" aria-hidden="true"></div>
              <div class="home-initiatives__content">
                <h3 class="home-initiatives__name">{item.label}</h3>
                <p class="home-initiatives__blurb">{item.blurb}</p>
                <span class="home-link">
                  <span class="home-link__line" aria-hidden="true"></span>
                  Enter
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
    <div class="home-h-scroll__meter" aria-hidden="true">
      <div class="home-h-scroll__track">
        <div class="home-h-scroll__thumb" data-home-h-scroll-thumb></div>
      </div>
      <span class="home-h-scroll__label">Swipe</span>
    </div>
  </div>
</section>

<style>
  .home-initiatives {
    padding: 5rem 0 0;
    background: #05070a;
    overflow: visible;
  }

  .home-initiatives__head {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding: 0 1.25rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      padding: 0 1.5rem 2.5rem;
    }
  }

  .home-initiatives__lead {
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-paper);
  }

  .home-initiatives__stage {
    overflow: hidden;
  }

  @media (max-width: 899px) {
    .home-initiatives__stage.home-h-scroll__stage {
      overflow-x: auto;
    }
  }

  .home-initiatives__track {
    display: flex;
    width: max-content;
  }

  .home-initiatives__panel {
    position: relative;
    flex: 0 0 auto;
    width: min(92vw, 42rem);
    min-height: clamp(22rem, 70vh, 34rem);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .home-initiatives__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-initiatives__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 8, 12, 0.15) 0%, rgba(5, 8, 12, 0.88) 78%),
      linear-gradient(90deg, rgba(5, 8, 12, 0.55), transparent 50%);
  }

  .home-initiatives__content {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem 1.4rem 2rem;
  }

  @media (min-width: 640px) {
    .home-initiatives__content {
      padding: 2.25rem;
    }
  }

  .home-initiatives__name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .home-initiatives__blurb {
    margin: 0.9rem 0 1.35rem;
    max-width: 28rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-paper);
  }

  .home-initiatives__panel:hover .home-initiatives__img {
    transform: scale(1.14);
  }

  @media (max-width: 899px) {
    .home-initiatives__panel {
      width: min(88vw, 28rem);
      scroll-snap-align: start;
    }
  }
</style>
