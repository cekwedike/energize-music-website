---
import type { EnrichedRelease } from '@energize/shared';
import { releaseYear, spotifyEmbedUrl } from '../../lib/releases/spotify';
import HomeReleases from './HomeReleases.astro';

interface Props {
  /** Featured first, then newest. The first one is the latest-release feature, the rest fill the row. */
  releases: EnrichedRelease[];
}

const [lead, ...more] = Astro.props.releases;

const spotifyUrl = lead?.links?.spotify;
const embedUrl = spotifyEmbedUrl(spotifyUrl);
const year = releaseYear(lead?.releaseDate);
---

{
  lead && (
    <section class="home-releases" id="music" data-home-releases aria-labelledby="home-music-title">
      <div class="home-releases__inner">
        <div class="home-releases__head">
          <div data-home-reveal>
            <p class="home-kicker">Latest release</p>
            <h2 id="home-music-title" class="home-title">Fresh from<br />the Energize Corner</h2>
          </div>
          <a href="/releases" class="home-link" data-home-reveal data-home-reveal-delay="70">
            <span class="home-link__line" aria-hidden="true"></span>
            All releases
          </a>
        </div>

        <div class="home-releases__stage">
          <a href={`/releases/${lead.slug}`} class="home-releases__cover" data-home-release-cover>
            {lead.coverUrl ? (
              <img
                src={lead.coverUrl}
                alt={`${lead.displayTitle || lead.title} cover art`}
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                referrerpolicy="no-referrer"
                sizes="(max-width: 768px) 80vw, 520px"
              />
            ) : (
              <div class="home-releases__cover-fallback" aria-hidden="true"></div>
            )}
          </a>

          <div class="home-releases__copy" data-home-release-copy>
            <p class="home-releases__type">
              {lead.type}
              {year && (
                <>
                  <span aria-hidden="true"> / </span>
                  <time datetime={lead.releaseDate}>{year}</time>
                </>
              )}
            </p>
            <h3 class="home-releases__name">
              <a href={`/releases/${lead.slug}`}>{lead.displayTitle || lead.title}</a>
            </h3>
            {lead.artistNames.length > 0 && (
              <p class="home-releases__artists">{lead.artistNames.join(' · ')}</p>
            )}

            {embedUrl && spotifyUrl && (
              <div class="home-releases__player" data-spotify-slot data-lenis-prevent>
                <a
                  href={spotifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="home-releases__player-load"
                  data-spotify-embed={embedUrl}
                  data-spotify-title={`${lead.displayTitle || lead.title} on Spotify`}
                >
                  <span class="home-releases__player-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                  <span>
                    <span class="home-releases__player-label">Play on this page</span>
                    <span class="home-releases__player-hint">Tap to load the Spotify player</span>
                  </span>
                </a>
              </div>
            )}

            {!embedUrl && lead.externalUrl && (
              <div class="home-releases__actions">
                <a
                  href={lead.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="home-btn home-btn--solid"
                >
                  Listen Now
                </a>
              </div>
            )}
          </div>
        </div>
      </div>

      <HomeReleases releases={more} />
    </section>
  )
}

<script>
  // The Spotify iframe is heavy, so it only loads after the visitor asks for it.
  document.querySelectorAll<HTMLAnchorElement>('[data-spotify-embed]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      const src = trigger.dataset.spotifyEmbed;
      const slot = trigger.closest('[data-spotify-slot]');
      if (!src || !slot) return;
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = trigger.dataset.spotifyTitle ?? 'Spotify player';
      iframe.width = '100%';
      iframe.height = '152';
      iframe.loading = 'lazy';
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      iframe.className = 'home-releases__player-frame';
      slot.replaceChildren(iframe);
    });
  });
</script>

<style>
  .home-releases {
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-top: -1px;
    padding: clamp(5rem, 4rem + 4vw, 8rem) 0;
    overflow: hidden;
    background: var(--color-bg);
  }

  .home-releases__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .home-releases__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .home-releases__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-releases__inner {
      padding-inline: 1.5rem;
    }
  }

  .home-releases__stage {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .home-releases__stage {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 3.5rem;
    }
  }

  .home-releases__cover {
    position: relative;
    display: block;
    aspect-ratio: 1;
    max-width: 34rem;
    margin-inline: auto;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .home-releases__cover img,
  .home-releases__cover-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-releases__cover-fallback {
    background: var(--color-accent-soft);
  }

  .home-releases__type {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .home-releases__name {
    margin-top: 0.9rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2.4rem, 1.6rem + 3.2vw, 4.25rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .home-releases__name a {
    color: inherit;
    text-decoration: none;
  }

  .home-releases__name a:hover {
    color: var(--color-accent);
  }

  .home-releases__artists {
    margin-top: 1rem;
    font-size: 1.05rem;
    color: var(--color-fg);
  }

  .home-releases__player {
    margin-top: 1.75rem;
    max-width: 30rem;
  }

  .home-releases__player-load {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-fg);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .home-releases__player-load:hover,
  .home-releases__player-load:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .home-releases__player-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .home-releases__player-icon svg {
    width: 1.1rem;
    height: 1.1rem;
    margin-left: 2px;
  }

  .home-releases__player-label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .home-releases__player-hint {
    display: block;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .home-releases__player :global(.home-releases__player-frame) {
    display: block;
    border: 0;
    border-radius: 12px;
  }

  .home-releases__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.85rem;
  }

</style>
