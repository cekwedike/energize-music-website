---
/**
 * Home page music section. Hand-picked spotlights get the dark, cover-lit stage; with none live
 * the newest release shows on the light page. Either way the record slides out of its sleeve and
 * turns, its label printed with the cover. With several spotlights, the rest wait in a crate below.
 */
import type { EnrichedRelease } from '@energize/shared';
import { releaseYear } from '../../lib/releases/spotify';
import { imageAlt, listNames } from '../../lib/seo/site';

interface Props {
  /** Live spotlights in their Studio order, or just the newest release when none are live. */
  releases: EnrichedRelease[];
  /** True when the releases come from Studio > Release Spotlights. */
  isSpotlight: boolean;
  /** Spotlight extras from Studio, in the same order as `releases`. Ignored for Latest Release. */
  notes?: Array<{ badge: string | null; message: string | null; upcoming: boolean }>;
}

const { isSpotlight, notes = [] } = Astro.props;
const releases: EnrichedRelease[] = Astro.props.releases;
const isCarousel = releases.length > 1;
const typeLabel: Record<EnrichedRelease['type'], string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};
const platforms = [
  { key: 'spotify', label: 'Spotify' },
  { key: 'appleMusic', label: 'Apple Music' },
  { key: 'youtube', label: 'YouTube' },
] as const;
---

{
  releases.length > 0 && (
    <section
      class:list={['hm', isSpotlight && 'hm--spotlight theme-dark']}
      id="music"
      data-home-releases
      aria-labelledby="home-music-title"
    >
      {isSpotlight && (
        <div class="hm__ambient" aria-hidden="true">
          {releases.map((release, index) =>
            release.coverUrl ? (
              <img
                src={release.coverUrl}
                alt=""
                class:list={['hm__ambient-img', index === 0 && 'is-active']}
                data-ambient={index}
                width="640"
                height="640"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            ) : null,
          )}
        </div>
      )}

      <div class="hm__inner">
        <div class="hm__head" data-home-reveal>
          <h2 id="home-music-title" class="hm__heading">Fresh from the Energize Corner</h2>
          <a href="/releases" class="hm__all">
            All releases
          </a>
        </div>

        <div class="hm__slides" data-carousel={isCarousel ? '' : undefined}>
          {releases.map((release, index) => {
            const title = release.displayTitle || release.title;
            const year = releaseYear(release.releaseDate);
            const note = isSpotlight ? notes[index] : undefined;
            const smartLink = isSpotlight ? release.links?.smartLink : undefined;
            const links = platforms.filter(({ key }) => release.links?.[key]);
            const href = `/releases/${release.slug}`;
            const meta = [note?.badge, typeLabel[release.type], year].filter(Boolean).join(', ');
            return (
              <article
                class:list={['hm__slide', index === 0 && 'is-active']}
                id={`hm-slide-${index}`}
                data-slide
                aria-label={title}
                {...(isCarousel ? { role: 'tabpanel', ...(index > 0 ? { inert: true } : {}) } : {})}
              >
                <div class="hm__deck">
                  <span class="hm__record" aria-hidden="true">
                    <span class="hm__disc">
                      {release.coverUrl && (
                        <img class="hm__label" src={release.coverUrl} alt="" width="240" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                      )}
                    </span>
                  </span>
                  <a
                    href={href}
                    class="hm__sleeve"
                    tabindex="-1"
                    aria-hidden="true"
                    {...(index === 0 ? { 'data-home-release-cover': '' } : {})}
                  >
                    {release.coverUrl ? (
                      <img
                        src={release.coverUrl}
                        alt={imageAlt(release.cover?.alt, `${title} cover art`)}
                        width="640"
                        height="640"
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        sizes="(max-width: 768px) 72vw, 520px"
                      />
                    ) : (
                      <span class="hm__sleeve-blank" />
                    )}
                  </a>
                </div>

                <div class="hm__copy" {...(index === 0 ? { 'data-home-release-copy': '' } : {})}>
                  <h3 class="hm__title">
                    <a href={href}>{title}</a>
                  </h3>
                  {release.artistNames.length > 0 && <p class="hm__artists">{listNames(release.artistNames)}</p>}
                  {meta && <p class="hm__meta">{meta}</p>}
                  {note?.message && <p class="hm__message">{note.message}</p>}

                  {smartLink ? (
                    <a href={smartLink} target="_blank" rel="noopener noreferrer" class="hm__listen">
                      {note?.upcoming ? 'Pre-save now' : 'Listen everywhere'}
                    </a>
                  ) : (
                    links.length === 0 &&
                    release.externalUrl && (
                      <a href={release.externalUrl} target="_blank" rel="noopener noreferrer" class="hm__listen">
                        Listen now
                      </a>
                    )
                  )}

                  {links.length > 0 && (
                    <ul class="hm__platforms" aria-label={`Listen to ${title}`}>
                      {links.map(({ key, label }) => (
                        <li>
                          <a href={release.links?.[key]} target="_blank" rel="noopener noreferrer" class="hm__platform">
                            {key === 'spotify' && (
                              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z" />
                              </svg>
                            )}
                            {key === 'appleMusic' && (
                              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M16.291 3.197c-.058.001-.118.008-.18.023l-7.223 1.807c-.492.123-.889.669-.889 1.223v8.77a2.6 2.6 0 0 0-1.3-.35 2.6 2.6 0 1 0 2.6 2.6V9.02l7-1.752v6.272a2.6 2.6 0 0 0-1.3-.35 2.6 2.6 0 1 0 2.6 2.6V4.395c0-.485-.303-1.206-.708-1.198z" />
                              </svg>
                            )}
                            {key === 'youtube' && (
                              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                              </svg>
                            )}
                            {label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}

                  <a href={href} class="hm__view">
                    View release
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        {isCarousel && (
          <div class="hm__crate" role="tablist" aria-label="Spotlight releases" data-carousel-controls>
            {releases.map((release, index) => {
              const title = release.displayTitle || release.title;
              return (
                <button
                  type="button"
                  role="tab"
                  class="hm__pick"
                  id={`hm-pick-${index}`}
                  aria-controls={`hm-slide-${index}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  data-carousel-dot={index}
                >
                  <span class="hm__pick-art">
                    {release.coverUrl && (
                      <img src={release.coverUrl} alt="" width="160" height="160" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    )}
                  </span>
                  <span class="hm__pick-title">{title}</span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  const section = document.querySelector<HTMLElement>('[data-home-releases]');

  if (section) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The record slides out the first time the section comes into view, and only turns while it is on screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) section.classList.add('is-out');
            section.classList.toggle('is-playing', entry.isIntersecting && !reduced);
          }),
        { threshold: 0.35 },
      );
      io.observe(section);
    } else {
      section.classList.add('is-out');
    }

    // Spotlight crate: only rendered when more than one spotlight is live.
    const track = section.querySelector<HTMLElement>('[data-carousel]');
    const crate = section.querySelector<HTMLElement>('[data-carousel-controls]');

    if (track && crate) {
      const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-slide]'));
      const picks = Array.from(crate.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
      const INTERVAL_MS = 8000;
      let current = 0;
      let timer = 0;
      let paused = false;

      const show = (next: number, focus = false) => {
        current = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle('is-active', active);
          slide.toggleAttribute('inert', !active);
        });
        picks.forEach((pick, i) => {
          const active = i === current;
          pick.setAttribute('aria-selected', String(active));
          pick.tabIndex = active ? 0 : -1;
          if (active && focus) pick.focus();
        });
        section
          .querySelectorAll<HTMLElement>('[data-ambient]')
          .forEach((img) => img.classList.toggle('is-active', img.dataset.ambient === String(current)));
      };

      const schedule = () => {
        window.clearTimeout(timer);
        if (reduced || paused || document.hidden) return;
        timer = window.setTimeout(() => {
          show(current + 1);
          schedule();
        }, INTERVAL_MS);
      };

      picks.forEach((pick, i) =>
        pick.addEventListener('click', () => {
          show(i);
          schedule();
        }),
      );

      crate.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        show(current + step, true);
        schedule();
      });

      // Pause while the visitor is reading or using it, and in background tabs.
      const pause = (value: boolean) => {
        paused = value;
        schedule();
      };
      section.addEventListener('pointerenter', () => pause(true));
      section.addEventListener('pointerleave', () => pause(false));
      section.addEventListener('focusin', () => pause(true));
      section.addEventListener('focusout', () => pause(false));
      document.addEventListener('visibilitychange', schedule);

      schedule();
    }
  }
</script>

<style>
  .hm {
    --sleeve: clamp(15rem, 70vw, 22rem);
    /* How far the record leaves the sleeve, as a share of its width. The deck is wide enough to hold it. */
    --deck: 1.52;
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-top: -1px;
    padding: clamp(5rem, 4rem + 4vw, 8.5rem) 0;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-fg);
  }

  .hm--spotlight {
    background: var(--color-scrim);
  }

  .hm__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2.5rem, 80rem);
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .hm__inner {
      width: min(100% - 3rem, 80rem);
    }
  }

  /* ---------- Heading ---------- */
  .hm__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .hm__heading {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 4rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hm__all,
  .hm__view {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-fg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .hm__all:hover,
  .hm__view:hover {
    color: var(--color-muted);
  }

  /* ---------- Slides share one grid cell, so they cross-fade without the layout jumping ---------- */
  .hm__slides {
    display: grid;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hm__slide {
    grid-area: 1 / 1;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem);
    align-items: center;
  }

  .hm__slides[data-carousel] > .hm__slide {
    transition:
      opacity 0.6s ease,
      visibility 0.6s ease;
  }

  .hm__slides[data-carousel] > .hm__slide:not(.is-active) {
    opacity: 0;
    visibility: hidden;
  }

  /* ---------- Sleeve and record ---------- */
  .hm__deck {
    position: relative;
    width: calc(var(--sleeve) * var(--deck));
    max-width: 100%;
    aspect-ratio: var(--deck);
  }

  .hm__sleeve {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    display: block;
    width: calc(100% / var(--deck));
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--color-surface);
    box-shadow:
      0 2.5rem 5rem -1.5rem rgba(0, 0, 0, 0.6),
      0 0 0 1px color-mix(in srgb, var(--color-fg) 8%, transparent);
  }

  .hm__sleeve img,
  .hm__sleeve-blank {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hm__sleeve-blank {
    background: var(--color-accent-soft);
  }

  .hm__record {
    position: absolute;
    top: 3%;
    left: 3%;
    width: calc(94% / var(--deck));
    aspect-ratio: 1;
    transition: transform 1.1s 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .is-out .hm__record {
    transform: translateX(56%);
  }

  .hm__disc {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 34%, #0b0b0d 34.5% 36%, transparent 36.5%),
      repeating-radial-gradient(circle, #18181b 0 1.5px, #0e0e10 1.5px 3px);
    box-shadow:
      inset 0 0 0 1px rgba(250, 250, 248, 0.07),
      0 1.5rem 3.5rem rgba(0, 0, 0, 0.5);
    animation: hm-spin 7s linear infinite paused;
  }

  .is-playing .hm__disc {
    animation-play-state: running;
  }

  /* Light catching the grooves. */
  .hm__disc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 40deg,
      transparent 0 18%,
      rgba(250, 250, 248, 0.09) 24%,
      transparent 31% 68%,
      rgba(250, 250, 248, 0.07) 74%,
      transparent 81%
    );
  }

  .hm__label {
    position: relative;
    z-index: 1;
    width: 34%;
    height: 34%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* The spindle hole. */
  .hm__disc::before {
    content: '';
    position: absolute;
    z-index: 2;
    width: 3%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0b0b0d;
  }

  @keyframes hm-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ---------- Copy ---------- */
  .hm__copy {
    min-width: 0;
    max-width: 34rem;
  }

  .hm__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.5rem + 4.5vw, 5.75rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hm__title a {
    color: inherit;
    text-decoration: none;
  }

  .hm__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.04em;
    text-underline-offset: 0.1em;
  }

  .hm__artists {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.2;
  }

  .hm__meta {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .hm__message {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .hm__listen {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.25rem;
    background: var(--color-accent-fill);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .hm__listen:hover {
    background: var(--color-accent-fill-hover);
  }

  .hm__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hm__listen + .hm__platforms {
    margin-top: 1.25rem;
  }

  .hm__platform {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-fg);
    font-weight: 600;
    text-decoration: none;
  }

  .hm__platform svg {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-accent);
  }

  .hm__platform:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .hm__view {
    margin-top: 0.75rem;
  }

  /* ---------- The crate: other spotlights, picked by their sleeves ---------- */
  .hm__crate {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .hm__pick {
    display: grid;
    gap: 0.6rem;
    width: 7.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .hm__pick-art {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-fg) 10%, transparent);
    opacity: 0.45;
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hm__pick-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hm__pick-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .hm__pick:hover .hm__pick-art {
    opacity: 0.8;
  }

  .hm__pick[aria-selected='true'] {
    color: var(--color-fg);
  }

  .hm__pick[aria-selected='true'] .hm__pick-art {
    opacity: 1;
    transform: translateY(-0.4rem);
  }

  /* ---------- Cover-lit glow behind the spotlight ---------- */
  .hm__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hm__ambient::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 28% 55%, transparent 0%, color-mix(in srgb, var(--color-scrim) 65%, transparent) 62%),
      linear-gradient(180deg, var(--color-scrim) 0%, transparent 24%, transparent 76%, var(--color-scrim) 100%);
  }

  .hm__ambient-img {
    position: absolute;
    top: 55%;
    left: 28%;
    width: 110%;
    max-width: none;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: blur(100px) saturate(1.4);
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 1.2s ease;
  }

  .hm__ambient-img.is-active {
    opacity: 0.42;
  }

  /* ---------- Wide ---------- */
  @media (min-width: 960px) {
    .hm {
      --sleeve: clamp(20rem, 30vw, 30rem);
    }

    .hm__slide {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm__record,
    .hm__slides[data-carousel] > .hm__slide,
    .hm__ambient-img,
    .hm__pick-art {
      transition: none;
    }

    .hm__disc {
      animation: none;
    }
  }
</style>
