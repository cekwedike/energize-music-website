---
import {
  HERO_VIDEO_MP4,
  HERO_VIDEO_POSTER,
  HERO_VIDEO_SRC,
  HERO_VIDEO_USES_CDN_FALLBACK,
} from '../../lib/hero-video';

const headline = "The Afro-Gospel Label Behind Africa's Biggest Christian Voices";
const headlineWords = headline.split(' ');
---

<section class="hero theme-dark" data-hero style={`--hero-poster: url('${HERO_VIDEO_POSTER}')`}>
  <video
    id="hero-video"
    class="hero-video"
    data-local-mp4={HERO_VIDEO_MP4}
    muted
    loop
    playsinline
    autoplay
    preload="metadata"
    poster={HERO_VIDEO_POSTER}
    aria-hidden="true"
  >
    {
      HERO_VIDEO_USES_CDN_FALLBACK ? (
        <source src={HERO_VIDEO_SRC} />
      ) : (
        <>
          {/* One lossless cut from the source for every device (H.264 plays everywhere, hardware decoded). */}
          <source src={HERO_VIDEO_MP4} type="video/mp4" />
        </>
      )
    }
  </video>

  <div class="hero-veil" aria-hidden="true"></div>

  <div id="hero-content" class="hero-content">
    <h1
      class="hero-headline font-instrument max-w-[min(100%,22rem)] text-[clamp(1.875rem,1.3rem+5.1vw,7.25rem)] leading-[0.95] tracking-tight text-[var(--color-on-dark)] sm:max-w-3xl md:max-w-[84rem]"
      aria-label={headline}
    >
      {
        headlineWords.map((word, i) => (
          <span class="hero-word" aria-hidden="true">
            <span class="hero-word__inner" style={`--i: ${i}`}>
              {word}
            </span>
          </span>
        ))
      }
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    height: 100svh;
    min-height: 36rem;
    margin-top: calc(-1 * var(--header-height, 4rem));
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Own compositor layer so decode is not blocked by overlay paints. */
    transform: translateZ(0);
    will-change: opacity;
    opacity: 0;
    transition: opacity 0.55s ease;
    background-color: var(--color-bg);
    background-image: var(--hero-poster);
    background-size: cover;
    background-position: center bottom;
  }

  .hero.is-playing .hero-video {
    opacity: 1;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* An even dim over the whole frame keeps the footage's colour while calming it down, plus extra
       shade behind the headline and at the top (header) and bottom edges. Overlay only: the video is untouched. */
    background:
      radial-gradient(ellipse 60% 45% at 50% 50%, color-mix(in srgb, var(--color-scrim) 38%, transparent) 0%, transparent 100%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-scrim) 35%, transparent) 0%, transparent 22%, transparent 70%, color-mix(in srgb, var(--color-scrim) 40%, transparent) 100%),
      color-mix(in srgb, var(--color-scrim) 32%, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height, 4rem) + 1.5rem) 1.25rem 3rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .hero-content {
      padding-inline: 1.5rem;
    }
  }

  /* Soft shadow keeps the white headline readable over bright frames. A filter (not text-shadow),
     because the words are painted with background-clip: text for the light sweep. */
  .hero-headline {
    /* Even line lengths at every width, e.g. "The Afro-Gospel Label Behind / Africa's Biggest Christian Voices". */
    text-wrap: balance;
    filter: drop-shadow(0 2px 18px color-mix(in srgb, var(--color-scrim) 55%, transparent));
  }

  /* Headline: each word rises out of its own mask, staggered, then a soft light sweep passes over once. */
  .hero-word {
    display: inline-block;
    overflow: hidden;
    /* Room for descenders (g, y) and the apostrophe so the mask never clips them. */
    padding-block: 0.08em 0.14em;
    margin-block: -0.08em -0.14em;
    vertical-align: top;
  }

  .hero-word:not(:last-child) {
    margin-right: 0.24em;
  }

  .hero-word__inner {
    display: inline-block;
    opacity: 0;
    transform: translate3d(0, 110%, 0) rotate(4deg);
    transform-origin: 0 100%;
    filter: blur(6px);
    color: transparent;
    background: linear-gradient(
        100deg,
        var(--color-on-dark) 0%,
        var(--color-on-dark) 40%,
        #bcd7ff 50%,
        var(--color-on-dark) 60%,
        var(--color-on-dark) 100%
      )
      0 0 / 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
  }

  #hero-content.is-visible .hero-word__inner {
    animation:
      hero-word-in 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards,
      hero-word-sheen 1.4s ease-in-out forwards;
    animation-delay:
      calc(0.15s + var(--i) * 0.07s),
      calc(1.5s + var(--i) * 0.06s);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0);
      filter: blur(0);
    }
  }

  @keyframes hero-word-sheen {
    to {
      background-position: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      opacity: 1 !important;
      transition: none !important;
    }

    .hero-word__inner {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      animation: none !important;
    }
  }
</style>

<script
  define:vars={{
    heroVideoUsesCdnFallback: HERO_VIDEO_USES_CDN_FALLBACK,
  }}
>
  const hero = document.querySelector('[data-hero]');
  const heroContent = document.getElementById('hero-content');
  const homePage = document.querySelector('[data-home-page]');
  const video = document.getElementById('hero-video');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const READY_EVENT = 'energize:hero-ready';
  const MAX_WAIT_MS = 4000;
  const SETTLE_MS = 700;
  let readyFired = false;
  let settleTimer = 0;

  // Animate the headline only once its font is in, so words never jump mid-animation (capped wait).
  const headlineFont =
    document.fonts && typeof document.fonts.load === 'function'
      ? Promise.race([
          document.fonts.load('400 1em "Instrument Serif"'),
          new Promise((resolve) => window.setTimeout(resolve, 1200)),
        ]).catch(() => undefined)
      : Promise.resolve();

  const revealHeroCopy = () => {
    headlineFont.then(() => heroContent?.classList.add('is-visible'));
  };

  const markHeroReady = () => {
    if (readyFired) return;
    readyFired = true;
    if (homePage instanceof HTMLElement) homePage.dataset.heroReady = 'true';
    document.documentElement.dataset.heroReady = 'true';
    if (hero instanceof HTMLElement) hero.classList.add('is-settled');
    revealHeroCopy();
    window.dispatchEvent(new CustomEvent(READY_EVENT));
  };

  const onFirstPaint = () => {
    if (hero instanceof HTMLElement) hero.classList.add('is-playing');
    revealHeroCopy();
    // Let the decoder run a few frames before mounting the rest of the page.
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(markHeroReady, SETTLE_MS);
  };

  if (prefersReducedMotion) {
    if (hero instanceof HTMLElement) {
      hero.classList.add('is-playing', 'is-settled');
    }
    markHeroReady();
  }

  if (video instanceof HTMLVideoElement) {
    if (heroVideoUsesCdnFallback) {
      video.addEventListener(
        'error',
        () => {
          if (video.dataset.heroFallback === 'local') return;
          const mp4 = video.dataset.localMp4;
          if (!mp4) return;
          video.dataset.heroFallback = 'local';
          video.removeAttribute('src');
          video.replaceChildren();
          const s = document.createElement('source');
          s.src = mp4;
          s.type = 'video/mp4';
          video.appendChild(s);
          video.load();
          video.play().catch(() => {});
        },
        { once: true },
      );
    }

    // Wait for real frames, not just canplay (which fires before decode is warm).
    const onPlaying = () => {
      if ('requestVideoFrameCallback' in video) {
        video.requestVideoFrameCallback(() => onFirstPaint());
      } else {
        onFirstPaint();
      }
    };

    video.addEventListener('playing', onPlaying, { once: true });
    if (!video.paused && video.readyState >= 2) onPlaying();
    video.play().catch(() => markHeroReady());

    // Pause when the tab is hidden or the hero has scrolled out of view.
    let heroInView = true;
    const syncPlayback = () => {
      if (document.hidden || !heroInView) video.pause();
      else if (!prefersReducedMotion) video.play().catch(() => {});
    };
    document.addEventListener('visibilitychange', syncPlayback);
    if ('IntersectionObserver' in window && hero instanceof HTMLElement) {
      new IntersectionObserver(([entry]) => {
        heroInView = entry.isIntersecting;
        syncPlayback();
      }).observe(hero);
    }
  } else {
    markHeroReady();
  }

  window.setTimeout(markHeroReady, MAX_WAIT_MS);
</script>
