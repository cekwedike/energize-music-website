---
import {
  HERO_VIDEO_MP4,
  HERO_VIDEO_POSTER,
  HERO_VIDEO_SRC,
  HERO_VIDEO_USES_CDN_FALLBACK,
  HERO_VIDEO_WEBM,
} from '../../lib/hero-video';
---

<section class="hero" data-hero style={`--hero-poster: url('${HERO_VIDEO_POSTER}')`}>
  <video
    id="hero-video"
    class="hero-video"
    data-local-mp4={HERO_VIDEO_MP4}
    data-local-webm={HERO_VIDEO_WEBM}
    muted
    loop
    playsinline
    autoplay
    preload="metadata"
    poster={HERO_VIDEO_POSTER}
    aria-hidden="true"
  >
    {
      HERO_VIDEO_USES_CDN_FALLBACK ? (
        <source src={HERO_VIDEO_SRC} />
      ) : (
        <>
          {/* MP4 first: hardware decode on Windows / Safari. */}
          <source src={HERO_VIDEO_MP4} type="video/mp4" />
          <source src={HERO_VIDEO_WEBM} type="video/webm" />
        </>
      )
    }
  </video>

  <div class="hero-veil" aria-hidden="true"></div>

  <div class="hero-content mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <h1 class="hero-title">
      <span class="hero-title__line">The Energy</span>
      <span class="hero-title__line hero-title__line--accent">Is Different.</span>
    </h1>
    <p class="hero-sub">Afro-Gospel. Soul-Fusion. Lagos.</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    display: flex;
    align-items: flex-end;
    /* Sits under the transparent overlay header. */
    margin-top: calc(-1 * var(--header-height, 4rem));
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    isolation: isolate;
    /* Poster paints first, before the video has frames. */
    background: #0a0a0a var(--hero-poster) center bottom / cover no-repeat;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Own compositor layer so decode is not blocked by overlay paints. */
    transform: translateZ(0);
    transition: opacity 0.55s ease;
    background-color: #0a0a0a;
    background-image: var(--hero-poster);
    background-size: cover;
    background-position: center bottom;
  }

  /* Only hide the video until frames are ready when JS can reveal it. */
  :global(.js) .hero-video {
    opacity: 0;
  }

  :global(.js) .hero.is-playing .hero-video {
    opacity: 1;
  }

  /* Flat tint so white text passes contrast on any frame. */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(10, 10, 10, 0.65);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(3rem, 10vh, 7rem);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 1.2rem + 11vw, 11rem);
    font-weight: 400;
    line-height: 0.88;
    text-transform: uppercase;
    color: #ffffff;
  }

  .hero-title__line {
    display: block;
  }

  .hero-title__line--accent {
    color: var(--color-accent);
  }

  .hero-sub {
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.9375rem);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      transition: none;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    heroVideoUsesCdnFallback: HERO_VIDEO_USES_CDN_FALLBACK,
  }}
>
  const hero = document.querySelector('[data-hero]');
  const video = document.getElementById('hero-video');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAX_WAIT_MS = 4000;

  // Fade the video in over the poster once it has real frames (or give up and show it).
  const markHeroReady = () => {
    if (hero instanceof HTMLElement) hero.classList.add('is-playing');
  };

  if (prefersReducedMotion) {
    markHeroReady();
  }

  if (video instanceof HTMLVideoElement) {
    if (heroVideoUsesCdnFallback) {
      video.addEventListener(
        'error',
        () => {
          if (video.dataset.heroFallback === 'local') return;
          const mp4 = video.dataset.localMp4;
          const webm = video.dataset.localWebm;
          if (!mp4 && !webm) return;
          video.dataset.heroFallback = 'local';
          video.removeAttribute('src');
          video.replaceChildren();
          if (mp4) {
            const s = document.createElement('source');
            s.src = mp4;
            s.type = 'video/mp4';
            video.appendChild(s);
          }
          if (webm) {
            const s = document.createElement('source');
            s.src = webm;
            s.type = 'video/webm';
            video.appendChild(s);
          }
          video.load();
          video.play().catch(() => {});
        },
        { once: true },
      );
    }

    // Wait for real frames, not just canplay (which fires before decode is warm).
    const onPlaying = () => {
      if ('requestVideoFrameCallback' in video) {
        video.requestVideoFrameCallback(() => markHeroReady());
      } else {
        markHeroReady();
      }
    };

    video.addEventListener('playing', onPlaying, { once: true });
    if (!video.paused && video.readyState >= 2) onPlaying();
    video.play().catch(() => markHeroReady());

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else if (!prefersReducedMotion) video.play().catch(() => {});
    });
  } else {
    markHeroReady();
  }

  window.setTimeout(markHeroReady, MAX_WAIT_MS);
</script>
