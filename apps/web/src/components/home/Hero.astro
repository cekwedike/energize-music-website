---
import {
  HERO_VIDEO_MP4,
  HERO_VIDEO_POSTER,
  HERO_VIDEO_SRC,
  HERO_VIDEO_USES_CDN_FALLBACK,
  HERO_VIDEO_WEBM,
} from '../../lib/hero-video';
---

<section class="hero theme-dark" data-hero style={`--hero-poster: url('${HERO_VIDEO_POSTER}')`}>
  <video
    id="hero-video"
    class="hero-video"
    data-local-mp4={HERO_VIDEO_MP4}
    data-local-webm={HERO_VIDEO_WEBM}
    muted
    loop
    playsinline
    autoplay
    preload="metadata"
    poster={HERO_VIDEO_POSTER}
    aria-hidden="true"
  >
    {
      HERO_VIDEO_USES_CDN_FALLBACK ? (
        <source src={HERO_VIDEO_SRC} />
      ) : (
        <>
          {/* MP4 first: hardware decode on Windows / Safari. */}
          <source src={HERO_VIDEO_MP4} type="video/mp4" />
          <source src={HERO_VIDEO_WEBM} type="video/webm" />
        </>
      )
    }
  </video>

  <div class="hero-veil" aria-hidden="true"></div>

  <div id="hero-content" class="hero-content">
    <h1 class="hero-text-el hero-text-el-heading font-instrument max-w-[min(100%,20rem)] text-[clamp(1.625rem,1.15rem+4.5vw,6.25rem)] leading-[0.95] tracking-tight text-[var(--color-on-dark)] sm:max-w-2xl md:max-w-4xl">
      The Afro-Gospel Label Behind Africa's Biggest Christian Voices
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    height: 100svh;
    min-height: 36rem;
    margin-top: calc(-1 * var(--header-height, 4rem));
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-bg);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Own compositor layer so decode is not blocked by overlay paints. */
    transform: translateZ(0);
    will-change: opacity;
    opacity: 0;
    transition: opacity 0.55s ease;
    background-color: var(--color-bg);
    background-image: var(--hero-poster);
    background-size: cover;
    background-position: center bottom;
  }

  .hero.is-playing .hero-video {
    opacity: 1;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-scrim) 55%, transparent) 0%, color-mix(in srgb, var(--color-scrim) 45%, transparent) 42%, color-mix(in srgb, var(--color-scrim) 65%, transparent) 100%);
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height, 4rem) + 1.5rem) 1.25rem 3rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .hero-content {
      padding-inline: 1.5rem;
    }
  }

  .hero-text-el {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.1s;
  }

  .hero-text-el-heading {
    transition-delay: 0.2s;
  }

  #hero-content.is-visible .hero-text-el {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      opacity: 1 !important;
      transition: none !important;
    }

    .hero-text-el {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script
  define:vars={{
    heroVideoUsesCdnFallback: HERO_VIDEO_USES_CDN_FALLBACK,
  }}
>
  const hero = document.querySelector('[data-hero]');
  const heroContent = document.getElementById('hero-content');
  const homePage = document.querySelector('[data-home-page]');
  const video = document.getElementById('hero-video');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const READY_EVENT = 'energize:hero-ready';
  const MAX_WAIT_MS = 4000;
  const SETTLE_MS = 700;
  let readyFired = false;
  let settleTimer = 0;

  const revealHeroCopy = () => {
    heroContent?.classList.add('is-visible');
  };

  const markHeroReady = () => {
    if (readyFired) return;
    readyFired = true;
    if (homePage instanceof HTMLElement) homePage.dataset.heroReady = 'true';
    document.documentElement.dataset.heroReady = 'true';
    if (hero instanceof HTMLElement) hero.classList.add('is-settled');
    revealHeroCopy();
    window.dispatchEvent(new CustomEvent(READY_EVENT));
  };

  const onFirstPaint = () => {
    if (hero instanceof HTMLElement) hero.classList.add('is-playing');
    revealHeroCopy();
    // Let the decoder run a few frames before mounting the rest of the page.
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(markHeroReady, SETTLE_MS);
  };

  if (prefersReducedMotion) {
    if (hero instanceof HTMLElement) {
      hero.classList.add('is-playing', 'is-settled');
    }
    markHeroReady();
  }

  if (video instanceof HTMLVideoElement) {
    if (heroVideoUsesCdnFallback) {
      video.addEventListener(
        'error',
        () => {
          if (video.dataset.heroFallback === 'local') return;
          const mp4 = video.dataset.localMp4;
          const webm = video.dataset.localWebm;
          if (!mp4 && !webm) return;
          video.dataset.heroFallback = 'local';
          video.removeAttribute('src');
          video.replaceChildren();
          if (mp4) {
            const s = document.createElement('source');
            s.src = mp4;
            s.type = 'video/mp4';
            video.appendChild(s);
          }
          if (webm) {
            const s = document.createElement('source');
            s.src = webm;
            s.type = 'video/webm';
            video.appendChild(s);
          }
          video.load();
          video.play().catch(() => {});
        },
        { once: true },
      );
    }

    // Wait for real frames, not just canplay (which fires before decode is warm).
    const onPlaying = () => {
      if ('requestVideoFrameCallback' in video) {
        video.requestVideoFrameCallback(() => onFirstPaint());
      } else {
        onFirstPaint();
      }
    };

    video.addEventListener('playing', onPlaying, { once: true });
    if (!video.paused && video.readyState >= 2) onPlaying();
    video.play().catch(() => markHeroReady());

    // Pause when the tab is hidden or the hero has scrolled out of view.
    let heroInView = true;
    const syncPlayback = () => {
      if (document.hidden || !heroInView) video.pause();
      else if (!prefersReducedMotion) video.play().catch(() => {});
    };
    document.addEventListener('visibilitychange', syncPlayback);
    if ('IntersectionObserver' in window && hero instanceof HTMLElement) {
      new IntersectionObserver(([entry]) => {
        heroInView = entry.isIntersecting;
        syncPlayback();
      }).observe(hero);
    }
  } else {
    markHeroReady();
  }

  window.setTimeout(markHeroReady, MAX_WAIT_MS);
</script>
