---
import Logo from '../ui/Logo.astro';
import { HERO_VIDEO_POSTER, HERO_VIDEO_SRC } from '../../lib/hero-video';

const videoAttrs = {
  autoplay: true,
  muted: true,
  loop: true,
  playsinline: true,
  preload: 'metadata' as const,
  poster: HERO_VIDEO_POSTER,
};
---

<section class="relative h-screen w-full overflow-hidden">
  <video
    id="hero-video-a"
    class="fixed inset-0 -z-10 h-screen w-full object-cover"
    style="transform-origin: 50% 100%; backface-visibility: hidden;"
    src={HERO_VIDEO_SRC}
    {...videoAttrs}
  />
  <video
    id="hero-video-b"
    class="fixed inset-0 -z-10 h-screen w-full object-cover opacity-0"
    style="transform-origin: 50% 100%; backface-visibility: hidden;"
    src={HERO_VIDEO_SRC}
    {...videoAttrs}
  />
  <div class="absolute inset-0 bg-black/20"></div>

  <div id="hero-content" class="absolute inset-0 flex flex-col items-center px-5 pt-24 text-center sm:px-6 sm:pt-32 md:pt-36">
    <Logo />
    <p class="hero-text-el font-inter mt-5 text-[11px] font-semibold uppercase tracking-[0.35em] text-white/60 sm:mt-6 sm:text-xs">
      The Energy Different
    </p>
    <h1 class="hero-text-el hero-text-el-heading font-instrument text-glow-pulse mt-5 max-w-[min(100%,20rem)] text-[clamp(1.625rem,1.15rem+4.5vw,6.25rem)] leading-[0.95] tracking-tight text-white sm:mt-8 sm:max-w-2xl md:mt-9 md:max-w-4xl">
      Rooted In Lagos. Reaching The World.
    </h1>
    <p class="hero-text-el hero-text-el-sub font-inter mt-4 max-w-xl text-sm text-white/70 sm:mt-5 md:mt-7 md:text-base">
      Afro-gospel and soul-fusion music, carried from Lagos to every corner of the earth.
    </p>
  </div>
</section>

<style>
  .hero-text-el {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 2.9s;
  }

  .hero-text-el-heading {
    transition-delay: 3.05s;
  }

  .hero-text-el-sub {
    transition-delay: 3.2s;
  }

  #hero-content.is-visible .hero-text-el {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text-el {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const heroContent = document.getElementById('hero-content');
  const prefersReducedMotionText = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroContent) {
    if (prefersReducedMotionText) {
      heroContent.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          heroContent.classList.add('is-visible');
        });
      });
    }
  }
</script>

<script>
  const videoA = document.getElementById('hero-video-a') as HTMLVideoElement | null;
  const videoB = document.getElementById('hero-video-b') as HTMLVideoElement | null;

  if (videoA && videoB) {
    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
    const lerp = (current: number, target: number, factor: number) => current + (target - current) * factor;
    const FADE_WINDOW = 0.8; // seconds of crossfade around each loop point

    let offsetApplied = false;
    videoB.addEventListener('loadedmetadata', () => {
      if (!offsetApplied && videoB.duration) {
        videoB.currentTime = videoB.duration / 2;
        offsetApplied = true;
      }
    });

    videoA.style.opacity = '1';
    videoB.style.opacity = '0';

    // translateZ(0) promotes each video to its own GPU layer for smoother scaling.
    const startScale = 1.001;
    const endScale = 1.12;
    let scale = startScale;
    let rafId = 0;

    const applyTransform = (value: number) => {
      const transform = `translateZ(0) scale(${value})`;
      videoA.style.transform = transform;
      videoB.style.transform = transform;
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const tick = () => {
      if (!prefersReducedMotion) {
        const scrollRange = window.innerHeight * 1.4;
        const progress = clamp01(window.scrollY / scrollRange);
        const targetScale = startScale + (endScale - startScale) * progress;
        scale = lerp(scale, targetScale, 0.06);
        applyTransform(scale);
      }

      if (videoA.duration && videoB.duration) {
        const remainingA = videoA.duration - videoA.currentTime;
        const remainingB = videoB.duration - videoB.currentTime;

        if (remainingA >= 0 && remainingA < FADE_WINDOW) {
          const t = clamp01(1 - remainingA / FADE_WINDOW);
          videoA.style.opacity = String(1 - t);
          videoB.style.opacity = String(t);
        } else if (remainingB >= 0 && remainingB < FADE_WINDOW) {
          const t = clamp01(1 - remainingB / FADE_WINDOW);
          videoB.style.opacity = String(1 - t);
          videoA.style.opacity = String(t);
        }
      }

      rafId = requestAnimationFrame(tick);
    };

    if (prefersReducedMotion) {
      applyTransform(startScale);
    }

    rafId = requestAnimationFrame(tick);
    window.addEventListener('pagehide', () => cancelAnimationFrame(rafId));

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else {
        rafId = requestAnimationFrame(tick);
      }
    });
  }
</script>
