---
import Logo from '../ui/Logo.astro';
import {
  HERO_VIDEO_LOCAL,
  HERO_VIDEO_POSTER,
  HERO_VIDEO_SRC,
  HERO_VIDEO_USES_CDN_FALLBACK,
} from '../../lib/hero-video';

const freqBars = Array.from({ length: 18 }, (_, i) => i);
---

<section class="hero" data-hero style={`--hero-poster: url('${HERO_VIDEO_POSTER}')`}>
  {/* src is set after first paint so the poster can be LCP without competing with the video. */}
  <video
    id="hero-video"
    class="hero-video"
    style="transform-origin: 50% 100%; backface-visibility: hidden;"
    data-src={HERO_VIDEO_SRC}
    muted
    loop
    playsinline
    preload="none"
    poster={HERO_VIDEO_POSTER}
    aria-hidden="true"
  />

  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-glow" data-hero-glow aria-hidden="true"></div>
  <div class="hero-noise" aria-hidden="true"></div>

  <p class="hero-watermark" data-hero-parallax data-parallax-depth="18" aria-hidden="true">ENERGY</p>

  <div class="hero-rail hero-rail--left" aria-hidden="true">
    <span>Lagos</span>
    <span class="hero-rail__dot"></span>
    <span>Afro-gospel</span>
    <span class="hero-rail__dot"></span>
    <span>Soul-fusion</span>
  </div>
  <div class="hero-rail hero-rail--right" aria-hidden="true">
    <span>Global</span>
    <span class="hero-rail__dot"></span>
    <span>Family-friendly</span>
    <span class="hero-rail__dot"></span>
    <span>Uplifting</span>
  </div>

  <div class="hero-frame" aria-hidden="true">
    <span class="hero-frame__corner hero-frame__corner--tl"></span>
    <span class="hero-frame__corner hero-frame__corner--tr"></span>
    <span class="hero-frame__corner hero-frame__corner--bl"></span>
    <span class="hero-frame__corner hero-frame__corner--br"></span>
  </div>

  <div id="hero-content" class="hero-content" data-hero-parallax data-parallax-depth="8">
    <Logo />
    <p class="hero-text-el font-inter mt-5 text-[11px] font-semibold uppercase tracking-[0.35em] text-white sm:mt-6 sm:text-xs">
      The Energy Different
    </p>
    <h1 class="hero-text-el hero-text-el-heading font-instrument text-glow-pulse mt-5 max-w-[min(100%,20rem)] text-[clamp(1.625rem,1.15rem+4.5vw,6.25rem)] leading-[0.95] tracking-tight text-white sm:mt-8 sm:max-w-2xl md:mt-9 md:max-w-4xl">
      Rooted In Lagos. Reaching The World.
    </h1>
    <p class="hero-text-el hero-text-el-sub font-inter mt-4 max-w-xl text-sm text-white sm:mt-5 md:mt-7 md:text-base">
      Afro-gospel and soul-fusion music, carried from Lagos to every corner of the earth.
    </p>

    <div class="hero-text-el hero-text-el-actions mt-7 flex flex-col items-stretch gap-3 sm:mt-9 sm:flex-row sm:items-center sm:justify-center sm:gap-4">
      <a
        href="/artists"
        class="hero-cta hero-cta--primary inline-flex min-h-12 items-center justify-center px-6 text-sm font-semibold text-[#041018] transition"
      >
        Meet The Roster
      </a>
      <a
        href="/releases"
        class="hero-cta hero-cta--ghost inline-flex min-h-12 items-center justify-center border border-white/40 px-6 text-sm font-semibold text-white transition"
      >
        Listen Now
      </a>
    </div>
  </div>

  <div class="hero-signal" aria-hidden="true">
    <div class="hero-signal__bars">
      {
        freqBars.map((i) => (
          <span class="hero-signal__bar" style={`--bar-i: ${i}`}></span>
        ))
      }
    </div>
  </div>

  <a
    href="#now-spinning"
    class="hero-scroll"
    aria-label="Scroll to Now Spinning"
  >
    <span>Scroll</span>
    <span class="hero-scroll__line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0;
    height: 100svh;
    min-height: 36rem;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #04080c;
    background-image: var(--hero-poster);
    background-size: cover;
    background-position: center bottom;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 70% 55% at 50% 28%, rgba(77, 168, 255, 0.16), transparent 60%),
      linear-gradient(180deg, rgba(4, 8, 12, 0.35) 0%, rgba(4, 8, 12, 0.12) 42%, rgba(4, 8, 12, 0.55) 100%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: 18%;
    left: 50%;
    z-index: 1;
    width: min(70vw, 28rem);
    height: min(70vw, 28rem);
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(77, 168, 255, 0.28), transparent 68%);
    filter: blur(28px);
    opacity: 0.55;
    pointer-events: none;
    animation: hero-glow-breathe 5.5s ease-in-out infinite;
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.12;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .hero-watermark {
    position: absolute;
    top: 46%;
    left: 50%;
    z-index: 2;
    margin: 0;
    translate: -50% -50%;
    font-family: var(--font-display);
    font-size: clamp(5rem, 22vw, 16rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.14);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    animation: hero-watermark-drift 14s ease-in-out infinite;
  }

  .hero-rail {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #ffffff;
    white-space: nowrap;
    pointer-events: none;
  }

  .hero-rail--left {
    left: 1.25rem;
    rotate: -90deg;
    transform-origin: left center;
  }

  .hero-rail--right {
    right: 1.25rem;
    rotate: 90deg;
    transform-origin: right center;
  }

  .hero-rail__dot {
    width: 0.28rem;
    height: 0.28rem;
    background: var(--color-glow);
    box-shadow: 0 0 10px rgba(77, 168, 255, 0.8);
  }

  @media (min-width: 1100px) {
    .hero-rail {
      display: flex;
    }
  }

  .hero-frame {
    position: absolute;
    inset: 1.1rem;
    z-index: 3;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero-frame {
      inset: 1.5rem;
    }
  }

  .hero-frame__corner {
    position: absolute;
    width: 1.75rem;
    height: 1.75rem;
    border-color: rgba(77, 168, 255, 0.55);
    border-style: solid;
    opacity: 0;
    animation: hero-corner-in 0.9s ease forwards;
    animation-delay: 2.6s;
  }

  .hero-frame__corner--tl {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }

  .hero-frame__corner--tr {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
  }

  .hero-frame__corner--bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
  }

  .hero-frame__corner--br {
    right: 0;
    bottom: 0;
    border-width: 0 1px 1px 0;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6rem 1.25rem 7.5rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .hero-content {
      padding: 8rem 1.5rem 8rem;
    }
  }

  @media (min-width: 768px) {
    .hero-content {
      padding-top: 9rem;
    }
  }

  .hero-text-el {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 2.9s;
  }

  .hero-text-el-heading {
    transition-delay: 3.05s;
  }

  .hero-text-el-sub {
    transition-delay: 3.2s;
  }

  .hero-text-el-actions {
    transition-delay: 3.35s;
  }

  #hero-content.is-visible .hero-text-el {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-cta--primary {
    background: var(--color-glow);
    box-shadow: 0 12px 36px rgba(77, 168, 255, 0.35);
  }

  .hero-cta--primary:hover {
    background: color-mix(in srgb, var(--color-glow) 88%, white);
    transform: translateY(-1px);
  }

  .hero-cta--ghost {
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
  }

  .hero-cta--ghost:hover {
    border-color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-signal {
    position: absolute;
    bottom: 4.75rem;
    left: 50%;
    z-index: 4;
    translate: -50% 0;
    width: min(16rem, 70vw);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease;
    transition-delay: 3.4s;
  }

  #hero-content.is-visible ~ .hero-signal {
    opacity: 0.85;
  }

  .hero-signal__bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.22rem;
    height: 1.75rem;
  }

  .hero-signal__bar {
    width: 0.18rem;
    height: 20%;
    background: linear-gradient(180deg, var(--color-glow), rgba(255, 255, 255, 0.35));
    transform-origin: bottom center;
    animation: hero-freq 1.1s ease-in-out infinite;
    animation-delay: calc(var(--bar-i) * 0.07s);
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.15rem;
    left: 50%;
    z-index: 5;
    display: flex;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease,
      color 0.2s ease;
    transition-delay: 3.55s;
  }

  #hero-content.is-visible ~ .hero-scroll {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-scroll:hover {
    color: #fff;
  }

  .hero-scroll__line {
    display: block;
    width: 1px;
    height: 1.6rem;
    background: linear-gradient(180deg, var(--color-glow), transparent);
    transform-origin: top center;
    animation: hero-scroll-pulse 1.8s ease-in-out infinite;
  }

  @keyframes hero-glow-breathe {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }

  @keyframes hero-watermark-drift {
    0%,
    100% {
      letter-spacing: -0.06em;
      opacity: 0.75;
    }
    50% {
      letter-spacing: -0.02em;
      opacity: 1;
    }
  }

  @keyframes hero-corner-in {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes hero-freq {
    0%,
    100% {
      height: 18%;
      opacity: 0.45;
    }
    50% {
      height: calc(35% + (var(--bar-i) % 5) * 12%);
      opacity: 1;
    }
  }

  @keyframes hero-scroll-pulse {
    0%,
    100% {
      transform: scaleY(0.55);
      opacity: 0.45;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text-el,
    .hero-scroll,
    .hero-signal,
    .hero-frame__corner {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }

    .hero-glow,
    .hero-watermark,
    .hero-signal__bar,
    .hero-scroll__line {
      animation: none !important;
    }
  }
</style>

<script>
  const heroContent = document.getElementById('hero-content');
  const hero = document.querySelector('[data-hero]');
  const prefersReducedMotionText = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroContent) {
    if (prefersReducedMotionText) {
      heroContent.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          heroContent.classList.add('is-visible');
        });
      });
    }
  }

  if (hero instanceof HTMLElement && !prefersReducedMotionText && window.matchMedia('(pointer: fine)').matches) {
    const layers = Array.from(hero.querySelectorAll('[data-hero-parallax]')).filter(
      (node): node is HTMLElement => node instanceof HTMLElement,
    );
    let raf = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let active = false;

    const tickParallax = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      for (const layer of layers) {
        const depth = Number(layer.dataset.parallaxDepth || 6);
        layer.style.transform = `translate3d(${currentX * depth}px, ${currentY * depth}px, 0)`;
      }
      const settled = Math.abs(targetX - currentX) < 0.001 && Math.abs(targetY - currentY) < 0.001;
      if (settled && !active) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(tickParallax);
    };

    const ensureTick = () => {
      if (!raf) raf = requestAnimationFrame(tickParallax);
    };

    const onPointerMove = (event: Event) => {
      if (!(event instanceof PointerEvent)) return;
      const rect = hero.getBoundingClientRect();
      targetX = (event.clientX - rect.left) / rect.width - 0.5;
      targetY = (event.clientY - rect.top) / rect.height - 0.5;
      active = true;
      ensureTick();
    };

    hero.addEventListener('pointermove', onPointerMove);
    hero.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
      active = false;
      ensureTick();
    });

    window.addEventListener('pagehide', () => {
      if (raf) cancelAnimationFrame(raf);
    });
  }
</script>

<script
  define:vars={{
    heroVideoLocal: HERO_VIDEO_LOCAL,
    heroVideoUsesCdnFallback: HERO_VIDEO_USES_CDN_FALLBACK,
  }}
>
  const video = document.getElementById('hero-video');

  if (video instanceof HTMLVideoElement) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = navigator.connection?.saveData === true;
    const slowNet = ['slow-2g', '2g'].includes(navigator.connection?.effectiveType || '');

    if (heroVideoUsesCdnFallback) {
      video.addEventListener(
        'error',
        () => {
          if (video.dataset.heroFallback === 'local') return;
          video.dataset.heroFallback = 'local';
          video.src = heroVideoLocal;
          video.load();
        },
        { once: true },
      );
    }

    const startPlayback = () => {
      if (video.dataset.heroStarted === '1') return;
      const src = video.dataset.src;
      if (!src) return;
      video.dataset.heroStarted = '1';
      video.src = src;
      video.preload = 'metadata';
      video.load();
      video.play().catch(() => {});
    };

    // Skip video on reduced motion / constrained networks; poster stays as background.
    if (!prefersReducedMotion && !saveData && !slowNet) {
      const schedule = () => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(startPlayback, { timeout: 2800 });
        } else {
          window.setTimeout(startPlayback, 1200);
        }
      };
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    }

    const clamp01 = (value) => Math.min(1, Math.max(0, value));
    const startScale = 1.001;
    const endScale = 1.12;
    let rafId = 0;

    const applyScrollScale = () => {
      rafId = 0;
      const scrollRange = window.innerHeight * 1.4;
      const progress = clamp01(window.scrollY / scrollRange);
      const scale = startScale + (endScale - startScale) * progress;
      video.style.transform = `translateZ(0) scale(${scale})`;
    };

    const onScroll = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(applyScrollScale);
    };

    if (!prefersReducedMotion) {
      applyScrollScale();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('pagehide', () => {
        window.removeEventListener('scroll', onScroll);
        if (rafId) cancelAnimationFrame(rafId);
      });
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else if (video.dataset.heroStarted === '1' && !prefersReducedMotion) {
        video.play().catch(() => {});
      }
    });
  }
</script>
