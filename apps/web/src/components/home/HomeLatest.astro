---
import type { EnrichedRelease } from '@energize/shared';
import ReleaseFeature from '../releases/ReleaseFeature.astro';

interface Props {
  release: EnrichedRelease;
}

const { release } = Astro.props;
---

<section class="home-latest">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <ReleaseFeature release={release} eyebrow="Latest project" />
  </div>
</section>

<style>
  .home-latest {
    padding-block: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--color-line);
  }
</style>
