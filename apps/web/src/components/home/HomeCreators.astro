---
import { sanityClient, urlForImage } from '../../lib/sanity/client';
import { allCreatorsQuery, type Creator } from '@energize/shared';

const creators = await sanityClient.fetch<Creator[]>(allCreatorsQuery);
---

{
  creators.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
      <h2 class="text-h2">Producers &amp; writers</h2>
      <div class="mt-8 flex flex-wrap gap-6">
        {creators.map((creator) => (
          <div class="flex items-center gap-3">
            {creator.photo?.asset && (
              <img
                src={urlForImage(creator.photo).width(96).height(96).fit('crop').auto('format').url()}
                alt={creator.photo.alt ?? creator.name}
                class="h-12 w-12 rounded-full object-cover"
              />
            )}
            <div>
              <p class="text-sm font-medium text-paper">{creator.name}</p>
              {creator.credits && <p class="text-xs text-paper/50">{creator.credits}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
