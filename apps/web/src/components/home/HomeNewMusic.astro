---
import ReleaseCard from '../releases/ReleaseCard.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allReleasesQuery, type Release } from '@energize/shared';

const releases = (await sanityClient.fetch<Release[]>(allReleasesQuery)).slice(0, 8);
---

{
  releases.length > 0 && (
    <section id="new-music" class="border-y border-white/10 bg-[var(--color-ink-raised)] py-16 sm:py-24">
      <div class="mx-auto flex max-w-6xl items-end justify-between gap-4 px-6">
        <h2 class="text-h2">New music</h2>
        <a href="/releases" class="shrink-0 text-sm font-semibold text-[var(--color-gold)] hover:underline">
          View all &rarr;
        </a>
      </div>
      <div
        id="new-music-track"
        class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 sm:pl-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] sm:pr-6"
      >
        {releases.map((release) => (
          <div class="w-[220px] shrink-0 snap-start sm:w-[260px]">
            <ReleaseCard release={release} />
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  const section = document.getElementById('new-music');
  const track = document.getElementById('new-music-track');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDesktopWidth = window.matchMedia('(min-width: 640px)').matches;

  if (section && track && !prefersReducedMotion && isDesktopWidth) {
    import('../../lib/motion/horizontalScroll').then(({ initHorizontalScroll }) => {
      // Re-check width in case the viewport changed while the module loaded.
      if (!window.matchMedia('(min-width: 640px)').matches) return;
      track.classList.remove('overflow-x-auto', 'snap-x', 'snap-mandatory');
      section.classList.add('overflow-hidden');
      initHorizontalScroll(section, track);
    });
  }
</script>
