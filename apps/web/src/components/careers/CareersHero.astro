---
interface Props {
  heroImageSrc?: string;
}

const { heroImageSrc = '/initiatives/energize-fest.webp' } = Astro.props;
---

<section class="careers-hero" aria-labelledby="careers-hero-title">
  <div class="careers-hero__bg" aria-hidden="true">
    <img src={heroImageSrc} alt="" class="careers-hero__bg-img" width="1800" height="900" loading="eager" decoding="async" />
  </div>
  <div class="careers-hero__overlay" aria-hidden="true"></div>
  <div class="careers-hero__mesh" aria-hidden="true"></div>
  <div class="careers-hero__grid" aria-hidden="true"></div>
  <div class="careers-hero__grain" aria-hidden="true"></div>

  <div class="careers-hero__inner">
    <div class="careers-hero__copy scroll-reveal">
      <h1 id="careers-hero-title" class="careers-hero__title font-display">
        Join Energize Music and help shape uplifting music culture
      </h1>

      <div class="careers-hero__actions">
        <a href="#open-roles" class="careers-hero__cta careers-hero__cta--primary">
          See Open Roles
          <svg class="careers-hero__cta-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M7.5 5l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href="#volunteer" class="careers-hero__contact">
          <span class="careers-hero__contact-dot" aria-hidden="true"></span>
          Volunteer With Us
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .careers-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(22rem, 48vh, 30rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .careers-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .careers-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(1) contrast(1.08) brightness(0.72);
  }

  .careers-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 11, 13, 0.94) 0%,
      rgba(11, 11, 13, 0.82) 38%,
      rgba(11, 11, 13, 0.62) 62%,
      var(--color-ink-raised) 100%
    );
    pointer-events: none;
  }

  .careers-hero__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(77, 168, 255, 0.12), transparent 62%),
      radial-gradient(ellipse 45% 40% at 90% 80%, rgba(103, 232, 249, 0.05), transparent 55%);
    pointer-events: none;
  }

  .careers-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 20%, transparent 75%);
    pointer-events: none;
  }

  .careers-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .careers-hero__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 72rem);
    margin-inline: auto;
    padding: 7.5rem 1.25rem 4.5rem;
    display: flex;
    align-items: center;
    min-height: inherit;
  }

  @media (min-width: 640px) {
    .careers-hero__inner {
      padding-top: 8.5rem;
      padding-bottom: 5.5rem;
    }
  }

  .careers-hero__copy {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .careers-hero__title {
    font-size: clamp(2rem, 1.35rem + 2.8vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-paper);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .careers-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.25rem;
    margin-top: 2rem;
  }

  .careers-hero__cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
    border-radius: 9999px;
    padding: 0.65rem 1.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .careers-hero__cta--primary {
    background: var(--color-glow);
    color: white;
  }

  .careers-hero__cta--primary:hover {
    background: color-mix(in srgb, var(--color-glow) 90%, white);
    transform: translateY(-1px);
  }

  .careers-hero__cta-icon {
    width: 1rem;
    height: 1rem;
  }

  .careers-hero__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-paper);
    transition: color 0.2s ease;
  }

  .careers-hero__contact:hover {
    color: var(--color-paper);
  }

  .careers-hero__contact-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: var(--color-glow-cyan);
    box-shadow: 0 0 12px rgba(103, 232, 249, 0.55);
  }
</style>
