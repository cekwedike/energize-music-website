---
---

<div id="next-music-player" class="next-music-player" aria-label="Music player" role="region">
  <div id="next-music-tooltip" class="next-music-tooltip" aria-hidden="true">Feel The ENERGY</div>
  <button
    id="next-music-btn"
    type="button"
    class="next-music-btn"
    aria-label="Play background music"
    aria-pressed="false"
  >
    <svg id="next-music-icon-play" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 18V5l12-2v13"/>
      <circle cx="6" cy="18" r="3"/>
      <circle cx="18" cy="16" r="3"/>
    </svg>
    <svg id="next-music-icon-pause" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="6" y="4" width="4" height="16"/>
      <rect x="14" y="4" width="4" height="16"/>
    </svg>
  </button>
  <div id="next-music-info" class="next-music-info" aria-hidden="true">
    <span id="next-music-track-name">Afrogospel Vibes</span>
    <div class="next-music-progress-wrap"><div id="next-music-progress-bar" class="next-music-progress-bar"></div></div>
  </div>
  <audio id="next-music-audio" preload="metadata" loop></audio>
</div>

<style>
  .next-music-player {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .next-music-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(16px);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s, border-color 0.25s;
    flex-shrink: 0;
  }

  .next-music-btn:hover {
    background: rgba(77, 168, 255, 0.18);
    border-color: rgba(77, 168, 255, 0.5);
  }

  .next-music-btn[aria-pressed='true'] {
    background: rgba(77, 168, 255, 0.22);
    border-color: var(--color-glow);
  }

  .next-music-tooltip {
    position: absolute;
    bottom: 62px;
    right: 0;
    background: rgba(11, 11, 13, 0.92);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }

  .next-music-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .next-music-info {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    border-radius: 12px;
    padding: 8px 14px;
    min-width: 160px;
    display: none;
  }

  .next-music-info.visible {
    display: block;
  }

  #next-music-track-name {
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    display: block;
    margin-bottom: 6px;
  }

  .next-music-progress-wrap {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
  }

  .next-music-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-glow);
    border-radius: 2px;
    transition: width 0.5s linear;
  }

  @media (max-width: 640px) {
    .next-music-player {
      bottom: 16px;
      right: 16px;
    }

    .next-music-info {
      min-width: 0;
      max-width: calc(100vw - 88px);
    }

    #next-music-track-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

<script is:inline>
  (function () {
    var tracks = [
      { src: '/next/music/all-the-praise.mp3', name: 'Greatman Takit - All The Praise' },
      { src: '/next/music/tinbake.mp3', name: 'Limoblaze - Tinbake' },
    ];

    var btn = document.getElementById('next-music-btn');
    var audio = document.getElementById('next-music-audio');
    var tooltip = document.getElementById('next-music-tooltip');
    var info = document.getElementById('next-music-info');
    var bar = document.getElementById('next-music-progress-bar');
    var nameEl = document.getElementById('next-music-track-name');
    var iconPlay = document.getElementById('next-music-icon-play');
    var iconPause = document.getElementById('next-music-icon-pause');
    if (!btn || !audio) return;

    var trackLoaded = false;
    var playPending = false;

    function pickRandomTrack() {
      var track = tracks[Math.floor(Math.random() * tracks.length)];
      audio.src = track.src;
      if (nameEl) nameEl.textContent = track.name;
      audio.load();
    }

    setTimeout(function () {
      if (!trackLoaded) {
        pickRandomTrack();
        trackLoaded = true;
      }
    }, 2000);

    var tooltipTimer = setTimeout(function () {
      if (tooltip) {
        tooltip.classList.add('visible');
        setTimeout(function () { tooltip.classList.remove('visible'); }, 6000);
      }
    }, 2500);

    btn.addEventListener('click', function () {
      clearTimeout(tooltipTimer);
      if (tooltip) tooltip.classList.remove('visible');
      if (playPending) return;

      if (audio.paused) {
        if (!trackLoaded) {
          pickRandomTrack();
          trackLoaded = true;
        }
        playPending = true;
        var playPromise = audio.play();
        if (playPromise !== undefined) {
          playPromise
            .then(function () {
              playPending = false;
              btn.setAttribute('aria-pressed', 'true');
              btn.setAttribute('aria-label', 'Pause background music');
              if (iconPlay) iconPlay.classList.add('hidden');
              if (iconPause) iconPause.classList.remove('hidden');
              if (info) {
                info.setAttribute('aria-hidden', 'false');
                info.classList.add('visible');
              }
            })
            .catch(function () {
              playPending = false;
            });
        }
      } else {
        audio.pause();
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', 'Play background music');
        if (iconPlay) iconPlay.classList.remove('hidden');
        if (iconPause) iconPause.classList.add('hidden');
      }
    });

    audio.addEventListener('timeupdate', function () {
      if (audio.duration && bar) {
        bar.style.width = (audio.currentTime / audio.duration * 100) + '%';
      }
    });
  })();
</script>
