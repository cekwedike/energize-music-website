---
import type { EventDetail } from '@energize/shared';
import PortableText from '../portable/PortableText.astro';
import EventHero from './EventHero.astro';
import EventPoster from './EventPoster.astro';
import EventShare from './EventShare.astro';
import DuotoneFilter from './DuotoneFilter.astro';
import SubscribeDialog from '../forms/SubscribeDialog.astro';
import { getEventCoverUrl } from '../../lib/events/media';
import { eventDateParts, formatEventLocation, isPastEvent, lineupDisplayName } from '../../lib/events/format';
import { imageAlt } from '../../lib/seo/site';
import { titleCase } from '../../lib/text/titleCase';
import '../../styles/events.css';
import '../../styles/event-page.css';

interface Props {
  event: EventDetail;
  shareUrl: string;
  /** Other upcoming events, shown at the foot of the page. */
  others?: EventDetail[];
}

const { event, shareUrl, others = [] } = Astro.props;
const { title, ticketUrl } = event;
const isPast = isPastEvent(event.startDate, event.endDate);
const date = eventDateParts(event.startDate);
const host = event.host?.trim();
const ticketLabel = event.ctaLabel || 'Get tickets';
const offerAlerts = !ticketUrl && !host && !isPast;
const hasAction = !isPast && Boolean(ticketUrl || offerAlerts);
const alerts = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get ticket alerts',
  'data-subscribe-lead': `Hear first when ${title} tickets go on sale.`,
};
const highlights = (event.highlights ?? []).filter((item) => item?.title && item?.body);
const body = event.body?.length ? event.body : null;
// Every act gets the same card, in the order set in the Studio.
const acts = (event.lineup ?? []).filter(Boolean).map((slot) => {
  const revealed = !slot.revealState || slot.revealState === 'confirmed';
  const photo = revealed ? (slot.photo?.asset ? slot.photo : slot.artistPhoto) : undefined;
  const name = lineupDisplayName(slot.revealState, slot.name);
  return {
    name,
    role: slot.role ? titleCase(slot.role) : undefined,
    href: revealed && slot.artistSlug ? `/artists/${slot.artistSlug}` : undefined,
    photoUrl: getEventCoverUrl(photo, 640, 800),
    photoAlt: imageAlt(photo?.alt, name),
    initials: name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase(),
  };
});
/** Up to this many acts sit in one row; longer lineups become a sideways rail. */
const ROW_MAX = 6;
const asRail = acts.length > ROW_MAX;
const moreEvents = others.map((other) => ({
  event: other,
  href: `/events/${other.slug}`,
  date: eventDateParts(other.startDate),
  venue: formatEventLocation(other.location),
}));
const shortDate = `${date.weekday.slice(0, 3)} ${date.day} ${date.monthShort}, ${date.time}`;
---

<article class="event-world ev" data-ev>
  <EventHero event={event} />

  {(event.summary || body) && (
    <section class="event-shell ev-story" aria-labelledby="ev-story-title">
      <h2 id="ev-story-title" class="ev-heading scroll-reveal">About the event</h2>
      {event.summary && (
        <p class="ev-story__lead scroll-reveal" style="--reveal-delay: 100ms">{event.summary}</p>
      )}
      {body && <div class="ev-story__body scroll-reveal" style="--reveal-delay: 180ms"><PortableText value={body} /></div>}
    </section>
  )}

  {acts.length > 0 && (
    <section
      class:list={['ev-lineup', asRail && 'ev-lineup--rail']}
      aria-labelledby="ev-lineup-title"
      data-ev-lineup={asRail ? 'rail' : 'row'}
    >
      <div class="event-shell ev-lineup__head">
        <h2 id="ev-lineup-title" class="ev-heading scroll-reveal">Lineup</h2>
        {asRail && <p class="ev-lineup__hint">{acts.length} artists. Scroll to see everyone.</p>}
      </div>
      <div class="ev-lineup__viewport" data-ev-rail-viewport>
        <ul class="ev-acts" style={`--count: ${acts.length}`} data-ev-rail-track>
          {acts.map((act, i) => {
            const Tag = act.href ? 'a' : 'div';
            return (
              <li class="ev-acts__item">
                <Tag class="ev-act" href={act.href}>
                  <span class="ev-act__photo reveal-image" style={`--reveal-delay: ${Math.min(i, 6) * 70}ms`}>
                    {act.photoUrl ? (
                      <img src={act.photoUrl} alt={act.photoAlt} width="640" height="800" loading="lazy" decoding="async" />
                    ) : (
                      <span class="ev-act__blank" aria-hidden="true">{act.initials}</span>
                    )}
                  </span>
                  <span class="ev-act__copy">
                    <span class="ev-act__name">{act.name}</span>
                    {act.role && <span class="ev-act__role">{act.role}</span>}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {highlights.length > 0 && (
    <section class="event-shell ev-notes" aria-labelledby="ev-notes-title">
      <h2 id="ev-notes-title" class="ev-heading scroll-reveal">Good to know</h2>
      <ul class="scroll-reveal-stagger">{highlights.map((item) => <li><h3>{titleCase(item.title)}</h3><p>{item.body}</p></li>)}</ul>
    </section>
  )}

  {moreEvents.length > 0 && (
    <section class="event-shell ev-more" aria-labelledby="ev-more-title">
      <h2 id="ev-more-title" class="ev-heading scroll-reveal">More events</h2>
      <ul class="ev-more__list scroll-reveal-stagger">
        {moreEvents.map((item) => (
          <li>
            <a class="ev-more__card" href={item.href}>
              <span class="ev-more__poster">
                <EventPoster cover={item.event.cover} title={item.event.title} width={420} />
              </span>
              <span class="ev-more__date">{item.date.weekday.slice(0, 3)} {item.date.day} {item.date.monthShort}, {item.date.time}</span>
              <span class="ev-more__title">{item.event.title}</span>
              <span class="ev-more__venue">{item.venue}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <footer class="ev-close theme-dark" data-ev-close data-evh>
    <div class="evh__photo" aria-hidden="true">
      <img src="/next/gaise.webp" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="evh__veil" aria-hidden="true"></div>
    <div class="event-shell ev-close__inner">
      <h2 class="ev-close__title">{isPast ? 'Catch the next one.' : 'Meet us there.'}</h2>
      <p class="ev-close__when">{date.weekday} {date.day} {date.month}, {date.time}</p>
      <div class="ev-close__actions">
        {!isPast && ticketUrl && (
          <a href={ticketUrl} class="event-btn event-btn--accent event-btn--big" target="_blank" rel="noopener noreferrer" data-ev-magnet>{ticketLabel}</a>
        )}
        {!isPast && offerAlerts && <button type="button" class="event-btn event-btn--accent event-btn--big" data-ev-magnet {...alerts}>Get ticket alerts</button>}
        {isPast && <a href="/events" class="event-btn event-btn--accent event-btn--big" data-ev-magnet>See upcoming events</a>}
        <EventShare title={title} summary={event.summary} shareUrl={shareUrl} />
      </div>
    </div>
  </footer>

  {hasAction && (
    <div class="ev-dock" data-ev-dock>
      <p class="ev-dock__text"><strong>{title}</strong><span>{shortDate}</span></p>
      {ticketUrl ? (
        <a href={ticketUrl} class="event-btn event-btn--solid ev-dock__btn" target="_blank" rel="noopener noreferrer">{ticketLabel}</a>
      ) : (
        <button type="button" class="event-btn event-btn--solid ev-dock__btn" {...alerts}>Get ticket alerts</button>
      )}
    </div>
  )}

  <DuotoneFilter />
  <SubscribeDialog />
</article>

<script>
  import { initEventPage } from '../../lib/events/eventPage';
  import { initHeroes } from '../../lib/events/hero';
  const root = document.querySelector<HTMLElement>('[data-ev]');
  initEventPage(root);
  initHeroes(root ?? document);
</script>
