---
/**
 * Event page, fed by one Sanity "event" document. Empty fields hide their sections.
 * Once the event has passed, the countdown and ticket buttons give way to a link back to Events.
 */
import type { EventDetail } from '@energize/shared';
import PortableText from '../portable/PortableText.astro';
import EventPoster from './EventPoster.astro';
import EventShare from './EventShare.astro';
import SubscribeDialog from '../forms/SubscribeDialog.astro';
import { getEventCoverUrl } from '../../lib/events/media';
import {
  formatEventDateLong,
  formatEventLocation,
  formatEventType,
  isPastEvent,
  lineupDisplayName,
} from '../../lib/events/format';
import { imageAlt } from '../../lib/seo/site';
import { titleCase } from '../../lib/text/titleCase';
import '../../styles/events.css';

interface Props {
  event: EventDetail;
  shareUrl: string;
}

const { event, shareUrl } = Astro.props;

const { title, ticketUrl } = event;
const isPast = isPastEvent(event.startDate, event.endDate);
const primaryLabel = ticketUrl ? event.ctaLabel || 'Get tickets' : 'Get ticket alerts';
const alerts = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get Ticket Alerts',
  'data-subscribe-lead': `Be the first to know when ${title} tickets go on sale and the lineup is announced.`,
};
const secondaryHref = event.secondaryCtaUrl || '/contact?intent=partnership';
const secondaryLabel = event.secondaryCtaLabel || 'Partner with us';

const highlights = (event.highlights ?? []).filter((item) => item?.title && item?.body);
const body = event.body?.length ? event.body : null;
const lineup = (event.lineup ?? []).filter(Boolean).map((slot) => {
  const revealed = !slot.revealState || slot.revealState === 'confirmed';
  const photo = revealed ? (slot.photo?.asset ? slot.photo : slot.artistPhoto) : undefined;
  const name = lineupDisplayName(slot.revealState, slot.name);
  return {
    name,
    // Shown in the tile until there is a photo.
    standIn: revealed ? name.split(/\s+/).map((word) => word[0]).slice(0, 2).join('') : '?',
    role: slot.role ? titleCase(slot.role) : undefined,
    href: revealed && slot.artistSlug ? `/artists/${slot.artistSlug}` : undefined,
    photoUrl: getEventCoverUrl(photo, 720, 900),
    photoAlt: imageAlt(photo?.alt, `${name} at ${title}`),
  };
});
---

<article class="event-world ev-page">
  <div class="event-shell">
    <a href="/events" class="event-textlink ev-page__back">All events</a>
    <h1 class="ev-page__title">{title}</h1>
    {event.subtitle && <p class="ev-page__subtitle">{titleCase(event.subtitle)}</p>}

    <div class="ev-page__grid">
      <aside class="ev-page__aside">
        <EventPoster cover={event.cover} title={title} width={900} lead />

        {
          isPast ? (
            <div class="ev-page__actions">
              <a href="/events" class="event-btn event-btn--solid">See upcoming events</a>
            </div>
          ) : (
            <div class="ev-page__actions">
              {ticketUrl ? (
                <a href={ticketUrl} class="event-btn event-btn--solid ev-page__tickets" target="_blank" rel="noopener noreferrer">
                  {primaryLabel}
                </a>
              ) : (
                <button type="button" class="event-btn event-btn--solid ev-page__tickets" {...alerts}>
                  {primaryLabel}
                </button>
              )}
              <a href={secondaryHref} class="event-btn event-btn--ghost">{secondaryLabel}</a>
            </div>
          )
        }

        <EventShare title={title} summary={event.summary} shareUrl={shareUrl} />
      </aside>

      <div class="ev-page__main">
        <div class="ev-when">
          <p class="ev-when__date">{formatEventDateLong(event.startDate)}</p>
          <p class="ev-when__place">
            {formatEventLocation(event.location)}<br />
            {formatEventType(event.eventType)}
          </p>
        </div>

        {
          isPast ? (
            <p class="ev-ended">This event has ended.</p>
          ) : (
            <div class="ev-count" data-countdown={event.startDate} role="timer" aria-label="Time until the event">
              {['Days', 'Hours', 'Mins', 'Secs'].map((unit) => (
                <div>
                  <span class="ev-count__value" data-unit={unit.toLowerCase()}>--</span>
                  <span class="ev-count__unit">{unit}</span>
                </div>
              ))}
            </div>
          )
        }

        {
          (event.summary || body) && (
            <section class="ev-block" aria-labelledby="event-about-title">
              <h2 id="event-about-title">About the event</h2>
              {event.summary && <p class="ev-lead">{event.summary}</p>}
              {body && (
                <div class="ev-body">
                  <PortableText value={body} />
                </div>
              )}
            </section>
          )
        }

        {
          highlights.length > 0 && (
            <section class="ev-block" aria-labelledby="event-details-title">
              <h2 id="event-details-title">Event details</h2>
              <ul class="ev-notes">
                {highlights.map((item) => (
                  <li>
                    <h3>{titleCase(item.title)}</h3>
                    <p>{item.body}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          lineup.length > 0 ? (
            <section class="ev-block" aria-labelledby="event-lineup-title">
              <h2 id="event-lineup-title">The lineup</h2>
              <ul class="ev-lineup">
                {lineup.map((slot) => {
                  const Tag = slot.href ? 'a' : 'div';
                  return (
                    <li>
                      <Tag href={slot.href} class="ev-lineup__slot">
                        <span class="ev-lineup__photo">
                          {slot.photoUrl ? (
                            <img src={slot.photoUrl} alt={slot.photoAlt} width="720" height="900" loading="lazy" decoding="async" />
                          ) : (
                            <span class="ev-lineup__stand-in" aria-hidden="true">{slot.standIn}</span>
                          )}
                        </span>
                        <span class="ev-lineup__name">{slot.name}</span>
                        {slot.role && <span class="ev-lineup__role">{slot.role}</span>}
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </section>
          ) : (
            !isPast && (
              <section class="ev-block" aria-labelledby="event-lineup-title">
                <h2 id="event-lineup-title">The lineup</h2>
                <p class="ev-lead">Names are coming. Join the list to hear them first.</p>
                <button
                  type="button"
                  class="event-btn event-btn--ghost ev-block__action"
                  data-subscribe-open
                  data-subscribe-title="Hear the Lineup First"
                  data-subscribe-lead={`Get the ${title} lineup in your inbox the moment it is announced.`}
                >
                  Get lineup updates
                </button>
              </section>
            )
          )
        }
      </div>
    </div>
  </div>

  {
    !isPast && (
      <div class="ev-ticketbar">
        {ticketUrl ? (
          <a href={ticketUrl} class="event-btn event-btn--solid" target="_blank" rel="noopener noreferrer">
            {primaryLabel}
          </a>
        ) : (
          <button type="button" class="event-btn event-btn--solid" {...alerts}>
            {primaryLabel}
          </button>
        )}
      </div>
    )
  }

  <SubscribeDialog />
</article>

<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');
  const target = root ? new Date(root.dataset.countdown ?? '').getTime() : NaN;

  if (root && !Number.isNaN(target)) {
    const write = (unit: string, value: string) => {
      const cell = root.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
      if (cell) cell.textContent = value;
    };
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const s = Math.floor(diff / 1000);
      write('days', String(Math.floor(s / 86400)));
      write('hours', pad(Math.floor((s % 86400) / 3600)));
      write('mins', pad(Math.floor((s % 3600) / 60)));
      write('secs', pad(s % 60));
      if (diff === 0) window.clearInterval(timer);
    };

    const timer = window.setInterval(tick, 1000);
    tick();
  }
</script>

<style>
  .ev-page {
    position: relative;
    padding-top: clamp(1rem, 2vw, 1.75rem);
  }

  .ev-page__back {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.9375rem;
  }

  .ev-page__title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 1.5rem + 7.2vw, 10rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-fg);
  }

  .ev-page__subtitle {
    margin: 1.25rem 0 0;
    max-width: 40rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.35;
  }

  .ev-page__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .ev-page__aside {
    --poster-w: 100%;
    --poster-h: 80svh;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    min-width: 0;
  }

  .ev-page__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
  }

  .ev-page__actions .event-btn {
    flex: 1 1 12rem;
  }

  /* On phones the ticket button lives in the bar at the bottom of the screen. */
  .ev-page__tickets {
    display: none;
  }

  .ev-page__main {
    min-width: 0;
    max-width: 44rem;
  }

  .ev-when__date {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .ev-when__place {
    margin: 1rem 0 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .ev-ended {
    margin: 2rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .ev-count {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, max-content));
    gap: clamp(1.25rem, 3.5vw, 3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .ev-count__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.75rem + 3.5vw, 5rem);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ev-count__unit {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .ev-block {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .ev-block h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .ev-lead {
    margin: 1.25rem 0 0;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    line-height: 1.45;
  }

  .ev-body {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .ev-body :global(p) {
    margin: 0 0 1rem;
    color: inherit;
  }

  .ev-block__action {
    margin-top: 1.75rem;
  }

  .ev-notes {
    display: grid;
    gap: 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ev-notes h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .ev-notes p {
    margin: 0.5rem 0 0;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .ev-lineup {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: 2rem 1.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ev-lineup__slot {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ev-lineup__photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-fg) 6%, transparent);
  }

  .ev-lineup__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ev-lineup__stand-in {
    display: grid;
    height: 100%;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-muted);
  }

  .ev-lineup__name {
    display: block;
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.1;
  }

  a.ev-lineup__slot:hover .ev-lineup__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .ev-lineup__role {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* Tickets stay in reach on phones while the poster's own button scrolls away. */
  .ev-ticketbar {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: grid;
    padding: 0.75rem 1.25rem;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(10px);
  }

  @media (min-width: 1024px) {
    .ev-page__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
    }

    .ev-page__tickets {
      display: inline-flex;
    }

    .ev-page__main {
      order: -1;
    }

    .ev-page__aside {
      --poster-h: 56svh;
      position: sticky;
      top: calc(var(--header-height, 4rem) + 1.5rem);
      align-self: start;
    }

    .ev-ticketbar {
      display: none;
    }
  }
</style>
