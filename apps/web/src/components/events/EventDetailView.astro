---
/**
 * Event page template. Every section is driven by the Sanity "event" document
 * and hides itself when its field is empty.
 */
import type { EventDetail } from '@energize/shared';
import PortableText from '../portable/PortableText.astro';
import Marquee from '../ui/Marquee.astro';
import EventShare from './EventShare.astro';
import { getEventCoverUrl } from '../../lib/events/media';
import {
  formatEventDate,
  formatEventDateLong,
  formatEventLocation,
  formatEventType,
  isPastEvent,
  lineupBadgeLabel,
  lineupDisplayName,
} from '../../lib/events/format';
import { imageAlt } from '../../lib/seo/site';
import { titleCase } from '../../lib/text/titleCase';

interface Props {
  event: EventDetail;
  shareUrl: string;
}

const { event, shareUrl } = Astro.props;

const coverUrl = getEventCoverUrl(event.cover, 2400, 1500);
const isPast = isPastEvent(event.startDate, event.endDate);
const hasTickets = Boolean(event.ticketUrl) && !isPast;
// No ticket link yet: send people to the email list so they hear when sales open.
const primaryHref = hasTickets ? event.ticketUrl! : '/#first-to-know';
const primaryLabel = hasTickets ? event.ctaLabel || 'Get Tickets' : 'Get Ticket Alerts';
const secondaryHref = event.secondaryCtaUrl || '/contact?intent=partnership';
const secondaryLabel = event.secondaryCtaLabel || 'Partner With Us';

const venue = formatEventLocation(event.location);
const highlights = (event.highlights ?? []).filter((item) => item?.title && item?.body);
const lineup = (event.lineup ?? []).filter(Boolean);
const hasBody = Boolean(event.body?.length);
const marqueeItems = [event.title, formatEventDate(event.startDate), venue, formatEventType(event.eventType)];

const lineupCards = lineup.map((slot) => {
  const revealed = !slot.revealState || slot.revealState === 'confirmed';
  const photo = revealed ? (slot.photo?.asset ? slot.photo : slot.artistPhoto) : undefined;
  const name = lineupDisplayName(slot.revealState, slot.name);
  return {
    name,
    role: slot.role ? titleCase(slot.role) : undefined,
    badge: lineupBadgeLabel(slot.revealState),
    href: revealed && slot.artistSlug ? `/artists/${slot.artistSlug}` : undefined,
    photoUrl: getEventCoverUrl(photo, 720, 900),
    photoAlt: imageAlt(photo?.alt, `${name} at ${event.title}`),
  };
});
---

<article class="fest">
  <header class="fest-hero theme-dark">
    {
      coverUrl ? (
        <img
          src={coverUrl}
          alt=""
          class="fest-hero__bg"
          width="2400"
          height="1500"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div class="fest-hero__bg fest-hero__bg--empty" />
      )
    }
    <div class="fest-hero__scrim" aria-hidden="true"></div>

    <div class="fest-hero__inner">
      <a href="/" class="fest-hero__back">← Home</a>

      <div class="fest-hero__grid">
        <div class="fest-reveal">
          <p class="fest-hero__eyebrow">
            <span class="fest-hero__pill">{isPast ? 'Past Event' : formatEventDate(event.startDate)}</span>
            Energize Music Presents
          </p>
          <h1 class="fest-hero__title">{event.title}</h1>
          {event.subtitle && <p class="fest-hero__subtitle">{titleCase(event.subtitle)}</p>}

          <dl class="fest-hero__facts">
            <div>
              <dt>Date</dt>
              <dd>{formatEventDateLong(event.startDate)}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{venue}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>{formatEventType(event.eventType)}</dd>
            </div>
          </dl>

          {
            !isPast && (
              <div class="fest-actions">
                <a
                  href={primaryHref}
                  class="fest-btn fest-btn--solid"
                  {...(hasTickets ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {primaryLabel}
                </a>
                <a href={secondaryHref} class="fest-btn fest-btn--ghost">{secondaryLabel}</a>
              </div>
            )
          }
        </div>

        {
          !isPast && (
            <div class="fest-countdown fest-reveal" data-countdown={event.startDate} aria-label="Countdown to the event">
              <p class="fest-countdown__label">Countdown</p>
              <div class="fest-countdown__grid">
                {['Days', 'Hours', 'Mins', 'Secs'].map((unit) => (
                  <div class="fest-countdown__cell">
                    <span class="fest-countdown__value" data-unit={unit.toLowerCase()}>
                      --
                    </span>
                    <span class="fest-countdown__unit">{unit}</span>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </header>

  <Marquee items={marqueeItems} variant="caps" class="fest-marquee" />

  {
    highlights.length > 0 && (
      <section class="fest-section" aria-labelledby="fest-details-title">
        <div class="fest-container">
          <div class="fest-head scroll-reveal">
            <p class="fest-kicker">The Night</p>
            <h2 id="fest-details-title" class="fest-h2">Event Details</h2>
          </div>
          <ol class="fest-details scroll-reveal-stagger">
            {highlights.map((item, index) => (
              <li class="fest-detail">
                <span class="fest-detail__num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="fest-detail__title">{titleCase(item.title)}</h3>
                <p class="fest-detail__body">{item.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    (lineupCards.length > 0 || !isPast) && (
      <section class="fest-section fest-section--surface" aria-labelledby="fest-lineup-title">
        <div class="fest-container">
          <div class="fest-head scroll-reveal">
            <p class="fest-kicker">On Stage</p>
            <h2 id="fest-lineup-title" class="fest-h2">The Lineup</h2>
          </div>
          {lineupCards.length > 0 ? (
            <ul class="fest-lineup scroll-reveal-stagger">
              {lineupCards.map((card) => {
                const inner = (
                  <>
                    <span class="fest-lineup__media media-frame">
                      {card.photoUrl ? (
                        <img src={card.photoUrl} alt={card.photoAlt} width="720" height="900" loading="lazy" decoding="async" />
                      ) : (
                        <span class="fest-lineup__placeholder" aria-hidden="true">
                          ?
                        </span>
                      )}
                      {card.badge && <span class="fest-lineup__badge">{card.badge}</span>}
                    </span>
                    <span class="fest-lineup__name">{card.name}</span>
                    {card.role && <span class="fest-lineup__role">{card.role}</span>}
                  </>
                );
                return <li>{card.href ? <a href={card.href} class="fest-lineup__card">{inner}</a> : <div class="fest-lineup__card">{inner}</div>}</li>;
              })}
            </ul>
          ) : (
            <div class="fest-soon scroll-reveal">
              <p class="fest-soon__title">Lineup Announcements Coming Soon</p>
              <p class="fest-soon__body">Join the list and you will hear the names first.</p>
              <a href="/#first-to-know" class="fest-btn fest-btn--solid">Notify Me</a>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    (hasBody || event.summary) && (
      <section class="fest-section" aria-labelledby="fest-story-title">
        <div class="fest-container fest-story">
          <div class="fest-story__aside scroll-reveal">
            <p class="fest-kicker">The Story</p>
            <h2 id="fest-story-title" class="fest-h2">About the Night</h2>
            <div class="fest-story__share">
              <EventShare title={event.title} summary={event.summary} shareUrl={shareUrl} />
            </div>
          </div>
          <div class="fest-story__body scroll-reveal" style="--reveal-delay: 100ms">
            {event.summary && <p class="fest-story__lead">{event.summary}</p>}
            {hasBody && <PortableText value={event.body!} />}
          </div>
        </div>
      </section>
    )
  }

  {
    !isPast && (
      <section class="fest-cta theme-dark" aria-labelledby="fest-cta-title">
        {coverUrl && <img src={coverUrl} alt="" class="fest-cta__bg" width="2400" height="1500" loading="lazy" decoding="async" />}
        <div class="fest-cta__inner scroll-reveal">
          <p class="fest-kicker">{hasTickets ? 'See You There' : "Don't Miss It"}</p>
          <h2 id="fest-cta-title" class="fest-cta__title">{hasTickets ? 'Get Your Tickets' : 'Be First in Line for Tickets'}</h2>
          <p class="fest-cta__meta">
            {formatEventDateLong(event.startDate)} · {venue}
          </p>
          <div class="fest-actions fest-actions--center">
            <a
              href={primaryHref}
              class="fest-btn fest-btn--solid"
              {...(hasTickets ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {primaryLabel}
            </a>
          </div>
        </div>
      </section>
    )
  }
</article>

<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');
  const target = root ? new Date(root.dataset.countdown ?? '').getTime() : NaN;

  if (root && !Number.isNaN(target)) {
    const cells = {
      days: root.querySelector<HTMLElement>('[data-unit="days"]'),
      hours: root.querySelector<HTMLElement>('[data-unit="hours"]'),
      mins: root.querySelector<HTMLElement>('[data-unit="mins"]'),
      secs: root.querySelector<HTMLElement>('[data-unit="secs"]'),
    };
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const s = Math.floor(diff / 1000);
      if (cells.days) cells.days.textContent = String(Math.floor(s / 86400));
      if (cells.hours) cells.hours.textContent = pad(Math.floor((s % 86400) / 3600));
      if (cells.mins) cells.mins.textContent = pad(Math.floor((s % 3600) / 60));
      if (cells.secs) cells.secs.textContent = pad(s % 60);
      if (diff === 0) window.clearInterval(timer);
    };

    tick();
    const timer = window.setInterval(tick, 1000);
  }

  document.querySelectorAll('.fest-reveal').forEach((node) => node.classList.add('is-in'));
</script>

<style>
  .fest {
    position: relative;
  }

  /* ---------- Hero ---------- */
  .fest-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: max(100svh, 40rem);
    margin-top: calc(-1 * var(--header-height, 4rem));
    background: var(--color-bg);
  }

  .fest-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: fest-zoom 14s ease-out forwards;
  }

  .fest-hero__bg--empty {
    background: radial-gradient(circle at 70% 30%, color-mix(in srgb, var(--color-accent) 30%, transparent), transparent 60%), var(--color-bg);
  }

  @keyframes fest-zoom {
    to {
      transform: scale(1);
    }
  }

  .fest-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-scrim) 60%, transparent) 0%, color-mix(in srgb, var(--color-scrim) 25%, transparent) 38%, color-mix(in srgb, var(--color-scrim) 92%, transparent) 100%),
      linear-gradient(90deg, color-mix(in srgb, var(--color-scrim) 55%, transparent) 0%, transparent 65%);
  }

  .fest-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    width: min(100%, 80rem);
    min-height: inherit;
    margin-inline: auto;
    padding: calc(var(--header-height, 4rem) + 2rem) 1.25rem clamp(2.5rem, 6vh, 4.5rem);
  }

  @media (min-width: 640px) {
    .fest-hero__inner {
      padding-inline: 1.5rem;
    }
  }

  .fest-hero__back {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    opacity: 0.85;
  }

  .fest-hero__back:hover {
    opacity: 1;
  }

  .fest-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }

  @media (min-width: 1024px) {
    .fest-hero__grid {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .fest-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-on-dark);
  }

  .fest-hero__pill {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--color-accent-fill);
    color: #fff;
    letter-spacing: 0.18em;
  }

  .fest-hero__title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 9vw, 10rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: var(--color-on-dark);
  }

  .fest-hero__subtitle {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.35rem, 1rem + 1.4vw, 2.1rem);
    font-style: italic;
    line-height: 1.2;
    color: var(--color-on-dark);
  }

  .fest-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-on-dark) 22%, transparent);
    max-width: 44rem;
  }

  .fest-hero__facts dt {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .fest-hero__facts dd {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-on-dark);
  }

  /* ---------- Buttons ---------- */
  .fest-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .fest-actions--center {
    justify-content: center;
  }

  .fest-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.6rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
  }

  .fest-btn--solid {
    background: var(--color-accent-fill);
    color: #fff;
  }

  .fest-btn--solid:hover {
    transform: translateY(-2px);
    background: var(--color-accent-fill-hover);
  }

  .fest-btn--ghost {
    border: 1px solid color-mix(in srgb, var(--color-fg) 45%, transparent);
    color: var(--color-fg);
  }

  .fest-btn--ghost:hover {
    border-color: var(--color-fg);
  }

  /* ---------- Countdown ---------- */
  .fest-countdown {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-on-dark) 18%, transparent);
    background: color-mix(in srgb, var(--color-scrim) 45%, transparent);
    backdrop-filter: blur(10px);
  }

  .fest-countdown__label {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .fest-countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(3.75rem, 1fr));
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .fest-countdown__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.7rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-on-dark) 12%, transparent);
  }

  .fest-countdown__value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.6rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-on-dark);
  }

  .fest-countdown__unit {
    margin-top: 0.4rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-on-dark) 75%, transparent);
  }

  .fest-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fest-reveal.is-in {
    opacity: 1;
    transform: none;
  }

  .fest-countdown.fest-reveal {
    transition-delay: 0.2s;
  }

  .fest :global(.fest-marquee) {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  /* ---------- Sections ---------- */
  .fest-section {
    padding-block: clamp(4.5rem, 3rem + 5vw, 8rem);
    border-bottom: 1px solid var(--color-line);
  }

  .fest-section--surface {
    background: var(--color-surface);
  }

  .fest-container {
    width: min(100%, 80rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 640px) {
    .fest-container {
      padding-inline: 1.5rem;
    }
  }

  .fest-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .fest-kicker::before {
    content: '';
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .fest-h2 {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4.25rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .fest-details {
    display: grid;
    gap: 1px;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  @media (min-width: 768px) {
    .fest-details {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .fest-detail {
    position: relative;
    padding: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    background: var(--color-bg);
    transition: background-color 0.3s ease;
  }

  .fest-detail::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .fest-detail:hover::before {
    transform: scaleX(1);
  }

  .fest-detail__num {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  .fest-detail__title {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .fest-detail__body {
    margin-top: 0.75rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* ---------- Lineup ---------- */
  .fest-lineup {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fest-lineup__card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .fest-lineup__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.75rem;
    background: color-mix(in srgb, var(--color-fg) 5%, transparent);
  }

  .fest-lineup__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  a.fest-lineup__card:hover .fest-lineup__media img {
    transform: scale(1.04);
  }

  .fest-lineup__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 4rem;
    color: color-mix(in srgb, var(--color-fg) 25%, transparent);
  }

  .fest-lineup__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.6rem;
    background: var(--color-accent-fill);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .fest-lineup__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.1;
  }

  .fest-lineup__role {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .fest-soon {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-top: 3rem;
    padding: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    border: 1px dashed color-mix(in srgb, var(--color-fg) 22%, transparent);
  }

  .fest-soon__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
  }

  .fest-soon__body {
    color: var(--color-muted);
  }

  .fest-soon .fest-btn {
    margin-top: 0.75rem;
  }

  /* ---------- Story ---------- */
  .fest-story {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .fest-story {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 5rem;
    }

    .fest-story__aside {
      position: sticky;
      top: calc(var(--header-height, 4rem) + 2rem);
      align-self: start;
    }
  }

  .fest-story__share {
    margin-top: 2rem;
  }

  .fest-story__lead {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.25rem);
    font-style: italic;
    line-height: 1.3;
  }

  .fest-story__body :global(p:not(.fest-story__lead)) {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-fg);
