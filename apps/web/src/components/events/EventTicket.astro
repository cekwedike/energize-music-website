---
/**
 * An event printed as a paper ticket: the details on the body, the date and the ticket button on the stub.
 * "tucked" tickets sit under the edge of the poster beside them and slide out once on load.
 * Hosted-by events (event.host set) never offer Energize ticket alerts, and the second button
 * only appears when Sanity gives it a link.
 */
import type { EventDetail } from '@energize/shared';
import EventPoster from './EventPoster.astro';
import { eventDateParts, formatEventLocation, formatEventType, isPastEvent } from '../../lib/events/format';

interface Props {
  event: EventDetail;
  /** feature: the next event on /events. row: later dates on /events. page: the event's own page. */
  variant: 'feature' | 'row' | 'page';
  href?: string;
  heading?: 'h2' | 'h3';
  tucked?: boolean;
}

const { event, variant, href, heading = 'h2', tucked = false } = Astro.props;
const Heading = heading;
const date = eventDateParts(event.startDate);
const isPast = isPastEvent(event.startDate, event.endDate);
const venue = formatEventLocation(event.location);
const host = event.host?.trim();

const ticketLabel = event.ctaLabel || 'Get tickets';
const offerAlerts = !event.ticketUrl && !host && !isPast;
const alerts = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get Ticket Alerts',
  'data-subscribe-lead': `Hear first when ${event.title} tickets go on sale.`,
};
const secondary =
  variant === 'page' && !isPast && event.secondaryCtaUrl
    ? { href: event.secondaryCtaUrl, label: event.secondaryCtaLabel || 'Learn more' }
    : null;
const external = (url: string) => /^https?:\/\//.test(url);
---

<div class:list={['tk', `tk--${variant}`, tucked && 'tk--tucked', isPast && 'tk--past']}>
  <div class="tk__paper">
    <div class="tk__body">
      {
        variant === 'row' && (
          <div class="tk__thumb">
            <EventPoster cover={event.cover} title={event.title} href={href} width={360} />
          </div>
        )
      }

      <div class="tk__info">
        {
          variant !== 'page' && (
            <Heading class="tk__title">{href ? <a href={href}>{event.title}</a> : event.title}</Heading>
          )
        }
        {variant === 'feature' && event.subtitle && <p class="tk__subtitle">{event.subtitle}</p>}

        <p class="tk__when">{date.weekday}, {date.time}</p>
        <p class="tk__where">
          {venue}
          {event.eventType && event.eventType !== 'physical' && <span>, {formatEventType(event.eventType)}</span>}
        </p>
        {host && <p class="tk__host">Hosted by {host}</p>}

        {
          variant === 'page' && !isPast && (
            <div class="tk__count" data-countdown={event.startDate} role="timer" aria-label="Time until the event">
              {['Days', 'Hours', 'Mins', 'Secs'].map((unit) => (
                <div>
                  <span class="tk__count-value" data-unit={unit.toLowerCase()}>--</span>
                  <span class="tk__count-unit">{unit}</span>
                </div>
              ))}
            </div>
          )
        }

        {variant === 'page' && isPast && <p class="tk__ended">This event has ended.</p>}

        {
          variant !== 'page' && href && (
            <a class="tk__more" href={href}>
              Event details
            </a>
          )
        }

        {
          secondary && (
            <a
              class="event-btn event-btn--ghost tk__secondary"
              href={secondary.href}
              {...(external(secondary.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {secondary.label}
            </a>
          )
        }
      </div>
    </div>

    <div class="tk__stub">
      <p class="tk__date">
        <span class="tk__day">{date.day}</span>
        <span class="tk__month">
          {date.month}
          <span class="tk__year">{date.year}</span>
        </span>
      </p>

      {
        isPast ? (
          variant === 'page' && (
            <a class="event-btn event-btn--solid tk__action" href="/events">
              Upcoming events
            </a>
          )
        ) : event.ticketUrl ? (
          <a class="event-btn event-btn--solid tk__action" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">
            {ticketLabel}
          </a>
        ) : offerAlerts ? (
          <button type="button" class="event-btn event-btn--solid tk__action" {...alerts}>
            Get ticket alerts
          </button>
        ) : null
      }
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-countdown]');
  const target = root ? new Date(root.dataset.countdown ?? '').getTime() : NaN;

  if (root && !Number.isNaN(target)) {
    const write = (unit: string, value: string) => {
      const cell = root.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
      if (cell) cell.textContent = value;
    };
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const s = Math.floor(diff / 1000);
      write('days', String(Math.floor(s / 86400)));
      write('hours', pad(Math.floor((s % 86400) / 3600)));
      write('mins', pad(Math.floor((s % 3600) / 60)));
      write('secs', pad(s % 60));
      if (diff === 0) window.clearInterval(timer);
    };

    const timer = window.setInterval(tick, 1000);
    tick();
  }
</script>

<style>
  /*
   * The paper is one masked box: two notches cut where the stub tears off.
   * Wide tickets tear top to bottom with the stub on the right; narrow ones tear across with the stub below.
   */
  .tk {
    --stub-w: clamp(11rem, 16vw, 14rem);
    --stub-h: 6.75rem;
    --notch: 0.9rem;
    --tuck-x: 0px;
    --tuck-y: 0px;
    --pad: 1.5rem;
    position: relative;
    min-width: 0;
    filter: drop-shadow(0 1px 0 color-mix(in srgb, var(--color-shadow) 9%, transparent))
      drop-shadow(0 1.25rem 1.75rem color-mix(in srgb, var(--color-shadow) 9%, transparent));
  }

  .tk__paper {
    --tear-x: 50%;
    --tear-y: calc(100% - var(--stub-h));
    display: grid;
    grid-template-rows: 1fr var(--stub-h);
    border-radius: 0.375rem;
    background: var(--color-surface);
    color: var(--color-fg);
    -webkit-mask:
      radial-gradient(circle var(--notch) at 0 var(--tear-y), #0000 98%, #000) ,
      radial-gradient(circle var(--notch) at 100% var(--tear-y), #0000 98%, #000);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle var(--notch) at 0 var(--tear-y), #0000 98%, #000) ,
      radial-gradient(circle var(--notch) at 100% var(--tear-y), #0000 98%, #000);
    mask-composite: intersect;
  }

  .tk__body {
    display: grid;
    gap: 1.25rem;
    padding: calc(var(--pad) + var(--tuck-y)) var(--pad) var(--pad) calc(var(--pad) + var(--tuck-x));
    min-width: 0;
  }

  .tk__info {
    min-width: 0;
  }

  .tk__stub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
    background: color-mix(in srgb, var(--color-fg) 3.5%, var(--color-surface));
  }

  .tk__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .tk--row .tk__title {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .tk__title a {
    color: inherit;
    text-decoration: none;
  }

  .tk__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }

  .tk__subtitle {
    margin: 0.75rem 0 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .tk__when {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
  }

  .tk--page .tk__when {
    margin-top: 0;
  }

  .tk__where,
  .tk__host {
    margin: 0.4rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .tk__host {
    margin-top: 0.85rem;
    color: var(--color-fg);
    font-weight: 600;
  }

  .tk__more {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 0.75rem;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .tk__more:hover {
    color: var(--color-muted);
  }

  .tk__secondary {
    margin-top: 1.5rem;
  }

  .tk__ended {
    margin: 1.5rem 0 0;
    font-weight: 600;
  }

  .tk__count {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    margin-top: 1.75rem;
  }

  .tk__count-value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-variant-numeric: tabular-nums lining-nums;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .tk__count-unit {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .tk__date {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .tk__day {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 400;
    font-variation-settings: 'opsz' 144;
    font-variant-numeric: lining-nums;
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .tk__month {
    display: grid;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .tk__year {
    font-weight: 400;
    color: var(--color-muted);
  }

  .tk__action {
    min-height: 3rem;
    padding-inline: 1.25rem;
  }

  .tk__thumb {
    --poster-w: 100%;
    --poster-h: 10rem;
  }

  /* Past tickets fade like an old stub. */
  .tk--past .tk__day,
  .tk--past .tk__month {
    color: var(--color-muted);
  }

  /* ---------- Wide: the stub moves to the right and tears top to bottom ---------- */
  @media (min-width: 640px) {
    .tk__paper {
      --tear-x: calc(100% - var(--stub-w));
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr) var(--stub-w);
      -webkit-mask:
        radial-gradient(circle var(--notch) at var(--tear-x) 0, #0000 98%, #000) ,
        radial-gradient(circle var(--notch) at var(--tear-x) 100%, #0000 98%, #000);
      -webkit-mask-composite: source-in;
      mask:
        radial-gradient(circle var(--notch) at var(--tear-x) 0, #0000 98%, #000) ,
        radial-gradient(circle var(--notch) at var(--tear-x) 100%, #0000 98%, #000);
      mask-composite: intersect;
    }

    .tk {
      --pad: clamp(1.75rem, 3vw, 2.75rem);
    }

    .tk--row .tk__body {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .tk--row .tk__thumb {
      --poster-w: 12rem;
      --poster-h: 13rem;
    }

    .tk__stub {
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      padding: clamp(1.75rem, 3vw, 2.5rem) 1.5rem;
    }

    .tk__date {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .tk__day {
      font-size: clamp(5rem, 3rem + 4vw, 7.5rem);
    }

    .tk__month {
      font-size: 1rem;
    }

    .tk__action {
      width: 100%;
      margin-top: 2rem;
    }
  }

  /* ---------- Tucked under a poster: the hidden edge is padded and the ticket slides out once ---------- */
  .tk--tucked {
    --tuck-y: 2rem;
    margin-top: calc(var(--tuck-y) * -1);
  }

  .tk--tucked .tk__paper {
    animation: tk-slide-down 0.9s 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (min-width: 1024px) {
    .tk--tucked {
      --tuck-x: 2.5rem;
      --tuck-y: 0px;
      margin-top: 0;
      margin-left: calc(var(--tuck-x) * -1);
    }

    .tk--tucked .tk__paper {
      animation-name: tk-slide-out;
    }

  }

  @keyframes tk-slide-out {
    from {
      transform: translateX(-40%);
    }
  }

  @keyframes tk-slide-down {
    from {
      transform: translateY(-35%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk--tucked .tk__paper {
      animation: none;
    }
  }
</style>
