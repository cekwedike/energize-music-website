---
/**
 * The Events page. The next event gets its poster with a ticket tucked under it,
 * later dates follow as a stack of tickets, and past posters hang in grey until you point at them.
 */
import type { EventDetail } from '@energize/shared';
import EventPoster from './EventPoster.astro';
import EventTicket from './EventTicket.astro';
import SubscribeDialog from '../forms/SubscribeDialog.astro';
import { eventDateParts } from '../../lib/events/format';
import '../../styles/events.css';

interface Props {
  upcoming: EventDetail[];
  past: EventDetail[];
}

const { upcoming, past } = Astro.props;
const href = (event: EventDetail) => `/events/${event.slug}`;
const [lead, ...later] = upcoming;

const updates = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get Event Updates',
  'data-subscribe-lead': 'New dates and ticket news, sent to your inbox.',
};
---

<div class="event-world evx">
  <header class="event-shell evx-head">
    <h1>Events</h1>
    <p>Shows we put on, and shows we back.</p>
  </header>

  {
    lead ? (
      <section class="event-shell evx-lead" aria-label={lead.title}>
        <div class="evx-lead__poster">
          <EventPoster cover={lead.cover} title={lead.title} href={href(lead)} width={900} lead />
        </div>
        <EventTicket event={lead} variant="feature" href={href(lead)} tucked />
      </section>
    ) : (
      <section class="event-shell evx-empty">
        <h2>The next date is on its way.</h2>
        <button type="button" class="event-btn event-btn--solid" {...updates}>
          Get event updates
        </button>
      </section>
    )
  }

  {
    later.length > 0 && (
      <section class="event-shell evx-later" aria-labelledby="evx-later-title">
        <h2 id="evx-later-title" class="evx-title">More dates</h2>
        <ul class="evx-later__stack">
          {later.map((event) => (
            <li>
              <EventTicket event={event} variant="row" href={href(event)} heading="h3" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="evx-past" aria-labelledby="evx-past-title">
        <div class="event-shell">
          <h2 id="evx-past-title" class="evx-title">Past events</h2>
          <ul class="evx-past__wall">
            {past.map((event) => {
              const date = eventDateParts(event.startDate);
              return (
                <li>
                  <EventPoster cover={event.cover} title={event.title} href={href(event)} width={560} />
                  <h3>
                    <a href={href(event)}>{event.title}</a>
                  </h3>
                  <p>
                    {date.month} {date.year}
                  </p>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  {
    (lead || past.length > 0) && (
      <section class="event-shell evx-close" aria-labelledby="evx-close-title">
        <h2 id="evx-close-title">Hear about the next one first.</h2>
        <button type="button" class="event-btn event-btn--solid" {...updates}>
          Join the event list
        </button>
      </section>
    )
  }

  <SubscribeDialog />
</div>

<style>
  .evx {
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  /* ---------- Heading ---------- */
  .evx-head {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .evx-head h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2rem + 6vw, 8rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .evx-head p {
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .evx-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .evx-head p {
      padding-bottom: 0.6rem;
    }
  }

  /* ---------- The next event: poster with the ticket tucked under its edge ---------- */
  .evx-lead {
    display: grid;
    justify-items: center;
  }

  .evx-lead__poster {
    --poster-w: 100%;
    --poster-h: 78svh;
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .evx-lead :global(.tk) {
    width: min(100%, 36rem);
  }

  @media (min-width: 1024px) {
    .evx-lead {
      grid-template-columns: auto minmax(0, 38rem);
      justify-content: center;
      align-items: center;
    }

    .evx-lead__poster {
      --poster-w: 48vw;
      --poster-h: 74svh;
      width: auto;
    }

    .evx-lead :global(.tk) {
      width: 100%;
    }
  }

  .evx-empty {
    display: grid;
    justify-items: start;
    gap: 2rem;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .evx-empty h2 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.75rem + 3.5vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  /* ---------- Section titles ---------- */
  .evx-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.75rem + 3vw, 4.5rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 144;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* ---------- Later dates: a stack of tickets ---------- */
  .evx-later {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .evx-later__stack {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 64rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Past events: posters in grey, colour comes back under the pointer ---------- */
  .evx-past {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .evx-past__wall {
    columns: 4 14rem;
    column-gap: clamp(1rem, 2vw, 1.75rem);
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .evx-past__wall li {
    break-inside: avoid;
    padding-bottom: 2.5rem;
  }

  .evx-past__wall :global(.ev-poster__face img) {
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.5s ease;
  }

  .evx-past__wall li:hover :global(.ev-poster__face img),
  .evx-past__wall li:focus-within :global(.ev-poster__face img) {
    filter: none;
  }

  .evx-past__wall h3 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .evx-past__wall h3 a {
    color: inherit;
    text-decoration: none;
  }

  .evx-past__wall h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .evx-past__wall p {
    margin: 0.3rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* ---------- Close ---------- */
  .evx-close {
    display: grid;
    justify-items: start;
    gap: 2rem;
    padding-block: clamp(5rem, 10vw, 9rem) clamp(2rem, 4vw, 4rem);
  }

  .evx-close h2 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.75rem + 5vw, 7rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  @media (min-width: 900px) {
    .evx-close {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
