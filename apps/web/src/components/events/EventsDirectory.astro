---
import type { EventDetail } from '@energize/shared';
import EventPoster from './EventPoster.astro';
import DuotoneFilter from './DuotoneFilter.astro';
import SubscribeDialog from '../forms/SubscribeDialog.astro';
import { eventDateParts, formatEventLocation } from '../../lib/events/format';
import '../../styles/events.css';

interface Props {
  upcoming: EventDetail[];
  past: EventDetail[];
}

const { upcoming, past } = Astro.props;

const getEvent = (event: EventDetail) => ({
  event,
  href: `/events/${event.slug}`,
  date: eventDateParts(event.startDate),
  venue: formatEventLocation(event.location),
  ticketLabel: event.ctaLabel || 'Get tickets',
});

const nights = upcoming.map(getEvent);
const next = nights[0];
const archive = past.map(getEvent);
const updates = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get event updates',
  'data-subscribe-lead': 'New dates and ticket news, sent to your inbox.',
};
---

<main class="event-world evs" data-evs>
  <section class="evs-hero theme-dark" data-evh>
    <div class="evh__photo evs-hero__photo" aria-hidden="true">
      <img src="/next/takit.webp" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="evh__veil" aria-hidden="true"></div>

    <div class="event-shell evs-hero__inner">
      <div class="evs-hero__lockup">
        <h1 class="evs-hero__title">Events</h1>
        <p class="evs-hero__script" aria-hidden="true">Energize Live</p>
      </div>
      <p class="evs-hero__lead">Live events from Energize Music and friends.</p>

      {next ? (
        <a class="evs-next" href={next.href}>
          <span class="evs-next__poster">
            <EventPoster cover={next.event.cover} title={next.event.title} width={200} />
          </span>
          <span class="evs-next__copy">
            <strong>{next.event.title}</strong>
            <span>{next.date.weekday.slice(0, 3)} {next.date.day} {next.date.monthShort}, {next.date.time}</span>
            <span>{next.venue}</span>
            <span class="evs-next__cta">See the event</span>
          </span>
        </a>
      ) : (
        <button type="button" class="event-btn event-btn--accent evs-hero__alerts" {...updates}>Get event updates</button>
      )}
    </div>
  </section>

  {
    nights.length > 0 ? (
      <section class="event-shell evs-list" aria-labelledby="evs-list-title" id="evs-dates">
        <h2 id="evs-list-title" class="evs-heading scroll-reveal">Upcoming</h2>
        <ol class="evs-rows" data-evs-pages="page" data-page-size="5">
          {nights.map((item) => (
            <li class="evs-row scroll-reveal">
              <p class="evs-row__date" aria-hidden="true">
                <span class="evs-row__month">{item.date.monthShort}</span>
                <span class="evs-row__day">{item.date.day}</span>
              </p>
              <div class="evs-row__poster">
                <EventPoster cover={item.event.cover} title={item.event.title} href={item.href} width={360} />
              </div>
              <div class="evs-row__copy">
                <h3><a href={item.href}>{item.event.title}</a></h3>
                <p class="evs-row__facts">
                  <span>{item.date.weekday} {item.date.day} {item.date.month} {item.date.year}, {item.date.time}</span>
                  <span>{item.venue}</span>
                  {item.event.host && <span>Hosted by {item.event.host}</span>}
                </p>
              </div>
              <div class="evs-row__actions">
                {item.event.ticketUrl && (
                  <a class="event-btn event-btn--accent" href={item.event.ticketUrl} target="_blank" rel="noopener noreferrer">
                    {item.ticketLabel}
                  </a>
                )}
                <a class="event-btn event-btn--ghost" href={item.href}>See the event</a>
              </div>
            </li>
          ))}
        </ol>
        <nav class="evs-pager" data-evs-pager="page" hidden></nav>
      </section>
    ) : (
      <section class="event-shell evs-empty">
        <h2 class="evs-heading">The next show is taking shape.</h2>
        <p>Join the list and we will tell you when the date is set.</p>
        <button type="button" class="event-btn event-btn--accent" {...updates}>Get event updates</button>
      </section>
    )
  }

  {
    archive.length > 0 && (
      <section class="evs-past" aria-labelledby="evs-past-title">
        <div class="event-shell">
          <h2 id="evs-past-title" class="evs-heading scroll-reveal">Past events</h2>
        </div>
        <ul class="event-shell evs-past__grid scroll-reveal-stagger" data-evs-pages="past" data-page-size="8">
          {archive.map((item) => (
            <li>
              <a class="evs-past__card" href={item.href}>
                <span class="evs-past__poster">
                  <EventPoster cover={item.event.cover} title={item.event.title} width={420} />
                </span>
                <span class="evs-past__title">{item.event.title}</span>
                <span class="evs-past__when">{item.date.month} {item.date.year}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="event-shell">
          <nav class="evs-pager" data-evs-pager="past" hidden></nav>
        </div>
      </section>
    )
  }

  <section class="evs-signup theme-dark" aria-labelledby="evs-signup-title" data-evh>
    <div class="evh__photo" aria-hidden="true">
      <img src="/initiatives/energize-fest.webp" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="evh__veil" aria-hidden="true"></div>
    <div class="event-shell evs-signup__inner">
      <h2 id="evs-signup-title" class="evs-signup__title">Be there for the next one.</h2>
      <p>New dates and ticket news, sent straight to you.</p>
      <button type="button" class="event-btn event-btn--accent event-btn--big" {...updates}>Join the event list</button>
    </div>
  </section>

  <DuotoneFilter />
  <SubscribeDialog />
</main>

<script>
  import { initHeroes } from '../../lib/events/hero';
  import { createPager } from '../../lib/ui/pagination';

  const root = document.querySelector<HTMLElement>('[data-evs]');
  initHeroes(root ?? document);

  // Upcoming and past events page in place (?page=2, ?past=2). Every event stays in the HTML.
  root?.querySelectorAll<HTMLElement>('[data-evs-pages]').forEach((list) => {
    const key = list.dataset.evsPages ?? 'page';
    const nav = root.querySelector<HTMLElement>(`[data-evs-pager="${key}"]`);
    if (!nav) return;
    const items = Array.from(list.children) as HTMLElement[];
    const pager = createPager({
      nav,
      pageSize: Number(list.dataset.pageSize ?? 6),
      param: key,
      scrollTarget: list.closest('section'),
      label: key === 'past' ? 'Past events pages' : 'Upcoming events pages',
    });
    pager.render(items, items);
  });
</script>
