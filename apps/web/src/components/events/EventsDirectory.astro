---
import type { EventDetail } from '@energize/shared';
import EventPoster from './EventPoster.astro';
import SubscribeDialog from '../forms/SubscribeDialog.astro';
import { eventDateParts, formatEventLocation } from '../../lib/events/format';
import { getEventPosterUrl } from '../../lib/events/media';
import '../../styles/events.css';

interface Props {
  upcoming: EventDetail[];
  past: EventDetail[];
}

const { upcoming, past } = Astro.props;
const [lead, ...moreUpcoming] = upcoming;

const getEvent = (event: EventDetail) => ({
  event,
  href: `/events/${event.slug}`,
  date: eventDateParts(event.startDate),
  venue: formatEventLocation(event.location),
  ticketLabel: event.ctaLabel || 'Get tickets',
});

const leadEvent = lead ? getEvent(lead) : null;
const leadPoster = lead ? getEventPosterUrl(lead.cover, 1600) : null;
const moreEvents = moreUpcoming.map(getEvent);
const updates = {
  'data-subscribe-open': '',
  'data-subscribe-title': 'Get event updates',
  'data-subscribe-lead': 'New dates and ticket news, sent to your inbox.',
};
---

<main class="event-world events-index">
  <header class="event-shell events-intro">
    <div class="events-intro__title">
      <p class="events-intro__kicker">Energize Music live</p>
      <h1>Events</h1>
    </div>
    <p>Good music is better in a room full of people. Find the next one.</p>
  </header>

  {
    leadEvent ? (
      <article class="event-shell event-feature">
        <div class="event-feature__art">
          <a class="event-mosaic" href={leadEvent.href} aria-label={`View ${leadEvent.event.title}`} data-event-mosaic>
            {leadPoster ? (
              <>
                <span class="event-mosaic__tile event-mosaic__tile--one"><img src={leadPoster} alt="" /></span>
                <span class="event-mosaic__tile event-mosaic__tile--two"><img src={leadPoster} alt="" /></span>
                <span class="event-mosaic__tile event-mosaic__tile--three"><img src={leadPoster} alt="" /></span>
                <span class="event-mosaic__tile event-mosaic__tile--four"><img src={leadPoster} alt="" /></span>
                <span class="event-mosaic__tile event-mosaic__tile--five"><img src={leadPoster} alt="" /></span>
              </>
            ) : (
              <span class="event-mosaic__blank">{leadEvent.event.title}</span>
            )}
            <span class="event-mosaic__date" aria-hidden="true">{leadEvent.date.day}</span>
            <span class="event-mosaic__month" aria-hidden="true">{leadEvent.date.monthShort}</span>
          </a>
        </div>

        <div class="event-feature__copy">
          <p class="event-feature__when">
            <span class="event-feature__day">{leadEvent.date.day}</span>
            <span>{leadEvent.date.month} {leadEvent.date.year}</span>
            <span>{leadEvent.date.weekday} at {leadEvent.date.time}</span>
          </p>
          <h2><a href={leadEvent.href}>{leadEvent.event.title}</a></h2>
          {leadEvent.event.subtitle && <p class="event-feature__summary">{leadEvent.event.subtitle}</p>}
          <p class="event-feature__place"><span>Venue</span>{leadEvent.venue}</p>
          {leadEvent.event.host && <p class="event-feature__host">Hosted by {leadEvent.event.host}</p>}
          <div class="event-feature__actions">
            {leadEvent.event.ticketUrl && (
              <a class="event-btn event-btn--solid" href={leadEvent.event.ticketUrl} target="_blank" rel="noopener noreferrer">
                {leadEvent.ticketLabel}
              </a>
            )}
            <a class="event-textlink" href={leadEvent.href}>See event details</a>
          </div>
        </div>
      </article>
    ) : (
      <section class="event-shell events-empty">
        <h2>The next show is taking shape.</h2>
        <p>Join the list and we will tell you when the date is ready.</p>
        <button type="button" class="event-btn event-btn--solid" {...updates}>Get event updates</button>
      </section>
    )
  }

  {
    moreEvents.length > 0 && (
      <section class="event-shell events-more" aria-labelledby="events-more-title">
        <h2 id="events-more-title">More dates</h2>
        <ol>
          {moreEvents.map((item) => (
            <li>
              <a href={item.href} class="events-more__link">
                <span class="events-more__date">{item.date.day}<small>{item.date.monthShort}</small></span>
                <span class="events-more__name">{item.event.title}</span>
                <span class="events-more__place">{item.venue}</span>
                <span class="events-more__open">View event</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="events-past" aria-labelledby="events-past-title">
        <div class="event-shell events-past__head">
          <h2 id="events-past-title">Past events</h2>
          <p>Good nights deserve another look.</p>
        </div>
        <ul class="events-past__rail">
          {past.map((event) => {
            const item = getEvent(event);
            return (
              <li>
                <EventPoster cover={event.cover} title={event.title} href={item.href} width={520} />
                <h3><a href={item.href}>{event.title}</a></h3>
                <p>{item.date.month} {item.date.year}</p>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section class="event-shell events-signup" aria-labelledby="events-signup-title">
    <h2 id="events-signup-title">Be there for the next one.</h2>
    <p>New dates and ticket news, sent straight to you.</p>
    <button type="button" class="event-btn event-btn--solid" {...updates}>Join the event list</button>
  </section>

  <SubscribeDialog />
</main>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (finePointer && !reducedMotion) {
    document.querySelectorAll<HTMLElement>('[data-event-mosaic]').forEach((mosaic) => {
      mosaic.addEventListener('pointermove', (event) => {
        const bounds = mosaic.getBoundingClientRect();
        mosaic.style.setProperty('--mosaic-x', `${((event.clientX - bounds.left) / bounds.width - 0.5).toFixed(3)}`);
        mosaic.style.setProperty('--mosaic-y', `${((event.clientY - bounds.top) / bounds.height - 0.5).toFixed(3)}`);
      });
      mosaic.addEventListener('pointerleave', () => {
        mosaic.style.setProperty('--mosaic-x', '0');
        mosaic.style.setProperty('--mosaic-y', '0');
      });
    });
  }
</script>
