---
/**
 * SVG filter that turns a photo into a duotone in the site colours:
 * shadows go to near-black, mid-tones to the brand blue, highlights to a pale blue-white.
 * Apply with `filter: url(#ev-duotone)`. Render once per page.
 */
---

<svg class="ev-duotone-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="ev-duotone" color-interpolation-filters="sRGB">
    <feColorMatrix type="matrix" values="0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0.3 0.59 0.11 0 0  0 0 0 1 0" />
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.035 0.145 0.93" />
      <feFuncG type="table" tableValues="0.035 0.31 0.95" />
      <feFuncB type="table" tableValues="0.06 0.92 1" />
    </feComponentTransfer>
  </filter>
</svg>

<style>
  .ev-duotone-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
