---
/** Copy-link and social share buttons for an event page. */
interface Props {
  title: string;
  summary?: string;
  shareUrl: string;
}

const { title, summary, shareUrl } = Astro.props;
const displayUrl = shareUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const encodedUrl = encodeURIComponent(shareUrl);
const encodedText = encodeURIComponent(summary || title);
const shareLinks = [
  { label: 'X', icon: 'x', href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}` },
  { label: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { label: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { label: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${shareUrl}`)}` },
] as const;
---

<div class="event-share">
  <button type="button" class="event-share__copy" data-copy-link data-copy-url={shareUrl}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path
        d="M10 13a5 5 0 0 0 7.54.54l1.92-1.92a5 5 0 0 0-7.07-7.07l-1.1 1.1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M14 11a5 5 0 0 0-7.54-.54L4.54 12.38a5 5 0 0 0 7.07 7.07l1.1-1.1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span data-copy-text aria-live="polite">Copy {displayUrl}</span>
  </button>
  <ul class="event-share__list">
    {
      shareLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="event-share__icon"
            aria-label={`Share on ${link.label}`}
            title={link.label}
          >
            {link.icon === 'x' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L2.25 2.25h7.09l4.261 5.669L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                />
              </svg>
            )}
            {link.icon === 'facebook' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M22 12.07C22 6.48 17.52 2 11.93 2S1.86 6.48 1.86 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.02H7.9v-2.91h2.4V9.84c0-2.37 1.41-3.68 3.57-3.68 1.03 0 2.11.18 2.11.18v2.32h-1.19c-1.17 0-1.54.73-1.54 1.48v1.78h2.62l-.42 2.91h-2.2V22c4.78-.75 8.44-4.91 8.44-9.93z"
                />
              </svg>
            )}
            {link.icon === 'linkedin' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V23h-4V8.5zM8.5 8.5h3.8v2h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-6.4c0-1.53-.03-3.5-2.13-3.5-2.13 0-2.46 1.66-2.46 3.38V23h-4V8.5z"
                />
              </svg>
            )}
            {link.icon === 'whatsapp' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const copyText = copyButton?.querySelector<HTMLElement>('[data-copy-text]');
  if (copyButton && copyText) {
    const url = copyButton.dataset.copyUrl ?? window.location.href;
    const idleText = copyText.textContent ?? '';
    let reset = 0;

    copyButton.addEventListener('click', async () => {
      window.clearTimeout(reset);
      try {
        await navigator.clipboard.writeText(url);
        copyText.textContent = 'Link copied';
      } catch {
        copyText.textContent = 'Could not copy. Copy it from the address bar.';
      }
      reset = window.setTimeout(() => {
        copyText.textContent = idleText;
      }, 2200);
    });
  }
</script>

<style>
  .event-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .event-share__copy {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.6rem;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: left;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  .event-share__copy:hover {
    color: var(--color-accent);
  }

  .event-share__copy svg {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  .event-share__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-share__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: var(--color-surface);
    color: var(--color-fg);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .event-share__icon:hover,
  .event-share__icon:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .event-share__icon svg {
    width: 1rem;
    height: 1rem;
  }
</style>
