---
import type { PostCard } from '@energize/shared';
import { focusPosition, responsiveImage } from '../../lib/blog/images';
import { authorNames, formatPostDate, readingLabel } from '../../lib/blog/format';

interface Props {
  post: PostCard;
  /** Featured: the large split card at the top of the blog. Compact: small cards under a post. */
  variant?: 'default' | 'featured' | 'compact';
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
  /** Rendered hidden for pages after the first; the pager script shows it when its page is opened. */
  hidden?: boolean;
}

const { post, variant = 'default', headingLevel = 'h3', eager = false, hidden = false } = Astro.props;
const Heading = headingLevel;
const isFeatured = variant === 'featured';
const image = post.mainImage
  ? responsiveImage(post.mainImage, { maxWidth: isFeatured ? 1600 : 960, ratio: isFeatured ? 4 / 3 : 3 / 2 })
  : null;
const sizes = isFeatured ? '(min-width: 1024px) 40rem, 100vw' : '(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw';
const alt = post.mainImage?.alt?.trim() || '';
const searchText = [post.title, post.excerpt, post.category?.title, authorNames(post.authors)].filter(Boolean).join(' ').toLowerCase();
---

<article
  class:list={['post-card', `post-card--${variant}`]}
  data-post-card
  data-category={post.category?.slug ?? ''}
  data-search={searchText}
  hidden={hidden}
>
  <a href={`/blog/${post.slug}`} class="post-card__link" aria-label={post.title}></a>
  <div class="post-card__media">
    {
      image ? (
        <img
          src={image.src}
          srcset={image.srcset}
          sizes={sizes}
          width={image.width}
          height={image.height}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
          style={`object-position:${focusPosition(post.mainImage)};${image.lqip ? `background-image:url('${image.lqip}')` : ''}`}
        />
      ) : (
        <div class="post-card__placeholder" aria-hidden="true">
          <span>{post.title.charAt(0)}</span>
        </div>
      )
    }
  </div>
  <div class="post-card__body">
    <p class="post-card__meta">
      {post.category?.title && <span class="post-card__category">{post.category.title}</span>}
      <time datetime={post.publishedAt}>{formatPostDate(post.publishedAt, 'short')}</time>
    </p>
    <Heading class="post-card__title">{post.title}</Heading>
    {variant !== 'compact' && <p class="post-card__excerpt">{post.excerpt}</p>}
    <p class="post-card__foot">
      <span>{authorNames(post.authors)}</span>
      <span aria-hidden="true">·</span>
      <span>{readingLabel(post.readingMinutes)}</span>
    </p>
    {isFeatured && (
      <span class="post-card__cta" aria-hidden="true">
        Read the story
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    )}
  </div>
</article>
