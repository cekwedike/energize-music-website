---
import type { NewsPostSummary } from '@energize/shared';
import {
  formatSidebarDate,
  getPostCoverUrl,
} from '../../lib/blogs/display';

interface Props {
  featuredPosts: NewsPostSummary[];
  latestPosts: NewsPostSummary[];
}

const { featuredPosts, latestPosts } = Astro.props;
---

<aside class="blogs-sidebar" data-blogs-sidebar aria-label="Featured and latest stories">
  {
    featuredPosts.length > 0 ? (
      <section class="blogs-sidebar__section" aria-labelledby="blogs-sidebar-featured">
        <header class="blogs-sidebar__header">
          <h2 id="blogs-sidebar-featured" class="blogs-sidebar__title font-display">Featured</h2>
          <span class="blogs-sidebar__rule" aria-hidden="true"></span>
        </header>

        <ul class="blogs-sidebar__list">
          {
            featuredPosts.map((post) => {
              const thumbUrl = getPostCoverUrl(post, 160, 160);
              const dateLabel = formatSidebarDate(post.date);

              return (
                <li class="blogs-sidebar__item">
                  <a href={`/blogs/${post.slug}`} class="blogs-sidebar__link group">
                    <span class="blogs-sidebar__thumb-wrap">
                      <img
                        src={thumbUrl}
                        alt=""
                        width={80}
                        height={80}
                        loading="lazy"
                        decoding="async"
                        class="blogs-sidebar__thumb"
                      />
                    </span>
                    <span class="blogs-sidebar__meta">
                      <span class="blogs-sidebar__date">{dateLabel}</span>
                      <span class="blogs-sidebar__post-title">{post.title}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    ) : null
  }

  {
    latestPosts.length > 0 ? (
      <section class="blogs-sidebar__section" aria-labelledby="blogs-sidebar-latest">
        <header class="blogs-sidebar__header">
          <h2 id="blogs-sidebar-latest" class="blogs-sidebar__title font-display">Latest</h2>
          <span class="blogs-sidebar__rule" aria-hidden="true"></span>
        </header>

        <ul class="blogs-sidebar__list">
          {
            latestPosts.map((post) => {
              const thumbUrl = getPostCoverUrl(post, 160, 160);
              const dateLabel = formatSidebarDate(post.date);

              return (
                <li class="blogs-sidebar__item">
                  <a href={`/blogs/${post.slug}`} class="blogs-sidebar__link group">
                    <span class="blogs-sidebar__thumb-wrap">
                      <img
                        src={thumbUrl}
                        alt=""
                        width={80}
                        height={80}
                        loading="lazy"
                        decoding="async"
                        class="blogs-sidebar__thumb"
                      />
                    </span>
                    <span class="blogs-sidebar__meta">
                      <span class="blogs-sidebar__date">{dateLabel}</span>
                      <span class="blogs-sidebar__post-title">{post.title}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    ) : null
  }
</aside>

<style>
  .blogs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .blogs-sidebar {
      position: sticky;
      top: 6.5rem;
    }
  }

  .blogs-sidebar__section + .blogs-sidebar__section {
    padding-top: 0.25rem;
  }

  .blogs-sidebar__header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .blogs-sidebar__title {
    flex-shrink: 0;
    font-size: 1.375rem;
    line-height: 1.1;
    color: var(--color-paper);
  }

  .blogs-sidebar__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
  }

  .blogs-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .blogs-sidebar__link {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blogs-sidebar__link:hover {
    opacity: 0.92;
  }

  .blogs-sidebar__link:hover .blogs-sidebar__post-title {
    color: var(--color-glow);
  }

  .blogs-sidebar__thumb-wrap {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--color-ink-raised);
  }

  .blogs-sidebar__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .blogs-sidebar__link:hover .blogs-sidebar__thumb {
    transform: scale(1.05);
  }

  .blogs-sidebar__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding-top: 0.15rem;
  }

  .blogs-sidebar__date {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.45);
  }

  .blogs-sidebar__post-title {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.25;
    color: var(--color-paper);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
