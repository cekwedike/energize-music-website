---
interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<section class="blogs-header" data-blogs-header aria-labelledby="blogs-page-title">
  <div class="blogs-header__mesh" aria-hidden="true"></div>
  <div class="blogs-header__inner mx-auto max-w-3xl px-5 py-14 text-center sm:px-6 sm:py-16 lg:py-20">
    <p class="blogs-header__eyebrow">Blog</p>

    <h1 id="blogs-page-title" class="blogs-header__title font-display">
      Discover our latest news
    </h1>

    <p class="blogs-header__lead">
      Announcements, release notes, and behind-the-scenes stories from Energize Music. Read what is moving across the label right now.
    </p>

    {
      totalCount > 0 ? (
        <form class="blogs-header__search" role="search" aria-label="Search blog stories" data-blogs-search-form>
          <label class="sr-only" for="blogs-search-input">Search stories</label>
          <div class="blogs-header__search-field">
            <svg class="blogs-header__search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Zm0-2a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11Z"
                fill="currentColor"
              />
              <path d="M15.74 15.74 20 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <input
              id="blogs-search-input"
              type="search"
              name="q"
              class="blogs-header__search-input"
              placeholder="Search stories"
              autocomplete="off"
              data-blogs-search-input
            />
          </div>
          <button type="submit" class="blogs-header__search-btn">Search</button>
        </form>
      ) : null
    }
  </div>
</section>

<script>
  function initBlogsSearch(): () => void {
    const form = document.querySelector<HTMLFormElement>('[data-blogs-search-form]');
    const input = document.querySelector<HTMLInputElement>('[data-blogs-search-input]');
    const grid = document.querySelector<HTMLElement>('[data-blogs-grid]');
    const emptyState = document.querySelector<HTMLElement>('[data-blogs-empty]');

    if (!input || !grid) return () => {};

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-blogs-card]'));

    const applyFilter = () => {
      const query = input.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.dataset.title ?? '';
        const matches = query.length === 0 || title.includes(query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0 || query.length === 0;
      }
    };

    const onInput = () => applyFilter();
    const onSubmit = (event: Event) => {
      event.preventDefault();
      applyFilter();
    };

    input.addEventListener('input', onInput);
    form?.addEventListener('submit', onSubmit);

    return () => {
      input.removeEventListener('input', onInput);
      form?.removeEventListener('submit', onSubmit);
    };
  }

  const cleanup = initBlogsSearch();
  window.addEventListener('pagehide', cleanup, { once: true });
</script>

<style>
  .blogs-header {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .blogs-header__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(77, 168, 255, 0.14), transparent 58%),
      linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-raised) 100%);
    pointer-events: none;
  }

  .blogs-header__inner {
    position: relative;
  }

  .blogs-header__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(77, 168, 255, 0.28);
    background: rgba(77, 168, 255, 0.08);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-glow);
  }

  .blogs-header__title {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-paper);
  }

  .blogs-header__lead {
    margin: 1.25rem auto 0;
    max-width: 38rem;
    font-size: var(--text-lead);
    line-height: 1.65;
    color: rgba(250, 250, 248, 0.68);
  }

  .blogs-header__search {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .blogs-header__search {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .blogs-header__search-field {
    position: relative;
    flex: 1;
  }

  .blogs-header__search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    transform: translateY(-50%);
    color: rgba(250, 250, 248, 0.45);
    pointer-events: none;
  }

  .blogs-header__search-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-paper);
    font-size: 0.9375rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .blogs-header__search-input::placeholder {
    color: rgba(250, 250, 248, 0.42);
  }

  .blogs-header__search-input:focus {
    outline: none;
    border-color: rgba(77, 168, 255, 0.45);
    background: rgba(255, 255, 255, 0.06);
  }

  .blogs-header__search-btn {
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    border: none;
    background: var(--color-glow);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .blogs-header__search-btn:hover {
    background: rgba(77, 168, 255, 0.88);
  }
</style>
