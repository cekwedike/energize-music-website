---
import type { NewsPost } from '@energize/shared';
import { urlForImage } from '../../lib/sanity/client';

interface Props {
  posts: NewsPost[];
}

const { posts } = Astro.props;
---

<section class="zine-spread mx-auto max-w-7xl px-5 pb-24 sm:px-6 sm:pb-32" data-zine-spread aria-label="Blog posts">
  {
    posts.length === 0 ? (
      <p class="py-20 text-center text-paper/55">Posts will appear here once added in Sanity Studio.</p>
    ) : (
      <div class="zine-spread__list">
        {
          posts.map((post, index) => {
            const coverUrl = urlForImage(post.cover).width(900).height(600).fit('crop').auto('format').url();
            const date = new Date(post.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            const isLead = index === 0;
            const tag = post.tags?.[0] ?? 'Story';
            const offset = index % 3;

            return (
              <article
                class:list={['zine-card group', isLead && 'zine-card--lead', `zine-card--offset-${offset}`]}
                data-zine-card
                style={`--card-i: ${index}`}
              >
                <a href={`/blogs/${post.slug}`} class="zine-card__link">
                  <div class="zine-card__ribbon">{tag}</div>
                  <span class="zine-card__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <div class="zine-card__media">
                    <img src={coverUrl} alt={post.cover.alt ?? post.title} loading={index < 3 ? 'eager' : 'lazy'} class="zine-card__photo" />
                    <div class="zine-card__halftone" aria-hidden="true"></div>
                  </div>

                  <div class="zine-card__body">
                    <time class="zine-card__date" datetime={post.date}>{date}</time>
                    <h2 class="zine-card__title">{post.title}</h2>
                    <span class="zine-card__read">Read →</span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    )
  }
</section>

<style>
  .zine-spread__list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 3rem;
  }

  @media (min-width: 768px) {
    .zine-spread__list {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2rem 1.5rem;
      align-items: start;
    }
  }

  .zine-card {
    position: relative;
  }

  @media (min-width: 768px) {
    .zine-card {
      grid-column: span 5;
    }

    .zine-card--lead {
      grid-column: span 7;
      grid-row: span 2;
    }

    .zine-card--offset-1 {
      transform: translateY(2.5rem);
    }

    .zine-card--offset-2 {
      transform: translateY(-1rem);
    }
  }

  .zine-card__link {
    display: block;
    position: relative;
    text-decoration: none;
    border: 2px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.02);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .zine-card__link:hover,
  .zine-card__link:focus-visible {
    transform: rotate(-0.5deg) translateY(-4px);
    border-color: var(--color-glow);
    box-shadow: 8px 8px 0 rgba(77, 168, 255, 0.15);
  }

  .zine-card--lead .zine-card__link:hover {
    transform: rotate(0.5deg) translateY(-6px);
  }

  .zine-card__ribbon {
    position: absolute;
    top: 0;
    right: 1.5rem;
    z-index: 3;
    padding: 0.35rem 0.75rem;
    background: var(--color-glow);
    color: var(--color-ink);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transform: translateY(-50%);
  }

  .zine-card__index {
    position: absolute;
    left: -0.5rem;
    top: 1rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }

  .zine-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .zine-card--lead .zine-card__media {
    aspect-ratio: 16 / 11;
  }

  .zine-card__photo {
    height: 100%;
    width: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.9);
    transition: transform 0.7s ease, filter 0.5s ease;
  }

  .zine-card__link:hover .zine-card__photo {
    transform: scale(1.04);
    filter: contrast(1.1) saturate(1);
  }

  .zine-card__halftone {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 80%, rgba(77, 168, 255, 0.15), transparent 50%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .zine-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
  }

  .zine-card__date {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.4);
  }

  .zine-card__title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-paper);
    transition: color 0.3s ease;
  }

  .zine-card--lead .zine-card__title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
  }

  .zine-card__link:hover .zine-card__title {
    color: var(--color-glow);
  }

  .zine-card__read {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.35);
    transition: color 0.3s ease;
  }

  .zine-card__link:hover .zine-card__read {
    color: var(--color-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .zine-card--offset-1,
    .zine-card--offset-2 {
      transform: none;
    }

    .zine-card__link:hover {
      transform: none;
    }

    .zine-card__link:hover .zine-card__photo {
      transform: none;
    }
  }
</style>
