---
import type { EnrichedRelease } from '@energize/shared';

interface Props {
  releases: EnrichedRelease[];
  totalCount: number;
}

// releases and totalCount stay in Props so the page call does not change.
---

<section class="releases-hero relative overflow-hidden border-b border-[var(--color-line)]" data-releases-hero>
  <div class="relative mx-auto max-w-7xl px-5 pb-8 pt-20 sm:px-6 sm:pb-10 sm:pt-24">
    <div class="max-w-2xl">
      <p class="releases-hero__reveal releases-hero__reveal-1 text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">
        Catalog
      </p>

      <h1 class="releases-hero__headline releases-hero__reveal releases-hero__reveal-2 mt-5 font-display text-[clamp(2.75rem,2rem+5vw,5.5rem)] leading-[0.9] tracking-tight text-fg">
        Releases
      </h1>

      <p class="releases-hero__reveal releases-hero__reveal-3 text-lead mt-5 max-w-xl text-fg">
        Browse every single, EP, and album on the Energize Music roster. Filter by artist or scroll the full stage lineup.
      </p>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-releases-hero]');
  if (hero) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      hero.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => hero.classList.add('is-visible'));
    }
  }
</script>

<style>
  .releases-hero {
    min-height: 0;
  }

  .releases-hero__headline {
    position: relative;
    z-index: 1;
  }

  .releases-hero__reveal {
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .releases-hero.is-visible .releases-hero__reveal-1 { transition-delay: 0ms; }
  .releases-hero.is-visible .releases-hero__reveal-2 { transition-delay: 80ms; }
  .releases-hero.is-visible .releases-hero__reveal-3 { transition-delay: 160ms; }

  .releases-hero.is-visible .releases-hero__reveal {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .releases-hero__reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
