---
import type { EnrichedRelease, ReleaseType } from '@energize/shared';

interface Props {
  releases: EnrichedRelease[];
}

const { releases } = Astro.props;

const typeLabel: Record<ReleaseType, string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};

const spotlightId = `release-spotlight-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="release-spotlight" aria-labelledby={`${spotlightId}-heading`} data-release-spotlight>
  <div class="release-spotlight__glow" aria-hidden="true"></div>
  <div class="release-spotlight__frame">
    {
      releases.length > 1 ? (
        <div class="release-spotlight__tabs" role="tablist" aria-label="Featured releases">
          {
            releases.map((release, index) => (
              <button
                type="button"
                class="release-spotlight__tab"
                role="tab"
                id={`${spotlightId}-tab-${index}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`${spotlightId}-panel-${index}`}
                data-spotlight-tab
                data-index={index}
              >
                {release.displayTitle}
              </button>
            ))
          }
        </div>
      ) : null
    }

    {
      releases.map((release, index) => {
        const releaseTypeLabel = typeLabel[release.type];
        const coverUrl = release.coverUrl;
        const coverAlt = release.cover?.alt ?? release.displayTitle;
        const artistLine =
          release.artistNames.length > 0 ? release.artistNames.join(', ') : 'Energize Music';
        const releaseYear = new Date(release.releaseDate).getFullYear();

        return (
          <div
            class="release-spotlight__panel"
            role="tabpanel"
            id={`${spotlightId}-panel-${index}`}
            aria-labelledby={`${spotlightId}-tab-${index}`}
            data-spotlight-panel
            data-index={index}
            hidden={index !== 0}
          >
            <div class="release-spotlight__copy">
              <p class="release-spotlight__eyebrow">Release spotlight</p>
              <h2
                id={index === 0 ? `${spotlightId}-heading` : undefined}
                class="release-spotlight__title"
              >
                {release.displayTitle}
              </h2>
              <p class="release-spotlight__artist">{artistLine}</p>
              <p class="release-spotlight__meta">
                {releaseTypeLabel} &middot; {releaseYear}
              </p>
              <div class="release-spotlight__actions">
                <a
                  href={`/releases/${release.slug}`}
                  class="release-spotlight__cta release-spotlight__cta--primary"
                >
                  View Release
                </a>
              </div>
            </div>

            <div class="release-spotlight__visual">
              {
                coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={coverAlt}
                    width={640}
                    height={640}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="release-spotlight__cover"
                  />
                ) : (
                  <div class="release-spotlight__cover release-spotlight__cover--fallback">
                    No cover
                  </div>
                )
              }
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-release-spotlight]');
  if (root) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-spotlight-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-spotlight-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = tab.dataset.index ?? '0';

        tabs.forEach((item) => {
          item.setAttribute('aria-selected', item === tab ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.index === index;
          panel.hidden = !isActive;
        });
      });
    });
  }
</script>

<style>
  .release-spotlight {
    position: relative;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-radius: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 13.2%, transparent);
    background:
      radial-gradient(ellipse 80% 70% at 0% 50%, color-mix(in srgb, var(--color-accent) 7.2%, transparent), transparent 60%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-fg) 3%, transparent), color-mix(in srgb, var(--color-fg) 1%, transparent));
    overflow: hidden;
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--color-fg) 5%, transparent) inset,
      0 24px 64px color-mix(in srgb, var(--color-shadow) 14%, transparent);
  }

  .release-spotlight__glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: min(420px, 60vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 8.4%, transparent);
    filter: blur(70px);
    pointer-events: none;
    opacity: 0.75;
  }

  .release-spotlight__frame {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .release-spotlight__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0.15rem;
  }

  .release-spotlight__tabs::-webkit-scrollbar {
    display: none;
  }

  .release-spotlight__tab {
    flex-shrink: 0;
    max-width: min(100%, 14rem);
    padding: 0.4375rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-fg) 12%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .release-spotlight__tab:hover,
  .release-spotlight__tab:focus-visible {
    color: var(--color-fg);
    border-color: color-mix(in srgb, var(--color-accent) 21%, transparent);
  }

  .release-spotlight__tab[aria-selected='true'] {
    color: var(--color-fg);
    border-color: color-mix(in srgb, var(--color-accent) 27%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7.2%, transparent);
  }

  .release-spotlight__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .release-spotlight__panel {
      grid-template-columns: minmax(0, 1.05fr) minmax(220px, 0.95fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .release-spotlight__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .release-spotlight__title {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.35rem + 2vw, 3.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }

  .release-spotlight__artist {
    margin: 0.875rem 0 0;
    font-size: clamp(0.9375rem, 0.9rem + 0.25vw, 1.125rem);
    color: var(--color-fg);
  }

  .release-spotlight__meta {
    margin: 0.625rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg);
  }

  .release-spotlight__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .release-spotlight__cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.125rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease,
      color 0.25s ease;
  }

  .release-spotlight__cta--primary {
    border: 1px solid color-mix(in srgb, var(--color-accent) 27%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8.4%, transparent);
    color: var(--color-fg);
  }

  .release-spotlight__cta--listen {
    border: 1px solid color-mix(in srgb, var(--color-fg) 18%, transparent);
    background: color-mix(in srgb, var(--color-fg) 4%, transparent);
    color: var(--color-fg);
  }

  .release-spotlight__cta--ghost {
    border: 1px solid transparent;
    color: var(--color-fg);
  }

  .release-spotlight__cta:hover,
  .release-spotlight__cta:focus-visible {
    transform: translateY(-1px);
    color: var(--color-accent);
  }

  .release-spotlight__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 280px);
  }

  @media (min-width: 900px) {
    .release-spotlight__visual {
      justify-self: end;
      width: min(100%, 320px);
    }
  }


  .release-spotlight__cover {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-card);
    object-fit: cover;
    box-shadow: var(--shadow-card);
  }

  .release-spotlight__cover--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-fg) 5%, transparent);
    color: var(--color-fg);
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .release-spotlight__cta:hover,
    .release-spotlight__cta:focus-visible {
      transform: none;
    }
  }
</style>
