---
import type { GroupedArtistReleases } from '../../lib/releases/groupReleasesByArtist';
import { sanityImageUrl } from '../../lib/sanity/client';
import ReleasesCatalogCard from './ReleasesCatalogCard.astro';

interface Props {
  group: GroupedArtistReleases;
  index: number;
}

const { group, index } = Astro.props;

const portraitUrl = sanityImageUrl(group.photo, {
  width: 900,
  height: 1120,
  fit: 'crop',
});

const releaseLabel =
  group.releases.length === 1 ? '1 release' : `${group.releases.length} releases`;

const tintVariant = index % 2 === 0 ? 'navy' : 'blue';
---

<section
  class="artist-stage"
  data-releases-section
  data-artist-slug={group.slug}
  data-index={index}
  data-filtered="visible"
  data-tint={tintVariant}
  style="--stage-accent: var(--color-glow);"
  aria-labelledby={`releases-artist-${group.slug}`}
>
  <div class="artist-stage__backdrop" aria-hidden="true"></div>

  <div class="artist-stage__inner">
    <div class="artist-stage__portrait-zone" data-motion="stage-identity">
      <div class="artist-stage__portrait-wrap">
        {
          portraitUrl ? (
            <img
              src={portraitUrl}
              alt=""
              width={900}
              height={1120}
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
              class="artist-stage__portrait"
            />
          ) : (
            <span class="artist-stage__portrait artist-stage__portrait--placeholder" aria-hidden="true" />
          )
        }
        <div class="artist-stage__portrait-wash"></div>
      </div>

      <div class="artist-stage__identity">
        <p class="artist-stage__eyebrow">Artist</p>
        <h2 id={`releases-artist-${group.slug}`} class="artist-stage__name">
          <a href={`/artists/${group.slug}`} class="artist-stage__name-link">
            {group.name}
          </a>
        </h2>
        {
          group.tagline?.trim() ? (
            <p class="artist-stage__tagline">{group.tagline.trim()}</p>
          ) : null
        }
        <p class="artist-stage__count">{releaseLabel}</p>
      </div>
    </div>

    <div class="artist-stage__catalog">
      <ul class="artist-stage__catalog-row">
        {
          group.releases.map((release) => (
            <li data-motion="reveal">
              <ReleasesCatalogCard release={release} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .artist-stage {
    --stage-tint: rgba(77, 168, 255, 0.05);
    position: relative;
    scroll-margin-top: 5rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0;
  }

  .artist-stage[data-tint='navy'] {
    --stage-tint: rgba(37, 99, 235, 0.045);
  }

  .artist-stage[data-tint='blue'] {
    --stage-tint: rgba(77, 168, 255, 0.055);
  }

  .artist-stage__backdrop {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      linear-gradient(180deg, var(--stage-tint) 0%, transparent 100%),
      linear-gradient(90deg, rgba(11, 11, 13, 0.92) 0%, rgba(11, 11, 13, 0.78) 100%);
    pointer-events: none;
  }

  .artist-stage__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .artist-stage__inner {
      grid-template-columns: minmax(0, 38%) minmax(0, 62%);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }
  }

  .artist-stage__portrait-zone {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .artist-stage__portrait-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    min-height: clamp(200px, 42vw, 300px);
    max-height: 320px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.42);
  }

  @media (min-width: 1024px) {
    .artist-stage__portrait-wrap {
      min-height: clamp(280px, 36vh, 420px);
      max-height: 460px;
      border-radius: 1.125rem;
    }
  }

  .artist-stage__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
  }

  .artist-stage__portrait--placeholder {
    display: block;
    min-height: inherit;
    background: rgba(255, 255, 255, 0.06);
  }

  .artist-stage__portrait-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 45%, rgba(11, 11, 13, 0.55) 100%),
      linear-gradient(135deg, rgba(77, 168, 255, 0.12) 0%, transparent 55%);
    pointer-events: none;
  }

  .artist-stage__identity {
    padding: 0;
  }

  .artist-stage__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--stage-accent);
  }

  .artist-stage__name {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 3.5vw, 4.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-paper);
  }

  .artist-stage__name-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .artist-stage__name-link:hover,
  .artist-stage__name-link:focus-visible {
    color: var(--stage-accent);
  }

  .artist-stage__tagline {
    margin: clamp(0.75rem, 2vw, 1rem) 0 0;
    max-width: 28rem;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-paper);
  }

  .artist-stage__count {
    margin: clamp(0.875rem, 2vw, 1.125rem) 0 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .artist-stage__catalog {
    min-width: 0;
    width: 100%;
    overflow: hidden;
  }

  .artist-stage__catalog-row {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  [data-motion='stage-identity'],
  [data-motion='reveal'] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-motion='stage-identity'],
    [data-motion='reveal'] {
      opacity: 1;
    }
  }
</style>
