---
import type { EnrichedRelease, ReleaseType } from '@energize/shared';

interface Props {
  release: EnrichedRelease;
}

const { release } = Astro.props as Props;
const coverUrl = release.coverUrl;
const year = new Date(release.releaseDate).getFullYear();

const typeLabel: Record<ReleaseType, string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};
const releaseTypeLabel = typeLabel[release.type];
const artistLine = release.artistNames.slice(0, 3).join(', ');
---

<a
  href={`/releases/${release.slug}`}
  data-type={release.type}
  data-year={year}
  class="release-card group block overflow-hidden rounded-xl bg-[var(--color-ink-raised)] transition duration-300 hover:-translate-y-1"
  style="--release-accent: var(--color-glow);"
>
  <div class="release-card__cover aspect-square overflow-hidden">
    {
      coverUrl ? (
        <img
          src={coverUrl}
          alt={release.cover?.alt ?? release.displayTitle}
          loading="lazy"
          referrerpolicy="no-referrer"
          decoding="async"
          class="release-card__image"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-white/[0.04] text-xs text-paper/40">
          No cover
        </div>
      )
    }
  </div>
  <div class="release-card__meta">
    <p class="release-card__title">{release.displayTitle}</p>
    {
      artistLine && (
        <p class="release-card__artists">{artistLine}</p>
      )
    }
    <p class="release-card__type">
      {releaseTypeLabel} &middot; {year}
    </p>
  </div>
</a>

<style>
  .release-card {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 8px 28px rgba(0, 0, 0, 0.32);
  }

  .release-card:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 16px 40px rgba(0, 0, 0, 0.42),
      0 0 24px color-mix(in srgb, var(--release-accent) 18%, transparent);
  }

  .release-card__cover {
    line-height: 0;
  }

  .release-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .release-card:hover .release-card__image {
    transform: scale(1.06);
  }

  .release-card__meta {
    position: relative;
    padding: 0.625rem 0.75rem 0.75rem;
    border-top: 1px solid transparent;
    transition:
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .release-card:hover .release-card__meta {
    border-top-color: color-mix(in srgb, var(--release-accent) 45%, transparent);
    background: color-mix(in srgb, var(--release-accent) 4%, transparent);
  }

  .release-card__title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-paper);
  }

  .release-card__artists {
    margin-top: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: rgba(250, 250, 248, 0.55);
  }

  .release-card__type {
    margin-top: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.45);
  }

  @media (min-width: 640px) {
    .release-card__meta {
      padding: 0.75rem 0.875rem 0.875rem;
    }

    .release-card__title {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .release-card:hover {
      transform: none;
    }

    .release-card:hover .release-card__image {
      transform: none;
    }
  }
</style>
