---
import type { Release, ReleaseType } from '@energize/shared';
import { sanityImageUrl } from '../../lib/sanity/client';

interface Props {
  release: Release;
}

const { release } = Astro.props as Props;
const coverUrl = sanityImageUrl(release.cover, { width: 600, height: 600, fit: 'crop' });
const year = new Date(release.releaseDate).getFullYear();

const typeLabel: Record<ReleaseType, string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};
const releaseTypeLabel = typeLabel[release.type];
---

<a
  href={`/releases/${release.slug}`}
  data-type={release.type}
  data-year={year}
  class="group block overflow-hidden rounded-lg border border-white/10 bg-white/[0.02] transition hover:border-[var(--color-accent)]/50"
>
  <div class="aspect-square overflow-hidden">
    {
      coverUrl ? (
        <img
          src={coverUrl}
          alt={release.cover?.alt ?? release.title}
          loading="lazy"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-white/[0.04] text-xs text-paper/40">No cover</div>
      )
    }
  </div>
  <div class="p-4">
    <p class="font-medium text-paper">{release.title}</p>
    <p class="mt-1 text-xs uppercase tracking-wide text-paper/50">
      {releaseTypeLabel} &middot; {year}
    </p>
  </div>
</a>
