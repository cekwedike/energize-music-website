---
import PortableText from '../portable/PortableText.astro';
import type { AboutPage, Page } from '@energize/shared';

interface Props {
  aboutPage: AboutPage | null;
  legacyPage: Page | null;
}

const { aboutPage, legacyPage } = Astro.props;

const hasIntro = aboutPage?.intro && aboutPage.intro.length > 0;
const hasLegacy = legacyPage && legacyPage.blocks.length > 0;
---

<section id="story" class="scroll-mt-24 border-b border-white/10">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
      <div class="about-scroll-reveal lg:sticky lg:top-28 lg:self-start">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-glow)]">Our story</p>
        <h2 class="text-h2 mt-4">Music with meaning</h2>
        <p class="mt-5 text-paper">
          From Lagos to the world: we create and curate sounds that carry faith, culture, and excellence.
        </p>

        <div class="about-story-visual mt-10 overflow-hidden rounded-2xl border border-white/10">
          <img
            src="/brand/logo.webp"
            alt="Energize Music logo"
            class="h-auto w-full bg-[var(--color-ink-raised)] p-8 object-contain"
            loading="lazy"
          />
        </div>

        <div class="mt-8 hidden h-24 w-px bg-gradient-to-b from-[var(--color-glow)]/60 to-transparent lg:block" aria-hidden="true"></div>
      </div>

      <div id="about-story-content" class="about-scroll-reveal about-story-content space-y-6 text-paper" style="--reveal-delay: 120ms">
        {
          hasIntro ? (
            <PortableText value={aboutPage!.intro!} />
          ) : hasLegacy ? (
            <PortableText value={legacyPage!.blocks} />
          ) : (
            <>
              <p class="text-lead text-paper">
                Energize Music is an Afro-gospel &amp; soul-fusion record label providing high-quality,
                family-friendly, uplifting music, built on the belief that music has the power to connect
                people and speak to audiences everywhere.
              </p>
              <p>
                We champion artists who blend African rhythm with gospel truth, creating a sound that
                resonates across generations and borders.
              </p>
              <p>
                Whether through releases, live experiences, or initiatives like NEXT and Energize Kids,
                our work is rooted in one conviction: music can inspire positive change.
              </p>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-story-visual {
    box-shadow: 0 16px 48px rgba(77, 168, 255, 0.06);
  }

  .about-story-content :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    margin-top: 2rem;
    color: var(--color-paper);
  }

  .about-story-content :global(h2:first-child) {
    margin-top: 0;
  }

  .about-story-content :global(p) {
    line-height: 1.75;
  }

  .about-scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .about-scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-scroll-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
