---
const story =
  'Energize Music is an Afro-gospel and soul-fusion record label based in Lagos, Nigeria, and part of Same Energy Global. We make high-quality, uplifting music for the whole family, built on the belief that music can connect people and reach audiences everywhere.';

const quote =
  'Through releases, live shows, NEXT, and Energize Kids, our work rests on one conviction: music can inspire positive change.';

const howWeWork = [
  { title: 'Sign', body: 'We find and develop artistes who blend African rhythm with gospel truth.' },
  { title: 'Release', body: 'We put out high-quality, family-friendly music made to travel beyond Nigeria.' },
  { title: 'Build', body: 'We grow the scene through NEXT, Energize Kids, and Energize Fest.' },
];
---

<section id="story" class="scroll-mt-24 border-b border-[var(--color-line)]">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-6 sm:py-28 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
    <div class="scroll-reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">Our story</p>
      <div class="about-story-copy mt-5 text-lead text-fg">
        <p>{story}</p>
      </div>
      <blockquote class="about-story-quote mt-10">
        <p>{quote}</p>
      </blockquote>
    </div>

    <div class="scroll-reveal" style="--reveal-delay: 120ms">
      <h2 class="text-h2">How the Label Works</h2>
      <ol class="mt-8 space-y-6">
        {
          howWeWork.map((item, i) => (
            <li class="about-story-step">
              <span class="about-story-step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display text-xl">{item.title}</h3>
                <p class="mt-1 text-[var(--color-muted)]">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about-story-copy :global(p) {
    line-height: 1.6;
  }

  .about-story-quote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-fg);
  }

  .about-story-step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }

  .about-story-step__num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-accent);
    padding-top: 0.35rem;
  }
</style>
