---
import TeamMemberCard from '../team/TeamMemberCard.astro';
import type { AboutPage, TeamMember } from '@energize/shared';

interface Props {
  team: TeamMember[];
  aboutPage: AboutPage | null;
}

const { team, aboutPage } = Astro.props;

const teamHeading = aboutPage?.teamSectionTitle || 'Meet Our Team';
const teamIntro =
  aboutPage?.teamSectionIntro ||
  'The people behind Energize Music: strategists, creatives, and builders shaping Afro-gospel culture.';
---

<section id="team" class="scroll-mt-24 border-b border-[var(--color-line)]" aria-labelledby="about-team-heading">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
    <div class="scroll-reveal max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">The team</p>
      <h2 id="about-team-heading" class="text-h2 mt-4">{teamHeading}</h2>
      <p class="mt-4 text-[var(--color-muted)]">{teamIntro}</p>
    </div>

    {
      team.length > 0 ? (
        <div class="about-team-grid mt-12">
          {team.map((member, i) => (
            <div class="scroll-reveal" style={`--reveal-delay: ${(i % 4) * 70}ms`}>
              <TeamMemberCard member={member} />
            </div>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-[var(--color-muted)]">Team profiles will appear here once published.</p>
      )
    }
  </div>
</section>

<style>
  .about-team-grid {
    display: grid;
    gap: 2.5rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1024px) {
    .about-team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
