---
import { HQ_URL } from '../../lib/nav';
import SectionTitle from '../ui/SectionTitle.astro';
import MediaCard from '../ui/MediaCard.astro';

// NEXT has no standalone site yet, so it points to Energize HQ.
const cards = [
  {
    title: 'Energize Kids',
    meta: 'energize-kids.com',
    body: 'Clean kids entertainment with music, Play Zone challenges and artist Xade.',
    href: 'https://energize-kids.com',
    image: '/initiatives/energize-kids.webp',
  },
  {
    title: 'NEXT',
    meta: 'Energize HQ',
    body: 'Pan-African Afrogospel talent competition. Finalists earn a spot on the ENERGIZE Afrogospel Album.',
    href: HQ_URL,
    image: '/initiatives/next.jpg',
  },
];
---

<section class="about-beyond" aria-labelledby="about-beyond-heading">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <SectionTitle id="about-beyond-heading" title="Beyond the Label" />
    <ul class="about-beyond__grid">
      {
        cards.map((card) => (
          <li class="scroll-reveal">
            <MediaCard
              href={card.href}
              image={card.image}
              title={card.title}
              meta={card.meta}
              subtitle={card.body}
              size={720}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-beyond {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--color-line);
  }

  .about-beyond__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 640px) {
    .about-beyond__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
