---
import { HQ_URL } from '../../lib/nav';

// NEXT has no standalone site yet, so it points to Energize HQ.
const cards = [
  {
    title: 'Energize Kids',
    body: 'Clean kids entertainment with music, Play Zone challenges and artist Xade.',
    href: 'https://energize-kids.com',
    linkLabel: 'energize-kids.com',
    image: '/initiatives/energize-kids.webp',
  },
  {
    title: 'NEXT',
    body: 'Pan-African Afrogospel talent competition. Finalists earn a spot on the ENERGIZE Afrogospel Album.',
    href: HQ_URL,
    linkLabel: 'Energize HQ',
    image: '/initiatives/next.jpg',
  },
];
---

<section class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-24" aria-labelledby="about-beyond-heading">
  <h2 id="about-beyond-heading" class="about-scroll-reveal text-h2">Beyond the label</h2>
  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    {
      cards.map((card) => (
        <li class="about-scroll-reveal">
          <a href={card.href} class="group block overflow-hidden rounded-2xl border border-white/10">
            <img
              src={card.image}
              alt=""
              width="800"
              height="600"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
            <span class="block p-6">
              <span class="block text-xl font-semibold text-paper">{card.title}</span>
              <span class="mt-2 block text-sm text-paper">{card.body}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-paper">
                {card.linkLabel}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
