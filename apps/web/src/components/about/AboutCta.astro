---
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-glow)]/10 via-transparent to-transparent" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-20 text-center sm:px-6 sm:py-24">
    <p class="about-scroll-reveal text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-glow)]">Join the movement</p>
    <h2 class="about-scroll-reveal text-h2 mx-auto mt-4 max-w-xl" style="--reveal-delay: 80ms">
      Be part of something bigger
    </h2>
    <p class="about-scroll-reveal mx-auto mt-4 max-w-lg text-paper" style="--reveal-delay: 160ms">
      Explore our artists, releases, and initiatives, or discover how you can get involved.
    </p>
    <div class="about-scroll-reveal mt-8 flex flex-wrap justify-center gap-3" style="--reveal-delay: 240ms">
      <a href="/artists" class="rounded-full bg-[var(--color-glow)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-glow)]/90">
        Our artists
      </a>
      <a href="/next" class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-paper transition hover:border-white/45 hover:bg-white/5">
        NEXT Competition
      </a>
    </div>
  </div>
</section>

<style>
  .about-scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .about-scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-scroll-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
