---
import Logo from '../ui/Logo.astro';

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = 'About Us' } = Astro.props;
---

<section class="about-hero relative overflow-hidden">
  <div class="about-hero__mesh" aria-hidden="true"></div>
  <div class="about-hero__grain" aria-hidden="true"></div>
  <div class="about-hero__glow about-hero__glow--left" aria-hidden="true"></div>
  <div class="about-hero__glow about-hero__glow--right" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-5 pb-20 pt-24 sm:px-6 sm:pb-32 sm:pt-36">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div>
        <div class="about-reveal about-reveal-1 mb-10 max-w-[280px] sm:max-w-[320px]">
          <Logo size="sm" />
        </div>
        <p class="about-reveal about-reveal-2 text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">
          {eyebrow}
        </p>
        <div class="about-reveal about-reveal-3 mt-4 h-px w-12 bg-[var(--color-accent)]" aria-hidden="true"></div>
        <h1 class="about-reveal about-reveal-4 text-display mt-8 max-w-3xl font-display leading-[0.95] tracking-tight">
          {title}
        </h1>
        <p class="about-reveal about-reveal-5 text-lead mt-8 max-w-xl text-fg">
          Afro-gospel and soul-fusion: uplifting music built on the belief that sound can connect people and speak to audiences everywhere.
        </p>

        <div class="about-reveal about-reveal-6 mt-12 flex flex-wrap gap-3">
          <a href="#story" class="rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-on-accent)] transition hover:bg-[var(--color-accent)]/90">
            Our story
          </a>
          <a href="#team" class="rounded-full border border-fg/25 px-6 py-3 text-sm font-semibold text-fg transition hover:border-fg/45 hover:bg-fg/5">
            Meet the team
          </a>
        </div>
      </div>

      <div class="about-reveal about-reveal-7 relative hidden lg:block">
        <div class="about-hero__visual relative aspect-[4/5] overflow-hidden rounded-2xl border border-fg/10">
          <img
            src="/initiatives/energize-fest.webp"
            alt="Energize Fest gathering with a global audience"
            class="h-full w-full object-cover object-center"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-[var(--color-bg)]/25 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--color-accent)]">From Lagos to the world</p>
            <p class="mt-2 max-w-xs text-sm text-fg">
              Faith, culture, and excellence woven into every release, experience, and initiative.
            </p>
          </div>
        </div>
        <div class="about-hero__visual-accent absolute -bottom-6 -left-6 -z-10 h-32 w-32 rounded-full bg-[var(--color-accent)]/15 blur-3xl" aria-hidden="true"></div>
        <div class="about-hero__visual-accent absolute -right-4 -top-4 -z-10 h-24 w-24 rounded-full bg-cyan-400/10 blur-2xl" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    min-height: min(72vh, 900px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 8%, transparent);
  }

  @media (min-width: 640px) {
    .about-hero {
      min-height: min(88vh, 900px);
    }
  }

  .about-hero__mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 15% 20%, color-mix(in srgb, var(--color-accent) 8.4%, transparent), transparent 55%),
      radial-gradient(ellipse 60% 50% at 85% 75%, color-mix(in srgb, var(--color-accent) 4%, transparent), transparent 50%),
      linear-gradient(165deg, var(--color-bg) 0%, var(--color-bg) 45%, var(--color-surface) 100%);
  }

  .about-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .about-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .about-hero__glow--left {
    top: 10%;
    left: -8%;
    width: 320px;
    height: 320px;
    background: color-mix(in srgb, var(--color-accent) 7.2%, transparent);
  }

  .about-hero__glow--right {
    bottom: 5%;
    right: -5%;
    width: 280px;
    height: 280px;
    background: color-mix(in srgb, var(--color-fg) 4%, transparent);
  }

  .about-hero__visual {
    box-shadow: 0 24px 80px color-mix(in srgb, var(--color-shadow) 18%, transparent);
  }

  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-hero.is-visible .about-reveal-1 { transition-delay: 0ms; }
  .about-hero.is-visible .about-reveal-2 { transition-delay: 80ms; }
  .about-hero.is-visible .about-reveal-3 { transition-delay: 140ms; }
  .about-hero.is-visible .about-reveal-4 { transition-delay: 220ms; }
  .about-hero.is-visible .about-reveal-5 { transition-delay: 320ms; }
  .about-hero.is-visible .about-reveal-6 { transition-delay: 420ms; }
  .about-hero.is-visible .about-reveal-7 { transition-delay: 500ms; }

  .about-hero.is-visible .about-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const hero = document.querySelector('.about-hero');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero) {
    if (reduced) {
      hero.classList.add('is-visible');
    } else {
      requestAnimationFrame(() => hero.classList.add('is-visible'));
    }
  }
</script>
