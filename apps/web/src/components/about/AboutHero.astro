---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = 'About us' } = Astro.props;
---

<section class="about-hero">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-24 sm:px-6 sm:pb-28 sm:pt-32 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
    <div class="scroll-reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">{eyebrow}</p>
      <h1 class="text-display mt-6 max-w-3xl font-display leading-[0.95] tracking-tight">{title}</h1>
      <p class="text-lead mt-8 max-w-xl text-fg">
        A Lagos record label making uplifting Afro-gospel and soul-fusion music for the whole family, and for listeners far beyond Nigeria.
      </p>
      <a
        href="#story"
        class="mt-10 inline-flex rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-on-accent)] transition hover:bg-[var(--color-accent-strong)]"
      >
        Our story
      </a>
    </div>

    <div class="scroll-reveal hidden lg:block" style="--reveal-delay: 120ms">
      <img
        src="/initiatives/energize-fest.webp"
        alt="Energize Fest gathering with a global audience"
        width="5372"
        height="3586"
        class="media-frame aspect-[4/5] w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .about-hero {
    border-bottom: 1px solid var(--color-line);
  }
</style>
