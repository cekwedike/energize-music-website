---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="about-hero">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-20 pt-24 sm:px-6 sm:pb-28 sm:pt-32 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
    <div class="scroll-reveal">
      <h1 class="text-display max-w-3xl font-display leading-[0.95] tracking-tight">{title}</h1>
    </div>

    <div class="scroll-reveal hidden lg:block" style="--reveal-delay: 120ms">
      <img
        src="/initiatives/energize-fest.webp"
        alt="Energize Music event with a global audience"
        width="5372"
        height="3586"
        class="media-frame aspect-[4/5] w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .about-hero {
    border-bottom: 1px solid var(--color-line);
  }
</style>
