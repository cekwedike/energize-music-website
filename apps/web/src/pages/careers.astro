---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { sanityClient } from '../lib/sanity/client';
import { allCareerOpeningsQuery, volunteerInfoQuery, type CareerOpening, type VolunteerInfo } from '@energize/shared';

const openings = await sanityClient.fetch<CareerOpening[]>(allCareerOpeningsQuery);
const volunteer = await sanityClient.fetch<VolunteerInfo | null>(volunteerInfoQuery);
---

<BaseLayout title="Careers" description="Open roles and volunteer opportunities at Energize Music.">
  <PageHero
    eyebrow="Join us"
    title="Careers"
    description="Join the team building Energize Music's global, family-friendly catalog, from Lagos to the world."
    ctas={[{ label: 'Open roles', href: '#openings', variant: 'primary' }, { label: 'Contact us', href: '/contact', variant: 'secondary' }]}
  />

  <section id="openings" class="scroll-mt-24 mx-auto max-w-6xl px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16">
    {
      openings.length === 0 ? (
        <p class="scroll-reveal text-paper/60">
          No open roles right now. Reach out via <a href="/contact" class="underline hover:text-[var(--color-glow)]">Contact</a> to introduce yourself.
        </p>
      ) : (
        <ul class="scroll-reveal-stagger divide-y divide-white/10 border-t border-white/10">
          {openings.map((role) => (
            <li class="flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="font-medium text-paper">{role.title}</p>
                <p class="mt-1 text-sm text-paper/60">
                  {role.location} &middot; {role.type}
                </p>
              </div>
              <a
                href={role.applyUrl}
                class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-paper transition hover:border-[var(--color-glow)] hover:text-[var(--color-glow)] sm:w-auto"
              >
                Apply
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="scroll-reveal mt-10 text-sm text-paper/50" style="--reveal-delay: 80ms">
      General applications are also welcome via
      {' '}
      <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-glow)]">
        LinkedIn
      </a>.
    </p>
  </section>

  {
    volunteer && (
      <section class="border-t border-white/10 bg-[var(--color-ink-raised)]">
        <div class="mx-auto max-w-3xl px-5 py-16 sm:px-6 sm:py-24">
          <h2 class="scroll-reveal text-h2">{volunteer.heading}</h2>
          <p class="scroll-reveal text-lead mt-4 text-paper/70" style="--reveal-delay: 80ms">{volunteer.intro}</p>

          {
            volunteer.roleOptions && volunteer.roleOptions.length > 0 && (
              <div class="scroll-reveal mt-8" style="--reveal-delay: 160ms">
                <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Ways to help</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {volunteer.roleOptions.map((role) => (
                    <li class="rounded-full border border-white/20 px-4 py-2 text-sm text-paper/80">{role}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            volunteer.platforms && volunteer.platforms.length > 0 && (
              <div class="scroll-reveal mt-6" style="--reveal-delay: 240ms">
                <p class="text-sm font-semibold uppercase tracking-wide text-paper/50">Platforms</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {volunteer.platforms.map((platform) => (
                    <li class="rounded-full border border-white/20 px-4 py-2 text-sm text-paper/80">{platform}</li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            volunteer.signupUrl ? (
              <a
                href={volunteer.signupUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="scroll-reveal mt-10 inline-flex min-h-11 items-center rounded-full bg-[var(--color-glow)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-glow)]/90"
                style="--reveal-delay: 320ms"
              >
                {volunteer.ctaLabel ?? 'Join the volunteer list'}
              </a>
            ) : (
              <p class="mt-10 text-sm text-paper/50">
                Sign-up link isn't configured yet. Add one in Sanity Studio under Volunteer Info.
              </p>
            )
          }
        </div>
      </section>
    )
  }
</BaseLayout>
