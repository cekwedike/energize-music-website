---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareersHero from '../components/careers/CareersHero.astro';
import CareersRoleList from '../components/careers/CareersRoleList.astro';
import CareersVolunteer from '../components/careers/CareersVolunteer.astro';
import { sanityClient } from '../lib/sanity/client';
import { careersPageQuery, type CareersPageData } from '@energize/shared';
import { crumbs } from '../lib/seo/schema';

const { openings, volunteer } = await sanityClient.fetch<CareersPageData>(careersPageQuery);
---

<BaseLayout
  title="Careers at Energize Music | Join the Team"
  description="Explore open roles at Energize Music, a Lagos-based Afro-gospel and soul-fusion label building a global sound."
  keywords={['music industry jobs Lagos', 'record label careers Nigeria', 'Energize Music careers']}
  breadcrumbs={crumbs({ name: 'Careers', path: '/careers' })}
  ambientVariant="editorial"
>
  <CareersHero />
  <CareersRoleList openings={openings} />
  <CareersVolunteer volunteer={volunteer} />
</BaseLayout>
