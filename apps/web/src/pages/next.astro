---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import NextLogo from '../components/next/NextLogo.astro';
import NextMusicPlayer from '../components/next/NextMusicPlayer.astro';
import { sanityClient } from '../lib/sanity/client';
import { nextPageQuery, type NextPageSettings } from '@energize/shared';
import { mergeNextPageSettings } from '../lib/next/pageDefaults';
import { buildFaqPageSchema, crumbs } from '../lib/seo/schema';
import { absoluteUrl } from '../lib/seo/site';

let pageSettings: NextPageSettings | null = null;
try {
  pageSettings = await sanityClient.fetch<NextPageSettings | null>(nextPageQuery);
} catch {
  pageSettings = null;
}

const settings = mergeNextPageSettings(pageSettings);
const submissionsOpen = Boolean(settings.submissionsOpen && settings.submitUrl);
const submitUrl = settings.submitUrl || '#';
const submitLabel = settings.submitLabel || 'Submit Your Music';
const closedLabel = settings.closedLabel || 'Submissions Closed';
const closedMessage =
  settings.closedMessage ||
  'Registration for this season has ended. Follow Energize Music for the next drop.';

const heroImages = [
  '/next/takit.webp',
  '/next/aeo.webp',
  '/next/gaise.webp',
  '/next/korale-2.webp',
  '/next/greatman.webp',
];

const journey = [
  { number: '01', title: 'Submissions', period: 'May', body: 'Artists across Africa enter with a performance video and artist profile.' },
  { number: '02', title: 'Showcase', period: 'June', body: 'Top 50 are revealed. Public voting narrows the field to 20.' },
  { number: '03', title: 'Finalists', period: 'July', body: 'Community votes crown the final 10 for the album.' },
  { number: '04', title: 'Album', period: 'Jul-Aug', body: 'Finalists record the ENERGIZE Afrogospel Album.' },
  { number: '05', title: 'Block Parties', period: 'Sep', body: 'Community nights across participating nations.' },
  { number: '06', title: 'Launch Concert', period: 'Oct', body: 'Pan-African concert launches the album and the artists.' },
];

const steps = [
  { num: '01', title: 'Create your artist profile' },
  { num: '02', title: 'Drop your performance video link' },
  { num: '03', title: 'Add your artist details' },
  { num: '04', title: 'Submit and wait for results' },
];

const faqs = [
  {
    q: 'Who can enter?',
    a: 'NEXT is open to Afrogospel singers and rappers across Africa. You do not need to be based in Nigeria.',
  },
  {
    q: 'Do I need an original song?',
    a: 'No. A video of you performing a rendition works. Originals are welcome, but not required.',
  },
  {
    q: 'How do I submit?',
    a: submissionsOpen
      ? 'Use the Submit button on this page. Fill in your artist details and drop your links.'
      : 'Submissions for this season are closed. Follow Energize Music for the next open window.',
  },
  {
    q: 'How does voting work?',
    a: 'We select the top 50. Public voting then narrows to 20, then to the final 10. Anyone can vote, including the diaspora.',
  },
  {
    q: 'What do top 10 artists get?',
    a: 'A place on the ENERGIZE Afrogospel Album and a performance at the pan-African launch concert.',
  },
];

const faqSchema = buildFaqPageSchema(faqs, absoluteUrl('/next'));
---

<BaseLayout
  title="NEXT: New Era Xceptional Talent"
  description="Africa's boldest Afrogospel talent competition and music incubator by Energize Music."
  ogImage="/next/takit.webp"
  keywords={['NEXT', 'New Era Xceptional Talent', 'Afrogospel', 'talent competition', 'Energize Music']}
  breadcrumbs={crumbs({ name: 'NEXT', path: '/next' })}
  headerVariant="overlay"
>
  {faqSchema && <JsonLd data={faqSchema} />}
  <section id="next-hero" class="next-hero" aria-labelledby="next-hero-title">
    <div id="next-hero-carousel" class="next-hero__stage" aria-hidden="true">
      {
        heroImages.map((src, i) => (
          <div
            class:list={['next-hero-slide', i === 0 && 'is-active']}
            data-src={src}
            style={i === 0 ? `background-image: url('${src}')` : undefined}
          />
        ))
      }
      <div class="next-hero__veil"></div>
      <div class="next-hero__grain"></div>
    </div>

    <div class="next-hero__content">
      <p class="next-reveal next-hero__eyebrow">Energize Music Presents</p>

      <div class="next-reveal next-hero__logo" style="--reveal-delay: 90ms">
        <NextLogo animated={true} />
      </div>

      <h1 id="next-hero-title" class="next-reveal next-hero__title" style="--reveal-delay: 180ms">
        Your Voice. Your Faith. Your Moment.
      </h1>

      <p class="next-reveal next-hero__lead" style="--reveal-delay: 260ms">
        Africa's boldest Afrogospel talent competition. Rise from community votes onto the ENERGIZE Afrogospel Album.
      </p>

      {
        !submissionsOpen && (
          <p class="next-reveal next-hero__closed-msg" style="--reveal-delay: 300ms">
            {closedMessage}
          </p>
        )
      }

      <div class="next-reveal next-hero__actions" style="--reveal-delay: 340ms">
        {
          submissionsOpen ? (
            <a
              href={submitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="next-hero__cta next-hero__cta--primary"
            >
              {submitLabel}
            </a>
          ) : (
            <span class="next-closed__badge">{closedLabel}</span>
          )
        }
        <a href="#journey" class="next-hero__cta next-hero__cta--ghost">
          How It Works
        </a>
      </div>
    </div>

    <div class="next-hero__rail" aria-hidden="true">
      <div class="next-hero__rail-track">
        <span>Submit</span>
        <span>Vote</span>
        <span>Rise</span>
        <span>Album</span>
        <span>Stage</span>
        <span>Submit</span>
        <span>Vote</span>
        <span>Rise</span>
        <span>Album</span>
        <span>Stage</span>
      </div>
    </div>
  </section>

  <section id="journey" class="scroll-mt-24 border-t border-white/10 bg-[var(--color-ink-raised)]">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 sm:py-20">
      <div class="next-scroll-reveal mx-auto max-w-2xl text-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-glow)]">The Journey</p>
        <h2 class="text-h2 mt-3">From submission to stage</h2>
        <p class="mt-3 text-sm text-paper/65">May to October 2026</p>
      </div>
      <ol class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          journey.map((phase, i) => (
            <li class="next-scroll-reveal next-glass-card rounded-2xl p-6" style={`--reveal-delay: ${i * 50}ms`}>
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-glow)]">{phase.number}</p>
                <p class="text-xs font-semibold uppercase tracking-wider text-paper/45">{phase.period}</p>
              </div>
              <h3 class="mt-2 font-display text-xl font-medium">{phase.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-paper/70">{phase.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    submissionsOpen ? (
      <section id="enter" class="scroll-mt-24 border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 sm:grid-cols-[0.9fr_1.1fr] sm:px-6 sm:py-20 lg:gap-12">
          <div class="next-scroll-reveal relative min-h-[240px] overflow-hidden rounded-2xl sm:min-h-full">
            <img
              src="/next/korale.jpg"
              alt="Afrogospel artist performing on stage"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover object-top"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)] via-[var(--color-ink)]/35 to-transparent"></div>
          </div>
          <div class="next-scroll-reveal">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-glow)]">Enter NEXT</p>
            <h2 class="text-h2 mt-3">Four steps. Free to join.</h2>
            <ol class="mt-8 space-y-4">
              {steps.map((step) => (
                <li class="flex gap-4 border-b border-white/8 pb-4 last:border-0">
                  <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-glow)]">{step.num}</span>
                  <p class="font-medium text-paper/90">{step.title}</p>
                </li>
              ))}
            </ol>
            <a
              href={submitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-[var(--color-glow)] px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-[var(--color-glow)]/90"
            >
              {submitLabel}
            </a>
          </div>
        </div>
      </section>
    ) : null
  }

  <section id="faq" class="scroll-mt-24 border-t border-white/10 bg-[var(--color-ink-raised)]">
    <div class="mx-auto max-w-3xl px-5 py-16 sm:px-6 sm:py-20">
      <div class="next-scroll-reveal text-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--color-glow)]">FAQ</p>
        <h2 class="text-h2 mt-3">Quick answers</h2>
      </div>
      <div class="mt-8 space-y-3">
        {
          faqs.map((item, i) => (
            <article class="next-scroll-reveal next-glass-card rounded-2xl px-6 py-5" style={`--reveal-delay: ${i * 40}ms`}>
              <h3 class="text-base font-semibold leading-snug sm:text-lg">{item.q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-paper/75">{item.a}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="mx-auto max-w-3xl px-5 py-14 text-center sm:px-6 sm:py-16">
      <div class="mx-auto max-w-[7.5rem] opacity-90">
        <NextLogo animated={false} />
      </div>
      <p class="mt-4 text-sm text-paper/50">by Energize Music</p>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-paper/60">
        Entrants also join the Kingdom Creatives Academy ecosystem for long-term growth beyond the season.
      </p>
      {
        submissionsOpen ? (
          <a
            href={submitUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="button-glow mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-[var(--color-ink)] transition hover:bg-white/90"
          >
            {submitLabel}
          </a>
        ) : (
          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-glow)]">{closedLabel}</p>
        )
      }
      <p class="mt-10 text-xs text-paper/40">&copy; 2026 NEXT by Energize Music. All rights reserved.</p>
    </div>
  </section>

  <NextMusicPlayer />
</BaseLayout>

<style>
  .next-hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
  }

  .next-hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .next-hero-slide {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 1.6s ease,
      transform 7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .next-hero-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .next-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 10, 14, 0.55) 0%, rgba(6, 10, 14, 0.28) 38%, rgba(6, 10, 14, 0.72) 72%, var(--color-ink) 100%),
      radial-gradient(ellipse 80% 55% at 50% 100%, rgba(77, 168, 255, 0.18), transparent 60%);
  }

  .next-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .next-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: 7.5rem 1.25rem 2.75rem;
    text-align: center;
  }

  .next-hero__eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--color-glow);
  }

  .next-hero__logo {
    width: min(100%, 34rem);
    margin: 1.25rem auto 0;
  }

  .next-hero__title {
    margin-top: 1.5rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.85rem, 5vw, 3.15rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
  }

  .next-hero__lead {
    max-width: 34rem;
    margin: 1rem auto 0;
    font-size: clamp(0.98rem, 2.1vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .next-hero__closed-msg {
    max-width: 28rem;
    margin: 0.85rem auto 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.5);
  }

  .next-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .next-hero__cta {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    border-radius: 0.55rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .next-hero__cta--primary {
    background: var(--color-glow);
    color: #fff;
    box-shadow: 0 0 0 1px rgba(77, 168, 255, 0.35), 0 12px 40px rgba(77, 168, 255, 0.28);
  }

  .next-hero__cta--primary:hover {
    background: color-mix(in srgb, var(--color-glow) 88%, white);
    transform: translateY(-1px);
  }

  .next-hero__cta--ghost {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
  }

  .next-hero__cta--ghost:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
  }

  .next-hero__rail {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.35));
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .next-hero__rail-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    padding: 0.85rem 0 1.1rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    animation: next-hero-rail 28s linear infinite;
  }

  .next-hero__rail-track span:nth-child(odd) {
    color: rgba(77, 168, 255, 0.65);
  }

  @keyframes next-hero-rail {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .next-glass-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .next-glass-card:hover {
    border-color: rgba(77, 168, 255, 0.35);
    box-shadow: 0 0 32px rgba(77, 168, 255, 0.08);
  }

  .next-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.75s ease,
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  #next-hero.is-loaded .next-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .next-scroll-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.65s ease,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .next-scroll-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .next-closed__badge {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid rgba(77, 168, 255, 0.5);
    background: rgba(77, 168, 255, 0.12);
    color: var(--color-glow);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .next-hero__content {
      padding: 8.5rem 1.5rem 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-reveal,
    .next-scroll-reveal,
    .next-hero-slide {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .next-hero__rail-track {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ heroImages }}>
  (function () {
    var hero = document.getElementById('next-hero');
    if (hero) requestAnimationFrame(function () { hero.classList.add('is-loaded'); });

    var slides = document.querySelectorAll('.next-hero-slide');
    if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var current = 0;
      slides[0].classList.add('is-active');

      function preload(index) {
        var slide = slides[index];
        if (slide && slide.dataset.src && !slide.style.backgroundImage) {
          slide.style.backgroundImage = "url('" + slide.dataset.src + "')";
        }
      }

      setInterval(function () {
        slides[current].classList.remove('is-active');
        current = (current + 1) % slides.length;
        preload(current);
        slides[current].classList.add('is-active');
        preload((current + 1) % slides.length);
      }, 6000);
    } else if (slides.length) {
      slides[0].classList.add('is-active');
    }
  })();
</script>
