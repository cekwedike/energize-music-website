---
import LegalPage from '../components/legal/LegalPage.astro';
import { sanityClient } from '../lib/sanity/client';
import { privacyBlocks, PRIVACY_EFFECTIVE_DATE } from '../lib/legal/fallbackContent';
import { pageBySlugQuery, type Page } from '@energize/shared';
import { crumbs } from '../lib/seo/schema';

// Edited in Studio under "Legal Pages". The code copy is only a safety net if Sanity is empty.
let page: Page | null = null;
try {
  page = await sanityClient.fetch<Page | null>(pageBySlugQuery, { slug: 'privacy' });
} catch {
  page = null;
}
const title = page?.title?.trim() || 'Privacy Policy';
---

<LegalPage
  title={title}
  description="How Energize Music collects, uses, and protects your information, including email sign-ups, contact messages, and analytics."
  blocks={page?.blocks?.length ? page.blocks : privacyBlocks}
  effectiveDate={page?.effectiveDate || PRIVACY_EFFECTIVE_DATE}
  eyebrow="Privacy"
  breadcrumbs={crumbs({ name: title, path: '/privacy' })}
/>
