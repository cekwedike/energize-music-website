---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
---

<BaseLayout title="Privacy Policy" description="Energize Music privacy policy.">
  <PageHero
    size="slim"
    title="Privacy Policy"
    description="How Energize Music collects, uses, and protects your information."
  />

  <section class="mx-auto max-w-3xl px-5 pb-16 pt-10 sm:px-6 sm:pb-24 sm:pt-12">
    <p class="text-paper/60">Full policy content wires up in Phase 2.</p>
  </section>
</BaseLayout>
