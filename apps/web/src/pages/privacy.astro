---
import LegalPage from '../components/legal/LegalPage.astro';
import { privacyBlocks, PRIVACY_EFFECTIVE_DATE } from '../lib/legal/fallbackContent';
import { crumbs } from '../lib/seo/schema';

// Legal wording is versioned in code so every change is reviewable in git history.
---

<LegalPage
  title="Privacy Policy"
  description="How Energize Music collects, uses, and protects your information, including email sign-ups, contact messages, and analytics."
  blocks={privacyBlocks}
  effectiveDate={PRIVACY_EFFECTIVE_DATE}
  eyebrow="Privacy"
  breadcrumbs={crumbs({ name: 'Privacy Policy', path: '/privacy' })}
/>
