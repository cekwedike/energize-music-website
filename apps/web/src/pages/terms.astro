---
import LegalPage from '../components/legal/LegalPage.astro';
import { termsBlocks, TERMS_EFFECTIVE_DATE } from '../lib/legal/fallbackContent';
import { crumbs } from '../lib/seo/schema';

// Legal wording is versioned in code so every change is reviewable in git history.
---

<LegalPage
  title="Terms of Service"
  description="The terms for using energize-music.com and other Energize Music websites, content, and digital services."
  blocks={termsBlocks}
  effectiveDate={TERMS_EFFECTIVE_DATE}
  eyebrow="Terms"
  breadcrumbs={crumbs({ name: 'Terms of Service', path: '/terms' })}
/>
