---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import HomeArtists from '../components/home/HomeArtists.astro';
import HomeReleases from '../components/home/HomeReleases.astro';
import HomeInitiatives from '../components/home/HomeInitiatives.astro';
import HomeEvents from '../components/home/HomeEvents.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeNewsletter from '../components/home/HomeNewsletter.astro';
import { sanityClient } from '../lib/sanity/client';
import { enrichRelease } from '../lib/metadata/enrichReleases';
import { isValidEventCard } from '../lib/events/format';
import {
  featuredEventsQuery,
  homeArtistsQuery,
  homeReleasesQuery,
  type ArtistCard,
  type EventCard,
  type Release,
} from '@energize/shared';
import { HERO_VIDEO_POSTER } from '../lib/hero-video';
import '../styles/home.css';

let artists: ArtistCard[] = [];
let homeReleases: Release[] = [];
let featuredEvents: EventCard[] = [];

try {
  [artists, homeReleases, featuredEvents] = await Promise.all([
    sanityClient.fetch<ArtistCard[]>(homeArtistsQuery),
    sanityClient.fetch<Release[]>(homeReleasesQuery),
    sanityClient.fetch<EventCard[]>(featuredEventsQuery),
  ]);
} catch {
  artists = [];
  homeReleases = [];
  featuredEvents = [];
}

const releases = await Promise.all(
  homeReleases.map((release) => enrichRelease(release, { coverSize: 480 })),
);

const homeEvents = featuredEvents.filter(isValidEventCard);
---

<BaseLayout
  title="Energize Music"
  description="Energize Music is a global Afro-gospel and soul-fusion label: artists, releases, live events, and initiatives including NEXT, Energize Kids, and Energize Fest."
  keywords={[
    'Energize Music',
    'Afro-gospel',
    'soul fusion',
    'Lagos record label',
    'gospel music',
    'NEXT Afrogospel',
    'Energize Fest',
  ]}
  hideAmbient
  showTopMarquee
>
  <link slot="head" rel="preload" as="image" href={HERO_VIDEO_POSTER} type="image/webp" fetchpriority="high" />
  <div data-home-page data-hero-ready="false">
    <Hero />
    <div data-home-below class="home-below">
      <HomeReleases releases={releases} />
      <HomeInitiatives />
      <HomeEvents events={homeEvents} />
      <HomeArtists artists={artists} />
      <HomeAbout />
      <HomeNewsletter />
    </div>
  </div>
</BaseLayout>

<script>
  let homeMotionModule: Promise<typeof import('../lib/motion/home/initHome')> | null = null;
  let homeMotionBooted = false;
  let homeMotionScheduled = false;

  const bootHomeMotion = () => {
    if (homeMotionBooted) return;
    homeMotionBooted = true;
    homeMotionModule ??= import('../lib/motion/home/initHome');
    void homeMotionModule.then(({ initHomePage }) => initHomePage());
  };

  const scheduleHomeMotion = () => {
    if (homeMotionScheduled) return;
    homeMotionScheduled = true;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const below = document.querySelector('[data-home-below]');

    const start = () => {
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(() => bootHomeMotion(), { timeout: 2500 });
      } else {
        window.setTimeout(bootHomeMotion, 1200);
      }
    };

    if (reduced || !below) {
      start();
      return;
    }

    let armed = false;
    const arm = () => {
      if (armed) return;
      armed = true;
      start();
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          arm();
        }
      },
      { rootMargin: '0px 0px 240px 0px', threshold: 0 },
    );
    io.observe(below);

    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 32) {
          io.disconnect();
          arm();
        }
      },
      { once: true, passive: true },
    );

    window.setTimeout(arm, 10000);
  };

  const onHeroReady = () => {
    const root = document.querySelector<HTMLElement>('[data-home-page]');
    if (root) root.dataset.heroReady = 'true';
    scheduleHomeMotion();
  };

  if (document.documentElement.dataset.heroReady === 'true') {
    onHeroReady();
  } else {
    window.addEventListener('energize:hero-ready', onHeroReady, { once: true });
    window.setTimeout(onHeroReady, 4000);
  }

  document.addEventListener('astro:page-load', () => {
    homeMotionBooted = false;
    homeMotionScheduled = false;
    if (document.documentElement.dataset.heroReady === 'true') onHeroReady();
  });
</script>
