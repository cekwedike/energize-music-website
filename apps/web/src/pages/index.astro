---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import HomeMission from '../components/home/HomeMission.astro';
import HomeLatest from '../components/home/HomeLatest.astro';
import HomeReleases from '../components/home/HomeReleases.astro';
import HomeArtists from '../components/home/HomeArtists.astro';
import HomeNewsletter from '../components/home/HomeNewsletter.astro';
import { sanityClient } from '../lib/sanity/client';
import { enrichRelease } from '../lib/metadata/enrichReleases';
import {
  homeArtistsQuery,
  homeReleasesQuery,
  latestReleaseQuery,
  type Artist,
  type Release,
} from '@energize/shared';
import { HERO_VIDEO_POSTER } from '../lib/hero-video';

let artists: Artist[] = [];
let featuredReleases: Release[] = [];
let latest: Release | null = null;

try {
  [artists, featuredReleases, latest] = await Promise.all([
    sanityClient.fetch<Artist[]>(homeArtistsQuery),
    sanityClient.fetch<Release[]>(homeReleasesQuery),
    sanityClient.fetch<Release | null>(latestReleaseQuery),
  ]);
} catch {
  artists = [];
  featuredReleases = [];
  latest = null;
}

const latestRelease = latest ? await enrichRelease(latest, { coverSize: 960 }) : null;

// The rail skips the release already shown in the latest project block.
const releases = await Promise.all(
  featuredReleases
    .filter((release) => release._id !== latest?._id)
    .map((release) => enrichRelease(release, { coverSize: 480 })),
);
---

<BaseLayout
  title="Energize Music | Afro-Gospel Record Label from Lagos"
  description="Energize Music is a Lagos-based Afro-gospel and soul-fusion label home to Greatman Takit, TY Bello, and Ellie Scotte. Hear the roster and the story."
  keywords={[
    'Afro-gospel record label',
    'Nigerian gospel music label',
    'Energize Music',
    'Greatman Takit',
    'TY Bello',
    'Ellie Scotte',
  ]}
  headerVariant="overlay"
>
  <link slot="head" rel="preload" as="image" href={HERO_VIDEO_POSTER} type="image/webp" fetchpriority="high" />
  <Hero />
  <HomeMission />
  {latestRelease && <HomeLatest release={latestRelease} />}
  <HomeReleases releases={releases} />
  <HomeArtists artists={artists} />
  <HomeNewsletter />
</BaseLayout>
