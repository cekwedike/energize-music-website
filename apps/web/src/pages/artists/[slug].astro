---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtistProfileHero from '../../components/artists/ArtistProfileHero.astro';
import ArtistBio from '../../components/artists/ArtistBio.astro';
import ArtistDiscography from '../../components/artists/ArtistDiscography.astro';
import ArtistExploreMore from '../../components/artists/ArtistExploreMore.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient, urlForImage } from '../../lib/sanity/client';
import { enrichReleases } from '../../lib/metadata/enrichReleases';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';
import {
  artistSlugsQuery,
  artistBySlugQuery,
  allArtistsQuery,
  releasesByArtistSlugQuery,
  type Artist,
  type ArtistCard,
  type Release,
} from '@energize/shared';

/** Build one static page per Sanity artist slug. Production needs a rebuild for new slugs. */
export const dynamicParams = true;

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<{ slug: string }[]>(artistSlugsQuery);
  return slugs
    .filter((entry: { slug: string }) => Boolean(entry.slug))
    .map((entry: { slug: string }) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const [artist, discography, allArtists] = await Promise.all([
  sanityClient.fetch<Artist | null>(artistBySlugQuery, { slug }),
  sanityClient.fetch<Release[]>(releasesByArtistSlugQuery, { slug }),
  sanityClient.fetch<ArtistCard[]>(allArtistsQuery),
]);

if (!artist) {
  return Astro.redirect('/404');
}

const enrichedDiscography = await enrichReleases(discography);

const photoUrl = urlForImage(artist.photo).width(1200).height(630).fit('crop').auto('format').url();
const pageUrl = absoluteUrl(`/artists/${artist.slug}`);
const pageId = `${pageUrl}#artist`;

const genreLabel = (artist.genres?.[0] ?? 'Afro-gospel').replace(/^Afro-Gospel$/i, 'Afro-gospel');
const pageTitle = `${artist.name}: Songs, Albums and Bio | Energize Music`;

/**
 * Builds a search snippet from whole sentences only (never cut mid-word).
 * Tries "lead + bio sentences" and "bio sentences only", keeping the richer one that fits.
 */
function buildDescription(): string {
  const limit = 155;
  const lead = `${artist!.name} is ${/^[aeiou]/i.test(genreLabel) ? 'an' : 'a'} ${genreLabel} artiste on Energize Music.`;
  const sentences = (artist!.bio ?? '').replace(/\s+/g, ' ').match(/[^.!?]+[.!?]+(?=\s|$)/g)?.map((s) => s.trim()) ?? [];
  const cta = 'Stream the music and read the bio.';

  const fill = (start: string[]): string => {
    const parts = [...start];
    for (const sentence of sentences) {
      if ([...parts, sentence].join(' ').length > limit) break;
      parts.push(sentence);
    }
    if ([...parts, cta].join(' ').length <= limit) parts.push(cta);
    return parts.join(' ');
  };

  const withLead = fill([lead]);
  const bioOnly = fill([]);
  const bioNamesArtist = bioOnly.includes(artist!.name);
  return bioNamesArtist && bioOnly.length > withLead.length ? bioOnly : withLead;
}
const description = buildDescription();

const sameAs = Object.values(artist.streaming ?? {}).filter(
  (value): value is string => typeof value === 'string' && value.length > 0,
);

function releaseRefs(key: 'album' | 'track', releases: Release[]) {
  if (releases.length === 0) return {};
  return {
    [key]: releases.map((release) => ({
      '@type': key === 'album' ? 'MusicAlbum' : 'MusicRecording',
      '@id': absoluteUrl(`/releases/${release.slug}#release`),
      name: release.title,
      url: absoluteUrl(`/releases/${release.slug}`),
    })),
  };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': pageId,
  name: artist.name,
  description: artist.bio,
  image: photoUrl,
  url: pageUrl,
  genre: artist.genres?.length ? artist.genres : ['Afro-gospel', 'Soul fusion'],
  sameAs,
  ...releaseRefs('album', discography.filter((release) => release.type !== 'single')),
  ...releaseRefs('track', discography.filter((release) => release.type === 'single')),
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogImage={photoUrl}
  ogType="profile"
  keywords={[artist.name, `${artist.name} songs`, `${artist.name} albums`, 'Energize Music', 'Afro-gospel', ...(artist.genres ?? [])]}
  breadcrumbs={crumbs({ name: 'Artistes', path: '/artists' }, { name: artist.name, path: `/artists/${artist.slug}` })}
  headerVariant="overlay"
>
  <JsonLd data={jsonLd} />
  <div class="artist-profile-page">
    <ArtistProfileHero artist={artist} />
    <div class="artist-profile-body">
      <ArtistBio bio={artist.bio} name={artist.name} />
      <ArtistDiscography releases={enrichedDiscography} artistName={artist.name} />
      <ArtistExploreMore artists={allArtists} currentSlug={artist.slug} />
    </div>
  </div>
</BaseLayout>

<style>
  .artist-profile-page {
    position: relative;
  }

  .artist-profile-page :global(.profile-hero) {
    position: relative;
    z-index: 2;
    background: var(--color-bg);
  }
</style>

