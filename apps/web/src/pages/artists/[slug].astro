---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseCard from '../../components/releases/ReleaseCard.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient, urlForImage } from '../../lib/sanity/client';
import {
  allArtistsQuery,
  artistBySlugQuery,
  releasesByArtistSlugQuery,
  type Artist,
  type Release,
} from '@energize/shared';

export async function getStaticPaths() {
  const artists = await sanityClient.fetch<Pick<Artist, 'slug'>[]>(allArtistsQuery);
  return artists.map((artist) => ({ params: { slug: artist.slug } }));
}

const { slug } = Astro.params;
const artist = await sanityClient.fetch<Artist>(artistBySlugQuery, { slug });
const discography = await sanityClient.fetch<Release[]>(releasesByArtistSlugQuery, { slug });

const photoUrl = urlForImage(artist.photo).width(900).height(900).fit('crop').auto('format').url();

const tierLabel: Record<Artist['tier'], string> = {
  official: 'Official',
  legacy: 'Legacy',
};

const streamingLabels: Record<string, string> = {
  spotify: 'Spotify',
  appleMusic: 'Apple Music',
  youtube: 'YouTube',
  instagram: 'Instagram',
};
const streamingEntries = Object.entries(artist.streaming ?? {}).filter(([, url]) => Boolean(url));

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://energize-music.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: artist.name,
  description: artist.bio,
  image: photoUrl,
  url: new URL(`/artists/${artist.slug}`, siteUrl).toString(),
  sameAs: Object.values(artist.streaming ?? {}).filter(Boolean),
};
---

<BaseLayout title={artist.name} description={artist.bio}>
  <JsonLd data={jsonLd} />
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16">
    <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] sm:items-start sm:gap-10">
      <img
        src={photoUrl}
        alt={artist.photo.alt ?? artist.name}
        class="aspect-square w-full max-w-md rounded-lg object-cover sm:max-w-none"
      />
      <div class="min-w-0">
        <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-glow)]">
          {tierLabel[artist.tier]}
        </p>
        <h1 class="text-h1 mt-2 break-words">{artist.name}</h1>
        <p class="text-lead mt-4 max-w-xl text-paper/75 sm:mt-6">{artist.bio}</p>

        {
          streamingEntries.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2 sm:mt-8 sm:gap-3">
              {streamingEntries.map(([key, url]) => (
                <a
                  href={url as string}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-10 items-center rounded-full border border-white/20 px-4 py-2 text-sm font-semibold text-paper transition hover:border-[var(--color-glow)] hover:text-[var(--color-glow)] sm:px-5 sm:py-2.5"
                >
                  {streamingLabels[key] ?? key}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      discography.length > 0 && (
        <div class="mt-14 sm:mt-20">
          <h2 class="text-h3">Discography</h2>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
            {discography.map((release) => (
              <ReleaseCard release={release} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
