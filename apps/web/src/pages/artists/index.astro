---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtistCard from '../../components/artists/ArtistCard.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allArtistsQuery, type Artist } from '@energize/shared';

const artists = await sanityClient.fetch<Artist[]>(allArtistsQuery);

const tabs: { label: string; value: Artist['tier'] | 'all' }[] = [
  { label: 'All', value: 'all' },
  { label: 'Official', value: 'official' },
  { label: 'Legacy', value: 'legacy' },
];
---

<BaseLayout title="Artists" description="Official and legacy artists on Energize Music.">
  <PageHero
    eyebrow="Roster"
    title="Artists"
    description="The Energize Music roster: official artists and legacy catalog shaping Afro-gospel and soul-fusion worldwide."
  />

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16">
    {
      artists.length === 0 ? (
        <p class="scroll-reveal text-paper/60">Artists will appear here once added in Sanity Studio.</p>
      ) : (
        <>
          <div id="artist-tabs" class="scroll-reveal flex flex-wrap gap-2" role="tablist" aria-label="Filter artists by tier" style="--reveal-delay: 80ms">
            {tabs.map((tab, index) => (
              <button
                type="button"
                data-tier={tab.value}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class="min-h-10 rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-paper/75 transition hover:border-[var(--color-glow)] aria-[pressed=true]:border-[var(--color-glow)] aria-[pressed=true]:text-[var(--color-glow)]"
              >
                {tab.label}
              </button>
            ))}
          </div>

          <div id="artist-grid" class="scroll-reveal-stagger mt-8 grid grid-cols-2 gap-3 sm:mt-10 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
            {artists.map((artist) => (
              <ArtistCard artist={artist} />
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  const tabsEl = document.getElementById('artist-tabs');
  const grid = document.getElementById('artist-grid');

  tabsEl?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-tier]');
    if (!button || !grid) return;

    tabsEl.querySelectorAll('button[data-tier]').forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
    button.setAttribute('aria-pressed', 'true');

    const tier = button.dataset.tier;
    grid.querySelectorAll<HTMLElement>('[data-tier]').forEach((card) => {
      const show = tier === 'all' || card.dataset.tier === tier;
      card.classList.toggle('hidden', !show);
    });
  });
</script>
