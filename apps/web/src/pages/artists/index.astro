---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ArtistsRosterStack from '../../components/artists/ArtistsRosterStack.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allArtistsQuery, type ArtistCard as ArtistCardType } from '@energize/shared';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl, listNames } from '../../lib/seo/site';

const artists = await sanityClient.fetch<ArtistCardType[]>(allArtistsQuery);
const names = artists.map((artist) => artist.name);
const rosterNames = listNames(names);

const itemList =
  artists.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Energize Music artistes',
        itemListElement: artists.slice(0, 50).map((artist: ArtistCardType, index: number) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: absoluteUrl(`/artists/${artist.slug}`),
          name: artist.name,
        })),
      }
    : null;
---

<BaseLayout
  title={rosterNames ? `Energize Music Artistes | ${names.join(', ')}` : 'Energize Music Artistes'}
  description={`Meet the Energize Music roster${rosterNames ? `: ${rosterNames}` : ''}. Afro-gospel and soul-fusion artistes from Lagos making uplifting, family-friendly music.`}
  keywords={['Afro-gospel artistes', 'Nigerian gospel artistes', 'gospel artists in Lagos', 'Energize Music', ...names]}
  breadcrumbs={crumbs({ name: 'Artistes', path: '/artists' })}
>
  {itemList && <JsonLd data={itemList} />}
  {
    artists.length === 0 ? (
      <section class="mx-auto max-w-6xl px-5 py-20 sm:px-6">
        <h1 class="text-center font-display text-3xl text-fg">Energize Music artistes</h1>
        <p class="mt-4 text-center text-fg">The roster is being updated. Check back soon.</p>
      </section>
    ) : (
      <ArtistsRosterStack artists={artists} />
    )
  }
</BaseLayout>
