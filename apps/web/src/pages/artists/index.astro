---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ArtistGrid from '../../components/artists/ArtistGrid.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allArtistsQuery, type ArtistCard as ArtistCardType } from '@energize/shared';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

const artists = await sanityClient.fetch<ArtistCardType[]>(allArtistsQuery);

const itemList =
  artists.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Energize Music Artists',
        itemListElement: artists.slice(0, 50).map((artist: ArtistCardType, index: number) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: absoluteUrl(`/artists/${artist.slug}`),
          name: artist.name,
        })),
      }
    : null;
---

<BaseLayout
  title="Energize Music Artists | Greatman Takit, TY Bello, Ellie Scotte"
  description="Meet the Energize Music roster. Afro-gospel and soul-fusion artists from Lagos making family-friendly music for a global audience."
  keywords={['Afro-gospel artists', 'Greatman Takit', 'TY Bello', 'Ellie Scotte', 'Energize Music']}
  breadcrumbs={crumbs({ name: 'Artists', path: '/artists' })}
>
  {itemList && <JsonLd data={itemList} />}
  <section class="mx-auto max-w-7xl px-5 pb-24 pt-14 sm:px-6 sm:pb-32 sm:pt-20 lg:px-8">
    <SectionTitle tag="h1" title="Our Artists" eyebrow="The roster" />
    {
      artists.length === 0 ? (
        <p class="mt-10 text-muted">Artists will appear here once they are published in Sanity Studio.</p>
      ) : (
        <ArtistGrid artists={artists} eager class="mt-10 sm:mt-14" />
      )
    }
  </section>
</BaseLayout>
