---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ArtistsRosterStack from '../../components/artists/ArtistsRosterStack.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allArtistsQuery, type ArtistCard as ArtistCardType } from '@energize/shared';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

const artists = await sanityClient.fetch<ArtistCardType[]>(allArtistsQuery);

const itemList =
  artists.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Energize Music Artists',
        itemListElement: artists.slice(0, 50).map((artist, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: absoluteUrl(`/artists/${artist.slug}`),
          name: artist.name,
        })),
      }
    : null;
---

<BaseLayout
  title="Artists"
  description="The Energize Music roster: Afro-gospel and soul-fusion artists shaping uplifting music from Lagos."
  keywords={['Energize Music artists', 'Afro-gospel artists', 'roster', 'Lagos']}
  breadcrumbs={crumbs({ name: 'Artists', path: '/artists' })}
  ambientVariant="editorial"
>
  {itemList && <JsonLd data={itemList} />}
  {
    artists.length === 0 ? (
      <section class="mx-auto max-w-6xl px-5 py-20 sm:px-6">
        <p class="text-center text-paper">
          Artists will appear here once you add them in Sanity Studio. Each published artist automatically gets a page
          at <code class="text-[var(--color-glow)]">/artists/their-slug</code> on the next site build.
        </p>
      </section>
    ) : (
      <ArtistsRosterStack artists={artists} />
    )
  }
</BaseLayout>
