---
import BaseLayout from '../layouts/BaseLayout.astro';
import { crumbs } from '../lib/seo/schema';

const LIVE_SITE = 'https://energize-kids.com/';

const pillars = [
  {
    icon: '♪',
    title: 'Music',
    body: 'Clean sounds kids can sing, dance, and grow with.',
  },
  {
    icon: '↗',
    title: 'Movement',
    body: 'Simple activities that get energy moving in a positive way.',
  },
  {
    icon: '?',
    title: 'Learning',
    body: 'Fun prompts and challenges that spark curiosity.',
  },
  {
    icon: '★',
    title: 'Joy',
    body: 'Bright experiences that feel safe, expressive, and shareable.',
  },
];
---

<BaseLayout
  title="Energize Kids | Clean, Faith-Based Entertainment for Children"
  description="Energize Kids brings clean, family-friendly music and activities to children across Nigeria, from Energize Music."
  ogImage="/initiatives/energize-kids.webp"
  keywords={['Christian kids entertainment Nigeria', 'family-friendly gospel music kids', 'Energize Kids']}
  breadcrumbs={crumbs({ name: 'Energize Kids', path: '/energize-kids' })}
>
  <!-- Hero -->
  <section class="border-b border-[var(--color-line)]">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
      <div>
        <p class="scroll-reveal text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-accent)]">
          Music · Movement · Learning · Joy
        </p>
        <h1 class="scroll-reveal text-h1 mt-6 max-w-3xl" style="--reveal-delay: 80ms">Christian Kids Entertainment from Energize Music</h1>
        <p class="scroll-reveal text-lead mt-6 max-w-2xl text-fg" style="--reveal-delay: 160ms">
          Energize Kids is the family wing of Energize Music: clean songs, movement games, learning prompts, and joy-first activities. Details and registration live on energize-kids.com.
        </p>
        <div class="scroll-reveal mt-10 flex flex-wrap gap-3" style="--reveal-delay: 240ms">
          <a
            href={LIVE_SITE}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-fg px-7 py-3.5 text-sm font-semibold text-[var(--color-bg)] transition hover:bg-fg/90"
          >
            Visit Energize Kids
          </a>
        </div>
      </div>
      <img
        src="/initiatives/energize-kids.webp"
        alt="A young Energize Kids performer"
        width="1080"
        height="1439"
        class="scroll-reveal media-frame aspect-[4/5] w-full max-w-md object-cover object-top lg:justify-self-end"
        style="--reveal-delay: 120ms"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- Highlights -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 sm:py-20">
      <ul class="scroll-reveal-stagger grid gap-6 sm:grid-cols-3">
        <li class="text-sm text-fg">
          <strong class="block text-fg">Play Zone challenges</strong>
          Short prompts kids can try at home, like saying one kind thing to a friend
        </li>
        <li class="text-sm text-fg">
          <strong class="block text-fg">Community powered</strong>
          By Energize Music and Energize Central
        </li>
        <li class="text-sm text-fg">
          <strong class="block text-fg">Parent-led registration</strong>
          A parent or guardian signs a child up and stays in control of updates
        </li>
      </ul>
    </div>
  </section>

  <!-- Event -->
  <section id="events" class="scroll-mt-24 border-b border-[var(--color-line)]">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
      <div class="scroll-reveal mb-10 rounded-2xl border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/[0.06] px-6 py-5 sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Live events &amp; registration</p>
          <p class="mt-2 text-sm text-fg">
            Dates, Zoom links, and sign-up live on the Energize Kids site. Visit Energize Kids for the latest.
          </p>
        </div>
        <a
          href={LIVE_SITE}
          target="_blank"
          rel="noopener noreferrer"
          class="button-glow mt-4 inline-flex shrink-0 items-center rounded-full bg-fg px-6 py-3 text-sm font-semibold text-[var(--color-bg)] transition hover:bg-fg/90 sm:mt-0"
        >
          Go to Energize Kids
        </a>
      </div>

      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div class="scroll-reveal">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Online event for parents and guardians</p>
          <h2 class="text-h2 mt-3">Crowned, Not Cloned.</h2>
          <p class="mt-4 text-fg">
            Join a Zoom conversation for parents and guardians about raising kids with identity, conviction, purpose, and confidence in God. Date: 25 July 2026. Register on energize-kids.com.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={LIVE_SITE}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-full bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-on-accent)] transition hover:bg-[var(--color-accent)]/90"
            >
              Register at Energize Kids
            </a>
          </div>
        </div>
        <div class="scroll-reveal scroll-reveal-pixel rounded-2xl border border-[var(--color-line)] bg-fg/5 p-8" style="--reveal-delay: 120ms">
          <p class="text-xs font-semibold uppercase tracking-widest text-fg">Featured Artist</p>
          <h3 class="text-h3 mt-2">Xade</h3>
          <p class="mt-4 text-fg">
            Xade brings a soulful blend of Afro-Gospel, Afrobeats, and Hip-Hop. His single <em>Prayer</em> is available across all platforms.
          </p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {['Afro-Gospel', 'Afrobeats', 'Hip-Hop', 'Clean Energy'].map((tag) => (
              <li class="rounded-full border border-[var(--color-line)] px-3 py-1 text-xs text-fg">{tag}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section id="pillars" class="scroll-mt-24 border-b border-[var(--color-line)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
      <div class="scroll-reveal max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">The Energize Kids World</p>
        <h2 class="text-h2 mt-3">More than music, built for joyful discovery.</h2>
      </div>
      <div class="scroll-reveal-stagger mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-variant="pixel">
        {pillars.map((pillar) => (
          <article class="rounded-xl border border-[var(--color-line)] bg-fg/5 p-6">
            <span class="text-2xl text-[var(--color-accent)]" aria-hidden="true">{pillar.icon}</span>
            <h3 class="mt-4 font-display text-lg font-medium">{pillar.title}</h3>
            <p class="mt-2 text-sm text-fg">{pillar.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:px-6 sm:py-28">
      <h2 class="scroll-reveal text-h2">Stay with Energize Kids online</h2>
      <p class="scroll-reveal mx-auto mt-4 max-w-xl text-fg" style="--reveal-delay: 80ms">
        Powered by Energize Music and Energize Central. Find Play Zone challenges, child registration, Xade's single Prayer, and event sign-ups on energize-kids.com.
      </p>
      <a
        href={LIVE_SITE}
        target="_blank"
        rel="noopener noreferrer"
        class="scroll-reveal button-glow mt-8 inline-block rounded-full bg-fg px-8 py-3.5 text-sm font-semibold text-[var(--color-bg)] transition hover:bg-fg/90"
        style="--reveal-delay: 160ms"
      >
        Visit Energize Kids
      </a>
    </div>
  </section>
</BaseLayout>
