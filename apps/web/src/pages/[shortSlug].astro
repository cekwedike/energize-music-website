---
import type { GetStaticPaths } from 'astro';
import { sanityClient } from '../lib/sanity/client';
import { eventsQuery, type EventDetail } from '@energize/shared';

export const getStaticPaths = (async () => {
  const events = await sanityClient.fetch<EventDetail[]>(eventsQuery);

  return events
    .filter((event) => event.shortSlug)
    .map((event) => ({
      params: { shortSlug: event.shortSlug! },
      props: { destination: `/events/${event.slug}` },
    }));
}) satisfies GetStaticPaths;

interface Props {
  destination: string;
}

return Astro.redirect(Astro.props.destination, 301);
---
