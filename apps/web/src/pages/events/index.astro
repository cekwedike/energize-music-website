---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import SubscribeDialog from '../../components/forms/SubscribeDialog.astro';
import { sanityClient } from '../../lib/sanity/client';
import { eventsQuery, type EventDetail } from '@energize/shared';
import { getEventCoverUrl } from '../../lib/events/media';
import { formatEventDateLong, formatEventLocation, formatEventType } from '../../lib/events/format';
import { splitEvents } from '../../lib/events/fest';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl, imageAlt } from '../../lib/seo/site';

let events: EventDetail[] = [];
try {
  events = await sanityClient.fetch<EventDetail[]>(eventsQuery);
} catch {
  events = [];
}

const { upcoming, past } = splitEvents(events);
const eventList = events.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: 'Energize Music Events',
      itemListElement: events.map((event, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteUrl(`/events/${event.slug}`),
        name: event.title,
      })),
    }
  : null;

const card = (event: EventDetail) => ({
  ...event,
  href: `/events/${event.slug}`,
  imageUrl: getEventCoverUrl(event.cover, 1600, 1067),
  imageAlt: imageAlt(event.cover?.alt, `${event.title} event cover`),
  date: formatEventDateLong(event.startDate),
  venue: formatEventLocation(event.location),
  format: formatEventType(event.eventType),
});

const featured = upcoming[0] ? card(upcoming[0]) : null;
const moreUpcoming = upcoming.slice(1).map(card);
const pastEvents = past.map(card);
---

<BaseLayout
  title="Events | Live Music from Energize Music"
  description="Find upcoming Energize Music events, revisit past shows, and open each event page for dates, venues, lineups, and tickets."
  ogImage={featured?.imageUrl ?? undefined}
  keywords={['Energize Music events', 'gospel concerts', 'Afro-gospel live shows']}
  breadcrumbs={crumbs({ name: 'Events', path: '/events' })}
>
  {eventList && <JsonLd data={eventList} />}

  <main class="events-page">
    <header class="events-intro">
      <div class="events-shell events-intro__grid">
        <h1>Events</h1>
        <div class="events-intro__copy">
          <p>Come for the music. Stay for the people, the energy, and the moments you will talk about later.</p>
          <button
            type="button"
            class="text-action"
            data-subscribe-open
            data-subscribe-title="Get Event Updates"
            data-subscribe-lead="Get new event dates and ticket news in your inbox."
          >
            Get event updates
          </button>
        </div>
      </div>
    </header>

    <section class="featured-section" aria-labelledby="featured-event-title">
      <div class="events-shell">
        {
          featured ? (
            <article class="featured-event">
              <a class="featured-event__media" href={featured.href} aria-label={`View ${featured.title}`}>
                {featured.imageUrl ? (
                  <img
                    src={featured.imageUrl}
                    alt={featured.imageAlt}
                    width="1600"
                    height="1067"
                    fetchpriority="high"
                    decoding="async"
                  />
                ) : (
                  <span class="event-image-fallback" aria-hidden="true"></span>
                )}
              </a>
              <div class="featured-event__body">
                <h2 id="featured-event-title">{featured.title}</h2>
                {featured.subtitle && <p class="featured-event__subtitle">{featured.subtitle}</p>}
                <p class="featured-event__date">{featured.date}</p>
                <dl class="featured-event__details">
                  <div>
                    <dt>Place</dt>
                    <dd>{featured.venue}</dd>
                  </div>
                  <div>
                    <dt>Format</dt>
                    <dd>{featured.format}</dd>
                  </div>
                </dl>
                <a class="solid-action" href={featured.href}>View event</a>
              </div>
            </article>
          ) : (
            <article class="featured-event featured-event--empty">
              <div class="featured-event__graphic" aria-hidden="true"><span>EM</span></div>
              <div class="featured-event__body">
                <h2 id="featured-event-title">More nights are coming</h2>
                <p class="featured-event__subtitle">We are getting the next dates ready. Join the list and hear about them first.</p>
                <button
                  type="button"
                  class="solid-action"
                  data-subscribe-open
                  data-subscribe-title="Get Event Updates"
                  data-subscribe-lead="Get new event dates and ticket news in your inbox."
                >
                  Get event updates
                </button>
              </div>
            </article>
          )
        }
      </div>
    </section>

    {
      moreUpcoming.length > 0 && (
        <section class="event-list-section" aria-labelledby="upcoming-events-title">
          <div class="events-shell">
            <div class="section-heading">
              <h2 id="upcoming-events-title">Coming Up</h2>
              <p>More dates to put on your calendar.</p>
            </div>
            <ul class="event-grid">
              {moreUpcoming.map((event) => (
                <li>
                  <a class="event-card" href={event.href}>
                    <span class="event-card__media">
                      {event.imageUrl ? (
                        <img src={event.imageUrl} alt={event.imageAlt} width="900" height="600" loading="lazy" decoding="async" />
                      ) : (
                        <span class="event-image-fallback" aria-hidden="true"></span>
                      )}
                    </span>
                    <span class="event-card__body">
                      <span class="event-card__date">{event.date}</span>
                      <span class="event-card__title">{event.title}</span>
                      <span class="event-card__place">{event.venue}</span>
                      <span class="event-card__action">View event</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      pastEvents.length > 0 && (
        <section class="past-section" aria-labelledby="past-events-title">
          <div class="events-shell past-section__grid">
            <div class="section-heading">
              <h2 id="past-events-title">Past Events</h2>
              <p>Look back at the nights we shared.</p>
            </div>
            <ol class="past-list">
              {pastEvents.map((event, index) => (
                <li>
                  <a href={event.href}>
                    <span class="past-list__number">{String(index + 1).padStart(2, '0')}</span>
                    <span class="past-list__name">{event.title}</span>
                    <span class="past-list__date">{event.date}</span>
                    <span class="past-list__action">View event</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section class="events-signup" aria-labelledby="events-signup-title">
      <div class="events-signup__mark" aria-hidden="true">E</div>
      <div class="events-shell events-signup__grid">
        <h2 id="events-signup-title">Hear about the next one first.</h2>
        <div>
          <p>Get event dates, ticket news, and lineup updates in your inbox.</p>
          <button
            type="button"
            class="solid-action solid-action--dark"
            data-subscribe-open
            data-subscribe-title="Get Event Updates"
            data-subscribe-lead="Get new event dates and ticket news in your inbox."
          >
            Join the event list
          </button>
        </div>
      </div>
    </section>
  </main>

  <SubscribeDialog />
</BaseLayout>

<style>
  .events-page { overflow: clip; background: #f4f3ef; color: #080808; }
  .events-shell { width: min(100% - 2.5rem, 90rem); margin-inline: auto; }

  .events-intro { padding: clamp(5rem, 9vw, 9rem) 0 clamp(3.5rem, 7vw, 6rem); }
  .events-intro__grid { display: grid; gap: 2rem; align-items: end; }
  .events-intro h1 { margin: 0; font-family: var(--font-display); font-size: clamp(4.5rem, 11vw, 10rem); font-weight: 500; line-height: .78; letter-spacing: -.065em; }
  .events-intro__copy { max-width: 34rem; }
  .events-intro__copy p { margin: 0; font-size: clamp(1.15rem, 1rem + .5vw, 1.5rem); line-height: 1.45; }
  .text-action { margin-top: 1.5rem; border: 0; border-bottom: 2px solid #080808; border-radius: 0; padding: 0 0 .3rem; background: transparent; color: inherit; font: inherit; font-size: .76rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; cursor: pointer; }

  .featured-section { padding-bottom: clamp(5rem, 9vw, 9rem); }
  .featured-event { display: grid; background: #0a0a0a; color: #fff; }
  .featured-event__media { display: block; min-height: 21rem; overflow: hidden; background: #161616; }
  .featured-event__media img, .event-image-fallback { display: block; width: 100%; height: 100%; object-fit: cover; }
  .featured-event__media img { transition: transform 700ms cubic-bezier(.22, 1, .36, 1); }
  .featured-event__media:hover img { transform: scale(1.025); }
  .event-image-fallback { background: linear-gradient(135deg, #173fbd, #07133a 60%, #080808); }
  .featured-event__body { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 5rem); }
  .featured-event__date { margin: 1.5rem 0 0; color: #89a6ff; font-size: .82rem; font-weight: 700; line-height: 1.45; }
  .featured-event h2 { max-width: 12ch; margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 5vw, 5.5rem); font-weight: 500; line-height: .9; letter-spacing: -.045em; }
  .featured-event__subtitle { max-width: 34rem; margin: 1.25rem 0 0; color: rgba(255,255,255,.72); font-size: 1rem; line-height: 1.6; }
  .featured-event__details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: clamp(2rem, 4vw, 3.5rem) 0 0; padding: 1.5rem 0 0; border-top: 1px solid rgba(255,255,255,.2); }
  .featured-event__details dt { color: #89a6ff; font-size: .66rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .featured-event__details dd { margin: .45rem 0 0; font-size: .9rem; line-height: 1.45; }
  .solid-action { display: inline-flex; width: fit-content; min-height: 3.25rem; align-items: center; justify-content: center; margin-top: 2rem; border: 1px solid #fff; border-radius: 0; padding: .9rem 1.4rem; background: #fff; color: #080808; font: inherit; font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: background-color 180ms ease, color 180ms ease; }
  .solid-action:hover { background: transparent; color: #fff; }
  .featured-event__graphic { display: grid; min-height: 24rem; place-items: center; overflow: hidden; background: #2458ed; }
  .featured-event__graphic span { font-family: var(--font-display); font-size: clamp(9rem, 30vw, 24rem); line-height: .7; letter-spacing: -.12em; color: #fff; transform: translateX(-.06em); }

  .event-list-section, .past-section { padding: clamp(5rem, 9vw, 9rem) 0; }
  .event-list-section { background: #fff; }
  .section-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 500; line-height: .9; letter-spacing: -.045em; }
  .section-heading p { max-width: 25rem; margin: 1rem 0 0; color: #5e5e5e; line-height: 1.55; }
  .event-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 3rem 1.5rem; margin: 3.5rem 0 0; padding: 0; list-style: none; }
  .event-card { display: block; height: 100%; color: inherit; }
  .event-card__media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #ececec; }
  .event-card__media img, .event-card__media .event-image-fallback { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.22, 1, .36, 1); }
  .event-card:hover .event-card__media img { transform: scale(1.025); }
  .event-card__body { display: flex; min-height: 13rem; flex-direction: column; padding-top: 1.25rem; }
  .event-card__date { color: #2458ed; font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .event-card__title { margin-top: .8rem; font-family: var(--font-display); font-size: 2.2rem; line-height: 1; }
  .event-card__place { margin-top: .65rem; color: #666; font-size: .88rem; }
  .event-card__action { width: fit-content; margin-top: auto; padding-top: 1.5rem; border-bottom: 1px solid currentColor; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }

  .past-section { background: #e9e8e3; }
  .past-section__grid { display: grid; gap: 3rem; }
  .past-list { margin: 0; padding: 0; list-style: none; }
  .past-list li { border-bottom: 1px solid rgba(8,8,8,.2); }
  .past-list li:first-child { border-top: 1px solid rgba(8,8,8,.2); }
  .past-list a { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .75rem 1rem; align-items: center; padding: 1.5rem 0; color: inherit; }
  .past-list__number, .past-list__date, .past-list__action { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .past-list__number { color: #2458ed; }
  .past-list__name { font-family: var(--font-display); font-size: clamp(1.65rem, 3vw, 2.5rem); line-height: 1; }
  .past-list__date { grid-column: 2; color: #5e5e5e; }
  .past-list__action { display: none; }

  .events-signup { position: relative; isolation: isolate; overflow: hidden; padding: clamp(5rem, 10vw, 10rem) 0; background: #2458ed; color: #fff; }
  .events-signup__mark { position: absolute; z-index: -1; right: -.07em; bottom: -.3em; font-family: var(--font-display); font-size: min(48vw, 42rem); line-height: .7; color: rgba(0,0,0,.11); }
  .events-signup__grid { display: grid; gap: 2.5rem; align-items: end; }
  .events-signup h2 { max-width: 9ch; margin: 0; font-family: var(--font-display); font-size: clamp(3.6rem, 8vw, 8rem); font-weight: 500; line-height: .84; letter-spacing: -.055em; }
  .events-signup p { max-width: 28rem; margin: 0; font-size: 1.05rem; line-height: 1.55; }
  .solid-action--dark { border-color: #080808; background: #080808; color: #fff; }
  .solid-action--dark:hover { background: transparent; color: #080808; }

  @media (min-width: 760px) {
    .events-shell { width: min(100% - 4rem, 90rem); }
    .events-intro__grid { grid-template-columns: minmax(0, 1.45fr) minmax(20rem, .55fr); }
    .featured-event { grid-template-columns: minmax(0, 1.18fr) minmax(24rem, .82fr); min-height: 40rem; }
    .featured-event__media { min-height: 100%; }
    .past-section__grid { grid-template-columns: minmax(16rem, .55fr) minmax(0, 1.45fr); }
    .past-list a { grid-template-columns: 2rem minmax(0, 1fr) minmax(11rem, auto) auto; gap: 1.5rem; }
    .past-list__date { grid-column: auto; }
    .past-list__action { display: block; }
    .events-signup__grid { grid-template-columns: minmax(0, 1.35fr) minmax(19rem, .65fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-event__media img, .event-card__media img, .solid-action { transition: none; }
  }
</style>
