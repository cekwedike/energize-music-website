---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailView from '../../components/events/EventDetailView.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient } from '../../lib/sanity/client';
import { festEventsQuery, type EventDetail } from '@energize/shared';
import { getEventCoverUrl } from '../../lib/events/media';
import { formatEventLocation } from '../../lib/events/format';
import { splitFestEvents } from '../../lib/events/fest';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

// Always built. The next upcoming event from Sanity fills the page; with none, default Events content shows.
// Events whose dates have passed move to Past Events.
let events: EventDetail[] = [];
try {
  events = await sanityClient.fetch<EventDetail[]>(festEventsQuery);
} catch {
  events = [];
}
const { upcoming, past } = splitFestEvents(events);

const shareUrl = absoluteUrl('/events');
const ogImage = upcoming
  ? getEventCoverUrl(upcoming.shareImage, 1200, 630) || getEventCoverUrl(upcoming.cover, 1200, 630) || undefined
  : undefined;

/** Whole sentences from the summary that fit a search snippet. */
function snippet(text: string | undefined, fallback: string): string {
  const sentences = text?.match(/[^.!?]+[.!?]+(?=\s|$)/g)?.map((s) => s.trim()) ?? [];
  let out = '';
  for (const sentence of sentences) {
    const next = out ? `${out} ${sentence}` : sentence;
    if (next.length > 155) break;
    out = next;
  }
  return out || fallback;
}

const year = upcoming ? new Date(upcoming.startDate).getUTCFullYear() : null;
const upcomingTitle = upcoming ? (upcoming.title === 'Energize Fest' ? 'Events' : upcoming.title) : null;
const pageTitle = upcoming ? `${upcomingTitle} ${year}: Date, Tickets and Lineup` : 'Events | Live Music from Energize Music';
const pageDescription = upcoming
  ? snippet(upcoming.summary, `${upcomingTitle} ${year}, a live event from Energize Music.`)
  : 'Find upcoming Energize Music events, see past shows, and get alerts when new dates and tickets are announced.';

const jsonLd = upcoming
  ? (() => {
      const hasVenue = formatEventLocation(upcoming.location) !== 'Venue to be announced';
      const performers = (upcoming.lineup ?? [])
        .filter((slot) => (!slot.revealState || slot.revealState === 'confirmed') && slot.name?.trim())
        .map((slot) => ({
          '@type': 'PerformingGroup',
          name: slot.name!.trim(),
          ...(slot.artistSlug ? { url: absoluteUrl(`/artists/${slot.artistSlug}`) } : {}),
        }));
      const attendanceMode =
        upcoming.eventType === 'virtual'
          ? 'https://schema.org/OnlineEventAttendanceMode'
          : upcoming.eventType === 'hybrid'
            ? 'https://schema.org/MixedEventAttendanceMode'
            : 'https://schema.org/OfflineEventAttendanceMode';
      return {
        '@context': 'https://schema.org',
        '@type': 'MusicEvent',
        '@id': `${shareUrl}#event`,
        name: upcomingTitle,
        startDate: upcoming.startDate,
        endDate: upcoming.endDate || upcoming.startDate,
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: attendanceMode,
        image: ogImage ? [ogImage] : undefined,
        url: shareUrl,
        description: upcoming.summary?.replaceAll('Energize Fest', 'Events') ?? upcomingTitle,
        inLanguage: 'en',
        location: hasVenue
          ? { '@type': 'Place', name: upcoming.location, address: { '@type': 'PostalAddress', addressLocality: upcoming.location, addressCountry: 'NG' } }
          : { '@type': 'Place', name: 'Venue to be announced', address: { '@type': 'PostalAddress', addressCountry: 'NG' } },
        organizer: { '@id': organizationId() },
        performer: performers.length > 0 ? performers : undefined,
        ...(upcoming.ticketUrl
          ? { offers: { '@type': 'Offer', url: upcoming.ticketUrl, availability: 'https://schema.org/InStock' } }
          : {}),
      };
    })()
  : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  keywords={['Energize Music events', ...(year ? [`Energize Music events ${year}`] : []), 'gospel concert', 'Afro-gospel live show']}
  breadcrumbs={crumbs({ name: 'Events', path: '/events' })}
  headerVariant="overlay"
>
  {jsonLd && <JsonLd data={jsonLd} />}
  <EventDetailView event={upcoming} pastEvents={past} shareUrl={shareUrl} />
</BaseLayout>
