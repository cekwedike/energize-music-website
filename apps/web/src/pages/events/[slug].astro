---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailView from '../../components/events/EventDetailView.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient } from '../../lib/sanity/client';
import { eventBySlugQuery, type EventDetail } from '@energize/shared';
import { getEventCoverUrl } from '../../lib/events/media';
import { formatEventLocation, isPastEvent } from '../../lib/events/format';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

// Other /events/* paths redirect to Energize HQ (see vercel.json), so only Energize Fest is built.
// The page only exists when the event is published in Sanity: there is no hardcoded fallback.
// getStaticPaths runs in isolation, so the slug is written inline.
export async function getStaticPaths() {
  const slug = 'energize-fest';
  const event = await sanityClient.fetch<EventDetail | null>(eventBySlugQuery, { slug });
  return event ? [{ params: { slug }, props: { event } }] : [];
}

const { event } = Astro.props as { event: EventDetail };

const shareImage = getEventCoverUrl(event.shareImage, 1200, 630);
const coverUrl = getEventCoverUrl(event.cover, 1200, 630);
const ogImage = shareImage || coverUrl || undefined;
const shareUrl = absoluteUrl(`/events/${event.slug}`);
const year = new Date(event.startDate).getUTCFullYear();
const isPast = isPastEvent(event.startDate, event.endDate);
const hasVenue = formatEventLocation(event.location) !== 'Venue to be announced';

const pageTitle = `${event.title} ${year}: Date, Tickets and Lineup`;

/** Whole sentences from the summary that fit a search snippet. */
function snippet(text: string | undefined, fallback: string): string {
  const sentences = text?.match(/[^.!?]+[.!?]+(?=\s|$)/g)?.map((s) => s.trim()) ?? [];
  let out = '';
  for (const sentence of sentences) {
    const next = out ? `${out} ${sentence}` : sentence;
    if (next.length > 155) break;
    out = next;
  }
  return out || fallback;
}
const pageDescription = snippet(event.summary, `${event.title} ${year}, a live event from Energize Music.`);

const performers = (event.lineup ?? [])
  .filter((slot) => (!slot.revealState || slot.revealState === 'confirmed') && slot.name?.trim())
  .map((slot) => ({
    '@type': 'PerformingGroup',
    name: slot.name!.trim(),
    ...(slot.artistSlug ? { url: absoluteUrl(`/artists/${slot.artistSlug}`) } : {}),
  }));

const attendanceMode =
  event.eventType === 'virtual'
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : event.eventType === 'hybrid'
      ? 'https://schema.org/MixedEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  '@id': `${shareUrl}#event`,
  name: event.title,
  startDate: event.startDate,
  endDate: event.endDate || event.startDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: attendanceMode,
  image: ogImage ? [ogImage] : undefined,
  url: shareUrl,
  description: event.summary ?? event.title,
  inLanguage: 'en',
  location: hasVenue
    ? { '@type': 'Place', name: event.location, address: { '@type': 'PostalAddress', addressLocality: event.location, addressCountry: 'NG' } }
    : { '@type': 'Place', name: 'Venue to be announced', address: { '@type': 'PostalAddress', addressCountry: 'NG' } },
  organizer: { '@id': organizationId() },
  performer: performers.length > 0 ? performers : undefined,
  ...(event.ticketUrl && !isPast
    ? { offers: { '@type': 'Offer', url: event.ticketUrl, availability: 'https://schema.org/InStock' } }
    : {}),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  keywords={[event.title, `${event.title} ${year}`, 'Energize Music', 'gospel concert', 'Afro-gospel live show', event.location].filter(Boolean) as string[]}
  breadcrumbs={crumbs({ name: event.title, path: `/events/${event.slug}` })}
  headerVariant="overlay"
>
  <JsonLd data={jsonLd} />
  <EventDetailView event={event} shareUrl={shareUrl} />
</BaseLayout>
