---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailView from '../../components/events/EventDetailView.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient } from '../../lib/sanity/client';
import { eventBySlugQuery, eventsQuery, type EventDetail } from '@energize/shared';
import { getEventCoverUrl } from '../../lib/events/media';
import { formatEventLocation } from '../../lib/events/format';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

export const getStaticPaths = (async () => {
  const events = await sanityClient.fetch<EventDetail[]>(eventsQuery);
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}) satisfies GetStaticPaths;

interface Props {
  event: EventDetail;
}

const { event } = Astro.props;
const slug = Astro.params.slug ?? event.slug;
const detail = event ?? (await sanityClient.fetch<EventDetail | null>(eventBySlugQuery, { slug }));

if (!detail) {
  return Astro.redirect('/events', 302);
}

const pageUrl = absoluteUrl(`/events/${detail.slug}`);
const ogImage =
  getEventCoverUrl(detail.shareImage, 1200, 630) ||
  getEventCoverUrl(detail.cover, 1200, 630) ||
  undefined;
const locationName = formatEventLocation(detail.location);
const hasVenue = locationName !== 'Venue to be announced';
const performers = (detail.lineup ?? [])
  .filter((slot) => (!slot.revealState || slot.revealState === 'confirmed') && slot.name?.trim())
  .map((slot) => ({
    '@type': 'PerformingGroup',
    name: slot.name!.trim(),
    ...(slot.artistSlug ? { url: absoluteUrl(`/artists/${slot.artistSlug}`) } : {}),
  }));
const attendanceMode =
  detail.eventType === 'virtual'
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : detail.eventType === 'hybrid'
      ? 'https://schema.org/MixedEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  '@id': `${pageUrl}#event`,
  name: detail.title,
  startDate: detail.startDate,
  endDate: detail.endDate || detail.startDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: attendanceMode,
  image: ogImage ? [ogImage] : undefined,
  url: pageUrl,
  description: detail.summary ?? detail.subtitle ?? detail.title,
  inLanguage: 'en',
  location: hasVenue
    ? {
        '@type': 'Place',
        name: detail.location,
        address: { '@type': 'PostalAddress', addressLocality: detail.location },
      }
    : { '@type': 'Place', name: locationName },
  organizer: { '@id': organizationId() },
  performer: performers.length > 0 ? performers : undefined,
  ...(detail.ticketUrl
    ? {
        offers: {
          '@type': 'Offer',
          url: detail.ticketUrl,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};
---

<BaseLayout
  title={`${detail.title} | Energize Music Events`}
  description={detail.summary ?? detail.subtitle ?? `Event details, dates, and tickets for ${detail.title}.`}
  ogImage={ogImage}
  keywords={[detail.title, 'Energize Music events', 'live music event']}
  breadcrumbs={crumbs(
    { name: 'Events', path: '/events' },
    { name: detail.title, path: `/events/${detail.slug}` },
  )}
  headerVariant="overlay"
>
  <JsonLd data={jsonLd} />
  <EventDetailView event={detail} pastEvents={[]} shareUrl={pageUrl} />
</BaseLayout>
