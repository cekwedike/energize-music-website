---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ReleaseDetail from '../../components/releases/ReleaseDetail.astro';
import { sanityClient } from '../../lib/sanity/client';
import { enrichRelease } from '../../lib/metadata/enrichReleases';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl, listNames } from '../../lib/seo/site';
import { allReleasesQuery, releaseBySlugQuery, type Release } from '@energize/shared';

/** Build one static page per published release slug. Dev can still resolve new slugs after publish. */
export const dynamicParams = true;

export async function getStaticPaths() {
  const releases = await sanityClient.fetch<Pick<Release, 'slug'>[]>(allReleasesQuery);
  return releases.map((release) => ({ params: { slug: release.slug } }));
}

const { slug } = Astro.params;
const release = await sanityClient.fetch<Release>(releaseBySlugQuery, { slug });

if (!release) {
  return Astro.redirect('/404');
}

const enriched = await enrichRelease(release, { coverSize: 1200 });

const typeLabel: Record<Release['type'], string> = {
  single: 'Single',
  ep: 'EP',
  album: 'Album',
  compilation: 'Compilation',
};
const releaseTypeLabel = typeLabel[release.type];

const artists = (enriched.artists ?? []).filter(
  (artist): artist is NonNullable<typeof artist> => Boolean(artist?._id && artist.slug && artist.name),
);

const pageUrl = absoluteUrl(`/releases/${release.slug}`);
const schemaType = release.type === 'single' ? 'MusicRecording' : 'MusicAlbum';
const albumReleaseType =
  release.type === 'ep'
    ? 'EPRelease'
    : release.type === 'compilation'
      ? 'CompilationAlbum'
      : release.type === 'album'
        ? 'AlbumRelease'
        : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${pageUrl}#release`,
  name: enriched.displayTitle,
  image: enriched.coverUrl,
  datePublished: release.releaseDate,
  url: pageUrl,
  ...(albumReleaseType ? { albumReleaseType } : {}),
  byArtist: artists.map((artist) => ({
    '@type': 'MusicGroup',
    '@id': absoluteUrl(`/artists/${artist.slug}#artist`),
    name: artist.name,
    url: absoluteUrl(`/artists/${artist.slug}`),
  })),
  recordLabel: { '@id': organizationId() },
  ...(enriched.externalUrl
    ? {
        potentialAction: {
          '@type': 'ListenAction',
          target: enriched.externalUrl,
        },
      }
    : {}),
};

const byline = listNames(artists.length > 0 ? artists.map((a) => a.name) : enriched.artistNames);
const year = new Date(release.releaseDate).getUTCFullYear();
const platforms = [
  release.links?.spotify && 'Spotify',
  release.links?.appleMusic && 'Apple Music',
  release.links?.youtube && 'YouTube',
].filter(Boolean) as string[];
const typeWord = releaseTypeLabel === 'EP' ? 'EP' : releaseTypeLabel.toLowerCase();

const seoTitle = byline ? `${enriched.displayTitle} by ${byline}` : enriched.displayTitle;
const seoDescription = [
  `Listen to ${enriched.displayTitle}, the ${year} Afro-gospel ${typeWord}${byline ? ` by ${byline}` : ''} on Energize Music.`,
  platforms.length > 0 ? `Stream on ${listNames(platforms)}.` : '',
]
  .filter(Boolean)
  .join(' ');
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={enriched.coverUrl}
  ogType={release.type === 'single' ? 'music.song' : 'music.album'}
  keywords={[
    enriched.displayTitle,
    ...artists.map((artist) => artist.name),
    ...artists.map((artist) => `${enriched.displayTitle} ${artist.name}`),
    releaseTypeLabel,
    'Energize Music',
    'Afro-gospel',
  ]}
  breadcrumbs={crumbs(
    { name: 'Releases', path: '/releases' },
    { name: enriched.displayTitle, path: `/releases/${release.slug}` },
  )}
>
  <JsonLd data={jsonLd} />
  <ReleaseDetail release={enriched} />
</BaseLayout>
