---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ReleaseFeature from '../../components/releases/ReleaseFeature.astro';
import { sanityClient } from '../../lib/sanity/client';
import { enrichRelease } from '../../lib/metadata/enrichReleases';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';
import { allReleasesQuery, releaseBySlugQuery, type Release } from '@energize/shared';
import { releaseTypeLabels } from '../../lib/releases/format';

/** Build one static page per published release slug. Dev can still resolve new slugs after publish. */
export const dynamicParams = true;

export async function getStaticPaths() {
  const releases = await sanityClient.fetch<Pick<Release, 'slug'>[]>(allReleasesQuery);
  return releases.map((release) => ({ params: { slug: release.slug } }));
}

const { slug } = Astro.params;
const release = await sanityClient.fetch<Release>(releaseBySlugQuery, { slug });

if (!release) {
  return Astro.redirect('/404');
}

const enriched = await enrichRelease(release, { coverSize: 1200 });

const releaseTypeLabel = releaseTypeLabels[release.type];

const artists = (enriched.artists ?? []).filter(
  (artist): artist is NonNullable<typeof artist> => Boolean(artist?._id && artist.slug && artist.name),
);

const pageUrl = absoluteUrl(`/releases/${release.slug}`);
const schemaType = release.type === 'single' ? 'MusicRecording' : 'MusicAlbum';
const albumReleaseType =
  release.type === 'ep'
    ? 'EPRelease'
    : release.type === 'compilation'
      ? 'CompilationAlbum'
      : release.type === 'album'
        ? 'AlbumRelease'
        : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${pageUrl}#release`,
  name: enriched.displayTitle,
  image: enriched.coverUrl,
  datePublished: release.releaseDate,
  url: pageUrl,
  ...(albumReleaseType ? { albumReleaseType } : {}),
  byArtist: artists.map((artist) => ({
    '@type': 'MusicGroup',
    '@id': absoluteUrl(`/artists/${artist.slug}#artist`),
    name: artist.name,
    url: absoluteUrl(`/artists/${artist.slug}`),
  })),
  recordLabel: { '@id': organizationId() },
  ...(enriched.externalUrl
    ? {
        potentialAction: {
          '@type': 'ListenAction',
          target: enriched.externalUrl,
        },
      }
    : {}),
};

const seoDescription =
  artists.length > 0
    ? `${enriched.displayTitle} by ${artists.map((a) => a.name).join(', ')}. ${releaseTypeLabel} on Energize Music.`
    : `${enriched.displayTitle}: ${releaseTypeLabel} on Energize Music.`;
---

<BaseLayout
  title={enriched.displayTitle}
  description={seoDescription}
  ogImage={enriched.coverUrl}
  ogType={release.type === 'single' ? 'music.song' : 'music.album'}
  keywords={[
    enriched.displayTitle,
    ...artists.map((artist) => artist.name),
    releaseTypeLabel,
    'Energize Music',
    'Afro-gospel',
  ]}
  breadcrumbs={crumbs(
    { name: 'Music', path: '/releases' },
    { name: enriched.displayTitle, path: `/releases/${release.slug}` },
  )}
>
  <JsonLd data={jsonLd} />
  <section class="mx-auto max-w-7xl px-5 pb-24 pt-10 sm:px-6 sm:pb-32 sm:pt-14 lg:px-8">
    <a href="/releases" class="release-back">
      <span aria-hidden="true">&lt;-</span> All music
    </a>
    <div class="mt-8 sm:mt-10">
      <ReleaseFeature release={enriched} eyebrow={releaseTypeLabel} tag="h1" showReleaseLink={false} showDetails eager />
    </div>
  </section>
</BaseLayout>

<style>
  .release-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
  }

  .release-back:hover,
  .release-back:focus-visible {
    color: var(--color-accent);
  }
</style>
