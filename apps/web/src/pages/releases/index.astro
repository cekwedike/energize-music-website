---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import ReleasesHero from '../../components/releases/ReleasesHero.astro';
import ReleaseSpotlight from '../../components/releases/ReleaseSpotlight.astro';
import ReleasesListingSection from '../../components/releases/ReleasesListingSection.astro';
import { sanityClient } from '../../lib/sanity/client';
import { enrichReleases, enrichRelease } from '../../lib/metadata/enrichReleases';
import {
  allReleasesQuery,
  releasesPageQuery,
  type Release,
  type ReleasesPage,
} from '@energize/shared';
import { crumbs } from '../../lib/seo/schema';
import { absoluteUrl, listNames } from '../../lib/seo/site';
import { activeSpotlights } from '../../lib/releases/spotlights';

const rawReleases = await sanityClient.fetch<Release[]>(allReleasesQuery);
const releases = await enrichReleases(rawReleases);
const releaseArtists = [...new Set(releases.flatMap((release) => release.artistNames))];
const byline = listNames(releaseArtists);

const releasesPage = await sanityClient.fetch<ReleasesPage | null>(releasesPageQuery);

const spotlightReleases = await Promise.all(
  activeSpotlights(releasesPage).map((release: Release) => enrichRelease(release, { coverSize: 800 })),
);

const itemList =
  releases.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Energize Music Releases',
        itemListElement: releases.slice(0, 50).map((release: (typeof releases)[number], index: number) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: absoluteUrl(`/releases/${release.slug}`),
          name: release.displayTitle,
        })),
      }
    : null;
---

<BaseLayout
  title="New Afro-Gospel Music and Releases | Energize Music"
  description={`Stream the latest Afro-gospel and soul-fusion singles, EPs, and albums from Energize Music${byline ? `, including ${byline}` : ''}.`}
  keywords={['new Afro-gospel music', 'new Nigerian gospel songs', 'Energize Music releases', ...releaseArtists]}
  breadcrumbs={crumbs({ name: 'Releases', path: '/releases' })}
>
  {itemList && <JsonLd data={itemList} />}
  <ReleasesHero releases={releases} totalCount={releases.length} />

  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 sm:py-20">
    {spotlightReleases.length > 0 ? <ReleaseSpotlight releases={spotlightReleases} /> : null}
    <ReleasesListingSection releases={releases} />
  </section>
</BaseLayout>
