---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleasesListingSection from '../../components/releases/ReleasesListingSection.astro';
import { sanityClient } from '../../lib/sanity/client';
import { enrichReleases } from '../../lib/metadata/enrichReleases';
import { allReleasesQuery, type Release } from '@energize/shared';

const rawReleases = await sanityClient.fetch<Release[]>(allReleasesQuery);
const releases = await enrichReleases(rawReleases);
---

<BaseLayout
  title="Releases"
  description="Singles, EPs, and albums from Energize Music artists."
  ambientVariant="editorial"
>
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-7xl px-5 pb-10 pt-24 sm:px-6 sm:pb-14 sm:pt-32">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-glow)]">Catalog</p>
      <h1 class="text-h1 mt-4 max-w-3xl">Releases</h1>
      <p class="text-lead mt-5 max-w-2xl text-paper/70">
        Browse every single, EP, and album on the Energize Music roster.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 sm:py-20">
    <ReleasesListingSection releases={releases} />
  </section>
</BaseLayout>
