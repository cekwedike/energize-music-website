---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseCard from '../../components/releases/ReleaseCard.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allReleasesQuery, type Release } from '@energize/shared';

const releases = await sanityClient.fetch<Release[]>(allReleasesQuery);

const types: { label: string; value: Release['type'] | 'all' }[] = [
  { label: 'All', value: 'all' },
  { label: 'Singles', value: 'single' },
  { label: 'EPs', value: 'ep' },
  { label: 'Albums', value: 'album' },
  { label: 'Compilations', value: 'compilation' },
];

const years = Array.from(new Set(releases.map((r) => new Date(r.releaseDate).getFullYear()))).sort(
  (a, b) => b - a,
);
---

<BaseLayout title="Releases" description="Energize Music catalog — singles, EPs, albums, compilations.">
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <h1 class="text-h1">Releases</h1>
    <p class="text-lead mt-4 max-w-xl text-paper/70">The Energize Music catalog.</p>

    {
      releases.length === 0 ? (
        <p class="mt-10 text-paper/60">Releases will appear here once added in Sanity Studio.</p>
      ) : (
        <>
          <div class="mt-10 flex flex-wrap items-center gap-6">
            <div id="release-type-tabs" class="flex flex-wrap gap-2" role="tablist" aria-label="Filter by type">
              {types.map((type, index) => (
                <button
                  type="button"
                  data-type={type.value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  class="rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-paper/75 transition hover:border-[var(--color-gold)] aria-[pressed=true]:border-[var(--color-gold)] aria-[pressed=true]:text-[var(--color-gold)]"
                >
                  {type.label}
                </button>
              ))}
            </div>

            {years.length > 1 && (
              <label class="flex items-center gap-2 text-sm text-paper/70">
                Year
                <select
                  id="release-year-filter"
                  class="rounded-full border border-white/20 bg-transparent px-3 py-1.5 text-paper"
                >
                  <option value="all">All</option>
                  {years.map((year) => (
                    <option value={year}>{year}</option>
                  ))}
                </select>
              </label>
            )}
          </div>

          <div id="release-grid" class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {releases.map((release) => (
              <ReleaseCard release={release} />
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  const tabsEl = document.getElementById('release-type-tabs');
  const yearSelect = document.getElementById('release-year-filter') as HTMLSelectElement | null;
  const grid = document.getElementById('release-grid');

  function applyFilters() {
    if (!grid) return;
    const activeType = tabsEl?.querySelector<HTMLButtonElement>('[aria-pressed="true"]')?.dataset.type ?? 'all';
    const activeYear = yearSelect?.value ?? 'all';

    grid.querySelectorAll<HTMLElement>('[data-type]').forEach((card) => {
      const matchesType = activeType === 'all' || card.dataset.type === activeType;
      const matchesYear = activeYear === 'all' || card.dataset.year === activeYear;
      card.classList.toggle('hidden', !(matchesType && matchesYear));
    });
  }

  tabsEl?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-type]');
    if (!button) return;
    tabsEl.querySelectorAll('button[data-type]').forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
    button.setAttribute('aria-pressed', 'true');
    applyFilters();
  });

  yearSelect?.addEventListener('change', applyFilters);
</script>
