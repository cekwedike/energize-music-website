---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseCard from '../../components/releases/ReleaseCard.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allReleasesQuery, type Release } from '@energize/shared';

const releases = await sanityClient.fetch<Release[]>(allReleasesQuery);
---

<BaseLayout
  title="Releases"
  description="Singles, EPs, and albums from Energize Music artists."
  ambientVariant="editorial"
>
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-7xl px-5 pb-10 pt-24 sm:px-6 sm:pb-14 sm:pt-32">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-[var(--color-glow)]">Catalog</p>
      <h1 class="text-h1 mt-4 max-w-3xl">Releases</h1>
      <p class="text-lead mt-5 max-w-2xl text-paper/70">
        Browse every single, EP, and album on the Energize Music roster.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-6 sm:py-20">
    {
      releases.length === 0 ? (
        <p class="rounded-2xl border border-dashed border-white/15 bg-white/[0.02] px-8 py-16 text-center text-paper/55">
          Releases will appear here once you add them in Sanity Studio.
        </p>
      ) : (
        <ul class="releases-index__grid">
          {releases.map((release) => (
            <li>
              <ReleaseCard release={release} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .releases-index__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .releases-index__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .releases-index__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .releases-index__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
