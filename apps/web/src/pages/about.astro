---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutValues from '../components/about/AboutValues.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutTeam from '../components/about/AboutTeam.astro';
import AboutCta from '../components/about/AboutCta.astro';
import { sanityClient } from '../lib/sanity/client';
import {
  aboutPageQuery,
  pageBySlugQuery,
  allTeamMembersQuery,
  type AboutPage,
  type Page,
  type TeamMember,
} from '@energize/shared';
import { crumbs } from '../lib/seo/schema';

const [aboutPage, legacyPage, team] = await Promise.all([
  sanityClient.fetch<AboutPage | null>(aboutPageQuery),
  sanityClient.fetch<Page | null>(pageBySlugQuery, { slug: 'about' }),
  sanityClient.fetch<TeamMember[]>(allTeamMembersQuery),
]);

const pageTitle = aboutPage?.title ?? legacyPage?.title ?? 'About Energize Music';
---

<BaseLayout
  title="About Energize Music | Our Story, Mission, and Team"
  description="The story, mission, and team behind Energize Music, the Lagos Afro-gospel record label founded by Tochukwu 'Dr. Foy' Macfoy."
  keywords={['about Energize Music', 'Afro-gospel record label Lagos', 'Energize Music team', 'Dr. Foy', 'Tochukwu Macfoy']}
  breadcrumbs={crumbs({ name: 'About', path: '/about' })}
>
  <AboutHero title={pageTitle} />
  <AboutStory />
  <AboutValues />
  <AboutTeam team={team} aboutPage={aboutPage} />
  <AboutCta />
</BaseLayout>
