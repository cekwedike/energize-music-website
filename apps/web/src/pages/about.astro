---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutValues from '../components/about/AboutValues.astro';
import AboutStory from '../components/about/AboutStory.astro';
import AboutTeam from '../components/about/AboutTeam.astro';
import AboutCta from '../components/about/AboutCta.astro';
import { sanityClient } from '../lib/sanity/client';
import {
  aboutPageQuery,
  pageBySlugQuery,
  allTeamMembersQuery,
  type AboutPage,
  type Page,
  type TeamMember,
} from '@energize/shared';

const [aboutPage, legacyPage, team] = await Promise.all([
  sanityClient.fetch<AboutPage | null>(aboutPageQuery),
  sanityClient.fetch<Page | null>(pageBySlugQuery, { slug: 'about' }),
  sanityClient.fetch<TeamMember[]>(allTeamMembersQuery),
]);

const pageTitle = aboutPage?.title ?? legacyPage?.title ?? 'About Energize Music';
---

<BaseLayout title="About Us" description="Energize Music's mission, vision, values, and the team behind it.">
  <AboutHero title={pageTitle} />
  <AboutValues />
  <AboutStory aboutPage={aboutPage} legacyPage={legacyPage} />
  <AboutTeam team={team} aboutPage={aboutPage} />
  <AboutCta />
</BaseLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) {
    document.querySelectorAll('.about-scroll-reveal').forEach((el) => el.classList.add('is-visible'));
  } else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    document.querySelectorAll('.about-scroll-reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.about-scroll-reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>
