---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { sanityClient, sanityImageUrl } from '../../lib/sanity/client';
import { enrichRelease } from '../../lib/metadata/enrichReleases';
import { renderBlogBody } from '../../lib/blog/renderBody';
import { authorNames, formatPostDate, readingLabel } from '../../lib/blog/format';
import { focusPosition, responsiveImage, shareImageUrl } from '../../lib/blog/images';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';
import {
  blogPostBySlugQuery,
  blogPostSlugsQuery,
  type EnrichedRelease,
  type Post,
  type PostCard as PostCardData,
  type Release,
} from '@energize/shared';
import '../../styles/blog.css';

export async function getStaticPaths() {
  let slugs: string[] = [];
  try {
    slugs = await sanityClient.fetch<string[]>(blogPostSlugsQuery);
  } catch {
    slugs = [];
  }
  return slugs.filter(Boolean).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<Post | null>(blogPostBySlugQuery, { slug });

if (!post) {
  return Astro.redirect('/404');
}

// Release cards in the body and "Listen now" releases need cover art, which can come from streaming links.
const bodyReleases = new Map<string, EnrichedRelease>();
await Promise.all(
  (post.body ?? [])
    .filter((block) => block._type === 'blogReleaseCard' && (block as { release?: Release | null }).release?.slug)
    .map(async (block) => {
      const release = (block as unknown as { release: Release }).release;
      bodyReleases.set(block._key, await enrichRelease(release, { coverSize: 320 }));
    }),
);
const relatedReleases = await Promise.all((post.relatedReleases ?? []).map((release) => enrichRelease(release, { coverSize: 480 })));

const body = renderBlogBody(post.body, { releases: bodyReleases });
const showToc = body.toc.length >= 3;

// "Read next": hand-picked posts first, then the same category, then the newest.
const readNext: PostCardData[] = [];
for (const candidate of [...(post.relatedPosts ?? []), ...(post.moreFromCategory ?? []), ...(post.latestPosts ?? [])]) {
  if (readNext.length >= 3) break;
  if (candidate && candidate._id !== post._id && !readNext.some((item) => item._id === candidate._id)) readNext.push(candidate);
}

const coverLayout = post.mainImage?.asset ? (post.coverLayout ?? 'contained') : 'hidden';
const immersive = coverLayout === 'immersive';
const cover =
  coverLayout !== 'hidden' && post.mainImage
    ? responsiveImage(post.mainImage, { maxWidth: immersive ? 2400 : 2000, ratio: immersive ? undefined : 16 / 9 })
    : null;
const coverAlt = post.mainImage?.alt?.trim() || '';

const authors = post.authors ?? [];
const byline = authorNames(authors);
const published = formatPostDate(post.publishedAt);
const updated = post.updatedAt && post.updatedAt.slice(0, 10) !== post.publishedAt.slice(0, 10) ? formatPostDate(post.updatedAt) : '';
const reading = readingLabel(post.readingMinutes);

const pageUrl = absoluteUrl(`/blog/${post.slug}`);
const seoTitle = post.seo?.title?.trim() || post.title;
const seoDescription = post.seo?.description?.trim() || post.excerpt;
const ogImage = shareImageUrl(post.seo?.shareImage) ?? shareImageUrl(post.mainImage);
const shareText = encodeURIComponent(post.title);
const shareUrl = encodeURIComponent(pageUrl);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  headline: post.title,
  description: seoDescription,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt ?? post.publishedAt,
  inLanguage: 'en',
  ...(ogImage ? { image: [ogImage] } : {}),
  ...(post.category?.title ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.join(', ') } : {}),
  author: authors.length
    ? authors.map((author) => ({
        '@type': 'Person',
        name: author.name,
        ...(author.role ? { jobTitle: author.role } : {}),
        ...(author.slug ? { url: absoluteUrl(`/artists/${author.slug}`) } : {}),
      }))
    : [{ '@id': organizationId() }],
  publisher: { '@id': organizationId() },
  isPartOf: { '@id': `${absoluteUrl('/blog')}#blog` },
};

const shareLinks = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${shareText}%20${shareUrl}`, icon: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm4.4 12.6c-.2.5-1 1-1.5 1-.4.1-.9.1-1.4 0-.3-.1-.8-.3-1.3-.5-2.3-1-3.8-3.3-3.9-3.5-.1-.1-.9-1.2-.9-2.3s.6-1.6.8-1.8c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .5.4l.7 1.6c.1.1.1.3 0 .4l-.3.4-.3.4c-.1.1-.2.3-.1.5.2.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.1.2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.5-.1l1.5.7c.2.1.4.2.4.3.1.2.1.6-.1 1z' },
  { label: 'X', href: `https://x.com/intent/post?text=${shareText}&url=${shareUrl}`, icon: 'M4 4l6.6 8.8L4.3 20h1.5l5.5-6.2 4.6 6.2H20l-6.9-9.3L19 4h-1.5l-5.1 5.7L8.1 4H4z' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, icon: 'M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.4 1.5-1.4h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.6V21h2.9z' },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, icon: 'M6.5 8.5h-3V20h3V8.5zM5 3.5a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5zM20.5 13.4c0-3-1.6-4.6-3.9-4.6-1.8 0-2.6 1-3.1 1.7V8.5h-3V20h3v-6.1c0-1.6.6-2.6 2-2.6 1.3 0 1.9.9 1.9 2.6V20h3v-6.6z' },
];

const typeLabel: Record<Release['type'], string> = { single: 'Single', ep: 'EP', album: 'Album', compilation: 'Compilation' };
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt ?? post.publishedAt}
  noindex={post.seo?.noIndex === true}
  keywords={[...(post.tags ?? []), post.category?.title ?? '', ...authors.map((author) => author.name), 'Energize Music'].filter(Boolean)}
  breadcrumbs={crumbs({ name: 'Blog', path: '/blog' }, { name: post.title, path: `/blog/${post.slug}` })}
  headerVariant={immersive ? 'overlay' : 'default'}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Energize Music Blog" href="/blog/rss.xml" />
  <JsonLd data={jsonLd} />

  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <article class:list={['post', immersive && 'post--immersive']} data-post>
    <header class:list={['post-hero', immersive && cover && 'post-hero--immersive theme-dark']}>
      {
        immersive && cover && (
          <div class="post-hero__backdrop">
            <img
              src={cover.src}
              srcset={cover.srcset}
              sizes="100vw"
              width={cover.width}
              height={cover.height}
              alt={coverAlt}
              fetchpriority="high"
              decoding="async"
              style={`object-position:${focusPosition(post.mainImage)};${cover.lqip ? `background-image:url('${cover.lqip}')` : ''}`}
            />
          </div>
        )
      }
      <div class="blog-shell post-hero__inner">
        <nav class="post-hero__trail blog-rise" aria-label="Breadcrumb">
          <a href="/blog">Blog</a>
          {
            post.category?.slug && (
              <>
                <span aria-hidden="true">/</span>
                <a href={`/blog?category=${encodeURIComponent(post.category.slug)}`}>{post.category.title}</a>
              </>
            )
          }
        </nav>
        <h1 class="post-hero__title blog-rise blog-rise--2">{post.title}</h1>
        <p class="post-hero__excerpt blog-rise blog-rise--3">{post.excerpt}</p>

        <div class="post-meta blog-rise blog-rise--4">
          {
            authors.length > 0 ? (
              <div class="post-meta__avatars" aria-hidden="true">
                {authors.map((author) => {
                  const photo = sanityImageUrl(author.photo as never, { width: 96, height: 96, fit: 'crop' });
                  return photo ? (
                    <img src={photo} alt="" width="40" height="40" loading="lazy" decoding="async" />
                  ) : (
                    <span>{author.name.charAt(0)}</span>
                  );
                })}
              </div>
            ) : (
              <div class="post-meta__avatars" aria-hidden="true">
                <img src="/favicon.svg" alt="" width="40" height="40" class="post-meta__brand" />
              </div>
            )
          }
          <div class="post-meta__text">
            <p class="post-meta__by">
              By{' '}
              {
                authors.length > 0
                  ? authors.map((author, index) => (
                      <>
                        {index > 0 && (index === authors.length - 1 ? ' and ' : ', ')}
                        {author.slug ? <a href={`/artists/${author.slug}`}>{author.name}</a> : <span>{author.name}</span>}
                      </>
                    ))
                  : byline
              }
            </p>
            <p class="post-meta__details">
              <time datetime={post.publishedAt}>{published}</time>
              <span aria-hidden="true">·</span>
              <span>{reading}</span>
              {updated && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Updated <time datetime={post.updatedAt}>{updated}</time>
                  </span>
                </>
              )}
            </p>
          </div>
        </div>
      </div>
    </header>

    {
      !immersive && cover && (
        <figure class="post-cover blog-shell">
          <img
            src={cover.src}
            srcset={cover.srcset}
            sizes="(min-width: 1280px) 76rem, 100vw"
            width={cover.width}
            height={cover.height}
            alt={coverAlt}
            fetchpriority="high"
            decoding="async"
            style={cover.lqip ? `background-image:url('${cover.lqip}')` : undefined}
          />
          {(post.mainImage?.caption || post.mainImage?.credit) && (
            <figcaption class="pt-caption">
              {post.mainImage?.caption}
              {post.mainImage?.credit && <span class="pt-credit">{post.mainImage.credit}</span>}
            </figcaption>
          )}
        </figure>
      )
    }
    {
      immersive && cover && (post.mainImage?.caption || post.mainImage?.credit) && (
        <p class="blog-shell post-cover__note pt-caption">
          {post.mainImage?.caption}
          {post.mainImage?.credit && <span class="pt-credit">{post.mainImage.credit}</span>}
        </p>
      )
    }

    <div class:list={['blog-shell post-layout', showToc && 'post-layout--toc']}>
      <aside class="post-rail" aria-label="Article tools">
        <div class="post-rail__sticky">
          {
            showToc && (
              <nav class="post-toc" aria-label="In this article">
                <p class="post-rail__label">In this article</p>
                <ol>
                  {body.toc.map((item) => (
                    <li class:list={[item.level === 3 && 'post-toc__sub']}>
                      <a href={`#${item.id}`} data-toc-link={item.id}>
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="post-share">
            <p class="post-rail__label">Share</p>
            <ul class="post-share__list">
              {
                shareLinks.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer" class="post-share__btn" aria-label={`Share on ${link.label}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={link.icon} />
                      </svg>
                    </a>
                  </li>
                ))
              }
              <li>
                <button type="button" class="post-share__btn" data-copy-link={pageUrl} aria-label="Copy link">
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="post-share__stroke">
                    <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
                  </svg>
                </button>
              </li>
            </ul>
            <p class="post-share__copied" data-copy-status role="status"></p>
          </div>
        </div>
      </aside>

      <div class="post-main">
        <div class="post-body" data-post-body set:html={body.html} />

        {
          post.tags && post.tags.length > 0 && (
            <ul class="post-tags" aria-label="Tags">
              {post.tags.map((tag) => (
                <li>#{tag}</li>
              ))}
            </ul>
          )
        }

        {
          authors.length > 0 && (
            <section class="post-authors" aria-label="About the author">
              {authors.map((author) => {
                const photo = sanityImageUrl(author.photo as never, { width: 200, height: 200, fit: 'crop' });
                return (
                  <div class="post-author">
                    {photo ? (
                      <img src={photo} alt="" width="72" height="72" loading="lazy" decoding="async" class="post-author__photo" />
                    ) : (
                      <span class="post-author__photo post-author__photo--empty" aria-hidden="true">
                        {author.name.charAt(0)}
                      </span>
                    )}
                    <div>
                      <p class="post-rail__label">Written by</p>
                      <p class="post-author__name">
                        {author.slug ? <a href={`/artists/${author.slug}`}>{author.name}</a> : author.name}
                      </p>
                      {author.role && <p class="post-author__role">{author.role}</p>}
                      {author.bio && <p class="post-author__bio">{author.bio}</p>}
                    </div>
                  </div>
                );
              })}
            </section>
          )
        }
      </div>
    </div>
  </article>

  {
    (relatedReleases.length > 0 || (post.relatedArtists ?? []).length > 0) && (
      <section class="post-related" aria-labelledby="post-related-title">
        <div class="blog-shell">
          <p class="blog-kicker">From this story</p>
          <h2 id="post-related-title" class="post-related__title">
            Listen and explore
          </h2>
          <div class="post-related__grid">
            {relatedReleases.map((release) => (
              <a href={`/releases/${release.slug}`} class="related-tile">
                {release.coverUrl ? (
                  <img src={release.coverUrl} alt="" width="320" height="320" loading="lazy" decoding="async" class="related-tile__media" />
                ) : (
                  <span class="related-tile__media related-tile__media--empty" aria-hidden="true" />
                )}
                <span class="related-tile__kicker">
                  {typeLabel[release.type]} / {new Date(release.releaseDate).getUTCFullYear()}
                </span>
                <span class="related-tile__title">{release.displayTitle}</span>
                <span class="related-tile__sub">{release.artistNames.join(', ') || 'Energize Music'}</span>
              </a>
            ))}
            {(post.relatedArtists ?? []).map((artist) => {
              const photo = sanityImageUrl(artist.photo as never, { width: 480, height: 480, fit: 'crop' });
              return (
                <a href={`/artists/${artist.slug}`} class="related-tile related-tile--artist">
                  {photo ? (
                    <img src={photo} alt="" width="320" height="320" loading="lazy" decoding="async" class="related-tile__media" />
                  ) : (
                    <span class="related-tile__media related-tile__media--empty" aria-hidden="true" />
                  )}
                  <span class="related-tile__kicker">Artiste</span>
                  <span class="related-tile__title">{artist.name}</span>
                  {artist.tagline && <span class="related-tile__sub">{artist.tagline}</span>}
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    readNext.length > 0 && (
      <section class="post-next" aria-labelledby="post-next-title">
        <div class="blog-shell">
          <div class="post-next__head">
            <div>
              <p class="blog-kicker">Keep reading</p>
              <h2 id="post-next-title" class="post-related__title">
                More stories
              </h2>
            </div>
            <a href="/blog" class="blog-textlink">
              <span class="blog-textlink__line" aria-hidden="true" />
              All stories
            </a>
          </div>
          <div class="blog-grid">
            {readNext.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    body.interactive && (
      <dialog class="lightbox" data-lightbox-dialog aria-label="Image viewer">
        <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close image">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
        <img class="lightbox__img" alt="" data-lightbox-img />
      </dialog>
    )
  }
</BaseLayout>

<script>
  function initPost() {
    const post = document.querySelector<HTMLElement>('[data-post]');
    if (!post || post.dataset.ready === 'true') return;
    post.dataset.ready = 'true';

    // Reading progress bar.
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const body = post.querySelector<HTMLElement>('[data-post-body]');
    if (bar && body) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const rect = body.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        bar.style.transform = `scaleX(${progress})`;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      update();
    }

    // Highlight the current section in the contents list.
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
      const headings = tocLinks
        .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
        .filter((node): node is HTMLElement => Boolean(node));
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (visible.length === 0) return;
          const id = visible[0].target.id;
          tocLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.tocLink === id));
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 },
      );
      headings.forEach((heading) => observer.observe(heading));
    }

    // Copy link, using the native share sheet on phones when available.
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
    copyButton?.addEventListener('click', async () => {
      const url = copyButton.dataset.copyLink ?? window.location.href;
      try {
        if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
          await navigator.share({ title: document.title, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        if (copyStatus) copyStatus.textContent = 'Link copied';
      } catch {
        if (copyStatus) copyStatus.textContent = '';
        return;
      }
      window.setTimeout(() => {
        if (copyStatus) copyStatus.textContent = '';
      }, 2500);
    });

    // Slideshow galleries.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      if (!track) return;
      const step = (direction: number) => {
        const item = track.firstElementChild as HTMLElement | null;
        const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
        track.scrollBy({ left: direction * ((item?.offsetWidth ?? track.clientWidth) + gap), behavior: 'smooth' });
      };
      carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => step(-1));
      carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => step(1));
      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') step(1);
        if (event.key === 'ArrowLeft') step(-1);
      });
    });

    // Tap an article image to view it full size.
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    const dialogImg = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    if (dialog && dialogImg && typeof dialog.showModal === 'function') {
      post.querySelectorAll<HTMLImageElement>('img[data-lightbox]').forEach((img) => {
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', img.alt ? `View larger: ${img.alt}` : 'View larger image');
        const open = () => {
          dialogImg.src = img.dataset.lightbox ?? img.currentSrc;
          dialogImg.alt = img.alt;
          dialog.showModal();
        };
        img.addEventListener('click', open);
        img.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open();
          }
        });
      });
      dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }

  initPost();
  document.addEventListener('astro:page-load', initPost);
</script>
