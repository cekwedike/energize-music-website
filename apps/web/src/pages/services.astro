---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortableText from '../components/portable/PortableText.astro';
import { sanityClient } from '../lib/sanity/client';
import { allServicesQuery, type Service } from '@energize/shared';

const services = await sanityClient.fetch<Service[]>(allServicesQuery);
---

<BaseLayout title="Services" description="A&R, production, distribution via Orchard, sync, and multimedia services.">
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
    <h1 class="text-h1">Services</h1>
    <p class="text-lead mt-4 max-w-xl text-paper/70">
      From artist development to global distribution — how Energize Music works with artists,
      brands, and partners.
    </p>

    {
      services.length === 0 ? (
        <p class="mt-10 text-paper/60">Services will appear here once added in Sanity Studio.</p>
      ) : (
        <div class="mt-14 grid gap-10 sm:grid-cols-2">
          {services.map((service) => (
            <div class="border-t border-white/10 pt-6">
              <h2 class="text-h3">{service.title}</h2>
              <PortableText value={service.body} />
              {service.contactIntent && (
                <a
                  href={`/contact?intent=${encodeURIComponent(service.contactIntent)}`}
                  class="mt-4 inline-block text-sm font-semibold text-[var(--color-gold)] hover:underline"
                >
                  Get in touch &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
