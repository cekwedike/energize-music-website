---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { contactIntents } from '@energize/shared';
import { crumbs } from '../lib/seo/schema';
import { CONTACT_EMAIL } from '../lib/nav';

// Grouped by purpose. Values stay as the shared contact intents.
const intentLabels: Record<(typeof contactIntents)[number], string> = {
  booking: 'Bookings',
  partnership: 'Partnerships',
  press: 'Press',
  'a&r': 'Artist submissions',
  general: 'Something else',
};
const intentOrder: (typeof contactIntents)[number][] = ['booking', 'partnership', 'press', 'a&r', 'general'];

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const workWithUsHref = CONTACT_EMAIL ? `mailto:${CONTACT_EMAIL}?subject=Work%20with%20Energize%20Music` : '#contact-form';
---

<BaseLayout
  title="Contact Energize Music"
  description="Get in touch with Energize Music for bookings, press, artist submissions, or general inquiries."
  keywords={['contact Energize Music', 'booking', 'press', 'A&R']}
  breadcrumbs={crumbs({ name: 'Contact', path: '/contact' })}
>
  <section class="mx-auto max-w-7xl px-5 pb-24 pt-14 sm:px-6 sm:pb-32 sm:pt-20 lg:px-8">
    <SectionTitle tag="h1" title="Let's Talk" eyebrow="Contact" />
    <p class="mt-6 max-w-xl text-muted">Bookings, partnerships, press or artist submissions. Tell us what it is about and we will route it to the right person.</p>

    <form
      id="contact-form"
      class="contact-form"
      data-endpoint-configured={formEndpoint ? 'true' : 'false'}
    >
      <fieldset class="contact-form__purpose">
        <legend class="contact-form__label">What is it about?</legend>
        <div class="contact-form__chips">
          {
            intentOrder.map((intent, index) => (
              <label class="contact-form__chip">
                <input type="radio" name="intent" value={intent} checked={index === 0} />
                <span>{intentLabels[intent]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="contact-form__row">
        <div>
          <label for="name" class="contact-form__label">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" class="contact-form__input" />
        </div>
        <div>
          <label for="email" class="contact-form__label">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="contact-form__input" />
        </div>
      </div>

      <div>
        <label for="message" class="contact-form__label">Message</label>
        <textarea id="message" name="message" rows={6} required class="contact-form__input"></textarea>
      </div>

      <!-- Honeypot: hidden from real users, bots that fill it are rejected. -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="contact-form__submit">Send message</button>

      <p id="contact-form-status" class="text-sm text-ink" role="status"></p>
    </form>

    <p class="contact-work">
      Want to work with us? <a href={workWithUsHref}>Email us.</a>
    </p>
  </section>
</BaseLayout>

<script>
  (function () {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-form-status');

    const params = new URLSearchParams(window.location.search);
    const requestedIntent = params.get('intent');
    if (requestedIntent) {
      const match = form?.querySelector<HTMLInputElement>(`input[name="intent"][value="${CSS.escape(requestedIntent)}"]`);
      if (match) match.checked = true;
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const company = (form.elements.namedItem('company') as HTMLInputElement | null)?.value;
      if (company) return;

      if (form.dataset.endpointConfigured !== 'true') {
        if (status) {
          status.textContent =
            'Thanks. The contact form is not connected to a delivery provider yet, so please reach us on social media for now.';
        }
        return;
      }
    });
  })();
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.5rem;
    max-width: 44rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .contact-form__purpose {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-form__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-form__chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .contact-form__chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    cursor: pointer;
  }

  .contact-form__chip input:checked + span {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .contact-form__chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-form__row {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .contact-form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-form__input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: var(--color-bg);
    font-size: 1rem;
    color: var(--color-ink);
  }

  .contact-form__input:focus-visible {
    outline: none;
    border-color: var(--color-ink);
  }

  .contact-form__submit {
    justify-self: start;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    border: 0;
    border-radius: 9999px;
    background: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    cursor: pointer;
  }

  .contact-form__submit:hover,
  .contact-form__submit:focus-visible {
    background: var(--color-ink);
  }

  .contact-work {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .contact-work a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }
</style>
