---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { contactIntents } from '@energize/shared';
import { crumbs } from '../lib/seo/schema';

const intentLabels: Record<(typeof contactIntents)[number], string> = {
  'a&r': 'A&R',
  press: 'Press',
  partnership: 'Partnership',
  booking: 'Booking',
  general: 'General',
};

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
---

<BaseLayout
  title="Contact"
  description="Reach Energize Music for A&R, press, partnerships, booking, and general inquiries."
  keywords={['contact Energize Music', 'A&R', 'press', 'booking']}
  breadcrumbs={crumbs({ name: 'Contact', path: '/contact' })}
>
  <PageHero
    size="slim"
    title="Contact"
    description="Tell us what you're reaching out about and we'll route it to the right team."
  />

  <section class="mx-auto max-w-2xl px-5 pb-16 pt-10 sm:px-6 sm:pb-24 sm:pt-12">
    <form
      id="contact-form"
      class="scroll-reveal space-y-5"
      style="--reveal-delay: 80ms"
      data-endpoint-configured={formEndpoint ? 'true' : 'false'}
    >
      <div>
        <label for="name" class="block text-sm font-medium text-paper/80">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="mt-1.5 w-full rounded-lg border border-white/20 bg-transparent px-4 py-3 text-base text-paper focus-visible:border-[var(--color-glow)] sm:py-2.5 sm:text-sm"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-paper/80">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="mt-1.5 w-full rounded-lg border border-white/20 bg-transparent px-4 py-3 text-base text-paper focus-visible:border-[var(--color-glow)] sm:py-2.5 sm:text-sm"
        />
      </div>

      <div>
        <label for="intent" class="block text-sm font-medium text-paper/80">I'm reaching out about</label>
        <select
          id="intent"
          name="intent"
          class="mt-1.5 w-full rounded-lg border border-white/20 bg-[var(--color-ink)] px-4 py-3 text-base text-paper focus-visible:border-[var(--color-glow)] sm:py-2.5 sm:text-sm"
        >
          {contactIntents.map((intent) => (
            <option value={intent}>{intentLabels[intent]}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-paper/80">Message</label>
        <textarea
          id="message"
          name="message"
          rows={5}
          required
          class="mt-1.5 w-full rounded-lg border border-white/20 bg-transparent px-4 py-3 text-base text-paper focus-visible:border-[var(--color-glow)] sm:py-2.5 sm:text-sm"
        />
      </div>

      <!-- Honeypot: hidden from real users, bots that fill it are rejected. -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        class="inline-flex min-h-11 items-center rounded-full bg-[var(--color-glow)] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[var(--color-glow)]/90"
      >
        Send message
      </button>

      <p id="contact-form-status" class="text-sm text-paper/60" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script>
  (function () {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-form-status');
    const intentSelect = document.getElementById('intent') as HTMLSelectElement | null;

    const params = new URLSearchParams(window.location.search);
    const requestedIntent = params.get('intent');
    if (requestedIntent && intentSelect) {
      const match = Array.from(intentSelect.options).find((opt) => opt.value === requestedIntent);
      if (match) intentSelect.value = requestedIntent;
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const company = (form.elements.namedItem('company') as HTMLInputElement | null)?.value;
      if (company) return;

      if (form.dataset.endpointConfigured !== 'true') {
        if (status) {
          status.textContent =
            'Thanks - the contact form is not wired to a delivery provider yet. Please email us directly in the meantime.';
        }
        return;
      }
    });
  })();
</script>
