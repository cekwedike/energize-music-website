---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostReader from '../../components/blogs/BlogPostReader.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { sanityClient, urlForImage } from '../../lib/sanity/client';
import { allNewsListQuery, newsBySlugQuery, type NewsPost, type NewsPostSummary } from '@energize/shared';
import {
  bodyWithoutLead,
  estimateReadMinutes,
  extractLeadParagraph,
  formatPublishedDate,
  formatRelatedDate,
} from '../../lib/blogs/postMeta';
import { getPostCategory } from '../../lib/blogs/display';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<Pick<NewsPostSummary, 'slug'>[]>(allNewsListQuery);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<NewsPost | null>(newsBySlugQuery, { slug });

if (!post) {
  return Astro.redirect('/blogs');
}

const coverUrl = urlForImage(post.cover).width(1920).height(1080).fit('crop').auto('format').url();
const publishedLabel = formatPublishedDate(post.date);
const readMinutes = estimateReadMinutes(post.body);
const lead = extractLeadParagraph(post.body);
const body = bodyWithoutLead(post.body);
const category = getPostCategory(post);
const shareUrl = absoluteUrl(`/blogs/${post.slug}`);

const allPosts = await sanityClient.fetch<NewsPostSummary[]>(allNewsListQuery);
const related = allPosts
  .filter((item) => item.slug !== post.slug)
  .slice(0, 3)
  .map((item) => ({
    title: item.title,
    slug: item.slug,
    dateLabel: formatRelatedDate(item.date),
    readMinutes: estimateReadMinutes([]),
    coverUrl: urlForImage(item.cover).width(720).height(900).fit('crop').auto('format').url(),
    category: getPostCategory(item),
  }));

// Prefer real read-time when we have excerpt word counts as a cheap proxy.
for (const item of related) {
  const source = allPosts.find((entry) => entry.slug === item.slug);
  if (source?.excerpt) {
    const words = source.excerpt.trim().split(/\s+/).filter(Boolean).length;
    item.readMinutes = Math.max(1, Math.round(words / 200));
  }
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  '@id': `${shareUrl}#article`,
  headline: post.title,
  description: lead ?? post.title,
  datePublished: post.date,
  dateModified: post.date,
  image: [coverUrl],
  url: shareUrl,
  mainEntityOfPage: shareUrl,
  articleSection: category,
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    '@id': organizationId(),
    name: 'Energize Music',
  },
  publisher: {
    '@id': organizationId(),
  },
  isPartOf: {
    '@type': 'Blog',
    name: 'Energize Music Blog',
    url: absoluteUrl('/blogs'),
  },
};
---

<BaseLayout
  title={post.title}
  description={lead ?? post.title}
  ogImage={coverUrl}
  ogType="article"
  publishedTime={post.date}
  modifiedTime={post.date}
  keywords={[post.title, 'Energize Music', category, 'Afro-gospel']}
  breadcrumbs={crumbs(
    { name: 'Blogs', path: '/blogs' },
    { name: post.title, path: `/blogs/${post.slug}` },
  )}
  ambientVariant="editorial"
  headerVariant="overlay"
>
  <JsonLd data={jsonLd} />
  <BlogPostReader
    post={post}
    coverUrl={coverUrl}
    publishedLabel={publishedLabel}
    readMinutes={readMinutes}
    lead={lead}
    body={body}
    shareUrl={shareUrl}
    category={category}
    related={related}
  />
</BaseLayout>

<script>
  import { initBlogPost } from '../../lib/motion/blogs/initBlogPost';

  initBlogPost();
</script>
