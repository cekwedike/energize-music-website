---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogsZineHero from '../../components/blogs/BlogsZineHero.astro';
import BlogsZineSpread from '../../components/blogs/BlogsZineSpread.astro';
import { sanityClient } from '../../lib/sanity/client';
import { allNewsQuery, type NewsPost } from '@energize/shared';

const posts = await sanityClient.fetch<NewsPost[]>(allNewsQuery);
---

<BaseLayout title="Blogs" description="Announcements and stories from Energize Music, filed like a zine." ambientVariant="editorial">
  <BlogsZineHero posts={posts} />
  <BlogsZineSpread posts={posts} />
</BaseLayout>

<script>
  import { initBlogsIndex } from '../../lib/motion/blogs/initBlogsIndex';

  initBlogsIndex();
</script>
