---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CareersRoleDetail from '../../components/careers/CareersRoleDetail.astro';
import { sanityClient } from '../../lib/sanity/client';
import {
  allCareerOpeningsQuery,
  careerOpeningBySlugQuery,
  type CareerOpening,
  type PortableTextBlock,
} from '@energize/shared';
import JsonLd from '../../components/seo/JsonLd.astro';
import { crumbs, organizationId } from '../../lib/seo/schema';
import { absoluteUrl } from '../../lib/seo/site';

export async function getStaticPaths() {
  const openings = await sanityClient.fetch<Pick<CareerOpening, 'slug'>[]>(allCareerOpeningsQuery);
  return openings.map((opening) => ({ params: { slug: opening.slug } }));
}

const { slug } = Astro.params;
const role = await sanityClient.fetch<
  (CareerOpening & { description: PortableTextBlock[] }) | null
>(careerOpeningBySlugQuery, { slug });

if (!role) {
  return Astro.redirect('/careers');
}

const pageUrl = absoluteUrl(`/careers/${role.slug}`);
const jobSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: role.title,
  description: `${role.title} at Energize Music. ${role.location}. ${role.type}.`,
  employmentType: role.type?.toUpperCase().replace(/\s+/g, '_'),
  hiringOrganization: { '@id': organizationId() },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: role.location || 'Lagos',
      addressCountry: 'NG',
    },
  },
  url: pageUrl,
  directApply: Boolean(role.applyUrl),
};
---

<BaseLayout
  title={role.title}
  description={`${role.title} at Energize Music. ${role.location}. ${role.type}.`}
  keywords={[role.title, 'Energize Music careers', role.location, role.type].filter(Boolean) as string[]}
  breadcrumbs={crumbs(
    { name: 'Careers', path: '/careers' },
    { name: role.title, path: `/careers/${role.slug}` },
  )}
  ambientVariant="editorial"
>
  <JsonLd data={jobSchema} />
  <CareersRoleDetail role={role} />
</BaseLayout>
