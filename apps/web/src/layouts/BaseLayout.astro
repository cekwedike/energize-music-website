---
import SEO from '../components/ui/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader, { type HeaderVariant } from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import FooterMarquee from '../components/ui/FooterMarquee.astro';
import AmbientBackground, { type AmbientVariant } from '../components/ui/AmbientBackground.astro';
import { buildBreadcrumbSchema, buildSiteGraph } from '../lib/seo/schema';
import type { BreadcrumbItem } from '../lib/seo/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'music.song' | 'music.album' | 'profile' | 'music.playlist';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  breadcrumbs?: BreadcrumbItem[];
  hideHeader?: boolean;
  hideFooter?: boolean;
  showTopMarquee?: boolean;
  ambientVariant?: AmbientVariant;
  /** Skip decorative ambient layers (e.g. homepage hero already fills the viewport). */
  hideAmbient?: boolean;
  headerVariant?: HeaderVariant;
  pageTheme?: 'dark' | 'light';
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  keywords,
  breadcrumbs,
  hideHeader = false,
  hideFooter = false,
  showTopMarquee = false,
  ambientVariant,
  hideAmbient = false,
  headerVariant = 'default',
  pageTheme = 'dark',
} = Astro.props;

const pathname = Astro.url.pathname;
const siteGraph = buildSiteGraph();
const breadcrumbGraph = breadcrumbs?.length ? buildBreadcrumbSchema(breadcrumbs) : null;

function resolveAmbientVariant(): AmbientVariant {
  if (ambientVariant) return ambientVariant;
  if (pathname === '/') return 'home';
  if (pathname.startsWith('/about') || pathname.startsWith('/artists')) return 'editorial';
  if (pathname.startsWith('/next')) return 'pulse';
  if (
    pathname.startsWith('/energize-kids') ||
    pathname.startsWith('/energize-fest') ||
    pathname.startsWith('/events')
  ) {
    return 'warm';
  }
  return 'cosmic';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <SEO
      title={title}
      description={description}
      path={Astro.url.pathname}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
    />
    <JsonLd data={siteGraph} />
    {breadcrumbGraph && <JsonLd data={breadcrumbGraph} />}
    <slot name="head" />
  </head>
  <body class:list={['site-body', pageTheme === 'light' && 'site-body--light']}>
    {
      pageTheme === 'light' || hideAmbient ? null : (
        <AmbientBackground variant={resolveAmbientVariant()} />
      )
    }
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideHeader && <SiteHeader variant={headerVariant} />}
    {showTopMarquee && <FooterMarquee placement="top" />}
    <main id="main-content" class="site-main relative">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}
  </body>
</html>

<script>
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const REVEAL_SELECTOR =
      '.scroll-reveal, .scroll-reveal-pixel, .about-scroll-reveal, .next-scroll-reveal';

    document.querySelectorAll<HTMLElement>('.scroll-reveal-stagger').forEach((host) => {
      const variant = host.dataset.revealVariant === 'pixel' ? 'scroll-reveal-pixel' : 'scroll-reveal';
      const step = Number(host.dataset.revealStep) || 70;

      host.querySelectorAll<HTMLElement>(':scope > *').forEach((node, index) => {
        if (
          !node.classList.contains('scroll-reveal') &&
          !node.classList.contains('scroll-reveal-pixel') &&
          !node.classList.contains('about-scroll-reveal') &&
          !node.classList.contains('next-scroll-reveal')
        ) {
          node.classList.add(variant);
        }

        if (!node.style.getPropertyValue('--reveal-delay')) {
          node.style.setProperty('--reveal-delay', `${index * step}ms`);
        }
      });
    });

    const reveals = document.querySelectorAll(REVEAL_SELECTOR);
    if (reveals.length === 0) return;

    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    reveals.forEach((el) => observer.observe(el));
  })();
</script>
