---
import SEO from '../components/ui/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader, { type HeaderVariant } from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import { buildBreadcrumbSchema, buildSiteGraph } from '../lib/seo/schema';
import type { BreadcrumbItem } from '../lib/seo/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'music.song' | 'music.album' | 'profile' | 'music.playlist';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  breadcrumbs?: BreadcrumbItem[];
  hideHeader?: boolean;
  hideFooter?: boolean;
  headerVariant?: HeaderVariant;
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  keywords,
  breadcrumbs,
  hideHeader = false,
  hideFooter = false,
  headerVariant = 'default',
} = Astro.props;

const siteGraph = buildSiteGraph();
const breadcrumbGraph = breadcrumbs?.length ? buildBreadcrumbSchema(breadcrumbs) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="author" type="text/plain" href="/humans.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <SEO
      title={title}
      description={description}
      path={Astro.url.pathname}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
    />
    <JsonLd data={siteGraph} />
    {breadcrumbGraph && <JsonLd data={breadcrumbGraph} />}
    <slot name="head" />
  </head>
  <body class="site-body">
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideHeader && <SiteHeader variant={headerVariant} />}
    <main id="main-content" class="site-main relative">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}
  </body>
</html>

<script>
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = document.querySelectorAll('.scroll-reveal');
    if (reveals.length === 0) return;

    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    reveals.forEach((el) => observer.observe(el));
  })();
</script>
