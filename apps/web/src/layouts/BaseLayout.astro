---
import SEO from '../components/ui/SEO.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import AmbientBackground, { type AmbientVariant } from '../components/ui/AmbientBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  ambientVariant?: AmbientVariant;
}

const { title, description, ogImage, hideHeader = false, hideFooter = false, ambientVariant } = Astro.props;

const pathname = Astro.url.pathname;

function resolveAmbientVariant(): AmbientVariant {
  if (ambientVariant) return ambientVariant;
  if (pathname === '/') return 'home';
  if (pathname.startsWith('/about')) return 'editorial';
  if (pathname.startsWith('/next')) return 'pulse';
  if (pathname.startsWith('/energize-kids') || pathname.startsWith('/energize-fest')) return 'warm';
  return 'cosmic';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} path={Astro.url.pathname} ogImage={ogImage} />
  </head>
  <body>
    <AmbientBackground variant={resolveAmbientVariant()} />
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideHeader && <SiteHeader />}
    <main id="main-content" class="relative">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}
  </body>
</html>

<script>
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const REVEAL_SELECTOR =
      '.scroll-reveal, .scroll-reveal-pixel, .about-scroll-reveal, .next-scroll-reveal';

    document.querySelectorAll<HTMLElement>('.scroll-reveal-stagger').forEach((host) => {
      const variant = host.dataset.revealVariant === 'pixel' ? 'scroll-reveal-pixel' : 'scroll-reveal';
      const step = Number(host.dataset.revealStep) || 70;

      host.querySelectorAll<HTMLElement>(':scope > *').forEach((node, index) => {
        if (
          !node.classList.contains('scroll-reveal') &&
          !node.classList.contains('scroll-reveal-pixel') &&
          !node.classList.contains('about-scroll-reveal') &&
          !node.classList.contains('next-scroll-reveal')
        ) {
          node.classList.add(variant);
        }

        if (!node.style.getPropertyValue('--reveal-delay')) {
          node.style.setProperty('--reveal-delay', `${index * step}ms`);
        }
      });
    });

    const reveals = document.querySelectorAll(REVEAL_SELECTOR);
    if (reveals.length === 0) return;

    if (reduced) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    reveals.forEach((el) => observer.observe(el));
  })();
</script>
