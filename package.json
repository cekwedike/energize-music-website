{
  "name": "energize-music-website",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @energize/web dev",
    "dev:studio": "pnpm --filter @energize/studio dev",
    "build": "pnpm --filter @energize/shared build && pnpm --filter @energize/web build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"],
    "overrides": {
      "sharp": ">=0.35.0"
    }
  }
}
