{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @energize/shared build && pnpm --filter @energize/web build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/blogs",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/blogs/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/careers",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/careers/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/events",
      "destination": "https://energizehq.netlify.app/live",
      "statusCode": 301
    },
    {
      "source": "/events/:path((?!energize-fest/?$).+)",
      "destination": "https://energizehq.netlify.app/live",
      "statusCode": 301
    },
    {
      "source": "/energize-fest",
      "destination": "/events/energize-fest",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/rebuild",
      "schedule": "0 23 * * *"
    }
  ]
}
