# Web (public)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
PUBLIC_SITE_URL=https://energize-music.com
# Forms post to /api on the same host. Only set this if the site is served
# somewhere else (e.g. Hostinger) and the API lives on Vercel.
PUBLIC_FORMS_API_BASE=

# SEO / ads (all optional; tags only load when set)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=

# Server / CI only (never commit values)
SANITY_READ_TOKEN=

# Brevo forms (Vercel env only, never commit values). See docs/FORMS.md
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_CONTACT_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Energize Music Website
CONTACT_TO_EMAIL=
# Optional double opt-in for the email list
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
# Optional: extra origins allowed to call /api (comma separated)
FORMS_ALLOWED_ORIGINS=

# Sanity Studio (apps/studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Studio seed scripts only (never commit values)
SANITY_WRITE_TOKEN=
